    <http://bauhaus/qualite/attribut/1653/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est bas&eacute;e sur un &eacute;chantillon de logements tir&eacute; au printemps 2014 dans une base de sondage au 1er janvier 2013.<br />La base de sondage principale envisag&eacute;e est l'&eacute;chantillon-Ma&icirc;tre OCTOPUSSE.<br />Cette base ne couvrant que les logements des m&eacute;nages ordinaires, un &eacute;chantillon compl&eacute;mentaire est tir&eacute; dans le r&eacute;pertoire des communaut&eacute;s (internats, foyers &eacute;tudiants, foyers de jeunes travailleurs).<br />L'enqu&ecirc;te vise 5 000 jeunes r&eacute;pondants environ : 4 000 en logements ordinaires, 1 000 en communaut&eacute;. Le volet des parents est estim&eacute; &agrave; 6 000 parents r&eacute;pondants environ.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1653/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1653/S.18.3/texte> , <http://bauhaus/qualite/attribut/1653/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "DREES : raphaelle.rivalin@sante.gouv.fr INSEE :sebastien.grobon@insee.fr"@fr , "DREES : raphaelle.rivalin@sante.gouv.fr INSEE :sebastien.grobon@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/I.20/texte>
