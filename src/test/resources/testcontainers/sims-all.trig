            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes suivants sont abord&eacute;s :</p>\n<p>- relations avec la fili&egrave;re automobile (fonction, rang, clients)</p>\n<p>- perspectives (carnet de commande, recrutements)</p>\n<p>- ressources humaines (cadres, int&eacute;rim)</p>\n<p>- rapport &agrave; l'innovation, la certification, la qualit&eacute;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
