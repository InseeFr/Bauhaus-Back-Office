            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur les entreprises et le développement durable 2011"@fr , "Quality report: Companies and sustainable development 2011"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1307> .
    
    <http://bauhaus/qualite/attribut/1656/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data was collected via Internet and mail if necessary (the latter case is relatively rare: in 2011, 90% of respondents chose to&nbsp;respond via Internet).</p>\n<p>Data collecting is one-time or multi-year.</p>\n<p>No regional expansion is envisaged.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1656/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1656/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1656> .
    
    <http://bauhaus/qualite/attribut/1656/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1656/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1656> .
    
    <http://bauhaus/qualite/attribut/1656/S.18.2>
