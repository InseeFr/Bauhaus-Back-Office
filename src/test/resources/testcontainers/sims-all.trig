    <http://bauhaus/documents/document/308>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie du dispositif d'enquêtes permanentes des Conditions de vie / EPCV"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-03-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_EPCV_fixe.pdf> .
    
    <http://bauhaus/qualite/attribut/1657/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1657/I.18.7/text> , <http://bauhaus/qualite/attribut/1657/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1657/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le dispositif EPCV comporte trois enqu&ecirc;tes par an.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1657/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>\"Social indicators\" component:</p>\n<p>- Quality of habitat and environment</p>\n<p>- Health, accommodation and the financial situation of households</p>\n<p>- Participation (in the voluntary sector and electoral activities, etc.) and social contacts.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1657/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Tous les ans, de 1996 &agrave; 2003, une enqu&ecirc;te est r&eacute;alis&eacute;e en janvier, une autre en mai et la derni&egrave;re en octobre. En 2004 et 2005, une enqu&ecirc;te est r&eacute;alis&eacute;e en janvier et une seconde en octobre. Les deux derni&egrave;res enqu&ecirc;tes ont &eacute;t&eacute; r&eacute;alis&eacute;es en janvier 2006.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1657/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1657/I.18.10/text> , <http://bauhaus/qualite/attribut/1657/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2011-11-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1657/S.18.3/text> , <http://bauhaus/qualite/attribut/1657/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Every year, from 1996 to 2003, one survey was conducted in January, another in May and the last one in October. In 2004 and 2005, one survey was conducted in January and a second in October. The last two surveys were in January 2006.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1657/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/308> .
    
    <http://bauhaus/qualite/attribut/1657/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Composante \" indicateurs sociaux \" :</p>\n<p>- qualit&eacute; de l'habitat et de l'environnement ;</p>\n<p>- sant&eacute;, logement et situation financi&egrave;re des m&eacute;nages ;</p>\n<p>- participation (&agrave; la vie associative, &eacute;lectorale etc.) et contacts sociaux.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1657>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Dispositif d'enquêtes permanentes des conditions de vie 2008"@fr , "Quality report: Permanent living conditions survey 2008"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1447> .
    
    <http://bauhaus/qualite/attribut/1657/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is administered to a sample of 8,800 households on each occasion and one (in October) to three (in May and January) randomly sampled individual(s) per household responding to the questionnaire, for a total of approximately 11,000 individuals responding in January."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1657/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1657> .
    
    <http://bauhaus/qualite/attribut/1657/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée auprès d'un échantillon de 8 800 ménages à chaque fois et de un (octobre) à trois (en mai et janvier) individu(s) tiré(s) au sort par ménage répondant au questionnaire, soit, en janvier, environ 11 000 individus répondants."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1778> {
    <http://bauhaus/qualite/attribut/1778/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1778/S.3.6/texte> , <http://bauhaus/qualite/attribut/1778/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les entreprises déclarant mensuellement la TVA sont celles relevant du régime fiscal réel normal. Ce régime concerne les entreprises prestataires de services réalisant un chiffre d'affaires supérieur à 236 000 euros ainsi que les entreprises de vente de marchandises et de fourniture de logement réalisant un chiffre d'affaires supérieur à 783 000 euros. Les entreprises dont le montant de TVA exigible annuellement ne dépasse pas 4 000 euros dans l'année peuvent toutefois effectuer des déclarations trimestrielles."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1778/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Depuis 2016 le calcul des indices de chiffre d'affaires est r&eacute;alis&eacute; &agrave; partir de l'exhaustivit&eacute; des d&eacute;clarations mensuelles de la source fiscale. Cette nouvelle m&eacute;thodologie de calcul des indices a &eacute;t&eacute; mise en &oelig;uvre pour mieux prendre en compte la d&eacute;mographie des entreprises et ainsi refl&eacute;ter plus pr&eacute;cis&eacute;ment la r&eacute;alit&eacute; &eacute;conomique. En effet les indices de chiffre d'affaires d'une ann&eacute;e N pr&eacute;c&eacute;demment calcul&eacute;s ne prenaient pas en compte les cr&eacute;ations d'entreprises, cessations, entr&eacute;es et sorties de champ et changement de secteur survenues au cours de l'ann&eacute;e N, l'&eacute;chantillon &eacute;tant tir&eacute; au 31/12 de l'ann&eacute;e N-1. Dans le cadre d'un projet de r&eacute;novation des indices de chiffres d'affaires, des solutions ont &eacute;t&eacute; mises en &oelig;uvre pour corriger ce biais et produire des&nbsp;indices de chiffre d'affaires de meilleure qualit&eacute;. Il s'agit, d'une part, de s'affranchir des &eacute;chantillons annuels en exploitant la totalit&eacute; des d&eacute;clarations mensuelles de TVA, d'autre part de s'appuyer sur le r&eacute;pertoire statistique Sirus &agrave; la place du r&eacute;pertoire administratif Sirene, de mani&egrave;re &agrave; b&eacute;n&eacute;ficier d'une mise &agrave; disposition beaucoup plus rapide et automatis&eacute;e des &eacute;v&eacute;nements d&eacute;mographiques les plus r&eacute;cents ayant affect&eacute; les entreprises.<br /><br />Les indices de chiffre d'affaires dans les services sont des indices mensuels en valeur (en euros courants hors taxe). Ces indices sont calcul&eacute;s en r&eacute;f&eacute;rence 100 en 2010 (les indices ont pour moyenne 100 en 2010). Ils sont calcul&eacute;s comme des indices de Laspeyres, &agrave; pond&eacute;rations constantes dans le temps des indices les plus fins, et font l'objet d'un rebasement tous les 5 ans.<br /><br />Les pond&eacute;rations constantes des indices &eacute;l&eacute;mentaires sont les productions vendues des branches en 2010 aux prix de base. Par d&eacute;finition, les productions aux prix de base excluent les imp&ocirc;ts sur les produits mais sont augment&eacute;es des subventions sur les produits&nbsp;; elles ne comprennent pas les prestations de transport. Les pond&eacute;rations ont &eacute;t&eacute; calcul&eacute;es &agrave; partir des donn&eacute;es des comptes nationaux.<br /><br />Les s&eacute;ries sont corrig&eacute;es des variations saisonni&egrave;res (CVS) et des effets de calendrier (CJO). Ces effets sont estim&eacute;s avec le logiciel X12-Arima sous JDemetra+ (fourni par Eurostat) au niveau des classes de la NAF r&eacute;v. 2. Les indices&nbsp;CVS-CJO des postes des niveaux sup&eacute;rieurs sont obtenus par agr&eacute;gation des indices CVS-CJO des classes qui les composent.<br /><br />La moyenne annuelle des indices CVS-CJO peut diff&eacute;rer l&eacute;g&egrave;rement de celle des indices bruts car elle tient compte des variations de la composition annuelle en jours ouvrables d&rsquo;une ann&eacute;e sur l&rsquo;autre&nbsp;: ann&eacute;es bissextiles, positionnement dans la semaine des&nbsp;diff&eacute;rents jours f&eacute;ri&eacute;s, etc.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/77> .
    
    <http://bauhaus/qualite/attribut/1778/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The turnover indices in the services are calculated according to the nomenclature NAF rev. 2, which came into force on 1 January 2008.<br /><br />They cover the following sectors:<br />- Transport and storage (Section H);<br />- Accommodation and Catering (Section I);<br />- Information and communication (Section J);<br />- Real estate activities (Section L);<br />- Specialized scientific and technical activities (Section M);<br />- Administrative and support services (Section N).<br />- Arts, Entertainment and Recreation (Section R);<br />- Other service activities (Section S, Divisions 95 and 96 only).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1778/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Since 2016, the calculation of turnover indices is based on the exhaustiveness of the monthly declarations of the tax source. This new index calculation methodology has been implemented in order to better take into account the demographics of companies and thus more accurately reflect the economic reality. Indeed, the turnover indexes of an N year previously calculated did not take into account the start-ups, discontinuations, entry and exit of fields and changes of sector that occurred during year N, the sample Being drawn at 31/12 of year N-1. As part of a project to revise turnover indices, solutions have been implemented to correct this bias and produce better sales turnover indices. On the one hand, it is necessary to free oneself from the annual samples by exploiting the totality of the monthly VAT returns and, on the other hand, to rely on the Sirus statistical register in place of the Sirene administrative register, to benefit from a much faster and automated provision of the most recent demographic events affecting businesses.<br /><br />Revenue indices in services are monthly indexes in value (in current euros excluding tax). These&nbsp;indices are calculated in reference 100 in 2010 (the indexes are for average 100 in 2010). They are calculated as Laspeyres indices, with constant weights over the time of the finest indices, and are re-plated every 5 years.<br /><br />The constant weightings of the basic indices are the sales of branches in 2010 at basic prices. By definition, productions at basic prices exclude taxes on products but are increased by subsidies on products; They do not include transport services. The weights were calculated from national accounts data.<br /><br />The series are corrected for seasonal adjustments (SA) and calendar effects (working day adjustments WDA). An estimate of these effects is produced with the X12-Arima software in JDemetra+ (supplied by Eurostat) at the classes level of NAF rev. 2. SA-WDA indices for higher levels are obtained by aggregating the SA-WDA indices of&nbsp;the classes that make up the level.<br />The annual mean of the SA-WDA indices can slightly differ from that of the raw indices because it takes into account variations from one year to the next in the annual composition in working days: presence of leap years, position in the week of various public holidays, and so on.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1778/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1778/S.19/texte> , <http://bauhaus/qualite/attribut/1778/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1778/S.18.1/texte> , <http://bauhaus/qualite/attribut/1778/S.18.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/rapport/1778>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Turnover index in services"@en , "Rapport qualité : Indice de chiffre d'affaires dans les services"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1637> .
    
    <http://bauhaus/qualite/attribut/1778/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 jours"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de chiffre d'affaires sont construits &agrave; partir d'une source fiscale, le formulaire &laquo;&nbsp;CA3&nbsp;&raquo;, que doivent remplir les&nbsp;entreprises pour le paiement de la taxe sur la valeur ajout&eacute;e (TVA) tous les mois.<br /><br />Ils comprennent l'ensemble du chiffre d'affaires des entreprises d&eacute;clarantes, toutes activit&eacute;s confondues, class&eacute;es selon l'activit&eacute; principale de l'entreprise.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1778/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1778/S.10.6/texte> , <http://bauhaus/qualite/attribut/1778/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.3.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.9>
                    "Année 2010"@fr , "Year 2010"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de chiffre d'affaires dans les services sont calcul&eacute;s selon la nomenclature NAF r&eacute;v. 2, entr&eacute;e en vigueur le 1er janvier 2008.<br /><br />Ils couvrent les secteurs suivants :<br />- Transport et entreposage (Section H) ;<br />- H&eacute;bergement et restauration (Section I) ;<br />- Information et communication (Section J) ;<br />- Activit&eacute;s immobili&egrave;res (Section L) ;<br />- Activit&eacute;s sp&eacute;cialis&eacute;es, scientifiques et techniques (Section M) ;<br />- Activit&eacute;s de services administratifs et de soutien (Section N).<br />- Arts, spectacles et activit&eacute;s r&eacute;cr&eacute;atives (Section R) ;<br />- Autres activit&eacute;s de services (Section S, divisions 95 et 96 uniquement).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1778/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-04-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "month"@en , "mois"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The turnover indices are calculated from a tax source, the \"CA3\" form, which must be completed by enterprises for the payment of value added tax (VAT) every month.<br /><br />France (with the exception of French Guiana and Mayotte not subject to VAT).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de chiffre d'affaires sont construits &agrave; partir d'une source fiscale, le formulaire &laquo;&nbsp;CA3&nbsp;&raquo;, que doivent remplir les&nbsp;entreprises pour le paiement de la taxe sur la valeur ajout&eacute;e (TVA) tous les mois.<br /><br />France enti&egrave;re (&agrave; l'exception de la Guyane et de Mayotte non assujettis &agrave; la TVA).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1778/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "à partir de 1999"@fr , "from year 1999"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The companies reporting VAT on a monthly basis are those under the normal real tax system. This scheme concerns service providers with a turnover of more than EUR 236 000, as well as companies selling goods and supplying housing with a turnover of more than EUR 783 000. However, companies whose annual VAT amount does not exceed € 4,000 can make quarterly returns."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1778/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1778/S.14.1/texte> , <http://bauhaus/qualite/attribut/1778/S.14.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The turnover indices are calculated&nbsp; from a tax source, the \"CA3\" form, which must be completed by enterprises for the payment of value added tax (VAT) every month.<br /><br />They include the total turnover of reporting companies, all activities combined, classified according to the main activity of the company.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1778/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.4>
                    "dimensionless value other than PC, PCPA and POINTS"@en , "valeur sans dimension autre que PC, PCPA et POINTS"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/documents/document/77>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indices de chiffres d'affaires dans les services"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IND_ICA_SERVICES.pdf> .
    
    <http://bauhaus/qualite/attribut/1778/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1778/S.18.3/text> , <http://bauhaus/qualite/attribut/1778/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.14.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 days"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1778/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1899> {
    <http://bauhaus/qualite/attribut/1899/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2018-07-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The Comit&eacute; de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry&nbsp;: DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D). <br />The needs of local partners are taken into account through partnership agreements with the tourism sites of Insee.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>The survey is conducted among a national sample of approximately 2,500 establishments from 3,500.</p>"@en , "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon national d'environ 2 500 &eacute;tablissements sur un total de 3 500.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is by post, and centralized collection at some enterprises (example Lagrange).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te de fr&eacute;quentation dans les autres h&eacute;bergements collectifs touristiques compl&egrave;te les informations concernant la fr&eacute;quentation touristique d&eacute;j&agrave; produites par :<br />- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie de tourisme ;<br />- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie de plein air.<br />Cette enqu&ecirc;te rentre dans le cadre du r&eacute;glement europ&eacute;en n&deg;692/2011 concernant la production d'informations statistiques sur le tourisme &agrave; Eurostat.<br />Elle r&eacute;pond &eacute;galement aux besoins nationaux de la Direction G&eacute;n&eacute;rale des Entreprises (DGE) et locaux pour les acteurs et d&eacute;cideurs r&eacute;gionaux du tourisme.<br />Le dispositif comporte deux extensions r&eacute;gionales dans les deux r&eacute;gions o&ugrave; existaient d&eacute;j&agrave; cette enqu&ecirc;te (Rh&ocirc;ne-Alpes, Languedoc-Roussillon).<br />Dans les DOM, les autres h&eacute;bergements collectifs sont enqu&ecirc;t&eacute;s dans l'enqu&ecirc;te de fr&eacute;quentation h&ocirc;teli&egrave;re.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1899/S.19/text> , <http://bauhaus/qualite/attribut/1899/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1899/S.18.3/text> , <http://bauhaus/qualite/attribut/1899/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le parc est mesur&eacute; au 31 d&eacute;cembre de chaque ann&eacute;e et la fr&eacute;quentation sur chaque mois.<br />Les principaux th&egrave;mes abord&eacute;s sont les suivants :<br />- caract&eacute;ristiques de l'&eacute;tablissement ;<br />- capacit&eacute; d'accueil ;<br />- occupation quotidienne des chambres ;<br />- arriv&eacute;es et nuit&eacute;es selon le pays de r&eacute;sidence des touristes ;<br />- dur&eacute;e moyenne de s&eacute;jour ;<br />- proportion de tourisme d'affaires.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1899/I.18.10/texte> , <http://bauhaus/qualite/attribut/1899/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The units surveyed are collective tourist accommodation that is subject to regulation&nbsp;: youth hostels, international accommodation centres, sports centres, tourism and hotel residences, family holiday homes and holiday villages.</p>\n<p>The economic unit surveyed is the accommodation operator (NAF rev. 2: 55.10Z and 55.20Z).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1899/S.3.6/text> , <http://bauhaus/qualite/attribut/1899/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling frame is the file of the other collective housing managed by INSEE. The stratification criteria for the national sample are:<br />- the geographical focus (regions, national tourist areas (ETNs))<br />- type of establishment<br />Within the strata, the draw is random.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est le fichier des autres h&eacute;bergements collectifs g&eacute;r&eacute; par l'Insee. Les crit&egrave;res de stratification de l'&eacute;chantillon national sont&nbsp;:<br />- l'axe g&eacute;ographique (r&eacute;gions, espaces touristiques nationaux (ETN))<br />- le type d'&eacute;tablissement<br />Au sein des strates, le tirage est al&eacute;atoire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1899/S.12.1/texte> , <http://bauhaus/qualite/attribut/1899/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les unit&eacute;s enqu&ecirc;t&eacute;es sont les h&eacute;bergements collectifs touristiques faisant l'objet d'une r&eacute;glementation&nbsp;: auberges de jeunesse, centres internationaux de s&eacute;jour, centres sportifs, r&eacute;sidences de tourisme et r&eacute;sidences h&ocirc;teli&egrave;res, maisons familiales de vacances et villages de vacances.</p>\n<p>L'unit&eacute; &eacute;conomique interrog&eacute;e est l'exploitant de l'h&eacute;bergement (NAF r&eacute;v.&nbsp;2 : 55.10Z et 55.20Z).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The occupancy survey in other collective tourist accommodation supplements the tourist occupancy information already produced by:<br />- Occupancy surveys of tourist hotels<br />- Occupancy surveys of campsites<br />This survey relates to European reglement n&deg;692/2011 concerning the production of statistical information on tourism at EUROSTAT.<br />It also meets the French national needs of the Enterprise Directorate General&nbsp; and the local needs of regional tourism stakeholders and decision makers.<br />The scheme includes two regional extensions in the two regions already covered by this survey (Rh&ocirc;ne-Alpes, Languedoc-Roussillon).<br />In the overseas departments, other collective tourist accomodation are in the hotel occupancy survey.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1899/I.18.7/texte> , <http://bauhaus/qualite/attribut/1899/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le Comit&eacute; de Coordination des Statistiques du Tourisme (CCST), anim&eacute; par l'Insee, int&egrave;gre les principaux acteurs nationaux du tourisme : DGE, Atout France, f&eacute;d&eacute;rations professionnelles des h&ocirc;teliers et repr&eacute;sentants des comit&eacute;s d&eacute;partementaux et r&eacute;gionaux du tourisme (FNCRT, RN2D). <br />Les besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1899/S.3.4/text> , <http://bauhaus/qualite/attribut/1899/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017M030EC"@fr , "2017M030EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The park is measured on December 31 of each year and the attendance over each month.<br />The main themes addressed are the following:<br />- characteristics of the establishment ;<br />- reception capacity ;<br />- daily occupancy of rooms ;<br />- arrivals and nights according to the country of residence of tourists ;<br />- average length of stay ;<br />- proportion of business tourism.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/rapport/1899>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête de fréquentation dans les autres hébergements collectifs touristiques 2017"@fr , "Quality report: Other Collective Tourist Accommodation Occupancy Survey 2017"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1455> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Questionnaires are sent at the end of the month for the month of collection.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les questionnaires sont envoy&eacute;s en fin de mois pour le mois de collecte.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e par voie postale, ainsi qu'une collecte centralis&eacute;e aupr&egrave;s de certaines enseignes (exemple Lagrange).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
}

