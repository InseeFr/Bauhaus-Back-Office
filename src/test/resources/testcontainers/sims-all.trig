    <http://bauhaus/documents/document/1224>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des micro-entrepreneurs créés en 2018 : situation initiale"@fr ;
