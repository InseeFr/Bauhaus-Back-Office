    <http://bauhaus/qualite/attribut/1719/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A specific data editing procedure has been implemented. This procedure&nbsp; also ensures the consistency of the survey data with admistrative data.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For the metrolopitan France, the scope of the survey covers the economic sectors of trade, market services excluding financial enterprises, the agri-food industries, building industry, transport, forestry and sawwmills (class 02.20). <br />For the overseas departments, the survey covers in addition the extractive, manufacturing and energy industry. The survey also allows to collect accounting information for the profiled enterprises.</p>\n<p>All sizes of businesses are covered by the scope of the survey.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es d&eacute;finitives sont publi&eacute;es en fin juin N+2 pour les donn&eacute;es de l'exercice N.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.8.1>
