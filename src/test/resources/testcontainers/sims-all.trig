    <http://bauhaus/qualite/attribut/1581/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1581/S.18.3/text> , <http://bauhaus/qualite/attribut/1581/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1581> .
    
    <http://bauhaus/qualite/attribut/1581/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1581> .
    
    <http://bauhaus/qualite/attribut/1581/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1581/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1581> .
    
    <http://bauhaus/qualite/attribut/1581/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers 2,500 companies with more than 10 employees.</p>\n<p>All companies with more than 500 employees are canvassed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1581/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly business outlook survey in the building industry is part of the European system to harmonise European Commission business outlook surveys, and to which the 27 Member States of the European Union contribute.<br /><br />Thus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system.<br /><br />Questions are formulated so that they can be answered quickly (most of the questions are qualitative with three response options expressed in the form \"higher, lower, stable\", or \"more than normal, normal, less than normal\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1581/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1581> .
    
    <http://bauhaus/qualite/attribut/1581/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1581/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1581> .
    
    <http://bauhaus/qualite/attribut/1581/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1581> .
    
    <http://bauhaus/qualite/attribut/1581/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly business outlook survey in the building industry covers companies working on the construction of individual houses and miscellaneous buildings, general building work, roofing, framing, fitting and finishing work.</p>\n<p>More precisely, the survey covers the sectors defined by the following NAF Rev. 2 codes: 41.2, 43.2, 43.3, 43.9</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1581/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/54> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1581/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1581/S.3.6/text> , <http://bauhaus/qualite/attribut/1581/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1581> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1690> {
    <http://bauhaus/qualite/attribut/1690/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sample of individuals to be surveyed was determined by combining sub-samples drawn from four different sources, including the master sample from INSEE (based on the 1999 population census) and the new housing survey data base (BSLN).</p>\n<p>Samples were taken from two surveys to ensure that they were fully representative of populations that were not sufficiently numerous in the general population for detailed analysis to be carried out: the Study of family history (EHF) survey and the Everyday life and health (VQS) survey.</p>\n<p>Three populations are therefore over-represented in the sample:<br />- people under 60 whose daily lives are disrupted because of a health problem;<br />- immigrants;<br />- people born in France with one parent who was born abroad.</p>\n<p>The survey sample included about 13,500 individuals who were representative of all the population aged 18 and over living in Metropolitan France.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1690/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey, which is also called \"Construction of identities\", consists of a biographical table (the person's past) and a traditional questionnaire which combines objective and subjective questions.</p>\n<p>The topics covered include:<br />- family and professional situation;<br />- geographic and social origins;<br />- ethical commitments;<br />- cultural practices;<br />- state of health.</p>\n<p>As well as the individual's family, residential and professional biography, questions focus on:<br />- stated affiliations and identifications in the areas of family, professional situation and work, leisure, health and relationship with the body, the ideological sphere;<br />- any negative experiences (including discrimination) and their effects on identity.</p>\n<p>The survey also shows the level of membership to associations (alumni, unions of job seekers, retired people, senior citizens, humanitarian groups, leisure activities, etc.).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1690/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1690/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'&eacute;chantillon d'individus enqu&ecirc;t&eacute;s est constitu&eacute; de la r&eacute;union de sous-&eacute;chantillons tir&eacute;s dans quatre sources diff&eacute;rentes dont l'&eacute;chantillon ma&icirc;tre de l'Insee (bas&eacute; sur le recensement de la population de 1999) et la base de sondage des logements neufs (BSLN).</p>\n<p>Les &eacute;chantillons de deux enqu&ecirc;tes ont &eacute;t&eacute; utilis&eacute;s pour permettre une bonne repr&eacute;sentativit&eacute; de populations pas assez nombreuses en population g&eacute;n&eacute;rale pour r&eacute;aliser des analyses fines : l'enqu&ecirc;te &Eacute;tude de l'histoire familiale (EHF) et l'enqu&ecirc;te Vie quotidienne et Sant&eacute; (VQS).</p>\n<p>Trois populations sont donc surrepr&eacute;sent&eacute;es dans l'&eacute;chantillon :<br />- les personnes de moins de 60 ans g&ecirc;n&eacute;es dans leur vie courante par un probl&egrave;me de sant&eacute; ;<br />- les immigr&eacute;s ;<br />- les personnes n&eacute;es en France dont un parent est n&eacute; &agrave; l'&eacute;tranger.</p>\n<p>L'&eacute;chantillon de l'enqu&ecirc;te comporte environ 13&nbsp;500 individus repr&eacute;sentatifs de l'ensemble de la population &acirc;g&eacute;e de 18 ans et plus habitant en France m&eacute;tropolitaine.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/257>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'élaboration d'une enquête quantitative sur la construction des identités"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2006-11-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/eco_et_stat_393394_enq_construction_identites2006.pdf> .
    
    <http://bauhaus/qualite/attribut/1690/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1690/S.3.4/texte> , <http://bauhaus/qualite/attribut/1690/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1690/S.18.3/text> , <http://bauhaus/qualite/attribut/1690/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les entretiens ont &eacute;t&eacute; r&eacute;alis&eacute;s en face-&agrave;-face par un enqu&ecirc;teur de l'Insee.</p>\n<p>La collecte a &eacute;t&eacute; effectu&eacute;e entre f&eacute;vrier et avril 2003 par un mode de collecte assist&eacute;e par informatique (Capi).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1690/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/rapport/1690>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Life story survey in 2003"@en , "Rapport qualité : Enquête Histoire de vie en 2003"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1384> .
    
    <http://bauhaus/qualite/attribut/1690/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/257> .
    
    <http://bauhaus/qualite/attribut/1690/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-02-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Face-to-face interviews were carried out by an INSEE researcher.</p>\n<p>Data collection was between February and April 2003 using a computer-assisted collection method (Capi).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1690/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1690/I.18.10/text> , <http://bauhaus/qualite/attribut/1690/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
    
    <http://bauhaus/qualite/attribut/1690/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te, &eacute;galement appel&eacute;e \"Construction des identit&eacute;s\" se compose d'une grille biographique (le pass&eacute; de l'individu) et d'un questionnaire classique m&ecirc;lant questions objectives et subjectives.</p>\n<p>Les th&egrave;mes abord&eacute;s portent sur :<br />- la situation familiale et professionnelle ;<br />- les origines g&eacute;ographiques et sociales ;<br />- l'engagement &eacute;thique ;<br />- les pratiques culturelles ;<br />- l'&eacute;tat de sant&eacute;.</p>\n<p>Le questionnement est centr&eacute;, outre sur la biographie familiale, r&eacute;sidentielle et professionnelle de l'individu, sur :<br />- les appartenances objectiv&eacute;es et les identifications revendiqu&eacute;es dans les domaines de la famille, de la position professionnelle et de la profession, des loisirs, de la sant&eacute; et du rapport au corps, de la sph&egrave;re id&eacute;ologique ;<br />- les assignations subies (y compris discriminations) et leurs effets sur l'identit&eacute;</p>\n<p>L'enqu&ecirc;te permet &eacute;galement d'observer le taux d'adh&eacute;sion aux associations (anciens &eacute;l&egrave;ves, syndicats de ch&ocirc;meurs, retrait&eacute;s, troisi&egrave;me &acirc;ge, humanitaires, loisirs&hellip;).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1690/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1690> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1907> {
    <http://bauhaus/qualite/attribut/1907/S.15.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es de l'enqu&ecirc;te EACEI 2018 peuvent &ecirc;tre en partie compl&eacute;t&eacute;es par l&rsquo;Enqu&ecirc;te sur les consommations d'&eacute;nergie et les investissements antipollution dans les petits &eacute;tablissements de moins de 20 salari&eacute;s (ECEI-PE) de 2014 en &eacute;tant vigilant quant aux diff&eacute;rences de champ&nbsp;: ECEI-PE, outre le d&eacute;calage de l&rsquo;ann&eacute;e de collecte, enqu&ecirc;te les &eacute;tablissements de 1 &agrave; 19 salari&eacute;s et ne s&rsquo;attache qu&rsquo;&agrave; un nombre restreint d&rsquo;&eacute;nergies.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Activity (NACE rev.2 divisions)<br />07-Mining of metal ores <br />08-Other mining and quarring <br />09-Mining support service activity <br />10-Manufacture of food products <br />11-Manufacturing of beverages <br />12-Manufacture of tobacco products <br />13-Manufacture of textiles <br />14-Manufacture of wearing apparel <br />15-Manufacture of leather and related products <br />16-Manufacture of wood and of products of wood and cork, except furniture; manufacture of articles of straw and painting materials <br />17-Manufacture of paper and paperproduct <br />18-Printing and reproduction of recorded media <br />19-Manufacture of coke and refined petroleum produtcs <br />20-Manufacture of chemical products <br />21-Manufacture of basic pharmaceutical products and pharmaceutical preparations <br />22-Manufacture of rubber and plastic products <br />23-Manufacture of other non-metallic mineral products <br />24-Manufacture of basic metals <br />25-Manufacture of fabricated metal products, except machinery and equipment <br />26-Manufacturing of computer, electronic and optical products <br />27-Manufacture of electrical equipment <br />28-Manufacture of machinery and equipment n.e.c. <br />29-Manufacture of motor vehicles, trallers and semi-trallers <br />30-Manufacture of other transport equipment <br />31-Manufacture of furniture <br />32-Other manufacturing <br />33-Repair and installation of machinery and equipment <br />38-Waste collection, treatment and disposal activities; materials recovery<br />TOTAL<br /><br />Number of employees<br />less than 50 employees<br />50 to 99 employees<br />100 to 249 employees<br />250 to 499 employees<br />500 employees and more<br />TOTAL<br /><br />Region<br />11-&Icirc;le-de-France&nbsp; <br />24-Centre-Val de Loire<br />27-Bourgogne-Franche-Comt&eacute; <br />28-Normandie<br />32-Hauts-de-France<br />44-Grand Est<br />52-Pays de la Loire<br />53-Bretagne<br />75-Nouvelle-Aquitaine<br />76-Occitanie<br />84-Auvergne-Rh&ocirc;ne-Alpes<br />93-Paca et Corse <br />97-D&eacute;partements d&rsquo;outre-mer<br />TOTAL</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The series include quantities consumed by type of energy, related costs, and the breakdown by use of each energy, as well as contextual data on the surveyed establishments.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1907/S.12.1/texte> , <http://bauhaus/qualite/attribut/1907/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>No revision of survey data planned.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Energy purchases or consumption are those corresponding to all invoices received in 2018.<br />The information concerning the certification of the establishment refers to its situation in 2018.<br />The other questions (presence of a heat pump, industrial production activity, activity on customer site) relate to the&nbsp; establishment&rsquo;s situation at the time of responding to the survey.</p>"@en , "<p>Les achats ou consommations d&rsquo;&eacute;nergie sont ceux correspondant &agrave; l&rsquo;ensemble des factures re&ccedil;ues en 2018.<br />Les informations concernant la certification de l'&eacute;tablissement se r&eacute;f&egrave;rent &agrave; sa situation en 2018.<br />Les autres questions (pr&eacute;sence d&rsquo;une pompe &agrave; chaleur, activit&eacute; industrielle de production, activit&eacute; sur site client) sont relatives &agrave; la situation de l'entreprise au moment de r&eacute;pondre &agrave; l'enqu&ecirc;te.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.7>
                    <http://bauhaus/qualite/attribut/1907/S.10.7/texte> , <http://bauhaus/qualite/attribut/1907/S.10.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La p&eacute;riode de collecte s'&eacute;tend de janvier &agrave;&nbsp;mai 2019.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.11.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.1>
                    <http://bauhaus/qualite/attribut/1907/S.11.1/texte> , <http://bauhaus/qualite/attribut/1907/S.11.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1907/I.18.10/texte> , <http://bauhaus/qualite/attribut/1907/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.17.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>No revision of survey data planned.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.7.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>In so far as concerns collection via the Internet, the Coltrane collection site is totally secure and the standards in terms of managing survey access codes are strict and standardized for all surveys. For enterprises that choose to use paper, the managers are responsible for the input, and must strictly respect the confidentiality of any data collected.<br />This confidentiality applies before any data is disseminated. For data relating to enterprises - no results are published that relates to less than three enterprises or establishments. Similarly, a result will only be disseminated if no enterprise or institution contributes more than 85% of this result. Primary suppressions correspond to boxes that do not meet the above criteria. Secondary confidentiality removes other boxes so that the data can not be retrieved by adding and subtracting with the margins of the tables. Statistical confidentiality is defined in law n&deg;&nbsp;51-711 of 7 June 1951.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "L’unité d’interrogation est l’établissement, identifié par son numéro SIRET."@fr , "The interrogation unit is the establishment, identified by its SIRET number."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te fait l'objet d'une proc&eacute;dure d'archivage interne des bases de donn&eacute;es.<br />Les fichiers individuels de l&rsquo;enqu&ecirc;te sont mis &agrave; disposition des utilisateurs ext&eacute;rieurs &agrave; l&rsquo;Insee via le Centre d&rsquo;acc&egrave;s s&eacute;curis&eacute; des donn&eacute;es (CASD), apr&egrave;s passage au Comit&eacute; du secret.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2019A036EC"@fr , "2019A036EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The theme addressed is the different energies used by the establishments, in terms of purchases (volume, value) and use by the establishment. The main energies observed are:<br />- electricity;<br />- steam and other heat transfer fluids;<br />- natural gas&nbsp; and other gases;<br />- coal, lignite, lean coal, coal coke, petroleum coke, butane, propane;<br />- heavy fuel oil, heating oil and other petroleum products;<br />- black liquor, wood;<br />- special renewable and non-renewable fuels.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les &eacute;tablissements appartiennent aux sections B et C (division 05 &agrave; 33), au groupe 383 (r&eacute;cup&eacute;ration),<br />hors&nbsp;: sous classes&nbsp;: 1013B, 1071B, 1071C, 1071D (artisanat commercial), 2013A et 2446Z&nbsp;;<br />hors divisions 05, 06 et 19&nbsp;;<br />hors groupe 091.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection period extends from January to May 2019.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Establishments belong to sections B and C (division 05 to 33), to group 383 (recovery),<br />excluding: subclasses 1013B, 1071B, 1071C, 1071D (commercial crafts), 2013A and 2446Z;<br />excluding divisions 05, 06 and 19;<br />excluding group 091.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.16>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.16>
                    <http://bauhaus/qualite/attribut/1907/S.16/text> , <http://bauhaus/qualite/attribut/1907/S.16/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier,&nbsp; CS 70 058, 92 541 Montrouge Cedex</p>"@fr , "<p>Insee, 88 avenue Verdier,&nbsp; CS 70 058, 92 541 Montrouge Cedex</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.18.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Contr&ocirc;les pendant la phase de collecte&nbsp;: contr&ocirc;les sur la coh&eacute;rence interne et la coh&eacute;rence temporelle sous forme d&rsquo;alerte au moment de la saisie&nbsp;;<br />- Relances pendant la phase de collecte&nbsp;: relances par courrier exhaustives sur les non-r&eacute;pondants, relances t&eacute;l&eacute;phoniques prioris&eacute;es sur les non-r&eacute;pondants de grande taille&nbsp;;<br />- Apurement&nbsp;pour assurer la coh&eacute;rence des r&eacute;ponses au sein de chaque questionnaire&nbsp;;<br />- Calcul d'indicateurs de pr&eacute;cision.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.16/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p style=\"margin-bottom: 0cm; font-style: normal; font-weight: normal; line-height: 100%; text-decoration: none;\" align=\"left\"><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">The label committee ensures that the survey does not place an excessive burden on respondents.</span></span></p>\n<p style=\"margin-bottom: 0cm; font-style: normal; font-weight: normal; line-height: 100%; text-decoration: none;\" align=\"left\"><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">In addition, other decisions were made to limit the burden on respondents: </span></span></p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">- the EACEI 2016 sample is the same as this of 2015, because of the EACEI 2015 extension ;</span></span></p>\n<p>- t<span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">he part of the EACEI 2016 sample is negatively coordinated with the thematics enterprises surveys&nbsp;;</span></span></p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">- collection is done electronically ;</span></span></p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">- the sample of the extension collected at the end of the year (second wave) was not intended to be interviewed by a panel and was therefore drawn independently of the numbers of the previous surveys.</span></span></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Il s'agit des &eacute;tablissements de 20 salari&eacute;s ou plus, ayant au moins 4 mois d&rsquo;activit&eacute; en 2017, et de code d&rsquo;activit&eacute; principale (APET) correspondant aux sections B et C (division 05 &agrave; 33), au groupe 383 (r&eacute;cup&eacute;ration), <br />hors&nbsp;: sous classes&nbsp;: 1013B, 1071B, 1071C, 1071D (artisanat commercial), 2013A et 2446Z&nbsp;;<br />hors divisions 05, 06 et 19&nbsp;;<br />hors groupe 091.</p>\n<p>L'&eacute;chantillon comprend environ 8&nbsp;500 &eacute;tablissements.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.7.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant la collecte internet, le site de collecte Coltrane est enti&egrave;rement s&eacute;curis&eacute; et les normes en termes de gestion des codes d&rsquo;acc&egrave;s &agrave; l&rsquo;enqu&ecirc;te sont strictes et standardis&eacute;es pour toutes les enqu&ecirc;tes entreprises. Pour les entreprises choisissant d&rsquo;utiliser le support papier, la saisie est assur&eacute;e par les gestionnaires, dans le strict respect de la confidentialit&eacute; des donn&eacute;es r&eacute;colt&eacute;es.<br />Avant la diffusion des donn&eacute;es le secret est appliqu&eacute;. Pour les donn&eacute;es relatives aux entreprises&nbsp;: on ne publie aucun r&eacute;sultat qui concerne moins de trois entreprises ou &eacute;tablissements. De m&ecirc;me, un r&eacute;sultat ne sera diffus&eacute; que si aucune entreprise ou &eacute;tablissement ne contribue &agrave; plus de 85&nbsp;% de ce r&eacute;sultat. Les suppression primaire correspondent aux cases ne r&eacute;pondant pas au crit&egrave;re ci-dessus. Le secret secondaire supprime d'autres cases pour que les donn&eacute;es ne puissent pas &ecirc;tre retrouv&eacute;es par addition soustraction avec les marge des tableaux. Le secret statistique est d&eacute;fini dans la loi n&deg;&nbsp;51-711 du 7 juin 1951.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1907>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Annual survey on industrial energy consumption 2018"@en , "Rapport qualité : Enquête sur les consommations d'énergie dans l'industrie 2018"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1466> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1907/I.18.7/texte> , <http://bauhaus/qualite/attribut/1907/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1907/S.3.4/texte> , <http://bauhaus/qualite/attribut/1907/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.18.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.4>
                    <http://bauhaus/qualite/attribut/1907/S.18.4/text> , <http://bauhaus/qualite/attribut/1907/S.18.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey responds to the request of the International Energy Agency (IEA) for information on the subject of energy consumption and to Community Regulation 58/97 on structural business statistics which lays down additional obligations in this area.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The population is composed by establishments with 20 or more employees, with at least 4 months of activity in 2017, and main activity code (APET) corresponding to sections B and C (division 05 to 33), to group 383 (materials recovery), <br />excluding: subclasses: 1013B, 1071B, 1071C, 1071D (commercial crafts), 2013A and 2446Z;<br />excluding divisions 05, 06 and 19;<br />outside group 091.</p>\n<p>The sample includes approximately 8,500 establishments.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les comit&eacute;s qui ont donn&eacute; &agrave; l'Insee le droit et la l&eacute;gitimit&eacute; pour collecter ses donn&eacute;es sont&nbsp;:<br />- Le Cnis qui examine chaque nouveau projet, qu&rsquo;il s&rsquo;agisse d&rsquo;une enqu&ecirc;te, d&rsquo;un r&eacute;pertoire ou d&rsquo;une exploitation de fichiers administratifs&hellip; Ces projets sont pr&eacute;sent&eacute;s par toutes les institutions qui contribuent par leurs travaux &agrave; la construction de la statistique publique. La discussion porte notamment sur la finalit&eacute; du projet, sa place dans le syst&egrave;me d&rsquo;information et les conditions pr&eacute;vues de sa diffusion. Il convient de v&eacute;rifier que chaque op&eacute;ration r&eacute;pond &agrave; un besoin d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et ne fait pas double emploi avec les sources d&rsquo;information existantes, en d&rsquo;autres termes de s&rsquo;assurer de son opportunit&eacute;. Il donne un un avis d&rsquo;opportunit&eacute;.<br />- Le comit&eacute; du label, au sein du Cnis, veille &agrave; ce qu&rsquo;il respecte les crit&egrave;res de qualit&eacute; statistique. Celui-ci s&rsquo;assure que l&rsquo;enqu&ecirc;te r&eacute;pond aux crit&egrave;res de qualit&eacute; statistique en ce qui concerne la m&eacute;thode de collecte et d&rsquo;&eacute;chantillonnage (plan de sondage, m&eacute;thode de redressement des donn&eacute;es, traitement des non-r&eacute;ponses garantissant la fiabilit&eacute; des r&eacute;sultats...), de pertinence du questionnement et d&rsquo;adaptation de la diffusion aux objectifs annonc&eacute;s. Il s&rsquo;assure &eacute;galement que l&rsquo;enqu&ecirc;te n&rsquo;entra&icirc;ne pas de charge excessive sur les enqu&ecirc;t&eacute;s, qu&rsquo;une concertation a &eacute;t&eacute; men&eacute;e avec les partenaires concern&eacute;s et que les souhaits exprim&eacute;s par le Cnis lors du d&eacute;bat d&rsquo;opportunit&eacute; ont bien &eacute;t&eacute; pris en compte. Il donne un label d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et de qualit&eacute; statistique.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Chef de la division ETET</p>"@fr , "<p>Head of the ETET Division</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La fiche qualit&eacute; est d&eacute;crite selon la norme europ&eacute;enne du Single integrated metadata structure (SIMS).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.5>
                    <http://bauhaus/qualite/attribut/1907/S.10.5/texte> , <http://bauhaus/qualite/attribut/1907/S.10.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un comit&eacute; de concertation compos&eacute;, outre des deux services producteurs, des experts et repr&eacute;sentants des politiques publiques concern&eacute;es par les questions d&rsquo;&eacute;nergie, des repr&eacute;sentants d&rsquo;organisations professionnelles, de syndicats de salari&eacute;s et du secteur &eacute;nerg&eacute;tique se r&eacute;unit chaque ann&eacute;e.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.18.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Checks during the collection phase: checks on internal coherence and temporal coherence in the form of an alert at the time of data entry;<br />- Follow-ups during the collection phase: exhaustive reminders by mail on non-respondents, priority telephone reminders on large non-respondents;<br />- Data cleaning to ensure consistency of answers within each questionnaire;<br />- Calculation of precision indicators.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Insee Focus, Insee R&eacute;sultats</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour la diffusion,&nbsp;en plus des publications, il y a &eacute;galement&nbsp;des indicateurs de qualit&eacute; des donn&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1907/S.3.3/text> , <http://bauhaus/qualite/attribut/1907/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La s&eacute;rie comprend des quantit&eacute;s consomm&eacute;es par type d'&eacute;nergie, les co&ucirc;ts aff&eacute;rents, et la r&eacute;partition par usage de chaque &eacute;nergie utilis&eacute;e ainsi que des donn&eacute;es de cadrage sur les &eacute;tablissements enqu&ecirc;t&eacute;s.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Insee Focus (<a href=\"https://www.insee.fr/fr/statistiques/3310452\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/fr/statistiques/3310452</a>) and Insee Resultats (<a href=\"https://www.insee.fr/fr/statistiques/3364874\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/fr/statistiques/3364874</a>) are available on the insee.fr site.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>EACEI 2018 is collected via the internet and possibly by post (at the request of the establishment).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1907/S.18.3/texte> , <http://bauhaus/qualite/attribut/1907/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/documents/document/1017>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice explicative 2018 de l'enquête sur les consommations d'énergie dans l'industrie / EACEI"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-12-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/EACEI2018_notice.pdf> .
    
    <http://bauhaus/qualite/attribut/1907/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1907/S.7.2/text> , <http://bauhaus/qualite/attribut/1907/S.7.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-10-23"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le th&egrave;me abord&eacute; est celui des diff&eacute;rentes &eacute;nergies employ&eacute;es par les &eacute;tablissements, en termes d&rsquo;achats (en volume, en valeur) et d&rsquo;usage par l&rsquo;&eacute;tablissement. Les principales &eacute;nergies observ&eacute;es sont&nbsp;:<br />- l&rsquo;&eacute;lectricit&eacute;&nbsp;;<br />- la vapeur et les autres fluides caloporteurs ;<br />- le gaz naturel&nbsp;et les autres gaz ;<br />- la houille , le lignite ou charbon pauvre, le coke de houille, le coke de p&eacute;trole et le butane- propane&nbsp;;<br />- le fioul lourd, le fioul domestique et les autres produits p&eacute;troliers ;<br />- la liqueur noire, le bois ;<br />- l&rsquo;hydrog&egrave;ne&nbsp;;<br />- les autres combustibles renouvelables ou non.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Insee Focus, Insee R&eacute;sultats</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.11.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The different stages of the survey ensure that the process meets the requirements for statistical production:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />- stratified sampling<br />- reminders and controls of data being collected <br />- data cleaning<br />- correction of overall non-response <br />- calibration<br />- correction of partial non-response<br />- the questionnaire was tested in 2013 upstream of the collection, with 97 establishments.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Fran&ccedil;ois-Xavier Dussud</p>"@fr , "<p>Fran&ccedil;ois-Xavier Dussud</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling frame is the Sirus directory (system of identification to directory of statistical units).<br />The sampling method is a stratified plan by the nomenclature of activities (NTE) dedicated to energy consumption, workforce bands, and region.<br />Allocations are optimised on the NTE x workforce bands, and on net energy consumption, taking into account the average dispersion per stratum over the last 3 years. The allowances are exhaustive above the threshold of 250 employees, big consumers of energy and for strata of less than 10 units.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.4>
                    <http://bauhaus/qualite/attribut/1907/S.10.4/text> , <http://bauhaus/qualite/attribut/1907/S.10.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.15.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.3>
                    <http://bauhaus/qualite/attribut/1907/S.15.3/texte> , <http://bauhaus/qualite/attribut/1907/S.15.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Year 2018</p>"@en , "<p>Ann&eacute;e 2018</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.16/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p style=\"margin-bottom: 0cm; font-style: normal; font-weight: normal; line-height: 100%; text-decoration: none;\" align=\"left\">&nbsp;<span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">Le comit&eacute; du label s&rsquo;assure que l&rsquo;enqu&ecirc;te n&rsquo;entra&icirc;ne pas de charge excessive sur les enqu&ecirc;t&eacute;s.</span></span></p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">De plus, d'autres d&eacute;cisions ont &eacute;t&eacute; prises afin de limiter la charge des r&eacute;pondants&nbsp;:</span></span></p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">- du fait de l&rsquo;extension r&eacute;alis&eacute;e en septembre 2016 pour l&rsquo;EACEI 2015, le m&ecirc;me &eacute;chantillon a &eacute;t&eacute; conserv&eacute; pour EACEI 2016 que pour EACEI 2015, en prenant en compte les sorties de champ et compl&eacute;t&eacute; d'un &eacute;chantillon d'entrants&nbsp;;</span></span></p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">- la partie de l&rsquo;&eacute;chantillon EACEI 2016 est coordonn&eacute;e n&eacute;gativement avec les autres enqu&ecirc;tes th&eacute;matiques aupr&egrave;s des entreprises ;</span></span></p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\">- la collecte se fait par voie &eacute;lectronique.</span></span></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1017> , <http://bauhaus/documents/document/1016> .
    
    <http://bauhaus/qualite/attribut/1907/S.15.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope of the survey is the same every year.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.17.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pas de r&eacute;vision pr&eacute;vue sur les donn&eacute;es de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.11.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les diff&eacute;rentes &eacute;tapes de l'enqu&ecirc;te garantissent que le processus r&eacute;pond aux exigences en mati&egrave;re de production statistique&nbsp;:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />- tirage stratifi&eacute; de l'&eacute;chantillon <br />- relances et contr&ocirc;les des donn&eacute;es en cours de collecte <br />- apurement <br />- redressement de la non-r&eacute;ponse totale <br />- calage <br />- redressement de la non-r&eacute;ponse partielle <br />- le questionnaire a &eacute;t&eacute; test&eacute; en 2013 aupr&egrave;s de 97 &eacute;tablissements dans le cadre du dernier passage de l&rsquo;enqu&ecirc;te devant le comit&eacute; du label.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For dissemination, in addition to publications, there are also data quality indicators.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/S.15.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ de l'enqu&ecirc;te est constant d&rsquo;une ann&eacute;e sur l&rsquo;autre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
