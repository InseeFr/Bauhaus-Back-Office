    <http://bauhaus/qualite/attribut/1838/S.10.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is subject to an internal database archiving procedure. Individual files are made available to users outside Insee via the Secure Data Access Centre (CASD), after being reviewed by the Committee on Statistical Confidentiality.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1838/S.18.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Checks during the collection phase: checks on internal coherence and temporal coherence in the form of an alert at the time of data entry<br />- Follow-ups during the collection phase: exhaustive reminders by mail on non-respondents, priority telephone reminders on large non-respondents<br />- Data cleaning to ensure consistency of answers within each questionnaire<br />- Calculation of precision indicators</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1838/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "01 87 69 61 70"@fr , "01 87 69 61 70"@en ;
