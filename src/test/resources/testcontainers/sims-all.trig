<http://rdf.insee.fr/graphes/qualite/rapport/1728> {
    <http://bauhaus/qualite/attribut/1728/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample of the survey ICT is pulled in a sampling database built from the Sirene directory and the CLAP 2010 database. The method of sampling is a random sampling stratified according to the economic activity, the turnover and per employment size, measured in number of persons employed (salaried employees and non salaried employees) according to the recommandations of Eurostat. About 10 000 Legal units are interviewed."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "A consultation committee met to take an active part in the questionnaire's design. Its member are experts and representatives of public policies interested in ICT and e-commerce questions (SOeS, SSP, DGE, CCIP, ARCEP, SGMAP, Télécom Paris Tech…), as well as representatives for syndicates of businesses and trade unions (FEVAD, Syntec Numérique, Medef, CCIP, CGPME, CGT, FO…)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The main topics are the ICT (information and communications technology)  equipment, access and use of the internet, sharing of information electronically within the enterprise and e-commerce."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon de l'enquête TIC est tiré dans une base de sondage construite à partir du répertoire Sirene apparié au fichier de diffusion CLAP 2010.\nLa méthode d'échantillonnage est un sondage aléatoire stratifié selon le secteur d'activité, le chiffre d'affaires et les tranches d'effectifs, mesurés en nombre de personnes occupées (salariés et non salariés) conformément aux préconisations d'Eurostat. Environ 10 000 unités légales sont interrogées. "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1728/I.18.10/texte> , <http://bauhaus/qualite/attribut/1728/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1728/S.19/text> , <http://bauhaus/qualite/attribut/1728/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "From September to December 2012"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
