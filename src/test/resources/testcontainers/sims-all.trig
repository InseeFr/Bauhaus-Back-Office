    <http://bauhaus/qualite/attribut/1552/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte a &eacute;t&eacute; r&eacute;alis&eacute;e de fa&ccedil;on annuelle, de 1980 &agrave; 2008.</p>\n<p>L'enqu&ecirc;te se fait aupr&egrave;s des si&egrave;ges ou &eacute;tablissements principaux des organismes.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/488>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les personnels de collectivités locales - Communes et établissements communaux"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
