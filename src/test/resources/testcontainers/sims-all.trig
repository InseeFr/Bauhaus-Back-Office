    <http://bauhaus/qualite/attribut/1629/S.10.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.3>
                    <http://bauhaus/qualite/attribut/1629/S.10.3/text> , <http://bauhaus/qualite/attribut/1629/S.10.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
