            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Enquete_CAM_Methodologie.pdf> .
    
    <http://bauhaus/qualite/attribut/1551/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
