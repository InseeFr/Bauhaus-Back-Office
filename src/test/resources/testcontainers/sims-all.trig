            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/ques_enq_colter_06072008.pdf> .
    
    <http://bauhaus/qualite/attribut/1552/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1552/S.18.3/text> , <http://bauhaus/qualite/attribut/1552/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1552> .
    
    <http://bauhaus/qualite/attribut/1552/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/486> .
    
    <http://bauhaus/qualite/attribut/1552/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The information collected covers the paid workforce at 31 December.</p>\n<p>The survey gives information about the gender of the workforce, status (incumbents, non incumbents, subsidised employment), employment terms (full time, part time), the principal or secondary nature of the job and the framework (hierarchical category of the agent, and the sector: administrative, technical, cultural, etc.).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1552/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1552/S.3.4/texte> , <http://bauhaus/qualite/attribut/1552/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1552> .
    
    <http://bauhaus/documents/document/487>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les personnels de collectivités locales - Régions et départements"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-10-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/quest_enq_colter_06072008_R.pdf> .
    
    <http://bauhaus/qualite/attribut/1552/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1552> .
    
    <http://bauhaus/qualite/attribut/1552/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey has been conducted annually, between 1980 to 2008.</p>\n<p>The survey is conducted with head offices or main establishments of institutions.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/490>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les personnels de collectivités locales - Établissements Publics Industriels et Commerciaux (EPIC)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-10-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaires_colter2008.pdf> .
    
    <http://bauhaus/qualite/attribut/1552/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'information collect&eacute;e porte sur les effectifs salari&eacute;s au 31 d&eacute;cembre.</p>\n<p>L'enqu&ecirc;te donne des informations sur le sexe des effectifs employ&eacute;s, le statut (titulaires, non titulaires, emplois aid&eacute;s), la condition d'emploi (temps complet, temps partiel), le caract&egrave;re principal ou secondaire de l'emploi et le cadre d'emploi (la cat&eacute;gorie hi&eacute;rarchique de l'agent et la fili&egrave;re de son emploi : administrative, technique, culturelle, etc.).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1552/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1552> .
    
    <http://bauhaus/documents/document/486>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
