                    "2013-10-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_collecte_2012.pdf> .
    
    <http://bauhaus/qualite/attribut/1537/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1537> .
    
    <http://bauhaus/qualite/attribut/1537/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The frequency envisaged is 4 to 5 years.</p>\n<p>The survey was conducted face-to-face by the Insee's specialized team, from April to June 2012.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1537/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/70> , <http://bauhaus/documents/page/69> , <http://bauhaus/documents/page/71> .
    
    <http://bauhaus/qualite/attribut/1537/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La p&eacute;riodicit&eacute; envisag&eacute;e est de 4 &agrave; 5 ans.</p>\n<p>La collecte a &eacute;t&eacute; r&eacute;alis&eacute;e en face-&agrave;-face par le r&eacute;seau d'enqu&ecirc;teurs de l'Insee d'avril &agrave; juin 2012.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/71>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Statistiques Eurostat"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Données Eurostat \\\"Education et formation\\\", Base de données"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/eurostat/web/education-and-training/data/database> .
    
    <http://bauhaus/qualite/attribut/1537/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "18 to 64 year-old people, living in ordinary housings. Only one person per household is interviewed."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1537/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1537/I.18.10/text> , <http://bauhaus/qualite/attribut/1537/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1537> .
    
    <http://bauhaus/qualite/attribut/1537/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>En plus de l'acc&egrave;s &agrave; la formation et de la caract&eacute;risation des formations suivies par les adultes, les autres th&egrave;mes abord&eacute;s sont, notamment, les sources d'information, les obstacles rencontr&eacute;s, le contexte professionnel dans lequel s'ins&egrave;re la formation,&nbsp;la conciliation formation - travail et les b&eacute;n&eacute;fices attendus &agrave; court terme par les participants.</p>\n<p>L'enqu&ecirc;te recense &eacute;galement les activit&eacute;s entreprises dans le but de se former ou d'accro&icirc;tre ses connaissances de fa&ccedil;on informelle (apprentissage informel), c'est-&agrave;-dire sans aucune intervention d'un formateur.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1537/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1537/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1537> .
    
    <http://bauhaus/qualite/attribut/1537/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon est composé de 20 000 logements ordinaires tirés dans la base du recensement de la population. Au final, 13 857 personnes ont été interrogées sur les formations suivies au cours des douze mois précédant l'interrogation (au maximum 3 formations ont été décrites pour chaque personne)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
