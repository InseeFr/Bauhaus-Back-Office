                    <http://bauhaus/qualite/rapport/1747> .
    
    <http://bauhaus/qualite/attribut/1747/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1747/I.18.10/text> , <http://bauhaus/qualite/attribut/1747/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1747> .
    
    <http://bauhaus/qualite/attribut/1747/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/135> .
    
    <http://bauhaus/qualite/attribut/1747/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1747> .
    
    <http://bauhaus/qualite/attribut/1747/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée par courrier et internet entre septembre et novembre 2014 puis par téléphone par un enquêteur auprès des non répondants entre novembre 2014 et février 2015."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1747/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1747/S.3.6/text> , <http://bauhaus/qualite/attribut/1747/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1747> .
    
    <http://bauhaus/qualite/attribut/1747/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/133> .
    
    <http://bauhaus/qualite/attribut/1747/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1747> .
    
    <http://bauhaus/qualite/attribut/1747/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted by mail and internet between September and November 2014 and then by telephone for non-respondents between November 2014 and February 2015."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1747/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- general health condition (European mini-module) ;<br />- sensory difficulties ;<br />- motor difficulties ;<br />- cognitive difficulties ;<br />- home care (provided by professional workers or by friends and relatives) ;<br />- the use of technical aids or housing adaptation ;<br />- the official recognition of disability.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1747/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1747/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1747> .
    
    <http://bauhaus/qualite/attribut/1747/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- l'&eacute;tat de sant&eacute; g&eacute;n&eacute;ral (mini-module europ&eacute;en) ;<br />- les difficult&eacute;s sensorielles ;<br />- les difficult&eacute;s motrices ;<br />- les difficult&eacute;s cognitives ;<br />- le recours &agrave; de l'aide humaine (professionnelle ou de l'entourage) ;<br />- le recours &agrave; des aides techniques ou des am&eacute;nagements du logement ;<br />- la reconnaissance officielle d'un handicap ou de la d&eacute;pendance.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1747/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1747/S.3.4/texte> , <http://bauhaus/qualite/attribut/1747/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1747> .
    
    <http://bauhaus/qualite/attribut/1747/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample includes approximately 210,000 households (10,000 in the French Overseas Departments)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1747/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>M&eacute;nages dits \" ordinaires \", c'est-&agrave;-dire hors m&eacute;nages vivant en collectivit&eacute; (maisons de retraite, EHPAD, foyers, prisons, h&ocirc;pitaux&hellip;) et vivant dans des habitations mobiles (mariniers, sans-abri&hellip;).<br />Ont &eacute;t&eacute; inclus les personnes vivant dans des logement-foyers.<br />Logements dans lesquels habite au moins un individu n&eacute; avant le 02/05/1955. Les r&eacute;pondants sont tous les habitants du logement &acirc;g&eacute;s de plus de 15 ans.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/135>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête Vie quotidienne et Santé en 2007"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2007-03-23"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_VQS_2007.pdf> .
    
    <http://bauhaus/qualite/rapport/1747>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
