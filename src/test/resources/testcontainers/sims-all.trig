    <http://bauhaus/documents/document/989>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La note de base 2014 Tome 3 : la dépense de consommation finale des ménages et la consommation effective finale des ménages"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
