    <http://bauhaus/documents/document/792>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Presentation of the Agricultural producer price index (IPPAP base 2005)"@en ;
