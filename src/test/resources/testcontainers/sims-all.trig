            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/131> , <http://bauhaus/documents/document/322> .
    
    <http://bauhaus/qualite/rapport/1750>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Annual employment survey"@en , "Rapport qualité : Enquête emploi annuelle"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1281> .
    
    <http://bauhaus/qualite/attribut/1750/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey focuses on employment, unemployment, training, prior professional activity, social origin, the situation in March of the previous year and the main monthly situation over the past twelve months."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1750/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1750> .
    
    <http://bauhaus/qualite/attribut/1750/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope of the survey is restricted to ordinary households (excluding hostels, barracks, etc.) and the sample is renewed by a&nbsp;third each year.</p>\n<p>The 75,000 dwellings surveyed are derived from a stratified sample (21 regions X 10 categories of municipalities).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1750/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1750/S.3.6/text> , <http://bauhaus/qualite/attribut/1750/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1750> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1871> {
    <http://bauhaus/qualite/attribut/1871/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1871/I.18.12/text> , <http://bauhaus/qualite/attribut/1871/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1871/S.3.6/text> , <http://bauhaus/qualite/attribut/1871/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Collection is carried out in January, April, July and October.<br />This is a panel survey: the occupants of the accommodation are interviewed during 5 consecutive quarters.<br />The first and last interviews of a household are conducted by visits with an interviewer (and after any&nbsp;change of tenant, or in the event of any difficulties in obtaining information by telephone). Intermediate surveys are conducted by telephone.<br /><br />Survey in Guadeloupe since October 2010</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1871/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes de l&rsquo;enqu&ecirc;te sont les suivants&nbsp;:<br />- Caract&eacute;ristiques de l'immeuble, du logement (dont les &eacute;l&eacute;ments de confort) ;<br />- Mode de location et aides per&ccedil;ues ;<br />- Montants des loyers et des charges.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1871/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes of the survey are as follows:<br />- Characteristics of the residential building and accommodation (including conveniences);<br />- Rental method and benefits received;<br />- Total amounts of rents and charges.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1871/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/241> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Chaque trimestre, environ 3 700 logements en m&eacute;tropole et 600 en Guadeloupe font partie de l'&eacute;chantillon &agrave; enqu&ecirc;ter. <br /><br />Il s'agit de r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation : les logements concern&eacute;s ne doivent pas avoir plus de 50 % de leur surface consacr&eacute;e &agrave; une activit&eacute; professionnelle.<br />Sont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occup&eacute;s &agrave; titre gratuit.<br />L'&eacute;chantillon est tir&eacute; dans l'&eacute;chantillon ma&icirc;tre de l'Insee (issu du recensement de la population).<br />Un cinqui&egrave;me de l'&eacute;chantillon est renouvel&eacute; chaque trimestre : l'&eacute;chantillon sortant se compose des logements interrog&eacute;s 5 fois&nbsp;et des logements hors champ &agrave; l'enqu&ecirc;te pr&eacute;c&eacute;dente.<br />On effectue chaque trimestre le remplacement du sous-&eacute;chantillon sortant par un sous &eacute;chantillon entrant.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1871/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/documents/document/1020>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2017 et 2018 de l'enquête Loyers et charges (complet avec contrôles)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-11-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire2017-2018controles.pdf> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>4,300 homes are surveyed every quarter.</p>"@en , "<p>4 300 logements sont enqu&ecirc;t&eacute;s chaque trimestre.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Each quarter, approximately 3,700 homes in Metropolitan France and 600 in Guadeloupe form part of the sample to be surveyed.<br /><br />These are main residences rented in an unfurnished state, whose main purpose is residential: the accommodation concerned must not have more than 50% of its surface area used for a professional activity.<br />Sub-let accommodation, leases with purchase options (or rental/purchase schemes) and accommodation occupied on a free basis, are excluded from the field of the survey.<br />The sample is drawn from the INSEE master sample (derived from the population census).<br />One fifth of the sample is renewed each quarter: the outgoing sample consists of accommodation surveyed 5 times and accommodation which fell outside the scope of the previous survey.<br />Each quarter, the outgoing sub-sample is replaced by an incoming sub-sample.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/241>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Pourquoi les ménages pauvres paient-ils des loyers plus ou moins élevés ? L’incidence des aides au logement en France"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-10-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/enq_loyer_charges_incidences_revenus.pdf> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/P> , <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "-dg75-F330@insee.fr"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Elle est constitu&eacute;e de l&rsquo;ensemble des r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation : les logements concern&eacute;s ne doivent pas avoir plus de 50 % de leur surface consacr&eacute;e &agrave; une activit&eacute; professionnelle. Sont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occup&eacute;s &agrave; titre gratuit.<br />Depuis 2013 pour la m&eacute;tropole et depuis juillet 2017 pour la Guadeloupe, l'enqu&ecirc;te&nbsp;porte uniquement sur les loyers du secteur libre. Les logements du secteur HLM sont interrog&eacute;s via l'enqu&ecirc;te conjoncturelle sur les loyers aupr&egrave;s des bailleurs sociaux (ELBS).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1871/I.18.10/text> , <http://bauhaus/qualite/attribut/1871/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1871/S.3.4/texte> , <http://bauhaus/qualite/attribut/1871/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/rapport/1871>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Rents and Charges Survey 2017"@en , "Rapport qualité : Enquête Loyers et charges 2017"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1419> .
    
    <http://bauhaus/qualite/attribut/1871/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017T012EC"@fr , "2017T012EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1871/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1871/I.18.7/texte> , <http://bauhaus/qualite/attribut/1871/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.11.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Information on the quality of the 2017 survey is presented in the attached document.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1018> .
    
    <http://bauhaus/qualite/attribut/1871/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All main residences rented in an unfurnished state which essential reason for the rental is housing.<br />Since 2013 for metropolitan France and since July 2017 for Guadeloupe, the scope of the survey has been restricted to the private sector (social sector is collected through the quarterly survey on the rents of the social sector).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte dure environ 3 semaines et demi par trimestre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1871/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est effectu&eacute;e en janvier, avril, juillet et octobre.<br />Il s'agit d'une enqu&ecirc;te par panel : on interroge les occupants du logement pendant 5 trimestres cons&eacute;cutifs.<br />La premi&egrave;re et la derni&egrave;re interrogation d'un m&eacute;nage sont r&eacute;alis&eacute;es par visite avec un enqu&ecirc;teur (et apr&egrave;s tout changement de locataire ou en cas&nbsp;de difficult&eacute; &eacute;ventuelle d'obtention des informations par t&eacute;l&eacute;phone). Les interrogations interm&eacute;diaires sont men&eacute;es par t&eacute;l&eacute;phone.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection lasts about 3.5 weeks per quarter.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1871/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Since 1958</p>"@en , "<p>Depuis 1958</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1871> .
    
    <http://bauhaus/qualite/attribut/1871/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The questionnaires for the Rent and Expenses 2017-2018 survey are attached below:</p>"@en ;
