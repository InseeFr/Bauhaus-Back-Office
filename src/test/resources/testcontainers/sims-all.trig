                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-10-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Tome_5_conso_menages_prod_indus_base_2014_20181022.pdf> .
    
    <http://bauhaus/documents/document/1085>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La dette trimestrielle de Maastricht des administrations publiques"@fr ;
