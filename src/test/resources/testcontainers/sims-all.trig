                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/quest_dechets_commerce_2016_specimen.pdf> .
    
    <http://bauhaus/qualite/attribut/1870/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Par internet avec possibilit&eacute; d'envoi par courrier sur demande. La collecte se d&eacute;roule de septembre &agrave; d&eacute;cembre (ou janvier).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1870/S.18.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.4>
                    <http://bauhaus/qualite/attribut/1870/S.18.4/text> , <http://bauhaus/qualite/attribut/1870/S.18.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1870> .
    
    <http://bauhaus/qualite/attribut/1870/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1870/S.3.4/texte> , <http://bauhaus/qualite/attribut/1870/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
