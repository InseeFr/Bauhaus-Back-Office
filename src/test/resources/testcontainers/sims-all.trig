<http://rdf.insee.fr/graphes/qualite/rapport/1844> {
    <http://bauhaus/qualite/attribut/1844/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1844/S.3.4/text> , <http://bauhaus/qualite/attribut/1844/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1844/S.18.3/texte> , <http://bauhaus/qualite/attribut/1844/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les &eacute;tablissements exploitants, sans restriction de taille, dont l'activit&eacute; principale appartient aux secteurs tertiaires principalement marchands, y compris artisanat commercial, mais hors transports et entreposage. Les secteurs principalement non marchands du tertiaire (enseignement, sant&eacute;&hellip;) sont donc exclus du champ.</p>\n<p>Cela correspond aux codes NAF r&eacute;v.2 suivants&nbsp;: section G (y compris l'artisanat commercial&nbsp;: 10.13B, 10.71B, 10.71C, 10.71D), sections I &agrave; N et divisions 95 et 96 de la section S.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1844/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is via the internet with the option of sending in a paper version of the questionnaire."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/356>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice  2011"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-10-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_ECET_2011.pdf> .
    
    <http://bauhaus/qualite/rapport/1844>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on services energy consumption"@en , "Rapport qualité : Enquête sur les consommations d'énergie dans le tertiaire"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1215> .
    
    <http://bauhaus/qualite/attribut/1844/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est effectuée par internet et voie postale si nécessaire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1844/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1844/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/G> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1844/I.18.10/text> , <http://bauhaus/qualite/attribut/1844/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/Établissement> , <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/356> .
    
    <http://bauhaus/qualite/attribut/1844/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The trade establishments and the operators, without limitation of size, whose main activity belongs to the trade tertiary sectors including commercial handicraft and excluding transport and storing. Thus the mainly non-trading sectors of the tertiary are excluded (education, health...).</p>\n<p>It corresponds to the codes NAF r&eacute;v.2 following: section G (including commercial handicraft: 10.13B, 10.71B, 10.71C, 10.71D), sections I in N and divisions 95 and 96 of the section S.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1844/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est &eacute;tablie &agrave; partir du r&eacute;pertoire Sirene. L'&eacute;chantillon est stratifi&eacute; par secteur d'activit&eacute; et taille d'unit&eacute; locale. L'&eacute;chantillon est constitu&eacute; d'environ 20 000 &eacute;tablissements.<br /><br />La partie exhaustive est constitu&eacute;e par les &eacute;tablissements de 250 salari&eacute;s ou plus. Cela repr&eacute;sente un peu plus de 2 500 &eacute;tablissements.<br /><br />Pour les unit&eacute;s n'appartenant pas &agrave; la partie exhaustive, la stratification est obtenue par croisement de l'activit&eacute; principale de l'&eacute;tablissement (en divisions de la NAF r&eacute;v. 2) et la tranche de taille de l'&eacute;tablissement.<br /><br />Les modalit&eacute;s de tranches d'effectifs sont au nombre de huit : 0 salari&eacute;, 1 &agrave; 5 salari&eacute;s, 6 &agrave; 9 salari&eacute;s, 10 &agrave; 19 salari&eacute;s, 20 &agrave; 49 salari&eacute;s, 50 &agrave; 99 salari&eacute;s, 100 &agrave; 249 salari&eacute;s, 250 salari&eacute;s ou plus.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1844/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The ECET survey is conducted among establishments, as this is where the electricity meters and gas and fuel tanks are."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1844/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'ECET est une enqu&ecirc;te r&eacute;alis&eacute;e aupr&egrave;s des &eacute;tablissements, car c'est l&agrave; que se trouvent les compteurs d'&eacute;lectricit&eacute; ou de gaz notamment.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/357> .
    
    <http://bauhaus/qualite/attribut/1844/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1844/S.3.6/text> , <http://bauhaus/qualite/attribut/1844/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1844/S.10.6/text> , <http://bauhaus/qualite/attribut/1844/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/qualite/attribut/1844/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey base is compiled from the File Sirene.<br />The survey adopted a sampling plan stratified by the activity and by size of size local collection unit. The sample includes about 20,000 establishments.<br /><br />The comprehensive part comprises establishments employing 250 or more employees. This represents a little more than 2,500 establishments.</p>\n<p>For units not belonging to the comprehensive part, stratification is obtained by crossing the main activity of the establishment (in divisions of NAF rev. 2) and the class size of the establishment.</p>\n<p>There are eight terms of size ranges : 0 employee, 1-5 employees, 6-9 employees, 10-19 employees, 20-49 employees, 50-99&nbsp;employees, 100-249 employees, 250 or more employees.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1844/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/358> .
    
    <http://bauhaus/qualite/attribut/1844/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/documents/document/358>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les consommations d'Énergie dans le tertiaire en 2011"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-09-18"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_ECET_2011.pdf> .
    
    <http://bauhaus/qualite/attribut/1844/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Apr&egrave;s avoir recueilli des donn&eacute;es de cadrage sur l'&eacute;tablissement tels que la surface en m&egrave;tres carr&eacute;s, le mode de chauffage, la&nbsp;pr&eacute;sence de climatisation par exemple, des questions de type qualitatif sont abord&eacute;es telles que :<br />- &eacute;nergies utilis&eacute;es (fioul, &eacute;lectricit&eacute;&hellip;),<br />- usage (chauffage, informatique intensif&hellip;).<br /><br />Dans un troisi&egrave;me temps, des questions quantitatives sont pos&eacute;es, telles que :<br />- quantit&eacute;s d'&eacute;nergies achet&eacute;es,<br />- co&ucirc;t de ces &eacute;nergies,<br />- r&eacute;partition par usage en %.<br /><br />Enfin, une derni&egrave;re partie porte sur les &eacute;nergies renouvelables.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1844/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>First is collected information about structure of the establishment: such as the surface in square meters, the mode of heating, the presence of air conditioning for example.<br /><br />Then, questions on qualitative side are approached such as:<br />- used energies (fuel, electricity),<br />- use (heating, IT intensive).<br /><br />As well as quantitative questions such as:<br />- quantities of purchased energies,<br />- cost of those energies,<br />- distribution by use in % .<br /><br />The last part is about renewable energies.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1844/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1844/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1844> .
    
    <http://bauhaus/documents/document/357>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l’enquête sur les consommations d’énergie dans le tertiaire (ECET)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-11-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_ecet.pdf> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1614> {
    <http://bauhaus/qualite/attribut/1614/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/documents/document/394>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête mensuelle de conjoncture dans les services"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_SERVICES_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1614/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête mensuelle de conjoncture dans les services fait partie du système européen harmonisé des enquêtes de conjoncture de la Commission européenne, auquel contribuent les vingt-sept États membres de l'Union européenne. À ce titre, les questionnaires, les nomenclatures et les méthodes de traitement sont largement harmonisés dans les instituts nationaux des pays adhérant à ce système. La formulation des questions est conçue de manière à faciliter une réponse rapide (la plupart des questions sont qualitatives à trois modalités exprimées sous la forme \"hausse, baisse, stable\", ou \"supérieur à la normale, normal, inférieur à la normale\")."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1614/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1614/S.3.6/texte> , <http://bauhaus/qualite/attribut/1614/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1614/S.18.3/texte> , <http://bauhaus/qualite/attribut/1614/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Survey of a sample of 4,500 enterprises in services and road haulage of goods.<br /><br />All road haulage companies having annual turnover in excess of &euro;30 million are surveyed systematically.<br /><br />For other service enterprises, this threshold is &euro;45 million.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1614/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in services aims to transcribe the opinion of entrepreneurs on their recent activity and business prospects.<br /><br />This opinion is tracked by monitoring turnover and activity-related variables such as prices, demand, operating profit and changes to the workforce.<br /><br />The entrepreneurs also provide an opinion on their cash flow and their recruitment difficulties, their general feeling of the overall situation of their company and any factors that might be restricting their activity.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1614/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans les services a pour objet de transcrire l'opinion des chefs d'entreprise sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.<br /><br />Cette opinion est retrac&eacute;e au moyen du suivi du chiffre d'affaires et de variables qui sont li&eacute;es &agrave; l'activit&eacute;, telles que les prix, la demande, les r&eacute;sultats d'exploitation ou l'&eacute;volution des effectifs.<br /><br />Les chefs d'entreprise fournissent &eacute;galement une opinion sur leur tr&eacute;sorerie et sur leurs difficult&eacute;s de recrutement, leur sentiment g&eacute;n&eacute;ral sur la situation globale de leur entreprise et les facteurs &eacute;ventuels limitant son activit&eacute;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1614/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1614/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Jusqu'en 2007, l'enqu&ecirc;te avait lieu chaque mois sauf au mois d'ao&ucirc;t. Depuis 2008, elle a lieu tous les mois.<br /><br />La collecte s'effectue par voie postale et par internet sur une p&eacute;riode qui s'&eacute;tend de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la date de publication de l'enqu&ecirc;te, soit 4 jours ouvrables avant la fin du mois courant.<br /><br />Les r&eacute;sultats d'enqu&ecirc;te sont envoy&eacute;s &agrave; la Commission europ&eacute;enne 4 jours ouvrables avant la fin de mois.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/388>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2012"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Services_francais_2012.pdf> .
    
    <http://bauhaus/qualite/attribut/1614/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enqu&ecirc;te par sondage aupr&egrave;s de 4&nbsp;500 entreprises des services et du transport routier de marchandises<br /><br />Toutes les entreprises du transport routier de marchandises dont le chiffre d'affaires annuel est sup&eacute;rieur &agrave; 30 millions d'euros sont interrog&eacute;es de mani&egrave;re syst&eacute;matique.<br /><br />Pour les autres entreprises des services, ce seuil est port&eacute; &agrave; 45 millions d'euros.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1614/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1614/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1614/S.3.4/text> , <http://bauhaus/qualite/attribut/1614/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre en quasi-totalit&eacute; les secteurs suivants : h&eacute;bergement et restauration ; information et communication ; activit&eacute;s immobili&egrave;res ; activit&eacute;s sp&eacute;cialis&eacute;es, scientifiques et techniques ; activit&eacute;s de services administratifs et de soutien ; autres activit&eacute;s de services ; transport routier de marchandises et messagerie.</p>\n<p>Plus pr&eacute;cis&eacute;ment, l'enqu&ecirc;te couvre les secteurs d&eacute;finis par les codes NAF r&eacute;v. 2 suivants : 49.41, 52.29A, 53.2, 55.1, 55.2, 56.1, 56.21Z, 56.3, 58, 59, 60, 61, 62, 63, 68 (except&eacute; 68.32B), 69, 70 (except&eacute; 70.10Z), 71, 73, 74, 77, 78, 79, 80, 81, 82, 95, 96.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1614/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Until 2007, the survey was carried out each month except in August. Since 2008 it has been carried out every month.<br /><br />Data collection is by post and online over a period stretching from the end of the month prior to the month of the survey to the date of publication of the survey, i.e. 4 working days before the end of the current month.<br /><br />The results of the survey are sent to the European Commission 4 working days before the end of the month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1614/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1614/S.19/text> , <http://bauhaus/qualite/attribut/1614/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1614/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/388> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1614/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/rapport/1614>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly outlook survey in services 2012"@en , "Rapport qualité : Enquête mensuelle de conjoncture dans les services 2012"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1158> .
    
    <http://bauhaus/qualite/attribut/1614/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The monthly outlook survey in services is part of the harmonised European Union programme of business and consumer surveys to which the 27 Member States of the European Union contribute. As such, the questionnaires, classifications and processing methods are largely harmonised in the national institutes of the countries belonging to the system. The wording of the questions is designed in such a way as to facilitate quick answers (most of the questions are qualitative with three possible answers in the form \"up, down, same\", or \"higher than normal, normal, lower than normal\")."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1614/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1614/I.18.10/texte> , <http://bauhaus/qualite/attribut/1614/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-03-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1614/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1614> .
    
    <http://bauhaus/qualite/attribut/1614/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/444> , <http://bauhaus/documents/document/394> .
    
    <http://bauhaus/qualite/attribut/1614/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers almost all of the following sectors: accommodation and catering; information and communication; real estate activities; specialised, scientific and technical activities; administrative and support activities; other service activities; road goods haulage and courier services.</p>\n<p>More precisely, the survey covers the sectors defined by NAF Rev. 2 codes: 49.41, 52.29A, 53.2, 55.1, 55.2, 56.1, 56.21Z, 56.3, 58, 59, 60, 61, 62, 63, 68 (except 68.32B), 69, 70 (except 70.10Z), 71, 73, 74, 77, 78, 79, 80, 81, 82, 95, 96.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1723> {
    <http://bauhaus/qualite/attribut/1723/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/184> , <http://bauhaus/documents/document/185> , <http://bauhaus/documents/document/178> , <http://bauhaus/documents/document/181> , <http://bauhaus/documents/document/177> , <http://bauhaus/documents/document/183> .
    
    <http://bauhaus/documents/document/177>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des entreprises créés en 2010 - situation en 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-07-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_SINE_entreprises_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1723/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/U> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Each generation (or set) of businesses responds to three surveys using two different questionnaires: a questionnaire for the first survey upon start-up and a second questionnaire for the second and third surveys, after three years and five years of activity."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1723/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La couverture &eacute;conomique du dispositif SINE correspond au champ de la d&eacute;mographie d'entreprises : l'ensemble des activit&eacute;s marchandes, hormis les activit&eacute;s agricoles.</p>\n<p>Jusqu'&agrave; la cohorte 2002, le dispositif SINE ne couvrait que le champ dit \"ICS\" (de l'Industrie, de la construction, du Commerce et des Services).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>SINE is an ongoing system to observe and monitor a generation (or set) of new enterprises every four years.</p>\n<p>In this case, a generation is a group of enterprises created over the same period (the first half) of a given year. Each generation of enterprises is therefore only represented by the companies created in the first half of the year.</p>\n<p>For each generation, the information is collected using three surveys:<br />- the first, a few months after the creation of the enterprise;<br />- the second, at the end of the third year of existence of the enterprise;<br />- the third, five years after its creation.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1723/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1723/I.18.10/texte> , <http://bauhaus/qualite/attribut/1723/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/documents/document/185>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des auto-entrepreneurs créés en 2010 - situation en 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-07-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_SINE_auto_entr_2013_.pdf> .
    
    <http://bauhaus/qualite/attribut/1723/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The economic coverage of the SINE programme matches the businesses' demographic scope: all market activities, excluding agricultural activities.</p>\n<p>Until the 2002 set, the SINE system only covered the \"ICS\" scope (Industry, the building industry, Trade and Services).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1723/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1723/S.3.6/texte> , <http://bauhaus/qualite/attribut/1723/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire porte sur :<br />- le profil du cr&eacute;ateur et les conditions de d&eacute;marrage de l'entreprise ;<br />- l'&eacute;volution de l'activit&eacute; de l'entreprise, le type de client&egrave;le, la coop&eacute;ration avec les autres entreprises ;<br />- l'&eacute;volution des effectifs (embauches, licenciements, personnel occasionnel) ;<br />- les investissements et leur mode de financement ;<br />- la formation et les conseils apr&egrave;s la cr&eacute;ation ;<br />- les difficult&eacute;s rencontr&eacute;es par l'entreprise ;<br />- la strat&eacute;gie de l'entreprise ;<br />- les conditions de son d&eacute;veloppement.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/documents/document/184>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête auprès des auto-entrepreneurs créés en 2010 : Situation initiale"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-07-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_auto_entrepreneurs.pdf> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    ""@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1723/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Chaque génération (ou cohorte) d'entreprises fait l'objet de trois enquêtes par le biais de deux questionnaires différents : un questionnaire pour la première interrogation dès la création et un second questionnaire pour la deuxième et la troisième interrogation, après trois ans et cinq ans d'activité."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1723/I.18.7/text> , <http://bauhaus/qualite/attribut/1723/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The surveying of a new set is launched every 4 years.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/183>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête auprès des entreprises créées ou reprises en 2010 : Situation initiale"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-07-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_createurs.pdf> .
    
    <http://bauhaus/qualite/attribut/1723/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1723/S.3.4/texte> , <http://bauhaus/qualite/attribut/1723/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/rapport/1723>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: New enterprises information system 2010"@en , "Rapport qualité : Système d'information sur les nouvelles entreprises 2010"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1079> .
    
    <http://bauhaus/qualite/attribut/1723/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The questionnaire dealt with:<br />- the profile of the creator and the conditions for the start-up of the enterprise;<br />- the development of the enterprise's activity, type of clientele, cooperation with other enterprises;<br />- changes to employee numbers (hiring, dismissals, occasional staff);<br />- investments and their form of financing;<br />- training and advice after start-up;<br />- the difficulties encountered by the enterprise;<br />- the enterprise's strategy;<br />- the conditions for its development.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Toutes les nouvelles entreprises ne sont pas enqu&ecirc;t&eacute;es.</p>\n<p>Les &eacute;chantillons de la cohorte 2010 du dispositif SINE sont tir&eacute;s &agrave; partir des cr&eacute;ations d'entreprises enregistr&eacute;es dans le r&eacute;pertoire Sirene au cours du premier semestre 2010, r&eacute;parties en strates selon les crit&egrave;res suivants&nbsp; :&nbsp;</p>\n<p>- la r&eacute;gion, le secteur d'activit&eacute; et l&rsquo;emploi (cr&eacute;ation avec ou sans salari&eacute;s) pour le questionnaire aupr&egrave;s des cr&eacute;ateurs hors auto-entrepreneurs ;</p>\n<p>- la r&eacute;gion et le secteur d'activit&eacute; pour le questionnaire aupr&egrave;s des auto-entrepreneurs.</p>\n<p>Le mode de tirage de l'&eacute;chantillon permet une repr&eacute;sentativit&eacute; nationale et r&eacute;gionale des r&eacute;sultats.</p>\n<p>Seules les entreprises survivantes sont ensuite r&eacute;interrog&eacute;es apr&egrave;s trois ans et cinq ans d'existence.</p>\n<p>L'&eacute;chantillon total SINE 2010 (premi&egrave;re interrogation de la g&eacute;n&eacute;ration 2010) compte environ 52 000 cr&eacute;ateurs hors auto-entrepreneurs (dont environ 12 000 au titre d&rsquo;extensions r&eacute;gionales), et 40 000 auto-entrepreneurs.</p>\n<p>La deuxi&egrave;me interrogation de cette cohorte a eu lieu en 2013 et la troisi&egrave;me en 2015.</p>\n<p>L&rsquo;&eacute;chantillon couvre la France enti&egrave;re, DOM compris.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/178>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des auto-entrepreneurs créés en 2010 - situation en 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-07-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_SINE_auto_entr_2015_.pdf> .
    
    <http://bauhaus/qualite/attribut/1723/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>SINE est un syst&egrave;me permanent d'observation et de suivi d'une g&eacute;n&eacute;ration (ou cohorte) de nouvelles entreprises tous les quatre ans.</p>\n<p>Une g&eacute;n&eacute;ration correspond ici aux entreprises cr&eacute;&eacute;es au cours de la m&ecirc;me p&eacute;riode (le premier semestre) d'une ann&eacute;e donn&eacute;e. Chaque g&eacute;n&eacute;ration d'entreprises est donc repr&eacute;sent&eacute;e par les seules cr&eacute;ations du premier semestre de l'ann&eacute;e.</p>\n<p>Pour chaque g&eacute;n&eacute;ration, le recueil d'information repose sur trois interrogations :<br />- la premi&egrave;re, quelques mois apr&egrave;s la cr&eacute;ation de l'entreprise ;<br />- la deuxi&egrave;me, au bout de la troisi&egrave;me ann&eacute;e d'existence de l'entreprise ;<br />- la troisi&egrave;me, cinq ans apr&egrave;s la cr&eacute;ation.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1723/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-09-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/documents/document/181>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des entreprises créés en 2010 - situation en 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-07-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_SINE_entreprises_2013.pdf> .
    
    <http://bauhaus/qualite/attribut/1723/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1723/S.18.3/texte> , <http://bauhaus/qualite/attribut/1723/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
    
    <http://bauhaus/qualite/attribut/1723/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'interrogation d'une nouvelle cohorte est initialis&eacute;e tous les 4 ans.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1723/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1723/S.19/text> , <http://bauhaus/qualite/attribut/1723/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1723> .
}

