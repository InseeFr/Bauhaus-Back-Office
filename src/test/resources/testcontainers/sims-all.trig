    <http://bauhaus/documents/document/172>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice 2016 de l'enquête sur l'usage de l'informatique et des technologies de la communication (auprès des entreprises de moins de 10 personnes) / TIC-TPE"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-08-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_TIC_TPE_2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1727/S.3.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Indicatrice d'unit&eacute; dite &laquo;&nbsp;microentreprise&nbsp;&raquo; (entreprise de 1 &agrave; 9 personnes occup&eacute;es dont le chiffre d'affaires n'exc&egrave;de pas 2 millions d'euros)&nbsp;:<br />- 0&nbsp;: Non<br />- 1&nbsp;: Oui <br /><br />Secteur d'activit&eacute; regroup&eacute; en 8 modalit&eacute;s :<br />- CDE : Industrie (divisions 10 &agrave; 39)<br />- F__ : Construction (divisions 41 &agrave; 43)<br />- G__ : Commerce (divisions 45 &agrave; 47)<br />- H__ : Transports (divisions 49 &agrave; 53)<br />- I__ : H&eacute;bergement et restauration (divisions 55 et 56)<br />- J_s : Information et communication ; r&eacute;paration d'ordinateurs (divisions 58 &agrave; 63 + groupe 951)<br />- M__ : Activit&eacute;s sp&eacute;cialis&eacute;es, scientifiques et techniques (divisions 69 &agrave; 74)<br />- N_L : Services administratifs et de soutien ; activit&eacute;s immobili&egrave;res (divisions 68 et 77 &agrave; 82)<br /><br />Indicatrice d'appartenance au secteur des TIC selon l'OCDE (divisions 61 et 62 + groupes 261 &agrave; 264, 268, 465, 582, 631 et 951) (TIC)&nbsp;:<br />- 0&nbsp;: Non<br />- 1&nbsp;: Oui<br /><br />Taille de l'entreprise en 3 tranches&nbsp;:<br />- 0_0 : 0 personne occup&eacute;e<br />- 1_1 : 1 personne occup&eacute;e<br />- 2_9 : 2 &agrave; 9 personnes occup&eacute;es <br /><br />Taille de l'entreprise en 4 tranches&nbsp;:<br />- 0_0 : 0 personne occup&eacute;e<br />- 1_1 : 1 personne occup&eacute;e<br />- 2_4 : 2 &agrave; 4 personnes occup&eacute;es<br />- 5_9 : 5 &agrave; 9 personnes occup&eacute;es</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1727/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1727/S.10.2/texte> , <http://bauhaus/qualite/attribut/1727/S.10.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1727> .
    
    <http://bauhaus/qualite/attribut/1727/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
