    <http://bauhaus/qualite/attribut/1507/S.14.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le délai de livraison correspond à la date cible."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1507/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1507> .
    
    <http://bauhaus/qualite/attribut/1507/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour l'emploi salari&eacute;&nbsp;:<br />- niveaux A88 de la NAF r&eacute;v 2 pour la France m&eacute;tropolitaine et A38 pour la France (hors Mayotte)&nbsp;;<br />- niveau A38 de la Naf r&eacute;v.2 pour les r&eacute;gions et d&eacute;partements (hors Mayotte)&nbsp;;<br />- niveau A5 de la Naf r&eacute;v.2 pour les zones d'emploi (hors Mayotte).<br /><br />Pour l'emploi non salari&eacute;&nbsp;:<br />- niveau A5 de la Naf R&eacute;v.2 pour la France m&eacute;tropolitaine&nbsp;; <br />- niveau A5 pour les d&eacute;partements de la France m&eacute;tropolitaine&nbsp;;<br />- niveau total pour les DOM&nbsp;;<br />- niveau total pour les zones d'emploi.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
