                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1572/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1572/S.3.6/text> , <http://bauhaus/qualite/attribut/1572/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1572> .
    
    <http://bauhaus/qualite/attribut/1572/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1572/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1572> .
    
    <http://bauhaus/qualite/attribut/1572/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/463> , <http://bauhaus/documents/document/444> .
    
    <http://bauhaus/qualite/attribut/1572/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1572> .
    
    <http://bauhaus/qualite/attribut/1572/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Survey of a sample of 3,750 enterprises</p>\n<p>All enterprises with more than 100 employees are surveyed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1572/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1572> .
    
    <http://bauhaus/qualite/attribut/1572/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in the retail trade and automobile trade and repairs aims to transcribe the opinion of retailers on their recent activity and business prospects.<br /><br />This opinion is tracked by monitoring sales volumes and related variables such as stocks, order intentions, changes in workforce and price trends.<br /><br />Entrepreneurs also provide an opinion on their cash flow and payment deadlines.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1572/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1572/S.19/texte> , <http://bauhaus/qualite/attribut/1572/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1572> .
    
    <http://bauhaus/qualite/attribut/1572/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in the retail trade and automobile trade and repairs is part of the harmonised European Union programme of business and consumer surveys to which the 27 Member States of the European Union contribute.<br /><br />As such, the questionnaires, classifications and processing methods are largely harmonised in the national institutes of the countries belonging to the system.<br /><br />The wording of the questions is designed in such a way as to facilitate quick answers (most of the questions are qualitative with three possible answers in the form \"up, down, same\", or \"higher than normal, normal, lower&nbsp;than normal\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1790> {
    <http://bauhaus/qualite/attribut/1790/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices en volume du Commerce de d&eacute;tail et du Commerce et r&eacute;paration d&rsquo;automobiles et de motocycles sont obtenus en d&eacute;flatant les indices en valeur par un indice de prix repr&eacute;sentatif des produits vendus, obtenu en agr&eacute;geant les indices des prix &agrave; la consommation (IPC) des m&eacute;nages des produits concern&eacute;s. On consid&egrave;re donc que, pour une activit&eacute; donn&eacute;e, l'indice de branche &eacute;volue de la m&ecirc;me mani&egrave;re que l'indice de prix sectoriel. On &eacute;tablit une table de correspondance entre les secteurs de la Naf r&eacute;v 2 et la nomenclature de fonction de consommation, construite par d&eacute;sagr&eacute;gation de la nomenclature europ&eacute;enne&nbsp;-Classification of Individual Consumption by Purpose (COICOP)- pour les IPC et le commerce de d&eacute;tail et le commerce et r&eacute;paration automobile... Pour chaque branche, on agr&eacute;ge les IPC rattach&eacute;s &agrave; partir de la structure de l'IPC de l'ann&eacute;e pr&eacute;c&eacute;dente pour calculer l'indice de prix global.</p>\n<p>Il ne suffit pas de d&eacute;flater les indices de chiffres d'affaires en valeur hors TVA par les indices de prix &agrave; la consommation pour d&eacute;terminer des indices de CA en volume. En effet, les IPC sont mesur&eacute;s toutes taxes comprise. Pour &eacute;liminer l'impact des variations de prix &agrave; partir des IPC, il est donc n&eacute;cessaire de corriger ces derniers de l'effet des changements de taux&nbsp;de TVA.</p>\n<p>Le secteur du Commerce de gros couvre l'ensemble des biens et marchandises produits (neufs ou d'occasion). On utilise donc selon les produits les IPGA (Indice des prix de gros alimentaires), les IPAMPA (Indice mensuel brut des prix d'achat des moyens de production agricole), des IPPAP (Indice mensuel des prix agricoles &agrave; la production), des IPPI (Indice de prix de production de l'industrie fran&ccedil;aise pour le march&eacute; fran&ccedil;ais - prix de march&eacute; ou prix de base) et des Indices de prix &agrave; la consommation.</p>\n<p>Les pond&eacute;rations des produits de chaque sous-secteur qui servent &agrave; la constitution&nbsp;de l&rsquo;indice de prix agr&eacute;g&eacute; (la somme des pond&eacute;rations est &eacute;gale &agrave; 1) sont issues de la matrice secteurs x produits &eacute;tablit par la &laquo;&nbsp;division Commerce&nbsp;&raquo; de l'Insee. Cette d&eacute;composition en produits est faite au niveau tr&egrave;s fin CPF 6 (classification des produits fran&ccedil;aise), selon la structure des ventes de l'enqu&ecirc;te sectorielle annuelle (ESA).</p>\n<p>L'indice sectoriel est donc une moyenne pond&eacute;r&eacute;e des diff&eacute;rents indices repr&eacute;sentant les produits composant la structure des ventes selon l'enqu&ecirc;te ESA en base 2010.</p>\n<p>Les indices de volumes des ventes &agrave; un niveau fin sont d&eacute;finis comme le rapport de l&rsquo;indice de chiffres d&rsquo;affaires en valeur par l&rsquo;indice de prix associ&eacute;. Cette op&eacute;ration est effectu&eacute;e pour les 116 sous-classes du secteur du commerce.</p>\n<p>Une fois les indices au niveau le plus fin de nomenclature calcul&eacute;s, on peut calculer les indices des secteurs de niveaux de nomenclature sup&eacute;rieurs par agr&eacute;gation.</p>\n<p>Les indices des secteurs plus larges sont calcul&eacute;s par des indices de Laspeyres (&agrave; pond&eacute;rations constantes dans le temps) des indices les plus fins. Ils sont rebas&eacute;s tous les 5 ans&nbsp;; les indices publi&eacute;s actuellement ont pour base 2010, c&rsquo;est-&agrave;-dire que les pond&eacute;rations des diff&eacute;rents niveaux correspondent &agrave; des valeurs&nbsp;calcul&eacute;es sur l&rsquo;ann&eacute;e 2010. Ils sont aussi publi&eacute;s en r&eacute;f&eacute;rence 100 en 2010, c&rsquo;est-&agrave;-dire que les indices ont pour moyenne 100 en 2010.</p>\n<p>Les pond&eacute;rations constantes des indices &eacute;l&eacute;mentaires sont les productions vendues des branches en 2010 aux prix de base. Par d&eacute;finition, les productions aux prix de base excluent les imp&ocirc;ts sur les produits mais sont augment&eacute;es des subventions sur les produits&nbsp;; elles ne comprennent pas les prestations de transport. Les pond&eacute;rations ont &eacute;t&eacute; calcul&eacute;es &agrave; partir des donn&eacute;es des comptes nationaux et de l&rsquo;enqu&ecirc;te sectorielle annuelle 2010.</p>\n<p>Les s&eacute;ries sont corrig&eacute;es des variations saisonni&egrave;res (CVS) et des effets de calendrier (CJO). Ces effets sont estim&eacute;s avec le logiciel X12-Arima sous JDemetra+ (fourni par Eurostat) au niveau des classes de la NAF r&eacute;v. 2. Cette correction est effectu&eacute;e au niveau du ratio &laquo;&nbsp;volume&nbsp;&raquo; c'est-&agrave;-dire indice brut de chiffre d'affaires en valeur/indice de prix brut. Les indices CVS-CJO des postes des niveaux sup&eacute;rieurs sont obtenus par agr&eacute;gation des indices CVS-CJO des classes qui les composent.</p>\n<p>La moyenne annuelle des indices CVS-CJO peut diff&eacute;rer l&eacute;g&egrave;rement de celle des indices bruts, car elle tient compte des variations de la composition annuelle en jours ouvrables d&rsquo;une ann&eacute;e sur l&rsquo;autre&nbsp;: ann&eacute;es bissextiles, positionnement dans la semaine des diff&eacute;rents jours f&eacute;ri&eacute;s, etc.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/58> .
    
