                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_BAT_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1585/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1585/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly business outlook survey in the building industry records the opinion of entrepreneurs in the sector on recent activity and on their future activity.<br /><br />This opinion is obtained by monitoring production itself and related variables, such as order books, production bottlenecks, workforce, difficulties with hiring workers, etc.<br /><br />Company chiefs also provide estimates of their investments and an opinion on their cash flow.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1585/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/443> , <http://bauhaus/documents/document/444> .
    
    <http://bauhaus/qualite/attribut/1585/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers 2,500 companies with more than 10 employees.</p>\n<p>All companies with more than 500 employees are canvassed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Until 2007, the survey was conducted every month except August.<br /><br />Since 2008, it takes place every month.<br /><br />Data collection is by post and via the internet over a period that extends from the end of the month preceding the survey month&nbsp;to the survey publication date, i.e. 4 business days before the end of the current month.<br /><br />Survey results are sent to the European Commission 4 business days before the end of the month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1585/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/54> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1585/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans l'industrie du b&acirc;timent a pour objet de transcrire l'opinion des entrepreneurs du secteur sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.<br /><br />Cette opinion est retrac&eacute;e au moyen du suivi de la production elle-m&ecirc;me et de variables qui lui sont li&eacute;es, telles que les carnets de commandes, goulots de production, effectifs, difficult&eacute;s de recrutement...<br /><br />Les chefs d'entreprise fournissent &eacute;galement des estimations de leurs investissements et une opinion sur leur tr&eacute;sorerie.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1585/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1791> {
    <http://bauhaus/qualite/attribut/1791/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/documents/document/57>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique des index divers de la construction  2010 / ID"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-04-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Note_methodo_ID_2010_fr_avril2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1791/S.3.4/text> , <http://bauhaus/qualite/attribut/1791/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The various indices for Construction do not give rise to a new survey, but use existing public statistics, including from survey on Producer Price Indices (OPISE), which provide the elementary indices."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1791/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1791/S.10.6/texte> , <http://bauhaus/qualite/attribut/1791/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/documents/document/749>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Composition index frais divers des index BT et TP"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-05-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ID_2010_COMPOSITION_INDEX_FRAIS_DIVERS_BT_TP.pdf> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Coût, construction"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/752>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Various indices for contruction (base 2010)"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ID_2010_INDEX_DIVERS_CONSTRUCTION_2010_BASE_gb.pdf> .
    
    <http://bauhaus/qualite/attribut/1791/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Various indices for Construction are released during the third month following the month under review, on the site of the Macro-economic database BDM in the topic \"Prices and price indices\" under \"Construction producer costs\". They are also published in the Official Journal. "@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1791/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1791/S.19/text> , <http://bauhaus/qualite/attribut/1791/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Conceptually, the statistical unit observed on its costs is a branch or sub-branch of activity of French construction companies&nbsp;or construction related companies.</p>\n<p>See associated documents.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1791>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Index divers (base 2010)"@fr , "Quality report: Various indices for construction (Base 2010)"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1650> .
    
    <http://bauhaus/qualite/attribut/1791/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les index divers de la construction&nbsp; ne donnent pas lieu &agrave; une enqu&ecirc;te nouvelle, mais utilisent les statistiques publiques existantes, notamment le dispositif OPISE, pour constituer les indices &eacute;l&eacute;mentaires.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/751>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique Index divers de la construction en base 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ID_2010_INDEX_DIVERS_CONSTRUCTION_2010_BASE_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Conceptuellement, l'unit&eacute; observ&eacute;e sur ses co&ucirc;ts est une branche ou sous-branche d'activit&eacute; des entreprises fran&ccedil;aises de construction ou li&eacute;s &agrave; la construction.</p>\n<p>Voir tableau dans la rubrique \"Documents associ&eacute;s\".</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1791/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/documents/document/747>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique Composition des index MABTGO,MABTSO,MATP"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ID_2010_COMPOSITION_FD_MABTGO_MABTSO_MATP.pdf> .
    
    <http://bauhaus/qualite/attribut/1791/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les index divers de la construction sont diffusés au cours du troisième mois suivant le mois sous revue, sur le site de la BDM, dans le thème « Prix et indices de prix », rubrique « Indices des prix de production et de coûts dans la construction », sous-rubrique « Indices des coûts de production dans la construction (indexation de contrats) ». Ils sont aussi publiés au Journal Officiel."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1791/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1791/S.18.3/text> , <http://bauhaus/qualite/attribut/1791/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Various indices for Construction are cost indices for different&nbsp; construction activity, apprehended from 7 line-items in a cost accounting approach: \"capital goods\", \"labour costs\" once called \"salaries and costs\", \"energy\", \"materials\", \"miscellaneous expenses\", \"transport\", &ldquo;waste&rdquo; similar to the productivity economists' approach called \"KLEMST\" (K = capital for \"material\", L = Labour ,\" E = energy, M = materials, S = Service for \"miscellaneous expenses\" T = transport). The structure and weights of various construction indices have been reviewed on the occasion of new base and reference 2010.</p>\n<p>(See also methodological note)</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/752> .
    
    <http://bauhaus/documents/document/746>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique Composition de l'index FD"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ID_2010_COMPOSITION_FD.pdf> .
    
    <http://bauhaus/qualite/attribut/1791/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Costs, construction"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1791/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les index travaux publics (TP) sont des indices de co&ucirc;ts des diff&eacute;rentes activit&eacute;s du secteur de la construction, appr&eacute;hend&eacute;s &agrave;&nbsp;partir de 7 postes dans une d&eacute;marche de comptabilit&eacute; analytique : &laquo;&nbsp;co&ucirc;t du travail&nbsp;&raquo; jadis appel&eacute; &laquo;&nbsp;salaires et charges&nbsp;&raquo;, &laquo;&nbsp;mat&eacute;riaux&nbsp;&raquo;, &laquo;&nbsp;mat&eacute;riel&nbsp;&raquo;, &laquo;&nbsp;&eacute;nergie&nbsp;&raquo;, &laquo;&nbsp;transport&nbsp;&raquo;, &laquo;&nbsp;frais divers&nbsp;&raquo;, analogue &agrave; l'approche &laquo;&nbsp;KLEMSTD&nbsp;&raquo; des &eacute;conomistes de la productivit&eacute; (K = capital pour &laquo;&nbsp;mat&eacute;riel&nbsp;&raquo;, L = labour pour &laquo;&nbsp;travail&nbsp;&raquo;, E = energy pour &laquo;&nbsp;&eacute;nergie&nbsp;&raquo;, M = materials pour &laquo;&nbsp;mat&eacute;riaux&nbsp;&raquo;, S = services pour &laquo;&nbsp;frais divers&nbsp;&raquo;, T = transport pour &laquo;&nbsp;transport&nbsp;&raquo; et D = &laquo;&nbsp;d&eacute;chets&nbsp;&raquo;). <br />La structure et les pond&eacute;rations des index divers de la construction ont &eacute;t&eacute; revues, &agrave; l&rsquo;occasion de la base et r&eacute;f&eacute;rence 2010.</p>\n<p>(Voir aussi&nbsp; la note m&eacute;thodologique)</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/747> , <http://bauhaus/documents/document/751> , <http://bauhaus/documents/document/749> , <http://bauhaus/documents/document/746> , <http://bauhaus/documents/document/57> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1791/S.3.6/text> , <http://bauhaus/qualite/attribut/1791/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
    
    <http://bauhaus/qualite/attribut/1791/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1791> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1561> {
    <http://bauhaus/qualite/attribut/1561/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-03-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1561> .
    
    <http://bauhaus/qualite/attribut/1561/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1561> .
    
    <http://bauhaus/qualite/attribut/1561/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e tous les trimestres (en janvier, avril, juillet et octobre, soit le mois suivant la fin de chaque trimestre).</p>\n<p>La collecte s'effectue par voie postale et par internet de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la fin du mois de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1561/S.10.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/470> .
    
    <http://bauhaus/qualite/attribut/1561/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1561> .
    
    <http://bauhaus/qualite/attribut/1561/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1561> .
    
    <http://bauhaus/qualite/attribut/1561/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1561/S.19/text> , <http://bauhaus/qualite/attribut/1561/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1561> .
    
    <http://bauhaus/qualite/attribut/1561/S.10.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.7>
                    <http://bauhaus/qualite/attribut/1561/S.10.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1561> .
    
    <http://bauhaus/qualite/attribut/1561/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quarterly outlook survey in the building trades aims to transcribe the opinion of craftspeople in the sector on their recent activity and activity prospects.</p>\n<p>This opinion is tracked by monitoring activity and related variables such as changes in workforce.</p>\n<p>The entrepreneurs also provide their opinion on their investments and their cash flow.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/473>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête trimestrielle dans l'artisanat du bâtiment"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-11-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/methodo_enq_trim_artisanat_bat_13112015.pdf> .
    
    <http://bauhaus/qualite/attribut/1561/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-G120> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1561> .
    
    <http://bauhaus/qualite/attribut/1561/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête par sondage auprès de 1 500 entreprises de 10 salariés ou moins."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1561/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
