            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête sur la production de déchets non dangereux dans le commerce"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-11-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_DECHETS_NDGRX_COMMERC_2012.pdf> .
    
    <http://bauhaus/qualite/attribut/1639/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/347> .
    
    <http://bauhaus/qualite/attribut/1639/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Since 2012, the sampling frame is the Sirus directory (directory of statistical units).</p>\n<p>The sampling method: stratification by sector of activity and by local unit size.</p>\n<p>The survey is more exhaustive for establishments of 250 or more employees.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1639/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Depuis 2012, La base de sondage est le r&eacute;pertoire Sirus (r&eacute;pertoire des unit&eacute;s statistiques).</p>\n<p>La m&eacute;thode d'&eacute;chantillonnage : stratification par secteur d'activit&eacute; et taille d'unit&eacute; locale.</p>\n<p>L'enqu&ecirc;te est exhaustive pour les &eacute;tablissements de 250 salari&eacute;s et plus.&nbsp;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1639/S.19/text> , <http://bauhaus/qualite/attribut/1639/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/348> .
    
    <http://bauhaus/qualite/attribut/1639/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1639/S.3.6/texte> , <http://bauhaus/qualite/attribut/1639/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Cette enquête thématique ne concerne que les déchets non dangereux. Les données sur les déchets dangereux sont obtenues par l'exploitation des déclarations administratives annuelles obligatoires en matière de déchets dangereux remplies par les entreprises (Base de données du répertoire des émissions polluantes : BDREP)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>These are establishments with 20 or more employees, with a NAF rev. 2 code belonging to the divisions 46 and 47 (wholesale and retail trade, except of motor vehicles and motorcycles).</p>\n<p>The sample is about 5000 units.</p>\n<p><!-- [if gte mso 9]><xml>\n <w:WordDocument>\n  <w:View>Normal</w:View>\n  <w:Zoom>0</w:Zoom>\n  <w:HyphenationZone>21</w:HyphenationZone>\n  <w:DoNotOptimizeForBrowser/>\n </w:WordDocument>\n</xml><![endif]--><span lang=\"EN-US\" style=\"font-size: 11.0pt; mso-bidi-font-size: 10.0pt; font-family: Arial; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: FR; mso-bidi-language: AR-SA;\">The survey covers Metropolitan France and the overseas departments.</span></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Internet with the possibility of sending by mail upon request. The data collection of the year n takes place from September to December n + 1.</p>\n<p>The survey is aperiodic. The two last surveys were conducted in 2007, on the observation years 2006 and in 2013, on the observation year 2012.</p>\n<p>The data collection of the year n takes place from September to December n + 1.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1639/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Internet avec possibilit&eacute; d'envoi par courrier sur demande. La collecte des donn&eacute;es de l'ann&eacute;e n se d&eacute;roule de septembre &agrave; d&eacute;cembre n+1.</p>\n<p>L'enqu&ecirc;te est ap&eacute;riodique. Les deux derni&egrave;res enqu&ecirc;tes datent de 2007, sur l'ann&eacute;e de constat 2006 et de 2013, sur l'ann&eacute;e de constat 2012.</p>\n<p>La collecte des donn&eacute;es de l'ann&eacute;e n se d&eacute;roule de septembre &agrave; d&eacute;cembre n+1.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1639/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1639/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire comporte 3 parties :<br /><br />- la premi&egrave;re partie recueille des informations de cadrage relatives aux &eacute;tablissements du&nbsp; champ de l'enqu&ecirc;te (activit&eacute;, effectif) ;<br /><br />- la deuxi&egrave;me partie recueille des informations qualitatives sur la gestion des d&eacute;chets et l'importance des pr&eacute;occupations environnementales au sein de l'&eacute;tablissement ;<br /><br />- la troisi&egrave;me partie recueille&nbsp; les tonnages de d&eacute;chets produits selon leur type, ainsi que des informations sur leur collecte&nbsp;et leur traitement. Elle se d&eacute;compose en trois sous-parties : les&nbsp; boues et d&eacute;chets organiques non-dangereux, les&nbsp; d&eacute;chets non dangereux en m&eacute;lange et&nbsp; les&nbsp; d&eacute;chets non dangereux tri&eacute;s.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1639>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on non-hazardous waste in wholesale and retail trade 2012"@en , "Rapport qualité : Enquête sur la production de déchets non dangereux dans le commerce 2012"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1355> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The questionnaire includes 3 sections:<br /><br />- the first part collects background information relating to the establishments of the scope of the survey (activity, numbers);<br /><br />- the second part collects qualitative information on waste management and the importance of environmental concerns for the establishment.<br /><br />- the third part collects tonnages of producted waste according to their type, as well as information on&nbsp; their collection and their processing. It is broken down into three sub-sections: non-hazardous slurry and organic waste, mixed non-hazardous waste, non-mixed non-hazardous waste.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/348> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1639/S.3.4/text> , <http://bauhaus/qualite/attribut/1639/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Il s'agit des &eacute;tablissements de 20 salari&eacute;s et plus, ayant un code NAF r&eacute;v. 2 appartenant aux divisions 46 et 47 (commerce de gros et commerce de d&eacute;tail &agrave; l'exception des automobiles et des motocycles).</p>\n<p>L'&eacute;chantillon est de l'ordre de 5 000 unit&eacute;s.</p>\n<p><!-- [if gte mso 9]><xml>\n <w:WordDocument>\n  <w:View>Normal</w:View>\n  <w:Zoom>0</w:Zoom>\n  <w:HyphenationZone>21</w:HyphenationZone>\n  <w:DoNotOptimizeForBrowser/>\n </w:WordDocument>\n</xml><![endif]--><span style=\"font-size: 11.0pt; mso-bidi-font-size: 10.0pt; font-family: Arial; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: FR; mso-fareast-language: FR; mso-bidi-language: AR-SA;\">L'enqu&ecirc;te couvre la France m&eacute;tropolitaine et les d&eacute;partements d'outre-mer (DOM).</span></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/348>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2012 de l'enquête sur la production de déchets non dangereux dans le commerce"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-08-26"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_DECHETS_NDGRX_COMMERC_2012_QUEST.pdf> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1639/I.18.10/texte> , <http://bauhaus/qualite/attribut/1639/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This thematic survey concerns only non-hazardous waste. Data on hazardous waste are produced by the operation of mandatory annual administrative declarations for hazardous waste fulfilled by firms (French pollutant emission database : BDREP)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

