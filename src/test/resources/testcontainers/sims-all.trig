    <http://bauhaus/qualite/attribut/1822/S.3.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.2>
                    <http://bauhaus/qualite/attribut/1822/S.3.2/texte> , <http://bauhaus/qualite/attribut/1822/S.3.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
