            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1801> .
    
    <http://bauhaus/qualite/attribut/1801/S.18.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Labour Force Survey&nbsp;: a survey conducted by Insee<br />- Jobseekers at the end of month (DEFM)&nbsp;: administrative data from P&ocirc;le emploi<br />- Employment estimates&nbsp;: Synthesis of administrative sources on employment computed by Insee</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1801/I.20/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Insee.fr website (in french only).</p>\n<p>Taux de ch&ocirc;mage localis&eacute;s par zone d'emploi&nbsp;: <br /><a href=\"https://www.insee.fr/fr/statistiques/1893230\"> https://www.insee.fr/fr/statistiques/1893230</a> <br /><br />Taux de ch&ocirc;mage localis&eacute; par d&eacute;partement et r&eacute;gion de France m&eacute;tropolitaine&nbsp;:<br /><a href=\"https://www.insee.fr/fr/statistiques/2012804\"> https://www.insee.fr/fr/statistiques/2012804</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1801/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Quarterly&nbsp;: localised unemployment rates by region, department and employment area in Metropolitan France;<br />-&nbsp; Annual&nbsp;: localised unemployment rates by region, department and employment area in overseas departments (except Mayotte)&nbsp;; in average on the year for overseas department since 2014.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
