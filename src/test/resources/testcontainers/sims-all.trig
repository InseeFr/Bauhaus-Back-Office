                    "<p>INSEE / DG, 88 avenue Verdier, CS 70058, 92541 MONTROUGE CEDEX</p>"@fr , "<p>INSEE / DG, 88 avenue Verdier, CS 70058, 92541 MONTROUGE CEDEX</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
