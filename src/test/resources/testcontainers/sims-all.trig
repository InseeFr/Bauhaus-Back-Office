            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee,<br />88 avenue Verdier,&nbsp; CS 70 058, 92 541 Montrouge Cedex.</p>"@fr , "<p>Insee,<br />88 avenue Verdier,&nbsp; CS 70 058, 92 541 Montrouge Cedex.</p>"@en ;
