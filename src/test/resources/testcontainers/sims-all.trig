    <http://bauhaus/qualite/attribut/1949/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te est publi&eacute;e avant le 10 du mois suivant le mois durant lequel les chefs d&rsquo;entreprises ont &eacute;t&eacute; interrog&eacute;s, &agrave; l&rsquo;exception de l&rsquo;enqu&ecirc;te de juillet, publi&eacute;e autour du 20 ao&ucirc;t.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1949/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
