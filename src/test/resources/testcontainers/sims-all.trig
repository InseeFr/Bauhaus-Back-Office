                    "0187696291"@fr , "0187696291"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is conducted each year, from March to July. The EVA survey (Panel 2007) started in 2013 and will finish in 2023.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
