            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: National survey on the resources of young adults 2014"@en , "Rapport qualité : Enquête sur les ressources des jeunes 2014"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1445> .
    
    <http://bauhaus/qualite/attribut/1653/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1653/S.3.6/text> , <http://bauhaus/qualite/attribut/1653/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
