                    <http://bauhaus/qualite/rapport/1512> .
    
    <http://bauhaus/qualite/attribut/1512/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Employees by private individuals , their descriptions and their work characteristics.<br /><br />- Remunerations and working hours.</p>"@en ;
