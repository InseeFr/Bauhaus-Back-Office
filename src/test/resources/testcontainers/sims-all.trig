    <http://bauhaus/qualite/rapport/1801>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Localised unemployment rates (by region, department and employment area)"@en , "Rapport qualité : Taux de chômage localisés (par régions, départements et zones d'emploi)"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1660> .
    
    <http://bauhaus/qualite/attribut/1801/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The localised unemployment rate estimation method is based on an estimate of, firstly, the unemployment (numerator) and, secondly, the employment (a part of the denominator), by employment area and department.<br /><br />The numerator is obtained each quarter by breaking down national figures for unemployment using the geographical structure observed in the DEFM.<br /><br />The employment is computed mainly due to employment estimations.<br /><br />The localised unemployment rate is finally calculated by comparing the number of unemployed persons to the labour force (sum of&nbsp;the number of unemployed persons and occupied active persons) estimated in this manner.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1801/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
