    <http://bauhaus/qualite/attribut/1739/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The following categories of the NACE Rev. 1.1 : sections D, E, F, G, H, I, K, groups 92.1, 92.2, classes 65.12, 65.22, 66.01 and 66.03.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Sections D, E, F, G, H, I, K, groupes 92.1, 92.2, classes 65.1C, 65.1D, 65.1E, 65.1F, 65.2C, 66.0A, 66.0E, 66.0F, 66.0G (mutuelles des livres I et II) de la NAF rev. 1.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
