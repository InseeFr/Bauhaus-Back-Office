                    <http://bauhaus/qualite/attribut/1943/S.8.2/texte> , <http://bauhaus/qualite/attribut/1943/S.8.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1943> .
    
    <http://bauhaus/qualite/attribut/1943/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1943/S.3.3/text> , <http://bauhaus/qualite/attribut/1943/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1943> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1810> {
    <http://bauhaus/qualite/attribut/1810/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les unit&eacute;s enqu&ecirc;t&eacute;es sont les h&eacute;bergements collectifs touristiques faisant l'objet d'une r&eacute;glementation.</p>\n<p>Il s'agit des auberges de jeunesse, des centres internationaux de s&eacute;jour, des centres sportifs, des r&eacute;sidences de tourisme et r&eacute;sidences h&ocirc;teli&egrave;res, des maisons familiales de vacances et des villages de vacances soit pr&egrave;s de 4&nbsp;000 unit&eacute;s.</p>\n<p>L'unit&eacute; &eacute;conomique interrog&eacute;e est l'exploitant de l'h&eacute;bergement (NAF r&eacute;v.&nbsp;2 : 55.10Z et 55.20Z).</p>\n<p>Les h&ocirc;tels et campings class&eacute;s sont observ&eacute;s dans le cadre des enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie homologu&eacute;e et h&ocirc;tellerie de plein air.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1810/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/rapport/1810>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête de fréquentation dans les autres hébergements collectifs touristiques 2013"@fr , "Quality report: Other Collective Tourist Accommodation Occupancy Survey 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1314> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1810/S.3.4/texte> , <http://bauhaus/qualite/attribut/1810/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1810/S.19/text> , <http://bauhaus/qualite/attribut/1810/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/documents/document/275>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-01-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/ENQ_FREQ_AUTRE_HEBERGEMENT_COLL_AHC_13.pdf> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon national d'environ 2 800 &eacute;tablissements.</p>\n<p>L'enqu&ecirc;te de fr&eacute;quentation dans les autres h&eacute;bergements collectifs touristiques compl&egrave;te les informations concernant la fr&eacute;quentation touristique d&eacute;j&agrave; produites par :</p>\n<p>- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie homologu&eacute;e ;</p>\n<p>- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie de plein air.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The units surveyed are collective tourist accommodation that is subject to regulation.</p>\n<p>This concerns youth hostels, international accommodation centres, sports centres, tourism and hotel residences, family holiday homes and holiday villages, amounting to nearly 4,000 units.</p>\n<p>The economic unit surveyed is the accommodation operator (NAF rev. 2: 55.10Z and 55.20Z).</p>\n<p>Classified hotels and campsites are observed in the context of occupancy surveys of approved hotels and campsites.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte des informations est effectu&eacute;e sur support papier et par voie postale.</p>\n<p>Les questionnaires sont envoy&eacute;s tout au long de l'ann&eacute;e vers le 25 du mois pr&eacute;c&eacute;dant le mois de collecte.</p>\n<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e par voie postale pour la plupart des &eacute;tablissements et de mani&egrave;re centralis&eacute;e aupr&egrave;s de quelques grandes&nbsp;enseignes (Lagrange, N&eacute;m&eacute;a &hellip;), qui font parvenir un fichier comportant les donn&eacute;es relatives &agrave; leurs &eacute;tablissements.</p>\n<p>Ces donn&eacute;es fournies font soit l'objet d'une mise &agrave; jour de masse (Lagrange) soit d'une saisie classique par les gestionnaires du site de collecte.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2015-11-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te de fr&eacute;quentation dans les autres h&eacute;bergements collectifs touristiques compl&egrave;te les informations concernant la fr&eacute;quentation touristique d&eacute;j&agrave; produites par :<br />- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie de tourisme ;<br />- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie de plein air.<br />Cette enqu&ecirc;te rentre dans le cadre du r&eacute;glement europ&eacute;en n&deg;692/2011 concernant la production d'informations statistiques sur le tourisme &agrave; Eurostat.<br />Elle r&eacute;pond &eacute;galement aux besoins nationaux de la Direction G&eacute;n&eacute;rale des Entreprises (DGE) et locaux pour les acteurs et d&eacute;cideurs r&eacute;gionaux du tourisme.<br />Le dispositif comporte deux extensions r&eacute;gionales dans les deux r&eacute;gions o&ugrave; existaient d&eacute;j&agrave; cette enqu&ecirc;te (Rh&ocirc;ne-Alpes, Languedoc-Roussillon).<br />Dans les DOM, les autres h&eacute;bergements collectifs sont enqu&ecirc;t&eacute;s dans l'enqu&ecirc;te de fr&eacute;quentation h&ocirc;teli&egrave;re.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/275> .
    
    <http://bauhaus/qualite/attribut/1810/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1810/I.18.10/text> , <http://bauhaus/qualite/attribut/1810/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data is collected on paper and by post.</p>\n<p>The questionnaires are sent out throughout the year towards the 25th of the month preceding the month of data collection.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The following topics are covered:</p>\n<p>- Daily occupancy of accommodation units (youth hostels, international accommodation centres, sports centres, tourism and hotel residences, family holiday homes and holiday villages)</p>\n<p>- Arrivals and nights according to the tourists' country of residence</p>\n<p>- Characteristics of the clientele (proportion of business tourism, individuals, families, holiday camps, groups, etc.).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The occupancy survey in other collective tourist accommodation supplements the tourist occupancy information already produced by:<br />- Occupancy surveys of tourist hotels<br />- Occupancy surveys of campsites<br />This survey relates to European reglement n&deg;692/2011 concerning the production of statistical information on tourism at EUROSTAT.<br />It also meets the French national needs of the Enterprise Directorate General&nbsp; and the local needs of regional tourism stakeholders and decision makers.<br />The scheme includes two regional extensions in the two regions already covered by this survey (Rh&ocirc;ne-Alpes, Languedoc-Roussillon).<br />In the overseas departments, other collective tourist accomodation are in the hotel occupancy survey.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s sont les suivants :</p>\n<p>- occupation quotidienne des unit&eacute;s d'h&eacute;bergement (auberges de jeunesse, centres internationaux de s&eacute;jour, centres sportifs, r&eacute;sidences de tourisme, r&eacute;sidences h&ocirc;teli&egrave;res, maisons familiales ou villages de vacances) ;</p>\n<p>- arriv&eacute;es et nuit&eacute;es selon le pays de r&eacute;sidence des touristes ;</p>\n<p>- profil de la client&egrave;le (proportion de tourisme d'affaires, d'individuel, de familles, de colonies, de groupes&hellip;).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted among a national sample of approximately 2,800 establishments."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1810/S.3.6/texte> , <http://bauhaus/qualite/attribut/1810/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1810/S.18.3/texte> , <http://bauhaus/qualite/attribut/1810/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1604> {
    <http://bauhaus/documents/document/403>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2014"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-07-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_CONJ_PROMO_IMMO_2014.pdf> .
    
    <http://bauhaus/qualite/attribut/1604/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e tous les trimestres (en janvier, avril, juillet et octobre, soit le mois suivant la fin de chaque trimestre).</p>\n<p>La collecte s'effectue par voie postale de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la fin du mois de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1604/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-06-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1604/S.19/text> , <http://bauhaus/qualite/attribut/1604/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre les secteurs définis par les codes NAF rév. 2 suivants : 4110A, 6820A."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1604/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
