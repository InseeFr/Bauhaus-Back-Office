                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1713/S.3.4/text> , <http://bauhaus/qualite/attribut/1713/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les agents de l&rsquo;&Eacute;tat en 2014&nbsp;: leurs profils, leurs carri&egrave;res (dossier de l&rsquo;Insee R&eacute;f&eacute;rences Emploi, ch&ocirc;mage, revenus du travail, &Eacute;dition 2018)<br /><a href=\"https://www.insee.fr/fr/statistiques/3573729?sommaire=3573876\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/fr/statistiques/3573729?sommaire=3573876</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1713/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/216> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey on government employees collects, on its field of interest, the individual characteristics of employees relating to:<br />- the training level;<br />- the career path before and after entering the civil service;<br />- the actual working time, taking account of days off of various types and other days not worked;<br />- the family situation, the household income and information on origins.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1713/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of the division</p>"@en , "<p>Chef de division</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1713/S.18.3/texte> , <http://bauhaus/qualite/attribut/1713/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.9>
                    "<p>2014</p>"@fr , "<p>2014</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sample includes approximately 33,000 randomly selected government employees in the Information system on public services.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1749> {
    <http://bauhaus/qualite/attribut/1749/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/132> .
    
    <http://bauhaus/qualite/attribut/1749/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "État civil : naissances, mariages et décès "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1749/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The municipalities that respond to the survey are:<br /><br />- Paris;<br /><br />- all the municipalities in departments 92 (Hauts-de-Seine), 93 (Seine-Saint-Denis) and 94 (Val-de-Marne);<br /><br />- 136 major metropolitan municipalities.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1749/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Relance téléphonique, télécopie et courriel auprès des non répondants."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1749/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les communes enqu&ecirc;t&eacute;es sont les suivantes :<br /><br />- Paris ;<br />- toutes les communes des d&eacute;partements 92 (Hauts-de-Seine), 93 (Seine-Saint-Denis) et 94 (Val-de-Marne) ;<br />- 136 grandes communes m&eacute;tropolitaines.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1749/S.10.6>
