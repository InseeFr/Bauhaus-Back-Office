    <http://bauhaus/qualite/attribut/1653/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Logements ordinaires et communaut&eacute;s.</p>\n<p>Les jeunes de 18 &agrave; 24 ans et leurs parents sont enqu&ecirc;t&eacute;s.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1653/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
