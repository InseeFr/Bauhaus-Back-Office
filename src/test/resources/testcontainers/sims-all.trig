                    <http://bauhaus/qualite/rapport/1975> .
    
    <http://bauhaus/qualite/attribut/1975/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-E401> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1975> .
    
    <http://bauhaus/qualite/attribut/1975/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection period will run from May 2021 to November 2021.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1975/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1975/S.18.3/text> , <http://bauhaus/qualite/attribut/1975/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1975> .
    
    <http://bauhaus/qualite/attribut/1975/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1975> .
    
    <http://bauhaus/qualite/attribut/1975/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The enterprises surveyed are enterprises established on French territory (metropolitan France and overseas departments including Mayotte), active on 31/12/2020 having had at least 6 months of activity, merchants, operators with 10 or more employees (in FTE).&nbsp; <br /><br />The companies belong to divisions 05 to 81 of the Statistical Classification of Economic Activities in the European Community (NACE rev.2, with the exception of 75: veterinary surgeons).&nbsp; Within Section K of NACE rev.2 (Divisions 64, 65 and 66), sections 5195, 6595 are excluded.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1975/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
