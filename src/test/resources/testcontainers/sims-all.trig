    <http://bauhaus/qualite/attribut/1895/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1895/I.18.7/texte> , <http://bauhaus/qualite/attribut/1895/I.18.7/text> ;
