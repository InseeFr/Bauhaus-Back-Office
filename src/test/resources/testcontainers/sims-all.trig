    <http://bauhaus/qualite/attribut/1727/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1727/S.19/texte> , <http://bauhaus/qualite/attribut/1727/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1727> .
    
    <http://bauhaus/qualite/attribut/1727/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A consultation committee comprising experts and representatives of the public policies concerned by information technology, communication and e-commerce issues (SdeS, SSP, DGE, CCIP, ARCEP, SGMAP, T&eacute;l&eacute;com Paris Tech, etc.) and representatives of professional organizations, or employee unions (FEVAD, Syntec Num&eacute;rique, Medef, CCIP, CGPME, CGT, FO ...) met to design the questionnaire together.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1727/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "01 87 69 61 70"@fr , "01 87 69 61 70"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1727> .
    
    <http://bauhaus/qualite/attribut/1727/S.17.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.1>
                    <http://bauhaus/qualite/attribut/1727/S.17.1/text> , <http://bauhaus/qualite/attribut/1727/S.17.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
