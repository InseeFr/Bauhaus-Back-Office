    <http://bauhaus/documents/document/971>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Housing price index"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Logement-neufs_m_en_septembre2018.pdf> .
    
    <http://bauhaus/qualite/attribut/1785/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices provisoires du trimestre T et les indices d&eacute;finitifs du trimestre T-1 sont publi&eacute;s le trimestre suivant dans la collection &laquo;&nbsp;Informations rapides&nbsp;&raquo;. Les s&eacute;ries d&rsquo;indices sont &eacute;galement consultables dans la rubrique &laquo;&nbsp;S&eacute;ries chronologiques &raquo; du site internet de l&rsquo;Insee.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1785/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1785/S.3.6/texte> , <http://bauhaus/qualite/attribut/1785/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1785> .
    
    <http://bauhaus/qualite/attribut/1785/S.8.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The housing price index is published quaterly approximately 3 months after the end of quarter.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1664> {
    <http://bauhaus/qualite/attribut/1664/S.3.6>
