    <http://bauhaus/qualite/attribut/1707/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/rapport/1707>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur la qualité de vie 2011"@fr , "Quality report: Survey on quality of life 2011 "@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1390> .
    
    <http://bauhaus/qualite/attribut/1707/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/227> .
    
    <http://bauhaus/documents/document/228>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête Qualité de vie 2011"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_QUEST_QUAL_VIE_2011.pdf> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample is drawn in the 2010 tax file. The sample size is 10,000 individuals. The stratification variables are: age, sex, rural or urban character of the commune of residence, whether or not the individual is attached to a principal residence and, if attached to a principal residence, the dwelling type and household composition. "@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1707/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1707/S.3.4/text> , <http://bauhaus/qualite/attribut/1707/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/documents/document/227>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Les préconisations du rapport Stiglitz-Sen-Fitoussi : quelques illustrations"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-07-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_QUAL_VIE_DOSSIER_PRECON_STIGLITZ.pdf> .
    
    <http://bauhaus/qualite/attribut/1707/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1707/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon est tiré dans le fichier d'imposition des personnes 2010 La taille de l'échantillon est de 10 000 individus. Les variables de stratification sont : l'âge, le sexe, le caractère rural ou urbain de la commune de résidence, le rattachement ou non de l'individu à une résidence principale et, s'il est rattaché à une résidence principale, le type d'immeuble et la composition du ménage."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Individus vivant dans des logements ordinaires (hors institutions) "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey comprises several modules covering several of the dimensions of quality of life, highlighted by the Stiglitz Commission, some of them not covered by public statistics:<br />- Living conditions, deprivations<br />- Quality of the environment and insecurity<br />- Job satisfaction<br />- Health<br />- Well-being in general<br />- Trust in society and in institutions </p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1707/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Unique survey carried out in the first half of 2011.<br />Bimodal survey: internet and postal surveys.<br />The questionnaire is self-administered via the Internet to 10,000 individuals 18 years of age or older, contacted by mail in May 2011. Non-respondents are contacted again , and receive a paper questionnaire to be returned by mail.<br />Metropolitan France for the 2011 survey. The overseas departments may be integrated if the experiment is conclusive and if the survey is renewed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te comprend plusieurs modules qui couvriront plusieurs dimensions de la qualit&eacute; de la vie, soulign&eacute;es par la Commission Stiglitz, pour certaines non couvertes par la statistique publique&nbsp;:<br />- conditions de vie, privations<br />- qualit&eacute; de l'environnement et ins&eacute;curit&eacute;<br />- satisfaction par rapport au travail<br />- sant&eacute;<br />- bien-&ecirc;tre en g&eacute;n&eacute;ral<br />- confiance dans la soci&eacute;t&eacute; et dans les institutions</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1707/I.18.10/texte> , <http://bauhaus/qualite/attribut/1707/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/228> .
    
    <http://bauhaus/qualite/attribut/1707/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-12-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enqu&ecirc;te unique r&eacute;alis&eacute;e au cours du premier semestre de 2011.<br />Enqu&ecirc;te bimode&nbsp;: internet et courrier.<br />Le questionnaire est auto-administr&eacute; par Internet aupr&egrave;s de 10 000 individus de 18 ans ou plus, contact&eacute;s par courrier en mai 2011. Les non-r&eacute;pondants par Internet sont relanc&eacute;s avec un questionnaire papier &agrave; retourner par la poste. <br />France m&eacute;tropolitaine pour l&rsquo;enqu&ecirc;te 2011. Les DOM pourront &ecirc;tre int&eacute;gr&eacute;s si l&rsquo;exp&eacute;rience est concluante et que l&rsquo;enqu&ecirc;te est renouvel&eacute;e.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1707/S.18.3/texte> , <http://bauhaus/qualite/attribut/1707/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1937> {
    <http://bauhaus/qualite/attribut/1937/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of Employment Division</p>"@en , "<p>Chef de la division Emploi</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The EVA system sample is the 2007 Education Panel one, containing 35 000 pupils who had entered the first year of secondary education in 2007 in public or private education institutions of France (except Mayotte).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1937/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1937/S.10.2/text> , <http://bauhaus/qualite/attribut/1937/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1937/I.18.10/text> , <http://bauhaus/qualite/attribut/1937/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1937/I.18.7/texte> , <http://bauhaus/qualite/attribut/1937/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Situation au 1er mars</p>"@fr , "<p>Situation on 1 March</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Chlo&eacute; Tavan</p>"@fr , "<p>Chlo&eacute; Tavan</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Lien vers la page EVA du site Insee.fr :</p>\n<p>&laquo; Une enqu&ecirc;te nationale sur &laquo; L&rsquo;entr&eacute;e dans la vie adulte &raquo; - Enqu&ecirc;te EVA &raquo;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1937/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The main themes of the questionnaire concern the situation of young people on the labour market (conditions of employment, trade practiced, unemployment, means used to get a job&hellip;) and their living conditions (resources, housing conditions, family situation&hellip;). The data collected can be enriched by merging with Depp education panel data (in particular, the &laquo; enqu&ecirc;tes Familles &raquo; surveys), and Sies data, which offer a detailed description of the education path (repetition, orientation choices, fields of education, family aspirations).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1937/S.10.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.1>
                    <http://bauhaus/qualite/attribut/1937/S.10.1/texte> , <http://bauhaus/qualite/attribut/1937/S.10.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte a lieu chaque ann&eacute;e, de mars &agrave; juillet. L&rsquo;enqu&ecirc;te EVA (Panel 2007) a d&eacute;but&eacute; en 2013 et se terminera en 2023.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1937/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e en multi-mode s&eacute;quentiel concurrentiel selon l&rsquo;ordre suivant :</p>\n<p>- mode Internet exclusivement en d&eacute;but d&rsquo;enqu&ecirc;te ;</p>\n<p>- puis mode Internet + mode papier (questionnaire transmis par voie postale) ;</p>\n<p>- puis mode Internet + mode papier + mode t&eacute;l&eacute;phone &agrave; partir de d&eacute;but mai.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1937/I.20/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Link to the EVA system page of the insee.fr website :</p>\n<p>Une enqu&ecirc;te nationale sur &laquo; L&rsquo;entr&eacute;e dans la vie adulte &raquo;Enqu&ecirc;te EVA</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1937/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F201> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1937> .
    
    <http://bauhaus/qualite/attribut/1937/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1937/S.3.1/text> , <http://bauhaus/qualite/attribut/1937/S.3.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
