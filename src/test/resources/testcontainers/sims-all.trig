                    "0187696367"@fr , "0187696367"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1785> .
    
    <http://bauhaus/qualite/attribut/1785/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1785/S.18.3/text> , <http://bauhaus/qualite/attribut/1785/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1785> .
    
    <http://bauhaus/qualite/attribut/1785/S.1.1>
