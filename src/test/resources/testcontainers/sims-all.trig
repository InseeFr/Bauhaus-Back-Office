                    <http://bauhaus/qualite/attribut/1728/S.12.1/text> , <http://bauhaus/qualite/attribut/1728/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/documents/document/170>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
