                    <http://bauhaus/qualite/rapport/1865> .
    
    <http://bauhaus/qualite/attribut/1865/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1865/I.18.10/texte> , <http://bauhaus/qualite/attribut/1865/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1865> .
    
    <http://bauhaus/qualite/attribut/1865/S.10.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quality sheet is described in accordance with the European standard of Single integrated metadata structure (SIMS).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1865/S.3.7>
