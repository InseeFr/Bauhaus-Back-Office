            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "L'enquête est réalisée auprès d'un échantillon national d'environ 12.000 hôtels sur un total de 18.000."@fr , "The survey is conducted on a national sample of about 12,000 hotels from 18,000."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
