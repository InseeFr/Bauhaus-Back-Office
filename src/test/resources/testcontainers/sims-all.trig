    <http://bauhaus/qualite/attribut/1926/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1926> .
    
    <http://bauhaus/qualite/attribut/1926/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les r&eacute;sultats sont publi&eacute;s mensuellement dans les Informations rapides sur insee.fr</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1926/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te est publi&eacute;e &agrave; la fin du mois durant lequel les chefs d&rsquo;entreprises ont &eacute;t&eacute; interrog&eacute;s.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1926/S.8.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.8.3>
                    "<p>The results are published monthly in &laquo;&nbsp;Informations Rapides&nbsp;&raquo; series.</p>"@en , "<p>Les r&eacute;sultats sont publi&eacute;s mensuellement dans les Informations rapides sur insee.fr.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
