<http://rdf.insee.fr/graphes/qualite/rapport/1793> {
    <http://bauhaus/qualite/attribut/1793/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1793/S.18.3/text> , <http://bauhaus/qualite/attribut/1793/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1793> .
    
    <http://bauhaus/qualite/attribut/1793/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices des prix d&rsquo;achat des moyens de production agricole sont des indices de Laspeyres &agrave; base fixe d&eacute;finie sur une p&eacute;riode de temps donn&eacute;e (i.e. les pond&eacute;rations sont inchang&eacute;es tout au long d&rsquo;une base). Ces coefficients sont issus des comptes semi-d&eacute;finitifs de l&rsquo;agriculture de 2015.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/55>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie des indices des prix agricoles"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-06-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IPAMPA_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1793/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
