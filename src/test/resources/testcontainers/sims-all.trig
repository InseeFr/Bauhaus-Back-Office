                    <http://bauhaus/qualite/attribut/1713/S.3.3/texte> , <http://bauhaus/qualite/attribut/1713/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/documents/document/216>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2015 de l'enquête auprès des salariés de l'État"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0014-01-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Quest_2015_FPE.pdf> .
    
    <http://bauhaus/qualite/attribut/1713/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-11-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All employees of the State civil service (ministries and public administrative services) except military members, irrespective of their status (official, contractual, vacant, paid trainee and other, including apprentices and assisted contractors), active at least one day during the year 2014.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te permettra, associ&eacute;e au syst&egrave;me d&rsquo;information sur les agents des services publics (SIASP), de compl&eacute;ter la couverture des secteurs d&rsquo;activit&eacute; non marchands des sections O et P de la NAF r&eacute;v.&nbsp;2 (administration&nbsp;publique et &eacute;ducation).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1713/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Fabien Guggemos</p>"@fr , "<p>Fabien Guggemos</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;ensemble des salari&eacute;s de la fonction publique d&rsquo;&Eacute;tat (minist&egrave;res et &eacute;tablissements publics administratifs) hors militaires, quel que soit leur statut (fonctionnaire, contractuel, vacataire, stagiaire r&eacute;mun&eacute;r&eacute; et autre y compris apprenti et en contrat aid&eacute;), actifs au moins un jour durant l&rsquo;ann&eacute;e 2014.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Since 2010</p>"@en , "<p>Depuis 2010</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1713/I.18.10/text> , <http://bauhaus/qualite/attribut/1713/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'&eacute;chantillon comporte environ 33&nbsp;000 agents de l&rsquo;&Eacute;tat s&eacute;lectionn&eacute;s al&eacute;atoirement dans le fichier du syst&egrave;me d&rsquo;information sur les agents des services publics (SIASP).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1713/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F240> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Collecte du 28 septembre au 14 d&eacute;cembre 2015.<br />Lancement du 28 septembre au 2 octobre 2015 par lettre-avis contenant l&rsquo;identifiant de connexion et le mot de passe.<br />1&deg; Relance du 27 octobre au 30 octobre 2015 par courrier contenant l&rsquo;identifiant de connexion et le mot de passe ainsi qu&rsquo;un questionnaire papier et une enveloppe T.<br />2&deg; Relance du 17 au 20 novembre 2015 par courrier contenant l&rsquo;identifiant de connexion et le mot de passe.<br />Fin de collecte&nbsp;: le 10 d&eacute;cembre 2015 pour les questionnaires papier et le 14 d&eacute;cembre 2015 pour la r&eacute;ponse par internet.<br />Un questionnaire papier est envoy&eacute; avec la 1&egrave;re relance (aux enqu&ecirc;t&eacute;s n&rsquo;ayant pas r&eacute;pondu avant le 22/10/2015).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Collection from September 28th to December 14th 2015.<br />Launch from September 28h to October 2nd 2015 by letter containing the login and the password.<br />1&deg; Relaunch from October 27th to October 30th 2015 by mail containing the login, the password, a paper questionnaire and a postage-paid envelope.<br />2&deg; Relaunch from November 17th to November 20th 2015 by mail containing the login and&nbsp;the password.<br />End of collection: December 10th 2015 for paper questionnaires and on 14th December 2015 for the Internet response.<br />A paper questionnaire is sent with the first dunning letter (to the respondents not having replied before 2015/10/22).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1713/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1713/S.10.2/texte> , <http://bauhaus/qualite/attribut/1713/S.10.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te aupr&egrave;s des salari&eacute;s de l&rsquo;&Eacute;tat recueille, sur son champ, les caract&eacute;ristiques individuelles des salari&eacute;s&nbsp;relatives&nbsp;: <br />- au niveau de formation,<br />- au parcours professionnel avant et apr&egrave;s l&rsquo;entr&eacute;e dans la Fonction publique,<br />- au volume de travail effectivement accompli, compte tenu des cong&eacute;s de divers types et des autres jours non travaill&eacute;s,<br />- &agrave; la situation familiale, au revenu du m&eacute;nage ainsi que des informations sur les origines.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1713/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-F201> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1713> .
    
    <http://bauhaus/qualite/attribut/1713/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Government officials in 2014: their profiles and careers (INSEE References Employment, unemployment and earned income, 2018 Edition)<br /><a href=\"https://www.insee.fr/en/statistiques/3579271?sommaire=3579287\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/en/statistiques/3579271?sommaire=3579287</a></p>"@en ;
