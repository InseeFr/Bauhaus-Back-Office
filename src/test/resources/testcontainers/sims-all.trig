            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Enqu&ecirc;te emploi&nbsp;: enqu&ecirc;te r&eacute;alis&eacute;e par l'Insee<br />- Demandeurs d'emploi en fin de mois (DEFM)&nbsp;: donn&eacute;es administratives produites par la Dares-P&ocirc;le emploi<br />- Estimations d'emploi&nbsp;: synth&egrave;se de sources administratives sur l'emploi r&eacute;alis&eacute;e par l&rsquo;Insee</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1801/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1801/S.10.6/texte> , <http://bauhaus/qualite/attribut/1801/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1801> .
    
