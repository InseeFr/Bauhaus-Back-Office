            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Questions cover employment, unemployment, training, social origin, situation one year before, and main situation on a monthly basis over the last twelve months."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1651/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1651/S.11.2/texte> ;
