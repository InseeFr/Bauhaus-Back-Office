            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Consumption items are described according to the Classification of Individual Consumption by Purpose (COICOP).</p>"@en ;
            <http://purl.org/dc/terms/language>
