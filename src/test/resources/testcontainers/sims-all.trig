                    <http://bauhaus/qualite/attribut/1863/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1863> .
    
    <http://bauhaus/qualite/attribut/1863/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
