            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>The reference period is mainly 2013 except for the characteristics referring to the previous accounting year (turnover, websales).</p>"@en , "<p>La p&eacute;riode de r&eacute;f&eacute;rence est 2013 pour la plupart des questions&nbsp;; le dernier exercice comptable (2012) pour le commerce &eacute;lectronique.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1733> .
    
