            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.13.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.13.1>
                    <http://bauhaus/qualite/attribut/1934/S.13.1/texte> , <http://bauhaus/qualite/attribut/1934/S.13.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Final data will be available in 2023, after revision, to take into account the final population estimate for 2019.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1120>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique EEC août 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0036-02-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/NoteMethodologique_EECAout2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1934/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1934/S.6.1/texte> , <http://bauhaus/qualite/attribut/1934/S.6.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F201> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.18.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.5>
                    <http://bauhaus/qualite/attribut/1934/S.18.5/text> , <http://bauhaus/qualite/attribut/1934/S.18.5/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data collection is conducted continuously, every week of the year. The interview is usually conducted in the 2 weeks and 2 days following the reference week.<br />Each dwelling is surveyed six consecutive quarters.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1934/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.4>
                    "personnes"@fr , "Persons"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Individus de 15 ans ou plus vivant en : <a href=\"https://www.insee.fr/fr/metadonnees/definition/c2056\" target=\"_blank\" rel=\"noopener noreferrer\">logement ordinaire</a>.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.18.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour la m&eacute;tropole, un calage sur marge est effectu&eacute; pour &agrave; la fois corriger de la non-r&eacute;ponse et contr&ocirc;ler les fluctuations d&rsquo;&eacute;chantillonnage. Les marges sont de niveau individuel (ventilation par sexe, &acirc;ge, r&eacute;gion) et de niveau logement (nombre de logements, type de logement, nombre de pi&egrave;ces, d&eacute;ciles de revenu du m&eacute;nage&hellip;.).<br />Pour les DOM, la correction se fait en 2 &eacute;tapes&nbsp;: un mod&egrave;le de non r&eacute;ponse, puis un calage sur marges (nombre et type de logements, dipl&ocirc;me, lieu de naissance&hellip;).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1121> .
    
    <http://bauhaus/qualite/attribut/1934/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling unit is dwelling. The sample is rotational: each cluster is surveyed 6 consecutive quarters, then replaced by a new cluster of the same sector.<br /><br />In Metropolitan France, the sample is currently being renewed. As of Q3 2019, each new cluster (1st wave&nbsp;: 1/6th of the sample) belongs to the new sample. This will ensure the gradual renewal of the sample. In the end, the sample from Metropolitan France will be completely renewed in Q4 2020. The sampling frame is the housing-tax register for the old sample and the demographic file of dwellings and individuals (&laquo;&nbsp;Fideli&nbsp;&raquo;) for the new sample.&nbsp; The sample selection is stratified by region. For each region, the sample is balanced, proportionnaly of the number of main residences, on some variables from the sampling frame.<br /><br />For DOM, the sampling is stratified (geographic strata) and systematic (with equal inclusion probabilities, within geographic strata). <br /><br />The sample is uniformely distributed among the 13 weeks of the quarter. Each cluster is affected to a reference week.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1934>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Labour force survey 2019"@en , "Rapport qualité : Enquête emploi en continu 2019"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1490> .
    
    <http://bauhaus/qualite/attribut/1934/S.13.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The unemployment rate in Metropolitan is estimated with a confidence interval at 95% of +- 0.3 pt.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1934/S.3.1/texte> , <http://bauhaus/qualite/attribut/1934/S.3.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The LFS is defined by the regulation n&deg;577/1998 of the Council of 9 march 1998. This text has been modified and amended. In particular, the regulation n&deg;1991/2002 imposed to have from 2003 a continuous survey, covering all the weeks of the year.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1934/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1934/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "0187696291"@fr , "0187696291"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-F001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un dossier p&eacute;dagogique sur le ch&ocirc;mage est disponible sur&nbsp;:<br /><a href=\"https://www.insee.fr/fr/information/2022025\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/fr/information/2022025 </a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te Emploi s&rsquo;inscrit dans un cadre europ&eacute;en, d&eacute;fini par le r&egrave;glement 577/1998 du Conseil du 9 mars 1998. Ce texte a &eacute;t&eacute; ponctuellement modifi&eacute; ou compl&eacute;t&eacute; par d'autres textes r&eacute;glementaires. Le plus important est le r&egrave;glement 1991/2002 qui fixe &agrave; 2003 la date limite pour la mise en oeuvre d&rsquo;une enqu&ecirc;te en continu, couvrant toutes les semaines de l&rsquo;ann&eacute;e.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The LFS questionnaire is structured around the following themes:<br />- a description of the household and its members;<br />- the status of an activity according to the ILO definition;<br />- a detailed description of the current main job (occupation, working time, kind of contract, income from work, etc.);<br />- the level of education and participation in training;<br />- the situation one year before the survey (place of residence, labour market situation, etc.);<br />- the receipt of benefits, including unemployment benefits and old-age pensions;<br />- social and geographical origin;<br />- health status;<br />- labour market trajectory over the past 12 months.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1934/S.3.6/texte> , <http://bauhaus/qualite/attribut/1934/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire de l&rsquo;enqu&ecirc;te Emploi est structur&eacute; autour des th&egrave;mes suivants&nbsp;:<br />- la description du m&eacute;nage et des personnes qui le composent&nbsp;;<br />- le statut d&rsquo;activit&eacute; au sens du BIT&nbsp;;<br />- la description de l&rsquo;emploi principal en cours (profession, dur&eacute;e du travail, type de contrat, revenus du travail&hellip;) ;<br />- le niveau d&rsquo;&eacute;tudes et la participation &agrave; des formations&nbsp;;<br />- la situation un an avant l&rsquo;enqu&ecirc;te (lieu de r&eacute;sidence, situation par rapport au march&eacute; du travail&hellip;)&nbsp;;<br />- la perception d&rsquo;allocations, parmi lesquelles les allocations ch&ocirc;mage&nbsp;et les retraites&nbsp;;<br />- l&rsquo;origine sociale et g&eacute;ographique&nbsp;;<br />- l&rsquo;&eacute;tat de sant&eacute;&nbsp;;<br />- la trajectoire sur le march&eacute; du travail au cours des 12 derniers mois.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1120> .
    
    <http://bauhaus/qualite/attribut/1934/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted continuously, every week of the year.</p>\n<p>Data is collected by computer-assisted data collection (CAPI). The interview is done face to face for the first and last waves and by phone for the intermediate waves. <br />If a person cannot respond (or does not want to), another person household can answer in their&nbsp; place (proxy).</p>\n<p>An annual specific survey is conducted in Mayotte.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1934/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont collect&eacute;es tout au long de l&rsquo;ann&eacute;e.</p>\n<p>La collecte est effectu&eacute;e sous collecte assist&eacute;e par informatique (Capi), en face-&agrave;-face pour la premi&egrave;re et la derni&egrave;re interrogations, et par t&eacute;l&eacute;phone pour les interrogations interm&eacute;diaires.<br />Si une personne ne peut (ou ne veut) pas r&eacute;pondre, une autre personne peut le faire &agrave; sa place (proxy).</p>\n<p>Une enqu&ecirc;te annuelle sp&eacute;cifique a lieu &agrave; Mayotte.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te permet de mesurer les concepts d&rsquo;activit&eacute;, d&rsquo;emploi et de ch&ocirc;mage conform&eacute;ment aux crit&egrave;res &eacute;tablis par le BIT. Elle comporte des questions permettant de d&eacute;crire l'emploi (statut, profession, temps de travail&hellip;.) selon des nomenclatures / d&eacute;finitions europ&eacute;ennes.<br />Elle mesure &eacute;galement les concepts de formation formelle et non formelle tels que d&eacute;finis par Eurostat.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1934/S.18.3/text> , <http://bauhaus/qualite/attribut/1934/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'&eacute;chantillon de l'enqu&ecirc;te Emploi est un &eacute;chantillon de logements, et non d'individus. Il pr&eacute;sente deux caract&eacute;ristiques principales&nbsp;: il est ar&eacute;olaire (constitu&eacute; d&rsquo;un tirage de groupes de logements proches) et rotatif (les logements entrants dans l&rsquo;&eacute;chantillon un trimestre donn&eacute; sont enqu&ecirc;t&eacute;s pendant six trimestres cons&eacute;cutifs). <br /><br />En France m&eacute;tropolitaine, l&rsquo;&eacute;chantillon de l&rsquo;EEC est en cours de renouvellement. &Agrave; partir du T3&nbsp;2019, les grappes entrantes (soit 1/6e de l&rsquo;&eacute;chantillon) sont issues de ce nouvel &eacute;chantillon. Ceci va assurer le renouvellement progressif de l&rsquo;&eacute;chantillon. Au final, l&rsquo;&eacute;chantillon de France m&eacute;tropolitaine sera compl&egrave;tement renouvel&eacute; au T4 2020. <br /><br />En France m&eacute;tropolitaine, la base de sondage de l&rsquo;enqu&ecirc;te Emploi est constitu&eacute;e&nbsp;:<br />- pour l&rsquo;ancien &eacute;chantillon, des fichiers de la taxe d&rsquo;habitation 2006&nbsp;;<br />- pour le nouvel &eacute;chantillon, du fichier d&eacute;mographique des logements et des individus 2016 (Fideli). <br /><br />En France m&eacute;tropolitaine, le tirage de l'&eacute;chantillon est stratifi&eacute; par r&eacute;gion. Au sein de chaque r&eacute;gion, le tirage des secteurs est fait de mani&egrave;re &laquo;&nbsp;&eacute;quilibr&eacute;e&nbsp;&raquo;, proportionnellement au nombre de r&eacute;sidences principales, selon des caract&eacute;ristiques de la base de sondage.<br /><br />Pour les DOM, il s&rsquo;agit d&rsquo;un &eacute;chantillonnage stratifi&eacute; (selon des zones g&eacute;ographiques) &agrave; un degr&eacute;, avec tirage syst&eacute;matique de logements &agrave; probabilit&eacute;s &eacute;gales au sein de chaque strate.</p>\n<p>L'&eacute;chantillon est uniform&eacute;ment r&eacute;parti sur les 13 semaines de chaque trimestre&nbsp;; chaque grappe est affect&eacute;e &agrave; une semaine &laquo;&nbsp;de r&eacute;f&eacute;rence&nbsp;&raquo;.<br /><br />Le taux de sondage moyen est de 1/400.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Individus"@fr , "Persons"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2018T006EC"@fr , "2018T006EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.13.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le taux de ch&ocirc;mage trimestriel en France m&eacute;tropolitaine est estim&eacute; avec un intervalle de confiance &agrave; 95&nbsp;% de &plusmn; 0,3 point.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.10.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.4>
                    <http://bauhaus/qualite/attribut/1934/S.10.4/texte> , <http://bauhaus/qualite/attribut/1934/S.10.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es d&eacute;finitives seront disponibles en 2023, apr&egrave;s r&eacute;vision, pour tenir compte de l&rsquo;estimation d&eacute;finitive de la population de 2019.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1934/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For Metropolitan France, a unique calibration is performed both to correct biases induced by non-response and to get consistency with external margins. The margins are individual characteristics (sex, age, NUTS2,&hellip;) and dwelling characteristics (number of dwellings, type of housing, income of the households,&hellip;).&nbsp; <br />For DOM, weights are first adjusted by using an estimation of response probabilities, and are next calibrated on external margins (number of dwellings, type of housing, diploma, place of birth&hellip;).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1934/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1934/I.20/text> , <http://bauhaus/qualite/attribut/1934/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/H> ;
