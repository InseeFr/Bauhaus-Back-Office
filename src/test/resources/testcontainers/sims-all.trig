            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.13.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le taux de ch&ocirc;mage annuel &agrave;&nbsp; Mayotte est estim&eacute; avec un intervalle de confiance &agrave; 95 % de &plusmn; 2 points.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es ont &eacute;t&eacute; r&eacute;vis&eacute;es apr&egrave;s le dernier recensement exhaustif de la population. Celui-ci a eu lieu en 2017, ainsi les donn&eacute;es 2013-2017 sont r&eacute;vis&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1956/S.3.4/texte> , <http://bauhaus/qualite/attribut/1956/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data collection is conducted from march to june. With some exceptions, the interview is usually conducted in the 2 weeks and 2 days following the reference week.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire est&nbsp; joint ci-dessous&nbsp;:</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1178> .
    
    <http://bauhaus/qualite/attribut/1956/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.18.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.5>
                    <http://bauhaus/qualite/attribut/1956/S.18.5/texte> , <http://bauhaus/qualite/attribut/1956/S.18.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est une base d&rsquo;adresses. Cette base d&rsquo;adresses est actualis&eacute;e via une enqu&ecirc;te cartographique r&eacute;alis&eacute;e chaque ann&eacute;e sur un cinqui&egrave;me du territoire. Les &icirc;lots mahorais ont &eacute;t&eacute; r&eacute;partis en 5 groupes de rotation &agrave; partir des donn&eacute;es du recensement de 2012. Ces groupes de rotation sont stratifi&eacute;s selon le groupement g&eacute;ographique de l&rsquo;ensemble des communes et ils sont &eacute;quilibr&eacute;s selon le nombre de logements. <br /><br />Le plan de sondage est stratifi&eacute; selon le type d&rsquo;adresse (mono-logements, petites adresses et grandes adresses). <br />Le tirage de l&rsquo;&eacute;chantillon est &eacute;quilibr&eacute; selon le type de b&acirc;ti (en dur ou autre), selon la localisation g&eacute;ographique et enfin selon une variable de classification des villages (celle-ci &eacute;tant bas&eacute;e sur des crit&egrave;res socio-&eacute;conomiques et d&eacute;mographiques).<br /><br />L&rsquo;&eacute;chantillon est rotatif. Il est renouvel&eacute; au tiers chaque ann&eacute;e. <br /><br />L'&eacute;chantillon est uniform&eacute;ment r&eacute;parti sur les 17 semaines de &laquo;&nbsp;r&eacute;f&eacute;rence&nbsp;&raquo;. <br /><br />Le taux de sondage moyen est de 1/66.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Chef de la division Emploi</p>"@fr , "<p>Head of Employment Section</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.13.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The unemployment rate in Mayotte is estimated with a confidence interval at 95&nbsp;% of &plusmn; 2 pt.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e entre mars et juin. Elle s&rsquo;effectue, sauf exception, dans les 2 semaines et 2 jours apr&egrave;s la fin de la semaine de r&eacute;f&eacute;rence.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1956>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête Emploi annuelle de Mayotte 2013"@fr , "Quality report: Labour force survey (LFS)  Mayotte 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1512> .
    
    <http://bauhaus/qualite/attribut/1956/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un fichier &agrave; destination des chercheurs est accessible par le r&eacute;seau Qu&eacute;telet&nbsp;:</p>\n<p><a href=\"https://quetelet.casd.eu/fr/utilisateur/connexion\">https://quetelet.casd.eu/fr/utilisateur/connexion</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data has been updated due to the new&nbsp; population census. This one occured in 2017, and data from 2013 to 2017 have been updated.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Le statut d&rsquo;activit&eacute; au sens du BIT est mesur&eacute; en r&eacute;f&eacute;rence &agrave; une semaine donn&eacute;e fixe, dite &laquo;&nbsp;semaine de r&eacute;f&eacute;rence&nbsp;&raquo;.</p>"@fr , "<p>The ILO status of activity is measured according to a fixed week, named reference week.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>See the link</p>\n<p><a href=\"https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology\">https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/S.13.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Taux de r&eacute;ponse&nbsp;: 86,0&nbsp;%</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Dossier ch&ocirc;mage</p>\n<p><a href=\"https://www.insee.fr/fr/information/2022025\">https://www.insee.fr/fr/information/2022025 </a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Chlo&eacute; Tavan</p>"@fr , "<p>Chlo&eacute; Tavan</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The LFS Mayotte questionnaire is structured around the following themes:<br />- a description of the household and its members;<br />- the status of an activity according to the ILO definition;<br />- a detailed description of the current main job (occupation, working time, kind of contract, etc.).<br />- the description of the employing institution<br />- The caracteristics of job search activities<br />- the level of education and participation in training;<br />- the situation one year before the survey (place of residence, labour market situation, etc.);<br />- the past and desired geographic mobility&nbsp;;<br />- casual activities&nbsp;;<br />- incomes.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>From March to July</p>"@en , "<p>De mars&nbsp; &agrave;&nbsp; juillet</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Individus de 15 ans ou plus vivant en logement ordinaire. <br />Lien vers d&eacute;finition</p>\n<p><a href=\"https://www.insee.fr/fr/metadonnees/definition/c2056\">https://www.insee.fr/fr/metadonnees/definition/c2056</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.2>
                    <http://bauhaus/qualite/attribut/1956/S.3.2/texte> , <http://bauhaus/qualite/attribut/1956/S.3.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey provides a measurement of activity, employment and unemployment according to the ILO definition. It provides a description of the job (status, occupation, working time&hellip;) according to european classifications / definitions.</p>\n<p><a href=\"https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology#EU-LFS_concept_of_labour_force_status\">https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology#EU-LFS_concept_of_labour_force_status</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1956/I.18.12/texte> , <http://bauhaus/qualite/attribut/1956/I.18.12/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1956/S.6.1/texte> , <http://bauhaus/qualite/attribut/1956/S.6.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F230> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te Emploi s&rsquo;inscrit dans un cadre europ&eacute;en, d&eacute;fini par le r&egrave;glement 577/1998 du Conseil du 9 mars 1998.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
