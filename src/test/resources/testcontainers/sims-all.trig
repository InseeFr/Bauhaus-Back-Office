            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1514/S.19/text> , <http://bauhaus/qualite/attribut/1514/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1514> .
    
    <http://bauhaus/qualite/rapport/1514>
