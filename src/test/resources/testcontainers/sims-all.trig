                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1507/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "Insee, 18 boulevard Adolphe Pinard, 75675 Paris cedex 14."@fr , "Insee, 18 boulevard Adolphe Pinard, 75675 Paris cedex 14."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1507> .
    
    <http://bauhaus/qualite/attribut/1507/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For employees:<br /><br />Estel uses the 'full format' Annual Declarations of Social Data (DADS)&nbsp;: stricto sensu DADS, complemented by information from the Public Service Employees Information System - SIASP - and data from private individual employers.<br /><br />For self-employed workers:<br /><br />The sources used are the files of the Agricultural Social Mutual Society (MSA) for self-employed agricultural workers and the files of the Central Agency of Social Security Organisations (ACOSS) for self-employed workers in sectors other than agriculture.<br /><br />The use of individual data allows direct processing of cases of multiple employment by counting each person solely for their main job.<br /><br />Annual localised employment estimates provide baseline levels of year-end for the quarterly localised employment estimates.<br /><br /></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1507/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1507/S.12.1/texte> , <http://bauhaus/qualite/attribut/1507/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1507> .
    
    <http://bauhaus/qualite/attribut/1507/S.15.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Time series consistency are ensured."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1507/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The level of employment takes account of people holding multiple jobs by selecting the person in his or her main job."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
