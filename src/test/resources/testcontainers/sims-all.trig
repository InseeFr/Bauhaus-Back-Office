            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/475> .
    
    <http://bauhaus/qualite/attribut/1558/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1558> .
    
    <http://bauhaus/qualite/attribut/1558/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La formulation des questions est conçue de manière à faciliter une réponse rapide (la plupart des questions sont qualitatives à trois modalités exprimées sous la forme \"favorable, défavorable ou neutre \" ou sous la forme \"très important, assez important ou pas important\"."@fr ;
            <http://purl.org/dc/terms/language>
