    <http://bauhaus/qualite/attribut/1955/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un fichier &agrave; destination des chercheurs est accessible par le r&eacute;seau Qu&eacute;telet&nbsp;:</p>\n<p><a href=\"https://quetelet.casd.eu/fr/utilisateur/connexion\">https://quetelet.casd.eu/fr/utilisateur/connexion</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1955/S.1.6>
