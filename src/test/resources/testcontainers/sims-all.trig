                    "2004-04-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/compet_en_trim_indus_G2004_01.pdf> .
    
    <http://bauhaus/qualite/rapport/1591>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly outlook survey in industry 2012"@en , "Rapport qualité : Enquête mensuelle de conjoncture dans l'industrie 2012"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1136> .
    
    <http://bauhaus/qualite/attribut/1591/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1591/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/qualite/attribut/1591/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in industry aims to transcribe the opinion of industrialists on their recent activity and business prospects.<br /><br />This opinion is tracked by monitoring production itself and related variables such as order books, foreign demand and inventory.<br /><br />The survey shows the activity trend in each of the industrial sectors covered, and also provides explanations of this trend, which is fundamental if we want to try to anticipate evolutions in the near future.<br /><br />The survey also aims to transcribe the opinion of entrepreneurs on demand for their products and their production capacities.<br /><br />This opinion is tracked by monitoring demand (past and forecasts, overall and foreign) and variables relating to production bottlenecks, changes in workforce, production capacities and prices.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1591/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1591/S.3.6/text> , <http://bauhaus/qualite/attribut/1591/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/qualite/attribut/1591/S.11.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1591/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Survey of a sample of 4,000 industrial enterprises with 20 employees or more</p>\n<p>All enterprises with at least 500 employees of turnover of &euro;150 million are surveyed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1591/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans l'industrie a pour objet de transcrire l'opinion des industriels sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.<br /><br />Cette opinion est retrac&eacute;e au moyen du suivi de la production elle-m&ecirc;me et de variables qui lui sont li&eacute;es, telles que les carnets de commandes, la demande &eacute;trang&egrave;re et les stocks.<br /><br />L'enqu&ecirc;te permet de conna&icirc;tre la tendance de l'activit&eacute; de chaque secteur industriel couvert, mais &eacute;galement les explications de cette tendance, ce qui est fondamental si on veut essayer d'en anticiper les &eacute;volutions dans un futur proche.<br /><br />L'enqu&ecirc;te vise aussi &agrave; transcrire l'opinion des chefs d'entreprise sur la demande qui leur est adress&eacute;e et sur leurs capacit&eacute;s de production.<br /><br />Cette opinion est retrac&eacute;e au moyen du suivi de la demande (pass&eacute;e et pr&eacute;vue, globale et &eacute;trang&egrave;re) et de variables portant sur les goulots de production, l'&eacute;volution des effectifs, les capacit&eacute;s de production, les prix.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1591/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1591/S.11.2/texte> , <http://bauhaus/qualite/attribut/1591/S.11.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1591/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers manufacturing industry and extraction industries; divisions 08 to 33 of NAF Rev. 2 (except 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z).<br />Industrial enterprise</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1591/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in industry is part of the harmonised European Union programme of business and consumer surveys to which the 27 Member States of the European Union contribute.</p>\n<p>As such, the questionnaires, classifications and processing methods are largely harmonised in the national institutes of the countries belonging to the system.</p>\n<p>The wording of the questions is designed in such a way as to facilitate quick answers (most of the questions are qualitative with three possible answers in the form \"up, down, same\", or \"higher than normal, normal, lower than normal\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1591/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1591/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/qualite/attribut/1591/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1591/S.19/text> , <http://bauhaus/qualite/attribut/1591/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/qualite/attribut/1591/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Jusqu'en 2007, l'enqu&ecirc;te avait lieu chaque mois sauf au mois d'ao&ucirc;t. Depuis 2008, elle a lieu tous les mois.</p>\n<p>La collecte s'effectue par voie postale et par internet sur une p&eacute;riode qui s'&eacute;tend de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la date de publication de l'enqu&ecirc;te, soit 4 jours ouvrables avant la fin du mois courant.</p>\n<p>Les r&eacute;sultats d'enqu&ecirc;te sont envoy&eacute;s &agrave; la Commission europ&eacute;enne 4 jours ouvrables avant la fin de mois.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/417>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Théorie de l'opinion : Faut-il pondérer les réponses individuelles ?"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2006-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/theorie_de_l_opinion2006.pdf> .
    
    <http://bauhaus/qualite/attribut/1591/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1591/S.3.4/text> , <http://bauhaus/qualite/attribut/1591/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/qualite/attribut/1591/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1591/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/documents/document/424>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2012"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Industrie_francais_2012.pdf> .
    
    <http://bauhaus/qualite/attribut/1591/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enqu&ecirc;te par sondage aupr&egrave;s de 4&nbsp;000 entreprises industrielles de 20 salari&eacute;s ou plus</p>\n<p>Les entreprises d'au moins 500 salari&eacute;s ou 150 millions d'euros de chiffre d'affaires sont interrog&eacute;es en totalit&eacute;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/431>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête trimestrielle de conjoncture dans l’industrie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-10-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_TRIM_INDUSTRIE_FR_2016.pdf> .
    
    <http://bauhaus/documents/page/50>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Insee Méthodes n° 117"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête de conjoncture sur la situation et les perspectives dans l'industrie : méthodologie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/7293> .
    
    <http://bauhaus/qualite/attribut/1591/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans l'industrie fait partie du syst&egrave;me europ&eacute;en harmonis&eacute; des enqu&ecirc;tes de conjoncture de la&nbsp;Commission europ&eacute;enne, auquel contribuent les vingt-sept &Eacute;tats membres de l'Union europ&eacute;enne.</p>\n<p>&Agrave; ce titre, les questionnaires, les nomenclatures et les m&eacute;thodes de traitement sont largement harmonis&eacute;s dans les instituts nationaux des pays adh&eacute;rant &agrave; ce syst&egrave;me.</p>\n<p>La formulation des questions est con&ccedil;ue de mani&egrave;re &agrave; faciliter une r&eacute;ponse rapide (la&nbsp;plupart des questions sont qualitatives &agrave; trois modalit&eacute;s exprim&eacute;es sous la forme \"hausse, baisse, stable\", ou \"sup&eacute;rieur &agrave; la normale, normal, inf&eacute;rieur &agrave; la normale\").</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1591/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/427> , <http://bauhaus/documents/document/431> , <http://bauhaus/documents/document/430> , <http://bauhaus/documents/document/428> , <http://bauhaus/documents/document/417> , <http://bauhaus/documents/document/444> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1917> {
    <http://bauhaus/qualite/attribut/1917/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Law n&deg; 51-711 of 7 June 1951 on obligations, co-ordination and confidentiality in respect of statistics. Available from https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573.<br /><br />Article 6 concerns statistical confidentiality: Subject to the provisions of Articles 40, 56, 76, 97 and 99 of the Code of Criminal Procedure and those of Article L. 213-3 of the French Heritage Code, the individual information contained in the questionnaires endorsed as provided for in Article 2 of this Law and relating to private and family life and, in general, to private acts and conduct can not, unless decided by the Archives Administration, after examining the opinion of the Statistical Confidentiality Committee and relating to a request made for the purposes of public statistics or scientific or historical research, be the subject of any communication by the depositary service before the expiry of a period of seventy-five years following the date of completion of the survey or a period of twenty-five years from the death of the person concerned, whichever is the shorter.<br />A Statistical Confidentiality Committee is set up. This committee is called upon to rule on any question relating to the confidentiality of statistics. It expresses its opinion on requests for the communication of individual data collected pursuant to this law. The committee is chaired by a State Councillor, appointed by the Vice-President of the Council of State. It includes in particular representatives of the French National Assembly and Senate. The composition and operating methods of the committee are set by decree of the Council of State. Recipients of the data communications resulting from Ministerial decisions made after consulting the Statistical Confidentiality Committee agree to not communicate these data to anyone. Any violation of the provisions of this paragraph is punishable by the penalties provided for in Article 226-13 of the Penal Code.<br /><br />Act no. 78-17 of 6 January 1978(amended), relating to information technology, files and civil freedoms.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ de l&rsquo;enqu&ecirc;te comprend les secteurs &eacute;conomiques marchands du commerce, des services marchands hors secteur financier, des industries agroalimentaires, des transports, de la construction et le secteur des exploitations foresti&egrave;res et des scieries (classe 02.20). S'y rajoute l'industrie, pour la partie collecte des &eacute;l&eacute;ments comptables relatifs aux entreprises profil&eacute;es d&rsquo;une part, et pour les DOM d&rsquo;autre part.</p>\n<p>Toutes les tailles d'entreprise sont dans le champ de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1917/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Ann&eacute;e civile</p>"@fr , "<p>Calendar year</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/documents/document/1042>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice Exploitations forestières et scieries"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_EFS.pdf> .
    
    <http://bauhaus/qualite/attribut/1917/S.18.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont contr&ocirc;l&eacute;es et valid&eacute;es par le service ESANE de Nantes et la division ESANE de la direction g&eacute;n&eacute;rale.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1917/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1917/S.19/texte> , <http://bauhaus/qualite/attribut/1917/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1917/S.3.1/texte> , <http://bauhaus/qualite/attribut/1917/S.3.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "0187696030"@fr , "0187696030"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.18.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.4>
                    <http://bauhaus/qualite/attribut/1917/S.18.4/text> , <http://bauhaus/qualite/attribut/1917/S.18.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes addressed in the survey are as follows:<br />-The business's principal activity;<br />-The events occurring during the accounting year (merger-absorption, full transfert of assets, partial transfer of assets, split off);<br />-The details of the restructuring (increases and decreases in fixed assets);<br />-Employment (non-employeed staff, temporary staff, staff leased to other companies, etc.);<br />-Breakdown of turnover by product or detailed activity;<br />-Professional expenses (non-stored purchases, incorporated sub-contracting, etc.);</p>\n<p>Sectoral characteristics such as:<br />- Breakdown of the turnover of the form of sales like company retail;<br />- Analysis of the customer base (breakdown of turnover by type of customer);<br />- Analysis of the providers retail;<br />- Other charges and external charges (general sub-contracting, rent and rental charges, maintenance expenses, etc.) for transport&nbsp;companies;<br />- Long-term assets, a for agri-food companies and agricultural cooperative;<br />- Work performed on existing or future buildings;<br />- Type of work performed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1034>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Commerce de détail (Questionnaire 2018)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Quest_ESA2018_com_detail.pdf> .
    
    <http://bauhaus/qualite/attribut/1917/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1917/S.3.6/texte> , <http://bauhaus/qualite/attribut/1917/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.7.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>In so far as concerns collection via the Internet, the Coltrane collection site is totally secure and the standards in terms of managing survey access codes are strict and standardized for all surveys. For enterprises that choose to use paper, the managers are responsible for the input, and must strictly respect the confidentiality of any data collected.<br />This confidentiality applies before any data is disseminated. For data relating to enterprises - no results are published that relates to less than three enterprises or establishments. Similarly, a result will only be disseminated if no enterprise or institution contributes more than 85% of this result. Primary suppressions correspond to boxes that do not meet the above criteria. Secondary confidentiality removes other boxes so that the data can not be retrieved by adding and subtracting with the margins of the tables. Statistical confidentiality is defined in law n&deg; 51-711 of 7 June 1951.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1041>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice Construction"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_construction.pdf> .
    
    <http://bauhaus/qualite/attribut/1917/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Comptabilit&eacute; nationale, SSM, chercheurs.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1917/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont publi&eacute;es &agrave; la rubrique Insee R&eacute;sultats sous insee.fr.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>More precisely, in terms of sectors of activity, the scope of the survey in metropolitan France includes the sectors of forestry and sawmills, agri-food industries, trade, construction, transport and other mainly market services (excluding the financial sector).<br />There is also a specific questionnaire for the French overseas departments, covering all these sectors, plus industry.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s dans l&rsquo;enqu&ecirc;te sont les suivants&nbsp;:<br />- l&rsquo;activit&eacute; principale de l&rsquo;entreprise&nbsp;;<br />-&nbsp;les &eacute;v&eacute;nements survenus pendant l&rsquo;exercice comptable (Fusion-Absorption, Transmission Universelle de Patrimoine, Apport partiel d&rsquo;actifs/Scission, &hellip;)&nbsp;;<br />- les d&eacute;tails de la restructuration (augmentation et diminution des immobilisations corporelles)&nbsp;;<br />- l&rsquo;emploi (personnel non salari&eacute;, personnel int&eacute;rimaire, personnel mis &agrave; disposition d&rsquo;autres soci&eacute;t&eacute;s, &hellip;)&nbsp;;<br />- la r&eacute;partition du chiffre d&rsquo;affaires par produit ou activit&eacute; d&eacute;taill&eacute;&nbsp;;<br />- les d&eacute;penses professionnelles (achats non stock&eacute;s, sous-traitance incorpor&eacute;e, etc.)&nbsp;;</p>\n<p>Des caract&eacute;ristiques sectorielles comme&nbsp;:<br />- la r&eacute;partition du chiffre d&rsquo;affaires selon les formes de vente pour les entreprises du commerce de d&eacute;tail&nbsp;;<br />- l&rsquo;&eacute;quipement commercial (nombre de points de vente, nombre de magasins&nbsp; par surface de vente) pour les entreprises du commerce&nbsp;;<br />- l&rsquo;analyse de la client&egrave;le (r&eacute;partition du chiffre d&rsquo;affaires par type de client&egrave;le) ;<br />- l&rsquo;analyse des fournisseurs pour les entreprises du commerce&nbsp;;<br />- les autres charges et charges externes (sous-traitance g&eacute;n&eacute;rale, loyers et charges locatives, d&eacute;penses d&rsquo;entretien, &hellip;) pour les entreprises de transport&nbsp;;<br />- les immobilisations pour les entreprises agro-alimentaires et les coop&eacute;ratives agricoles&nbsp;; <br />- les travaux r&eacute;alis&eacute;s sur des b&acirc;timents existants ou non ;<br />- la nature des ouvrages r&eacute;alis&eacute;s&nbsp;;<br />- la sous-traitance refactur&eacute;e pour les entreprises foresti&egrave;res et les entreprises de&nbsp; l&rsquo;industrie agro-alimentaire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1917/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is historically conducted by mail. It is possible to respond by internet since 2013, initially via a fillable PDF questionnaire, and then from the ESA 2018 collected in 2019, via an online questionnaire proposed by Coltrane, the internet-based data collection system developped by Insee.</p>\n<p>The annual data on the year N is collected in several waves between February and June of the year N+1&nbsp; in order to take account of businesses' different financial year end dates.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1917/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1917/S.18.3/text> , <http://bauhaus/qualite/attribut/1917/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.7.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant la collecte internet, le site de collecte est enti&egrave;rement s&eacute;curis&eacute; et les normes en termes de gestion des codes d&rsquo;acc&egrave;s &agrave; l&rsquo;enqu&ecirc;te sont strictes et standardis&eacute;es pour toutes les enqu&ecirc;tes entreprises. Pour les entreprises choisissant d&rsquo;utiliser le support papier, la saisie est assur&eacute;e par les gestionnaires, dans le strict respect de la confidentialit&eacute; des donn&eacute;es r&eacute;colt&eacute;es.<br />Avant la diffusion des donn&eacute;es le secret est appliqu&eacute;. Pour les donn&eacute;es relatives aux entreprises : on ne publie aucun r&eacute;sultat qui concerne moins de trois entreprises ou &eacute;tablissements. De m&ecirc;me, un r&eacute;sultat ne sera diffus&eacute; que si aucune entreprise ou &eacute;tablissement ne contribue &agrave; plus de 85 % de ce r&eacute;sultat. Les suppression primaire correspondent aux cases ne r&eacute;pondant pas au crit&egrave;re ci-dessus. Le secret secondaire supprime d'autres cases pour que les donn&eacute;es ne puissent pas &ecirc;tre retrouv&eacute;es par addition soustraction avec les marge des tableaux. Le secret statistique est d&eacute;fini dans la loi n&deg; 51-711 du 7 juin 1951.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/1033>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Services aux particuliers (Questionnaire 2018)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Quest_ESA2018_serv_part.pdf> .
    
    <http://bauhaus/documents/document/1046>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Lettre explicative Insee-DGFiP"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Lettre_cosignee_DGFIP-INSEE.pdf> .
    
    <http://bauhaus/qualite/attribut/1917/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data are published in the INSEE Results section and available at insee.fr.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1059>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Promotion immobilière (Questionnaire 2018)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Quest_ESA2018_prom_immo.pdf> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Enterprise"@en , "Entreprise"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2019A016EC"@fr , "2019A016EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1917> .
    
    <http://bauhaus/qualite/attribut/1917/S.18.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Une cha&icirc;ne de contr&ocirc;les et redressements automatiques sp&eacute;cifique a &eacute;t&eacute; mise en &oelig;uvre. Cette cha&icirc;ne assure en outre la coh&eacute;rence des donn&eacute;es de l'enqu&ecirc;te avec les donn&eacute;es fiscales de l'entreprise.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1917/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For the metrolopitan France, the scope of the survey covers the economic sectors of trade, market services excluding financial enterprises, the agri-food industries, building industry, transport, forestry and sawwmills (class 02.20). For the overseas departments, the survey covers in addition the extractive, manufacturing and energy industry. The survey also allows to collect accounting information for the profiled enterprises.</p>\n<p>All sizes of businesses are covered by the scope of the survey.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1917/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling design is a two-stage stratified clustered simple ramdom sampling, according to strata defined by the size classes crossed with the economic sectors. Above given size thresholds &ndash; thresholds on tunover and on number of employees &ndash;, which are variable according to the economic sector, the strata are take-all strata.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1917/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex</p>"@en ;
