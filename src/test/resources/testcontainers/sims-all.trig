<http://rdf.insee.fr/graphes/qualite/rapport/1843> {
    <http://bauhaus/documents/document/1142>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "S.18.5. Methodologie_dech_ind"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/S.18.5.Methodologie_dech_ind.pdf> .
    
    <http://bauhaus/qualite/attribut/1843/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1843/S.10.2/text> , <http://bauhaus/qualite/attribut/1843/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1843> .
    
    <http://bauhaus/qualite/attribut/1843/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1843/S.3.4/texte> , <http://bauhaus/qualite/attribut/1843/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1843> .
    
    <http://bauhaus/qualite/attribut/1843/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te fait l'objet d'une proc&eacute;dure d'archivage interne des bases de donn&eacute;es.<br />Les fichiers individuels sont mis &agrave; disposition des utilisateurs ext&eacute;rieurs &agrave; l&rsquo;Insee via le CASD, apr&egrave;s passage au Comit&eacute; du secret.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1843/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope of the survey corresponds to establishments: &nbsp;<br />- French (metropolitan France + DROM); <br />- operators ; <br />- having at least 4 months of activity in 2016; <br />- belonging to divisions 05 to 35 of NAF (R&eacute;v.2)<br />- with at least 10 employees.<br /><br />The survey covers the french establishments of 10 employees or more, with NAF code belonging to sections B, C, D and 4 month of activity in 2016.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1843/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1843> .
    
    <http://bauhaus/qualite/attribut/1843/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1843/I.18.7/texte> , <http://bauhaus/qualite/attribut/1843/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1843> .
    
    <http://bauhaus/qualite/attribut/1843/S.10.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>&nbsp;La fiche qualit&eacute; est d&eacute;crite selon la norme europ&eacute;enne du Single integrated metadata structure (SIMS).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1843/S.13.1>
