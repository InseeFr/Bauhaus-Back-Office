            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/attribut/1888/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/rapport/1888>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Indice de production dans les services base 2015"@fr , "Quality report: Services Production index base 2015"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1671> .
    
    <http://bauhaus/qualite/attribut/1888/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/attribut/1888/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1888/S.3.6/texte> , <http://bauhaus/qualite/attribut/1888/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/attribut/1888/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de production dans les services sont diffus&eacute;s mensuellement au plus tard 60 jours apr&egrave;s le mois sous revue.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1888/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The production indices in the services are calculated according to the nomenclature NAF rev. 2, which came into force on 1 January 2008. They cover the following sectors:<br />&bull; Transport and storage (Section H);<br />&bull; Accommodation and Catering (Section I);<br />&bull; Information and communication (Section J);<br />&bull; Real estate activities (Section L);<br />&bull; Specialized scientific and technical activities (Section M);<br />&bull; Administrative and support services (Section N);<br />&bull; Arts, Entertainment and Recreation (Section R);<br />&bull; Other service activities (Section S, Divisions 95 and 96 only).<br />Services Production index are constructed from a tax source, the \"CA3\" form, which must be completed by enterprises for the payment of value added tax (VAT) every month. These indexes cover &ldquo;whole France&rdquo; including overseas departments (excepted French Guyana and Mayotte, which are not liable for VAT). Price indices calculated by INSEE, mainly for &ldquo;whole France&rdquo; (including Overseas Departments) are used as deflators for indices in value.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1888/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 jours"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1888/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1888/S.18.1/texte> , <http://bauhaus/qualite/attribut/1888/S.18.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/documents/document/909>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indices de production dans les services base 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-03-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/IPS_methodo_20180330_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1888/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Calculation of indices in volume:<br />The production indices at a fine level are defined as the ratio of the turnover index in value to the associated price deflator. This is done for the 141 classes in the service sector. Once the indices at the finest level of nomenclature are calculated, the indices for higher levels are obtained by aggregating (cf infra). They are disseminated on the INSEE website from the class level. They are calculated since 2005, according to the availability of the prices.<br /><br />For most of sectors, the deflators used are production price indices in services (PPS). Production price indices in services are produced only quarterly (available at T + 60 days) and should be monthly. The date of availability of these indices is 60 days after the end of the quarter when the index of production is to be published 60 days after the end of the month. At this date, for some months, the quarterly price indices are not yet available. Prices must therefore be predicted.<br />Some sectors do not have a production price index for services. An imputation must then be used. Other sectors have been covered more recently, so a retropolation is necessary. The production prices of certain sectors are not collected; In these cases, a&nbsp;very close price index, the consumer price index (CPI), or a price index of production in another service appearing as a good proxy, are used.<br />For the R and S sectors, which are mainly services sectors for households, there is none production price index for services. The Consumer Price Index (CPI), which measures changes in the prices of goods and services consumed by households, is then used as a deflator. It is measured all taxes included, so it is necessary to correct the VAT rates to&nbsp;make it duty-free.<br />Aggregation method, rebasing and reference chance to 2015:<br />Services production indices are rebased every 5 years. From now on, they have reference year 2015, which means that they have for average 100 in 2015. Previously, indices had reference year 2010.<br />The 2015 rebasing implements an innovation, with the introduction of a two-weighting system (instead of a constant-weight system) in order to better take into account the structural evolutions. Until now, aggregation of elementary indices was done on the basis of constant weights representing the reference year &ndash; i.e. 2010 previously. From now on, 2010 weights are used for the aggregation of elementary indices between 1999 and 2012, whereas 2015 weights are used for the period after. The calculation on the whole period is then achieved by chaining both series (computation of a link coefficient on the year 2013). This change responds to a recommandation of Eurostat in order to increase the robustness of indices over a long period.<br />The estimation of annual weights is based primarily on the value added at basic prices per branch calculated by the annual national accounts. By definition, added value at basic prices excludes taxes on products but includes subsidies on products. It does not include transport services. At the lower levels of the classification, weights are also based on INSEE&rsquo;s Esane device (structural business statistics).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/910> .
    
    <http://bauhaus/qualite/attribut/1888/S.18.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Series are seasonally adjusted &ndash; SA &ndash; and working-days adjusted &ndash; WDA. The computation is performed with the X13-Arima program available in JDemetra+ - supplied by Eurostat &ndash; at the NAF rev. 2 class level for the volume ratio (i.e.&nbsp; the turnover index in value/ price index). Upper SWDA levels are obtained by class level series aggregation (indirect SWDA correction).<br />The annual mean of SWDA indices may slightly differ from that of the unadjusted indices, mainly because it takes into account the variations from one year to the next of the annual composition in working days &ndash; presence of leap year, position in the week of the various bank holidays, etc.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1888/S.18.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.6>
                    <http://bauhaus/qualite/attribut/1888/S.18.6/texte> , <http://bauhaus/qualite/attribut/1888/S.18.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/attribut/1888/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1888/S.14.1/text> , <http://bauhaus/qualite/attribut/1888/S.14.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/documents/document/910>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Services production index base 2015"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-03-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/IPS_methodo_20180330_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1888/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Chef de la division indicateurs conjoncturels d'activit&eacute;s (E320)</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/attribut/1888/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les d&eacute;clarations des entreprises ne sont pas toujours disponibles en totalit&eacute; au moment de la premi&egrave;re publication de l&rsquo;indice. L&rsquo;int&eacute;gration des r&eacute;ponses retardataires conduit &agrave; r&eacute;viser les donn&eacute;es brutes des valeurs comme celles de certains prix. Par ailleurs, les indices de prix de production &eacute;tant trimestriels, ils doivent &ecirc;tre estim&eacute;s pour le trimestre en cours et mensualis&eacute;s. La publication effective de ces indices peut entra&icirc;ner &eacute;galement quelques r&eacute;visions.<br />Enfin, le calcul des coefficients CVS-CJO est mis &agrave; jour chaque mois sur l&rsquo;ensemble de la p&eacute;riode de diffusion (depuis janvier 2005). Tous les mod&egrave;les CVS-CJO sont r&eacute;vis&eacute;s annuellement. Cette mise &agrave; jour est susceptible de modifier &eacute;galement l&rsquo;ensemble des s&eacute;ries CVS-CJO.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1888/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Calcul des indices de volume&nbsp;:<br />D'une mani&egrave;re g&eacute;n&eacute;rale, les indices de production dans les services sont obtenus &agrave; un niveau fin (pour les 141 classes du champ concern&eacute;) en d&eacute;flatant les indices en valeur par un indice de prix sp&eacute;cifique. Une fois les indices &eacute;tablis au niveau le plus fin de nomenclature, les indices des niveaux de nomenclature sup&eacute;rieurs sont calcul&eacute;s par agr&eacute;gation (cf.&nbsp;infra). Ils sont disponibles sur le site insee.fr en NAF r&eacute;v. 2, &agrave; partir du niveau classe. Les indices de production dans les services sont calcul&eacute;s depuis janvier 2005, compte tenu de la disponibilit&eacute; des donn&eacute;es sources.<br /><br />Pour l&rsquo;essentiel des secteurs, les d&eacute;flateurs utilis&eacute;s sont des indices de prix &agrave; la production dans les services (IPSE). Les indices de prix de production dans les services sont produits trimestriellement (disponibles &agrave; T+60 jours) et doivent donc &ecirc;tre mensualis&eacute;s&nbsp;; de plus la date de mise &agrave; disposition de ces indices est de 60 jours apr&egrave;s la fin du trimestre alors que l&rsquo;indice de production dans les services est publi&eacute; 60 jours apr&egrave;s la fin du mois. &Agrave; cette date, pour certains mois, les indices de prix trimestriels ne sont pas encore disponibles et il est alors n&eacute;cessaire de calculer une estimation en attendant la production effective de l&rsquo;indice de prix. <br />Il existe peu d'indices de prix &agrave; la production dans les services pour les secteurs R et S, qui regroupent des services principalement rendus aux m&eacute;nages. L&rsquo;indice des prix &agrave; la consommation (IPC) qui mesure l&rsquo;&eacute;volution des prix des biens et services consomm&eacute;s par les m&eacute;nages est alors utilis&eacute; comme d&eacute;flateur. Comme il est mesur&eacute; toutes taxes comprises, il est donc n&eacute;cessaire de le corriger de l'effet des changements de taux de TVA. <br />M&eacute;thode d&rsquo;agr&eacute;gation et base 2015&nbsp;:<br />Les indices de production dans les services changent de base et de r&eacute;f&eacute;rence tous les 5&nbsp;ans. Les indices d&eacute;sormais publi&eacute;s ont pour base et ann&eacute;e de r&eacute;f&eacute;rence 2015. Ils ont donc d&eacute;sormais pour moyenne 100 en 2015 (contre pr&eacute;c&eacute;demment 100 en 2010).<br />Le changement de base 2015 comporte une innovation avec la prise en compte de la d&eacute;formation des pond&eacute;rations entre 2010 et 2015, en lieu et place de pond&eacute;rations constantes sur l&rsquo;ensemble de la p&eacute;riode. Ainsi, jusqu&rsquo;&agrave; pr&eacute;sent, l&rsquo;agr&eacute;gation des indices &agrave; partir des indices &eacute;l&eacute;mentaires &eacute;tait effectu&eacute;e sur la base de pond&eacute;rations fixes repr&eacute;sentatives de l&rsquo;ann&eacute;e de r&eacute;f&eacute;rence (soit 2010 pr&eacute;c&eacute;demment). D&eacute;sormais, sur la p&eacute;riode 2005 &agrave; 2012, l&rsquo;agr&eacute;gation est r&eacute;alis&eacute;e en utilisant des pond&eacute;rations calcul&eacute;es sur l&rsquo;ann&eacute;e 2010. &Agrave; partir de 2013, elle s&rsquo;appuie sur des pond&eacute;rations calcul&eacute;es sur l&rsquo;ann&eacute;e 2015. La s&eacute;rie enti&egrave;re est ensuite obtenue par cha&icirc;nage (calcul d&rsquo;un coefficient de raccordement sur l&rsquo;ann&eacute;e 2013) des deux sous-s&eacute;ries. Cette &eacute;volution r&eacute;pond &agrave; une demande d&rsquo;Eurostat destin&eacute;e &agrave; am&eacute;liorer la robustesse des indicateurs sur longue p&eacute;riode.<br />Le calcul des pond&eacute;rations repose en premier lieu (jusqu&rsquo;au niveau A 129 de la nomenclature d&rsquo;activit&eacute;s) sur des donn&eacute;es des comptes nationaux, les valeurs ajout&eacute;es par branche aux prix de base. Par d&eacute;finition, les valeurs ajout&eacute;es aux prix de base excluent les imp&ocirc;ts sur les produits mais sont augment&eacute;es des subventions sur les produits&nbsp;; elles ne comprennent pas les prestations de transport. Aux niveaux de nomenclature plus fins, l&rsquo;estimation des pond&eacute;rations s&rsquo;appuie &eacute;galement sur les agr&eacute;gats de chiffre d&rsquo;affaires du dispositif Esane (&Eacute;laboration des Statistiques Annuelles d&rsquo;Entreprises).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/909> .
    
    <http://bauhaus/qualite/attribut/1888/S.3.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.9>
                    "<p>Year 2015</p>"@en , "<p>Ann&eacute;e 2015</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/attribut/1888/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>France enti&egrave;re (&agrave; l'exception de la Guyane et de Mayotte non assujettis &agrave; la TVA)</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1646> {
    <http://bauhaus/qualite/attribut/1646/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope includes the companies managing supermarkets, hypermarkets and/or multi-commerce stores.</p>\n<p>The survey covers the main activities defined by NAF rev. 2 codes: 47.11D, 47.11E and 47.11F.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/332>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le questionnaire de l'enquête"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-12-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_EMAGSA.pdf> .
    
    <http://bauhaus/qualite/attribut/1646/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1646/S.19/texte> , <http://bauhaus/qualite/attribut/1646/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Environ 7&nbsp;500 entreprises entrent dans le champ de l'enqu&ecirc;te (hypermarch&eacute;s, supermarch&eacute;s et magasins multi-commerces).</p>\n<p>L'&eacute;chantillon est d'environ 400 entreprises&nbsp;; il est exhaustif pour les entreprises ayant un chiffre d'affaires sup&eacute;rieur &agrave; 300&nbsp;millions d'euros TTC annuel. Dans les autres strates, un tirage coordonn&eacute; positivement avec les pr&eacute;c&eacute;dentes &eacute;ditions est mis en&nbsp;&oelig;uvre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1646/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e mensuellement par Internet &agrave; partir du Portail de R&eacute;ponse aux Enqu&ecirc;tes Entreprises : (http://entreprises.insee.fr/).</p>\n<p>L'ouverture de chaque campagne mensuelle a lieu quelques jours apr&egrave;s la fin du mois d'affaires enqu&ecirc;t&eacute;. Les entreprises ayant transmis une adresse &eacute;lectronique sont inform&eacute;es par courriel de l'ouverture de la campagne.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1646/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1646/I.18.10/text> , <http://bauhaus/qualite/attribut/1646/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/rapport/1646>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly survey of large-scale food retail activities 2011"@en , "Rapport qualité : Enquête mensuelle sur l'activité des grandes surfaces alimentaires 2011"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1179> .
    
    <http://bauhaus/qualite/attribut/1646/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/332> .
    
    <http://bauhaus/qualite/attribut/1646/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted monthly by Internet : (http://entreprises.insee.fr/).</p>\n<p>The opening of each monthly campaign takes place just days after the end of retail month investigated. Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1646/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te r&eacute;pond &agrave; une forte demande d'analyse conjoncturelle, au niveau du secteur d'activit&eacute; comme au niveau macro-&eacute;conomique&nbsp;(pr&eacute;occupations exprim&eacute;es par les membres de la Commission des Comptes Commerciaux de la Nation - CCCN).<br /><br />L'enqu&ecirc;te permet &eacute;galement de prendre en compte les fr&eacute;quentes restructurations et l'&eacute;volution d&eacute;mographique du secteur ; le d&eacute;tail par famille de produits permet &eacute;galement de d&eacute;gager un&nbsp;diagnostic conjoncturel.<br /><br />Enfin, l'enqu&ecirc;te permet surtout de disposer d'un r&eacute;sultat plus rapide que la mobilisation des sources fiscales : &agrave; cet &eacute;gard, l'enqu&ecirc;te Emagsa est un maillon indispensable pour &eacute;tablir l'indice pr&eacute;coce &agrave; 30 jours du volume des ventes dans le commerce de d&eacute;tail qui est requis par le r&egrave;glement europ&eacute;en.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1646/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s sont :<br /><br />- le chiffre d'affaires total TTC et sa ventilation par forme de vente (supermarch&eacute;s/hypermarch&eacute;s) ;<br /><br />- la r&eacute;partition des ventes par type de produits : alimentaires, non alimentaires, carburants ;<br /><br />- les modifications &eacute;ventuelles du parc de magasins : ouvertures, fermetures, modifications de surface.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1646/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes addressed are:<br /><br />- total turnover incl. VAT and breakdown per type of sale (supermarkets/hypermarkets);<br /><br />- breakdown of sales per product type: food, non-food, fuel;<br /><br />- any modifications to the stock of stores: openings, closures, modifications in floor area.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1646/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ concerne les entreprises qui g&egrave;rent des supermarch&eacute;s, des hypermarch&eacute;s et/ou des magasins multi-commerces.</p>\n<p>L'enqu&ecirc;te couvre les activit&eacute;s principales d&eacute;finies par les codes NAF r&eacute;v. 2 : 47.11D, 47.11E et 47.11F.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1646/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1646/S.3.6/texte> , <http://bauhaus/qualite/attribut/1646/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Approximately 7,500 companies are involved in the survey (hypermarkets, supermarkets and multi-commerce stores).</p>\n<p>The sample is about 400 companies; It is exhaustive for companies with a turnover of more than 300 million euros (inclusive of VAT). In the other strata, a draw coordinated positively with the previous editions is implemented.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1646/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey meets strong demand for outlook analysis at both sector and macro-economic level alike (preoccupations expressed by the members of the Commission for the Commercial Accounts of the Nation - CCCN).<br /><br />The survey also takes into account the frequent restructuring and demographic changes in the sector; The breakdown by family of&nbsp;products also makes it possible to establish a cyclical diagnosis.<br /><br />Finally, the survey provides a quicker result than the mobilization of tax sources: in this respect, the Emagsa survey is an indispensable link in establishing the early index at 30 days of the volume of sales in commerce Which is required by the European&nbsp;Regulation. </p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1646/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1646/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1646/S.18.3/texte> , <http://bauhaus/qualite/attribut/1646/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1646/S.3.4/text> , <http://bauhaus/qualite/attribut/1646/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
    
    <http://bauhaus/qualite/attribut/1646/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1646> .
}

