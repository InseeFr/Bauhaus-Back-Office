            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Presentation of the Agricultural means of production purchasing price index (IPAMPA base 2000)"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IPAMPA_2000_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1793/S.17.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.2>
                    <http://bauhaus/qualite/attribut/1793/S.17.2/texte> , <http://bauhaus/qualite/attribut/1793/S.17.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1793> .
    
    <http://bauhaus/qualite/attribut/1793/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
