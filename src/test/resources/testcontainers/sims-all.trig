                    <http://bauhaus/qualite/attribut/1628/S.3.2/text> , <http://bauhaus/qualite/attribut/1628/S.3.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1628> .
    
    <http://bauhaus/qualite/attribut/1628/S.13.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The out-of-scope share in the sample is 2.1%.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1628/S.13.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
