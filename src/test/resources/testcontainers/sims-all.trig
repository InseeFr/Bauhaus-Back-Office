                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/notice_explicative_AHCT_2015.pdf> .
    
