                    <http://bauhaus/qualite/attribut/1949/I.20/texte> , <http://bauhaus/qualite/attribut/1949/I.20/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1949> .
    
    <http://bauhaus/qualite/attribut/1949/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
