                    <http://bauhaus/qualite/rapport/1966> .
    
    <http://bauhaus/qualite/attribut/1966/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1966> .
    
    <http://bauhaus/qualite/attribut/1966/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1966/S.14.1/texte> , <http://bauhaus/qualite/attribut/1966/S.14.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1966> .
    
    <http://bauhaus/qualite/attribut/1966/S.3.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les entreprises fournisseurs de la D&eacute;fense sont &eacute;tudi&eacute;es selon leur cat&eacute;gorie Insee : microentreprises (micro), petites et moyennes entreprises (PME), entreprises de taille interm&eacute;diaire (ETI), grandes entreprises (GE).</p>\n<p><a href=\"https://www.insee.fr/fr/metadonnees/definition/c1057\">https://www.insee.fr/fr/metadonnees/definition/c1057</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1966/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1966/S.3.1/text> , <http://bauhaus/qualite/attribut/1966/S.3.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1966> .
    
    <http://bauhaus/qualite/attribut/1966/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "+33988681386"@en , "0988681386"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1966> .
    
    <http://bauhaus/qualite/attribut/1966/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/oed> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1966> .
    
    <http://bauhaus/qualite/attribut/1966/S.11.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.1>
                    <http://bauhaus/qualite/attribut/1966/S.11.1/texte> , <http://bauhaus/qualite/attribut/1966/S.11.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1966> .
    
    <http://bauhaus/qualite/attribut/1966/S.3.6>
