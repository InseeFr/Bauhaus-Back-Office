            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1801/S.12.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Besoin d'informations sur l'évolution du marché du travail, en particulier sur le chômage, à destination du grand public, des médias, des acteurs publics régionaux, etc."@fr ;
            <http://purl.org/dc/terms/language>
