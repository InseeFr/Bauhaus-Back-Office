                    <http://bauhaus/qualite/attribut/1739/I.18.7/texte> , <http://bauhaus/qualite/attribut/1739/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1739/S.3.4/texte> , <http://bauhaus/qualite/attribut/1739/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ couvre les entreprises-unit&eacute;s l&eacute;gales de 10 salari&eacute;s ou plus appartenant aux secteurs suivants de la NAF r&eacute;v. 1 : l'industrie et les industries agroalimentaires (section D), le secteur de l'&eacute;nergie (section E), la construction (section F), le commerce (section G), les h&ocirc;tels et restaurants (section H), les transports et communications (section I), les services financiers (section J partielle), l'immobilier, la location et les services aux entreprises (section K) et le secteur de l'audiovisuel (groupes 92.1 et 92.2 en NAF r&eacute;v. 1).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1739/I.18.10/text> , <http://bauhaus/qualite/attribut/1739/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/documents/document/142>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2006"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2009-02-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Fiche_qualite_TIC.pdf> .
    
    <http://bauhaus/documents/document/946>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2006 de l'Enquête sur les changements organisationnels et technologies de l'information et de la communication (auprès des entreprises) / TIC-COI"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/tic06_quest2006.pdf> .
    
    <http://bauhaus/qualite/attribut/1739/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>La p&eacute;riode de r&eacute;f&eacute;rence est 2006 pour la plupart des questions&nbsp;; le dernier exercice comptable (2005) pour le commerce &eacute;lectronique.</p>"@fr , "<p>The reference period is mainly 2006 except for the characteristics referring to the previous accounting year (turnover, websales).</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The topics covered are: the development of new technologies and the intensity of their use in business; the types of use of ICT&nbsp;(electronic commerce, sharing and exchanging of information and, more generally, relations with the world outside the business); the obstacles and impacts of this dissemination&nbsp;; the organizational changes it involves.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1739/S.19/text> , <http://bauhaus/qualite/attribut/1739/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1739/S.3.3/texte> , <http://bauhaus/qualite/attribut/1739/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-01-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1739/S.18.3/texte> , <http://bauhaus/qualite/attribut/1739/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/946> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope covers businesses with 10 employees or more belonging to the following sectors of NACE rev. 1: industry and the agri-food industries (section D), the energy sector (section E), the building industry&nbsp;(section F), trade (section G), hotels and restaurants (section H), transport and communications (section I), financial services (section J partial), real-estate, leasing and services to businesses (section K) and the audiovisual sector (groups 92.1 and 92.2 in NAF rev. 1).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection, conducted by mail, is launched in the first quarter of the year in question.<br />The survey covers the whole of France (geography at the time of collection).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1739>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on organizational changes and information and communication technologies in business 2006"@en , "Rapport qualité : Enquête sur les changements organisationnels et technologies de l'information et de la communication dans les entreprises 2006"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1313> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sample is drawn from the annual enterprises surveys files 2004 (EAE), except for the enterprises belonging to financial sectors and the division 73, taken from the SIRENE register.<br /><br />The sample is stratified by business sector and by size.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s sont : le d&eacute;veloppement des nouvelles technologies et l'intensit&eacute; de leur utilisation au sein de l'entreprise ; les types d'utilisation des TIC (commerce &eacute;lectronique, partage et &eacute;change d'information, plus g&eacute;n&eacute;ralement les relations avec le monde externe &agrave; l'entreprise) ; les obstacles et l'impact de cette diffusion&nbsp;; les changements organisationnels qui en d&eacute;coulent.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;&eacute;chantillon est tir&eacute; dans les fichiers d&rsquo;entreprises des enqu&ecirc;tes annuelles d&rsquo;entreprises 2004 (EAE), &agrave; l&rsquo;exception des unit&eacute;s appartenants aux secteurs financiers ou &agrave; la division 73, tir&eacute;s dans le r&eacute;pertoire Sirene.<br /><br />L'&eacute;chantillon est stratifi&eacute; par secteur d'activit&eacute; et par taille.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te communautaire sur \" l'utilisation des TIC et le commerce &eacute;lectronique \" dans les entreprises est un ensemble d'enqu&ecirc;tes r&eacute;alis&eacute;es par les instituts nationaux de la statistique des pays membres de l'union europ&eacute;enne.<br /><br />Elle s'inscrit dans le r&egrave;glement n&deg; 808/2004 adopt&eacute; en date du 21 avril 2004 dans le cadre de la mise en &oelig;uvre du plan d'action&nbsp;eEurope 2005 consacr&eacute; aux technologies de l'information et de la communication, r&egrave;glement amend&eacute; par le r&egrave;glement europ&eacute;en n&deg; 1006/2009 du 16 septembre 2009. Dans ce cadre, les enqu&ecirc;tes sur les TIC et le commerce &eacute;lectronique dans les entreprises r&eacute;alis&eacute;es par les pays de l'Union europ&eacute;enne suivent une m&eacute;thodologie commune et un m&ecirc;me mod&egrave;le de questionnaire.<br /><br />Chaque ann&eacute;e, un ou plusieurs th&egrave;mes, d&eacute;termin&eacute;s par le r&egrave;glement europ&eacute;en annuel d'application du r&egrave;glement cadre, fait l'objet d'un d&eacute;veloppement particulier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte, effectu&eacute;e par voie postale, est lanc&eacute;e au premier trimestre de l'ann&eacute;e consid&eacute;r&eacute;e.<br />L'enqu&ecirc;te couvre la France enti&egrave;re (g&eacute;ographie &agrave; la date de la collecte).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The EC survey on the \"use of ICT and electronic commerce\" in business is a set of surveys conducted by the national institutes of statistics of the member countries of the European Union.<br /><br />It complies with regulation n&deg;808/2004 adopted on April 21, 2004&nbsp;as part of the implementation of the 2005 eEurope action plan devoted to information and communication technologies: this regulation was amended by European regulation n&deg; 1006/2009 of September 16, 2009. Accordingly, the surveys on ICT and electronic commerce in business conducted by the countries of the European Union follow a common methodology and the same model of questionnaire.<br /><br />Each year, one or more topics, determined by the annual European regulation for&nbsp;the implementation of the framework regulation, are developed in particular.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1739/S.3.6/texte> , <http://bauhaus/qualite/attribut/1739/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1739/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
