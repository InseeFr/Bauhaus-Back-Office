}

<http://rdf.insee.fr/graphes/qualite/rapport/1618> {
    <http://bauhaus/qualite/attribut/1618/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
