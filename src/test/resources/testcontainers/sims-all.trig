                    <http://bauhaus/documents/document/405> .
    
    <http://bauhaus/qualite/attribut/1610/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1610/S.3.6/texte> , <http://bauhaus/qualite/attribut/1610/S.3.6/text> ;
