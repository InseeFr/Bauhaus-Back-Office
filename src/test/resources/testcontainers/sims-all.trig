    <http://bauhaus/qualite/attribut/1877/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted monthly by Internet : (http://entreprises.insee.fr/).</p>\n<p><br />Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
