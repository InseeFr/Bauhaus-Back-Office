    <http://bauhaus/documents/page/66>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Insee Méthodes n° 123"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête de conjoncture dans l'artisanat du bâtiment : méthodologie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/7268> .
    
    <http://bauhaus/qualite/attribut/1559/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1559/S.3.6/text> , <http://bauhaus/qualite/attribut/1559/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1559> .
    
    <http://bauhaus/qualite/attribut/1559/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quarterly outlook survey in the building trades is conducted among craftspeople working in the construction of individual homes and various buildings, general masonry work, wood framing and roofing, and installation and finishing.</p>\n<p>More precisely, the survey covers the sectors defined by the following NAF Rev.2 codes: 41.2, 43.2, 43.3, 43.9.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1668> {
    <http://bauhaus/qualite/attribut/1668/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-02-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection takes place by post, with the possibility to respond through an e-mailed, mailed or faxed questionnaire from April to June of the given year.<br />The questionnaire is different depending on whether the company is mono -regional and mono- institution, mono -regional multi-establishment or multi-regional.<br />The geographical reference area is the Large Southwest of France (departments 09, 12, 24, 31, 32, 33, 33, 40, 46, 47, 64, 65, 81, 82).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1668/I.18.7/text> , <http://bauhaus/qualite/attribut/1668/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1668/I.18.10/text> , <http://bauhaus/qualite/attribut/1668/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/284> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The following topics are covered:<br />- Relations with the aeronautics and space industry (function, range, customers)<br />- Outlook (order book, recruitments)<br />- Human resources (managers, temporary staff)<br />- Relation to innovation, certification, quality</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes suivants sont abord&eacute;s&nbsp;:<br />- relations avec la fili&egrave;re AS (fonction, rang, clients)<br />- perspectives (carnet de commande, recrutements)<br />- ressources humaines (cadres, int&eacute;rim)<br />- rapport &agrave; l'innovation, la certification, la qualit&eacute;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is comprehensive for the field of the aerospace industry's \"core\" (3030Z, 5122Z), \"partial\" sectors'sunits (2051Z, 2562B, 2651A, 3316Z), units of more than 20 employees in  \"potential \" sector (40 NAF classes of activity). The survey asks survey units with fewer than 20 employees belonging to the 'potential'sectors. Specific units known as belonging to a priori the sector are also interviewed."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le périmètre conventionnel de la filière aéronautique et spatiale est défini par les unités des secteurs du « noyau » de la filière AS (3030Z, 5122Z), les unités des secteurs « partiel » (2051Z, 2562B, 2651A, 3316Z), et les unités des secteurs « potentiel » (40 classes d'activités NAF)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1668/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/documents/document/284>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur la filière Aéronautique et Spatiale dans le Grand Sud-Ouest 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_AERONAUTIQUE_ESPACE_FOURNISSEURS_QUEST_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1668/S.3.6/text> , <http://bauhaus/qualite/attribut/1668/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1668/S.18.3/texte> , <http://bauhaus/qualite/attribut/1668/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/rapport/1668>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on aerospace and space sector of the large Southwest region 2015"@en , "Rapport qualité : Enquête sur la filière aéronautique et spatiale dans le grand Sud-Ouest 2015"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1425> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Conventional perimeter of the aerospace industry is defined by the aeronautics and space industry's \"core\" units (3030Z, 5122Z), by the \"partial\" sectors units (2051Z, 2562B, 2651A, 3316Z), and the \"potential\" areas units (40 classes of activity NAF)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection takes from April to June of the given year.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1668/S.3.4/text> , <http://bauhaus/qualite/attribut/1668/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1668/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte se d&eacute;roule d'avril &agrave; juin de l'ann&eacute;e. </p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1668/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte se d&eacute;roule par voie postale, avec possibilit&eacute; de r&eacute;pondre au moyen d&rsquo;un questionnaire par mail, courrier ou fax, d&rsquo;avril &agrave; juin de l&rsquo;ann&eacute;e.<br />Le questionnaire est diff&eacute;rent selon que l&rsquo;entreprise est mono-r&eacute;gionale mono-&eacute;tablissement, mono-r&eacute;gionale multi-&eacute;tablissement ou multir&eacute;gionale.<br />La zone g&eacute;ographique de r&eacute;f&eacute;rence est le grand Sud-Ouest (d&eacute;partements 09, 12, 24, 31, 32, 33, 40, 46, 47, 64, 65, 81, 82).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est exhaustive sur le champ du « noyau » de la filière AS (3030Z, 5122Z), des unités des secteurs « partiel » (2051Z, 2562B, 2651A, 3316Z), des unités de plus de 20 salariés appartenant aux secteurs « potentiel » (40 classes d'activités NAF). L'enquête interroge par sondage les unités de moins de 20 salariés appartenant au secteurs « potentiel ». Des unités spécifiques connues comme appartenant à priori à la filière sont également interrogées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1898> {
    <http://bauhaus/qualite/rapport/1898>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Outdoor accommodation occupancy survey 2017"@en , "Rapport qualité : Enquête de fréquentation dans l'hôtellerie de plein air 2017"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1456> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/952> , <http://bauhaus/documents/document/953> .
    
    <http://bauhaus/qualite/attribut/1898/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e d&rsquo;avril &agrave; septembre par voie postale ou par internet, ainsi qu'une collecte centralis&eacute;e aupr&egrave;s de certaines enseignes.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers the activities defined by the NAF rev. 2 code: 55.30Z (campsites and areas for caravans or leisure vehicles). Only residentials campsites are not surveyed.<br /><br />Type of unit surveyed&nbsp;: campsite, classified from 1 to 5 stars or non-classified site offering at least one short-stay pitch.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1898/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1898/S.3.4/text> , <http://bauhaus/qualite/attribut/1898/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1898/S.19/texte> , <http://bauhaus/qualite/attribut/1898/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017M031EC"@fr , "2017M031EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>A compter de la saison 2013, l&rsquo;enqu&ecirc;te n&rsquo;est plus exhaustive : elle est r&eacute;alis&eacute;e aupr&egrave;s d&rsquo;un &eacute;chantillon de 6 000 campings sur 8 000.</p>"@fr , "<p>From the 2013 season, the survey is no longer exhaustive: it is carried out with a sample of 6,000 campsites from 8,000.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un emplacement, consid&eacute;r&eacute; comme locatif, dispose d'un &eacute;quipement d'h&eacute;bergement de type bungalow, bungatoile, mobil-home, habitation l&eacute;g&egrave;re de loisir (HLL)&hellip;</p>\n<p>Les &eacute;ventuels emplacements pr&eacute;vus pour le stationnement des camping-cars sont consid&eacute;r&eacute;s comme des emplacements nus.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The Comit&eacute; de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry&nbsp;: DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D). <br />The needs of local partners are taken into account through partnership agreements with the tourism sites of Insee.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2018-07-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1898/I.18.10/texte> , <http://bauhaus/qualite/attribut/1898/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is carried out from April to September by post or by internet, and centralized collection at some enterprises.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1898/S.18.3/text> , <http://bauhaus/qualite/attribut/1898/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey concerns the occupancy in the five summer months, from May to September: the stock is measured on 30 November of each year.It covers the following topics:<br />- Characteristics of the site<br />- Opening period<br />- Accommodation capacity (bare pitches and pitches with rental accommodation)<br />- Occupancy of pitches (bare and with rental accommodation)<br />- Monthly occupancy (in terms of the numbers of arrivals and nights) according to the type of pitch (bare and with rental accommodation) and the customers' normal country of residence.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te porte sur la fr&eacute;quentation des cinq mois d'&eacute;t&eacute;, de mai &agrave; septembre : le parc est mesur&eacute; chaque ann&eacute;e au 30 novembre.<br />Elle aborde les th&egrave;mes suivants :<br />- caract&eacute;ristiques du terrain ;<br />- p&eacute;riode d'ouverture ;<br />- capacit&eacute; d'accueil (emplacements nus et emplacements locatifs) ;<br />- occupation des emplacements (nus et locatifs) ;<br />- fr&eacute;quentation mensuelle (en termes de nombre d'arriv&eacute;es et de nuit&eacute;es) selon le type d'emplacements (nus et locatifs) et le pays de r&eacute;sidence habituelle des clients.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A pitch that is considered to have rental accommodation is equipped with a bungalow, \"Bungatent\", mobile home, leisure home, etc.</p>\n<p>Any pitches that may be reserved for campervans are considered to be bare pitches.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1898/S.12.1/text> , <http://bauhaus/qualite/attribut/1898/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par le code NAF r&eacute;v. 2 : 55.30Z (terrains de camping et parcs pour caravanes ou v&eacute;hicules de loisirs). Sont exclus les campings &agrave; vocation exclusivement r&eacute;sidentielle.</p>\n<p>Type d'unit&eacute; enqu&ecirc;t&eacute;e&nbsp;: terrain de camping, class&eacute; de 1 &agrave; 5 &eacute;toiles ou terrain non class&eacute; offrant au moins un emplacement de passage.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/documents/document/953>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête de fréquentation dans l'hôtellerie de plein air 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_camping_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1898/S.3.6/texte> , <http://bauhaus/qualite/attribut/1898/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le Comit&eacute; de Coordination des Statistiques du Tourisme (CCST), anim&eacute; par l'Insee, int&egrave;gre les principaux acteurs nationaux du tourisme : DGE, Atout France, f&eacute;d&eacute;rations professionnelles des h&ocirc;teliers et repr&eacute;sentants des comit&eacute;s d&eacute;partementaux et r&eacute;gionaux du tourisme (FNCRT, RN2D). <br />Les besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est le fichier des campings offrant au moins un emplacement de passage g&eacute;r&eacute; par l'Insee. <br />Dans dix r&eacute;gions de petite taille,&nbsp;l'enqu&ecirc;te est exhaustive. Pour les autres r&eacute;gions, les crit&egrave;res de stratification de l'&eacute;chantillon sont :<br />- l'axe g&eacute;ographique (espaces touristiques nationaux (ETN)<br />- la cat&eacute;gorie de camping (1 &agrave; 5 &eacute;toiles, non class&eacute;)<br />- la taille en nombre d'emplacements<br />A l'int&eacute;rieur des strates le tirage est al&eacute;atoire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling frame is the file of campsites offering at least one passage site managed by INSEE.<br />In ten small areas, the survey is comprehensive. For the other regions, the stratification criteria of the sample are:<br />- the geographical focus (national tourist areas (ETNs)<br />- camping category (1 to 5 stars, unclassified)<br />- size in number of locations<br />Inside the strata the draw is random.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.8>
