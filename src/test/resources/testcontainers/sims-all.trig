    <http://bauhaus/documents/document/335>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2012 Établissement public / format coût de la main-d'œuvre ECMOSS"@fr ;
