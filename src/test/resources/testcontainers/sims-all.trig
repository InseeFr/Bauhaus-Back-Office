    <http://bauhaus/qualite/attribut/1962/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1962/S.3.4/texte> , <http://bauhaus/qualite/attribut/1962/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/documents/document/1261>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des entreprises créées en 2018 - situation en 2021 (test2)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0027-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/NOTICE_SINE_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1962/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>SINE est un syst&egrave;me permanent d'observation et de suivi d'une g&eacute;n&eacute;ration (ou cohorte) de nouvelles entreprises tous les quatre ans.</p>\n<p>Une g&eacute;n&eacute;ration correspond ici aux entreprises cr&eacute;&eacute;es au cours de la m&ecirc;me p&eacute;riode (le premier semestre) d'une ann&eacute;e donn&eacute;e. Chaque g&eacute;n&eacute;ration d'entreprises est donc repr&eacute;sent&eacute;e par les seules cr&eacute;ations du premier semestre de l'ann&eacute;e.</p>\n<p>Pour chaque g&eacute;n&eacute;ration, le recueil d'information repose sur trois interrogations :<br />- la premi&egrave;re, quelques mois apr&egrave;s la cr&eacute;ation de l'entreprise ;<br />- la deuxi&egrave;me, au bout de la troisi&egrave;me ann&eacute;e d'existence de l'entreprise ;<br />- la troisi&egrave;me, cinq ans apr&egrave;s la cr&eacute;ation.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>&nbsp;L'interrogation d'une nouvelle cohorte est initialis&eacute;e tous les 4 ans.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/documents/document/1223>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des entreprises créées en 2018 : situation initiale"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0006-07-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Quest_SINE_20181.pdf> .
    
    <http://bauhaus/documents/document/1260>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des entreprises créées en 2018 - situation en 2021 (test1)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0027-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/QUESTIONNAIRE_SINE_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1962/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1962/S.19/texte> , <http://bauhaus/qualite/attribut/1962/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire porte sur :<br />- le profil du cr&eacute;ateur et les conditions de d&eacute;marrage de l'entreprise ;<br />- l'&eacute;volution de l'activit&eacute; de l'entreprise, le type de client&egrave;le, la coop&eacute;ration avec les autres entreprises ;<br />- l'&eacute;volution des effectifs (embauches, licenciements, personnel occasionnel) ;<br />- les investissements et leur mode de financement ;<br />- la formation et les conseils apr&egrave;s la cr&eacute;ation ;<br />- les difficult&eacute;s rencontr&eacute;es par l'entreprise ;<br />- la strat&eacute;gie de l'entreprise ;<br />- les conditions de son d&eacute;veloppement.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1962/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-09-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The economic coverage of the SINE programme matches the businesses' demographic scope: all market activities, excluding agricultural activities.</p>\n<p>Until the 2002 set, the SINE system only covered the \"ICS\" scope (Industry, the building industry, Trade and Services).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1962/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Each generation (or set) of businesses responds to three surveys using two different questionnaires: a questionnaire for the first survey upon start-up and a second questionnaire for the second and third surveys, after three years and five years of activity."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1962/I.18.7/text> , <http://bauhaus/qualite/attribut/1962/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Toutes les nouvelles entreprises ne sont pas enqu&ecirc;t&eacute;es.</p>\n<p>Les &eacute;chantillons de la cohorte 2018 du dispositif SINE sont tir&eacute;s &agrave; partir des cr&eacute;ations d'entreprises enregistr&eacute;es dans le r&eacute;pertoire Sirene au cours du premier semestre 2018, r&eacute;parties en strates selon les crit&egrave;res suivants&nbsp; :&nbsp;</p>\n<p>- la r&eacute;gion, le secteur d'activit&eacute; et la cat&eacute;gorie juridique (personne physique ou morale) pour le questionnaire aupr&egrave;s des cr&eacute;ateurs hors micro-entrepreneurs ;</p>\n<p>- la r&eacute;gion et le secteur d'activit&eacute; pour le questionnaire aupr&egrave;s des micro-entrepreneurs.</p>\n<p>La r&eacute;gion correspond aux nouvelles r&eacute;gions issues de la r&eacute;forme territoriale.</p>\n<p>Le mode de tirage de l'&eacute;chantillon permet une repr&eacute;sentativit&eacute; nationale et r&eacute;gionale des r&eacute;sultats.</p>\n<p>Seules les entreprises survivantes sont ensuite r&eacute;interrog&eacute;es apr&egrave;s trois ans et cinq ans d'existence.</p>\n<p>L'&eacute;chantillon total SINE 2018 (premi&egrave;re interrogation de la g&eacute;n&eacute;ration 2018) compte environ 40 000 cr&eacute;ateurs hors micro-entrepreneurs, et 40 000 micro-entrepreneurs.</p>\n<p>La deuxi&egrave;me interrogation de cette cohorte aura lieu en 2021.</p>\n<p>&Agrave; compter de cette g&eacute;n&eacute;ration 2018, l&rsquo;&eacute;chantillon couvre Mayotte pour les cr&eacute;ateurs hors micro-entrepreneurs.</p>\n<p>Par souci d'all&egrave;gement de la charge statistique pesant sur les entreprises, celles s&eacute;lectionn&eacute;es pour cette enqu&ecirc;te ne sont pas interrog&eacute;es dans le cadre de l'enqu&ecirc;te sectorielle annuelle (ESA).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1962/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La couverture &eacute;conomique du dispositif SINE correspond au champ de la d&eacute;mographie d'entreprises : l'ensemble des activit&eacute;s marchandes, hormis les activit&eacute;s agricoles.</p>\n<p>Jusqu'&agrave; la cohorte 2002, le dispositif SINE ne couvrait que le champ dit \"ICS\" (de l'Industrie, de la construction, du Commerce et des Services).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1962/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Chaque génération (ou cohorte) d'entreprises fait l'objet de trois enquêtes par le biais de deux questionnaires différents : un questionnaire pour la première interrogation dès la création et un second questionnaire pour la deuxième et la troisième interrogation, après trois ans et cinq ans d'activité."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1962/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>SINE is an ongoing system to observe and monitor a generation (or set) of new enterprises every four years.</p>\n<p>In this case, a generation is a group of enterprises created over the same period (the first half) of a given year. Each generation of enterprises is therefore only represented by the companies created in the first half of the year.</p>\n<p>For each generation, the information is collected using three surveys:<br />- the first, a few months after the creation of the enterprise;<br />- the second, at the end of the third year of existence of the enterprise;<br />- the third, five years after its creation.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1962/I.18.10/texte> , <http://bauhaus/qualite/attribut/1962/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    ""@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1962/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1260> , <http://bauhaus/documents/document/1262> , <http://bauhaus/documents/document/1261> , <http://bauhaus/documents/document/1224> , <http://bauhaus/documents/document/1223> .
    
    <http://bauhaus/qualite/attribut/1962/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1962/S.3.6/texte> , <http://bauhaus/qualite/attribut/1962/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1962> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1732> {
    <http://bauhaus/qualite/attribut/1732/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
