    <http://bauhaus/qualite/attribut/1987/S.11.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le prestataire r&eacute;alise pour chaque vague d'enqu&ecirc;te un bilan de collecte (nombre de r&eacute;pondants, adresses mail erron&eacute;es&hellip;).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1987/S.15.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La comparabilit&eacute; se fait entre les donn&eacute;es de fr&eacute;quentation N-2 et N-1 collect&eacute;es au cours de l'EFLM de l'ann&eacute;e N car les donn&eacute;es sont collect&eacute;es aupr&egrave;s du m&ecirc;me enqu&ecirc;t&eacute;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
