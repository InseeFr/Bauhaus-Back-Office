                    <http://bauhaus/qualite/attribut/1934/I.18.7/texte> , <http://bauhaus/qualite/attribut/1934/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>The complete year.</p>"@en , "<p>L&rsquo;ensemble de l&rsquo;ann&eacute;e.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
