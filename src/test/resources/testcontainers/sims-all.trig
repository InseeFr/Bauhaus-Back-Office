                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/QLT_loyers_et_charges_2018.pdf> .
    
    <http://bauhaus/qualite/attribut/1912/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
