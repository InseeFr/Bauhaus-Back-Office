    <http://bauhaus/qualite/attribut/1754/S.3.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>French classification of activities (Naf r&eacute;v.2).</p>"@en ;
