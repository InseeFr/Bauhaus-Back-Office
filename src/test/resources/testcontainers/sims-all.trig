    <http://bauhaus/documents/document/270>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice  2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-01-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_FREQ_HOTELLERIE_PLEIN_AIR_2013.pdf> .
    
    <http://bauhaus/qualite/attribut/1682/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "A compter de la saison 2013, l'enquête n'est plus exhaustive : elle est réalisée auprès d'un échantillon de  6000 campings sur 7 500"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1682/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Mai (ou avril) &agrave; septembre. Les questionnaires sont envoy&eacute;s vers le 25 du mois pr&eacute;c&eacute;dant le mois de collecte.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1682/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée de mai à septembre, par voie postale."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1682/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1682/S.19/texte> , <http://bauhaus/qualite/attribut/1682/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/rapport/1682>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Outdoor accommodation occupancy survey 2013"@en , "Rapport qualité : Enquête de fréquentation dans l'hôtellerie de plein air 2013"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1093> .
    
    <http://bauhaus/qualite/attribut/1682/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1682/S.3.6/text> , <http://bauhaus/qualite/attribut/1682/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey concerns the occupancy in the five summer months, from May to September: the stock is measured on 30 November of each year.</p>\n<p>It covers the following topics:</p>\n<p>- Characteristics of the site</p>\n<p>- Opening period</p>\n<p>- Accommodation capacity (bare pitches and pitches with rental accommodation)</p>\n<p>- Occupancy of pitches (bare and with rental accommodation)</p>\n<p>- Monthly occupancy (in terms of the numbers of arrivals and nights) according to the type of pitch (bare and with rental accommodation) and the customers' normal country of residence.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1682/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/270> .
    
    <http://bauhaus/qualite/attribut/1682/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par le code NAF r&eacute;v. 2 : 55.30Z (terrains de camping et parcs pour caravanes ou v&eacute;hicules de loisirs).</p>\n<p>Les unit&eacute;s enqu&ecirc;t&eacute;es sont des terrains de camping, class&eacute;s de 1 &agrave; 5 &eacute;toiles ou des terrains non class&eacute;s offrant au moins un emplacement de passage</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1682/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1682/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is carried out from May to September, by post."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1682/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A pitch that is considered to have rental accommodation is equipped with a bungalow, \"Bungatent\", mobile home, leisure home, etc.</p>\n<p>Any pitches that may be reserved for campervans are considered to be bare pitches.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1682/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1682/I.18.10/text> , <http://bauhaus/qualite/attribut/1682/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te porte sur la fr&eacute;quentation des cinq mois d'&eacute;t&eacute;, de mai &agrave; septembre : le parc est mesur&eacute; chaque ann&eacute;e au 30 novembre.</p>\n<p>Elle aborde les th&egrave;mes suivants :</p>\n<p>- caract&eacute;ristiques du terrain ;</p>\n<p>- p&eacute;riode d'ouverture ;</p>\n<p>- capacit&eacute; d'accueil (emplacements nus et emplacements locatifs) ;</p>\n<p>- occupation des emplacements (nus et locatifs) ;</p>\n<p>- fr&eacute;quentation mensuelle (en termes de nombre d'arriv&eacute;es et de nuit&eacute;es) selon le type d'emplacements (nus et locatifs) et le pays de r&eacute;sidence habituelle des clients.</p>\n<p>&nbsp;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1682/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1682/S.3.4/texte> , <http://bauhaus/qualite/attribut/1682/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "From the 2013 season, the survey is no longer exhaustive: it is carried out with a sample of 6,000 campsites from 7500"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1682/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1682/S.18.3/texte> , <http://bauhaus/qualite/attribut/1682/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
    
    <http://bauhaus/qualite/attribut/1682/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un emplacement, consid&eacute;r&eacute; comme locatif, dispose d'un &eacute;quipement d'h&eacute;bergement de type bungalow, bungatoile, mobil-home, habitation l&eacute;g&egrave;re de loisir (HLL)&hellip;</p>\n<p>Les &eacute;ventuels emplacements pr&eacute;vus pour le stationnement des camping-cars sont consid&eacute;r&eacute;s comme des emplacements nus.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1682/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers the activities defined by the NAF rev. 2 code: 55.30Z (campsites and areas for caravans or leisure vehicles).</p>\n<p>The survey covers campsites, classified from 1 to 5 stars or non-classified sites offering at least one short-stay pitch.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1682/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1682> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1573> {
    <http://bauhaus/documents/document/451>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-02-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_CONJ_COMMERCE_GROS_FR_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1573/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te bimestrielle de conjoncture dans le commerce de gros a pour objet de transcrire l'opinion des grossistes sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.</p>\n<p>Cette opinion est retrac&eacute;e au moyen du suivi du volume des ventes et de variables qui lui sont li&eacute;es, telles que les stocks, les intentions de commandes, les livraisons, les perspectives g&eacute;n&eacute;rales d'activit&eacute;, l'&eacute;volution des effectifs ainsi que celle des prix.</p>\n<p>Les grossistes fournissent &eacute;galement une opinion sur leur situation de tr&eacute;sorerie et les d&eacute;lais de paiement.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1573/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1573/I.18.10/texte> , <http://bauhaus/qualite/attribut/1573/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1573/S.3.4/texte> , <http://bauhaus/qualite/attribut/1573/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/451> .
    
    <http://bauhaus/qualite/attribut/1573/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1573/I.20/texte> , <http://bauhaus/qualite/attribut/1573/I.20/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
