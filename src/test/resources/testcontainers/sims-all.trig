            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1940> .
    
    <http://bauhaus/qualite/attribut/1940/S.15.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.2>
                    <http://bauhaus/qualite/attribut/1940/S.15.2/text> , <http://bauhaus/qualite/attribut/1940/S.15.2/texte> ;
