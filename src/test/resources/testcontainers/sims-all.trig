                    <http://bauhaus/qualite/rapport/1983> .
    
    <http://bauhaus/qualite/attribut/1983/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1983/I.18.7/texte> , <http://bauhaus/qualite/attribut/1983/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1983> .
    
    <http://bauhaus/qualite/attribut/1983/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
