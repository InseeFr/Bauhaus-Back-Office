    <http://bauhaus/qualite/attribut/1797/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Période et mode de collecte : Base de données du RNM (pour l'essentiel)"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/786>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Presentation of the Wholesale food price index (IPGA base 2005)"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IPGA_base_2005_GB.pdf> .
    
    <http://bauhaus/qualite/rapport/1797>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Wholesale food price index (stopped)"@en , "Rapport qualité : Indice des prix de gros alimentaire (série arrêtée)"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1656> .
    
    <http://bauhaus/qualite/attribut/1797/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'IPGA est un indice de Laspeyres base fixe, en r&eacute;f&eacute;rence 2005. Une nomenclature sp&eacute;cifique est utilis&eacute;e.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/785> , <http://bauhaus/documents/document/25> , <http://bauhaus/documents/document/784> .
    
    <http://bauhaus/qualite/attribut/1797/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1797/S.18.3/texte> , <http://bauhaus/qualite/attribut/1797/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1797> .
    
    <http://bauhaus/qualite/attribut/1797/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This price index includes food products from the following categories :&nbsp; fresh fruits and fresh vegetables, meats, seafood, eggs and dairy products.<br /><br />The unit of observation is the product the price of which is registered by the National Network of Markets in Rungis, or exceptionally collected by INSEE under OPISE (for milk).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/785>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Présentation de l'Indice des prix de gros alimentaire (IPGA base 2000)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IPGA_base_2000_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1797/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les produits couverts correspondent aux denr&eacute;es alimentaires parmi les fruits et l&eacute;gumes frais, les viandes, produits de la mer, oeufs et produits laitiers.<br /><br />L'unit&eacute; observ&eacute;e est le produit, dont le prix est relev&eacute; par le R&eacute;seau National des March&eacute;s au MIN de Rungis, ou exceptionnellement collect&eacute; par l'Insee dans le cadre d'OPISE (pour le lait).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1797/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1797> .
    
    <http://bauhaus/documents/document/784>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Présentation de l'Indice des prix de gros alimentaire (IPGA base 2005)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IPGA_base_2005_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1797/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-02-23"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1797> .
    
    <http://bauhaus/documents/document/25>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
