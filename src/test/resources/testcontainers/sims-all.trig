            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1869> .
    
    <http://bauhaus/qualite/attribut/1869/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1869> .
    
    <http://bauhaus/qualite/attribut/1869/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sample selection process is based on a two stages sampling design, with first a choice of local units (selected in the French administrative business register Sirene) then, with a selection of employees within the local units selected in first stage (via DADS).</p>\n<p>Ecmoss samples for successive years are negatively correlated, to avoid re-interviewing the same local units two years running.</p>\n<p>The survey is conducted on a sample of about 18,000 local units which form part of a company with more than 10 employees, and a sample of 160,000 employees.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/333>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête annuelle sur le coût de la main-d'œuvre et la structure des salaires / Ecmoss"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-10-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ECMOSS_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1869/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1869> .
    
    <http://bauhaus/qualite/attribut/1869/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1869/S.3.6/text> , <http://bauhaus/qualite/attribut/1869/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1869> .
