            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1957> .
    
    <http://bauhaus/qualite/attribut/1957/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All sizes of enterprise are included in the scope of the survey, that covers the economic sectors of industry (sections B to E of NACE rev. 2 excluding the agrifood industries).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1957/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- &Agrave; la fin juin apr&egrave;s l'ann&eacute;e de r&eacute;f&eacute;rence pour les donn&eacute;es PRODCOM sur le site d'Eurostat.<br />- En juillet apr&egrave;s l'ann&eacute;e de r&eacute;f&eacute;rence pour les donn&eacute;es provisoires en classification des produits fran&ccedil;aise (CPF 4-5) sur le site de l'Insee.<br />- &Agrave; la fin de l&rsquo;ann&eacute;e apr&egrave;s l'ann&eacute;e de r&eacute;f&eacute;rence pour les donn&eacute;es d&eacute;finitives en classification des produits fran&ccedil;aise (CPF 4-5) et Prodfra sur le site de l'Insee.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1957/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1957/S.3.1/text> , <http://bauhaus/qualite/attribut/1957/S.3.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1957> .
    
    <http://bauhaus/qualite/attribut/1957/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est annuelle et se d&eacute;roule de janvier N+1 &agrave; septembre N+1 avec toutefois une concentration sur le 1er semestre pour&nbsp;fournir une r&eacute;ponse &agrave; Prodcom au 30 juin N+1.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1957/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les entreprises de plus de 20 salari&eacute;s ou de plus de 5 millions de chiffre d&rsquo;affaires sont interrog&eacute;es de mani&egrave;re exhaustive par sous-classe NAF, et par sondage en dessous de ces seuils.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1957>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête annuelle de production 2019"@fr , "Quality report: Annual production survey 2019"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1513> .
}

