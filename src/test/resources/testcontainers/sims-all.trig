            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1808> .
    
    <http://bauhaus/qualite/attribut/1808/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1808/S.18.3/texte> , <http://bauhaus/qualite/attribut/1808/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1808> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1929> {
    <http://bauhaus/qualite/rapport/1929>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Quarterly business outlook survey on investment in industry 2019"@en , "Rapport qualité : Enquête trimestrielle sur les investissements dans l'industrie 2019"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1485> .
    
    <http://bauhaus/qualite/attribut/1929/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te est publi&eacute;e avant le 10 du mois suivant le mois durant lequel les chefs d&rsquo;entreprises ont &eacute;t&eacute; interrog&eacute;s, &agrave; l&rsquo;exception de l&rsquo;enqu&ecirc;te de juillet, publi&eacute;e autour du 20 ao&ucirc;t.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.2.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.1>
                    "2019-06-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1929/I.18.7/text> , <http://bauhaus/qualite/attribut/1929/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1929/S.10.6/text> , <http://bauhaus/qualite/attribut/1929/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les s&eacute;ries de l&rsquo;enqu&ecirc;te sont librement accessibles sous insee.fr &agrave; la rubrique des s&eacute;ries chronologiques.<br /><a href=\"https://www.insee.fr/fr/statistiques/series/102410343\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/fr/statistiques/series/102410343</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-G101> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data from the last available survey are provisional. They are revised upon publication of the next survey, taking into account, in particular, late replies received.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te sur les investissements dans l'industrie : m&eacute;thodologie (Insee M&eacute;thodes n&deg; 119)<br /><a href=\"https://www.insee.fr/fr/information/2579180\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/fr/information/2579180</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/416> , <http://bauhaus/documents/document/418> .
    
    <http://bauhaus/qualite/attribut/1929/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte s'effectue par voie postale et par internet sur une p&eacute;riode qui s'&eacute;tend de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la date de publication de l'enqu&ecirc;te.</p>\n<p>Les r&eacute;sultats d'enqu&ecirc;te sont envoy&eacute;s &agrave; la Commission europ&eacute;enne en avril et en novembre, 4 jours ouvrables avant la fin de mois.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/1106>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'octobre"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-06-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_INVT_MODELE3_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1929/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre l'industrie manufacturi&egrave;re et les industries extractives soit les divisions 08 &agrave; 33 de la nomenclature d&rsquo;activit&eacute; fran&ccedil;aise (NAF R&eacute;v.&nbsp;2) (hors 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.14.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is published before the 10th of the month following the month in which the business managers were surveyed, with the exception of the July survey, published around August 20.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les principaux th&egrave;mes abord&eacute;s sont&nbsp;:<br />- les investissements&nbsp;: les chefs d'entreprise sont interrog&eacute;s sur les montants de leurs investissements sur les 3 derni&egrave;res ann&eacute;es&nbsp;;<br />- leurs motivations&nbsp;;<br />- les facteurs influen&ccedil;ant les d&eacute;cisions d&rsquo;investissements&nbsp;;<br />- leur capacit&eacute;s de production, etc.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is by post and via the internet over a period that extends from the end of the month preceding the survey month&nbsp;to the survey publication date.</p>\n<p>Survey results are sent to the European Commission in April and November, 4 business days before the end of the month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es de la derni&egrave;re enqu&ecirc;te disponible sont provisoires. Elles sont r&eacute;vis&eacute;es lors de la publication de l&rsquo;enqu&ecirc;te suivante en tenant compte notamment des r&eacute;ponses re&ccedil;ues tardivement.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.7.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant la collecte internet, le site de collecte est enti&egrave;rement s&eacute;curis&eacute; et les normes en termes de gestion des codes d&rsquo;acc&egrave;s &agrave; l&rsquo;enqu&ecirc;te sont strictes et standardis&eacute;es pour toutes les enqu&ecirc;tes entreprises. Pour les entreprises choisissant d&rsquo;utiliser le support papier, la saisie est assur&eacute;e par les gestionnaires, dans le strict respect de la confidentialit&eacute; des donn&eacute;es r&eacute;colt&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "L’unité interrogée est l’entreprise (au sens d’unité légale ou d’unité profilée)."@fr , "The unit interviewed is the company."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1929/S.18.3/texte> , <http://bauhaus/qualite/attribut/1929/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/documents/document/1105>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'avril"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-06-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_INVT_MODELE2_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e tous les trimestres mais toutes les questions ne sont pas pos&eacute;es chaque trimestre.</p>\n<p>En pratique, trois mod&egrave;les de questionnaires ont &eacute;t&eacute; cr&eacute;&eacute;s pour tenir compte de ces sp&eacute;cificit&eacute;s&nbsp;: <br />- le premier questionnaire correspond aux mois de janvier et juillet&nbsp;; <br />- le deuxi&egrave;me correspond au mois d&rsquo;avril&nbsp;;<br />- le dernier correspond au mois d&rsquo;octobre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1106> , <http://bauhaus/documents/document/1104> , <http://bauhaus/documents/document/1105> .
    
    <http://bauhaus/qualite/attribut/1929/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2019T007EC"@fr , "2019T007EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte s&rsquo;&eacute;tend de la fin du mois pr&eacute;c&eacute;dant le mois de r&eacute;f&eacute;rence de l&rsquo;enqu&ecirc;te &agrave; la date de la publication des r&eacute;sultats (entre le 5 et le 10 du mois suivant le mois de r&eacute;f&eacute;rence).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les comit&eacute;s qui ont donn&eacute; &agrave; l'Insee le droit et la l&eacute;gitimit&eacute; pour collecter ses donn&eacute;es sont :<br />- le Conseil national de l'information statistique (Cnis) qui examine chaque nouveau projet, qu&rsquo;il s&rsquo;agisse d&rsquo;une enqu&ecirc;te, d&rsquo;un r&eacute;pertoire ou d&rsquo;une exploitation de fichiers administratifs&hellip; Ces projets sont pr&eacute;sent&eacute;s par toutes les institutions qui contribuent par leurs travaux &agrave; la construction de la statistique publique. La discussion porte notamment sur la finalit&eacute; du projet, sa place dans le syst&egrave;me d&rsquo;information et les conditions pr&eacute;vues de sa diffusion. Il convient de v&eacute;rifier que chaque op&eacute;ration r&eacute;pond &agrave; un besoin d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et ne fait pas double emploi avec les sources d&rsquo;information existantes, en d&rsquo;autres termes de s&rsquo;assurer de son opportunit&eacute;. Le Cnis donne un avis d&rsquo;opportunit&eacute;.<br />- le comit&eacute; du label, au sein du Cnis, qui veille au respect de la qualit&eacute; statistique. Celui-ci s&rsquo;assure que l&rsquo;enqu&ecirc;te r&eacute;pond aux crit&egrave;res de qualit&eacute; statistique en ce qui concerne la m&eacute;thode de collecte et d&rsquo;&eacute;chantillonnage (plan de sondage, m&eacute;thode de redressement des donn&eacute;es, traitement des non-r&eacute;ponses garantissant la fiabilit&eacute; des r&eacute;sultats...), de pertinence du questionnement et d&rsquo;adaptation de la diffusion aux objectifs annonc&eacute;s. Il s&rsquo;assure &eacute;galement que l&rsquo;enqu&ecirc;te n&rsquo;entra&icirc;ne pas de charge excessive sur les enqu&ecirc;t&eacute;s, qu&rsquo;une concertation a &eacute;t&eacute; men&eacute;e avec les partenaires concern&eacute;s et que les souhaits exprim&eacute;s par le Cnis lors du d&eacute;bat d&rsquo;opportunit&eacute; ont bien &eacute;t&eacute; pris en compte. Il donne un label d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et de qualit&eacute; statistique et d&eacute;termine le caract&egrave;re obligatoire des enqu&ecirc;tes.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee,<br />88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex</p>"@fr , "<p>Insee,<br />88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1929/I.18.12/texte> , <http://bauhaus/qualite/attribut/1929/I.18.12/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les fichiers de r&eacute;ponses individuelles sont mis en conservation annuellement. Toute demande d&rsquo;acc&egrave;s &agrave; ces donn&eacute;es individuelles est soumise &agrave; l&rsquo;autorisation du comit&eacute; du secret statistique. Les donn&eacute;es sont alors mises &agrave;&nbsp; &agrave; disposition des utilisateurs ext&eacute;rieurs &agrave; l&rsquo;Insee via le CASD (Centre d&rsquo;acc&egrave;s s&eacute;curis&eacute; aux donn&eacute;es), apr&egrave;s passage au Comit&eacute; du secret.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.4>
                    <http://bauhaus/qualite/attribut/1929/S.10.4/text> , <http://bauhaus/qualite/attribut/1929/S.10.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te de conjoncture sur les investissements dans l&rsquo;industrie est r&eacute;alis&eacute;e le premier mois de chaque trimestre. Les r&eacute;sultats sont publi&eacute;s entre le 5 et le 10 du mois suivant le mois d&rsquo;enqu&ecirc;te. L&rsquo;enqu&ecirc;te conduite au mois de juillet est publi&eacute;e aux deux tiers du mois d&rsquo;ao&ucirc;t.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Individual response files are stored annually. Any request for access to these individual data shall be subject to the authorisation of the Committee on Statistical Confidentiality. The data is then made available to users outside Insee via the CASD (Centre d'acc&egrave;s s&eacute;curis&eacute; aux donn&eacute;es), after passing through the Secret Committee.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.8.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.8.3>
                    "<p>The results are published quaterly in \"Informations Rapides\" series.</p>"@en , "<p>Les r&eacute;sultats sont publi&eacute;s trimestriellement dans les Informations rapides sur insee.fr.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/documents/document/1104>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire des mois de janvier et juillet"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-06-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_INVT_MODELE1_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey series are freely accessible in the macroeconomic database.<br /><a href=\"https://www.insee.fr/en/statistiques/series/102410343\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/en/statistiques/series/102410343</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.17.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.2>
                    <http://bauhaus/qualite/attribut/1929/S.17.2/texte> , <http://bauhaus/qualite/attribut/1929/S.17.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The committees that have given Insee the right and legitimacy to collect its data are:<br />- The National Council for Statistical Information (Cnis), which examines each new project, whether it is a survey, a directory or the exploitation of administrative files... These projects are presented by all the institutions that contribute by their work to producing public statistics. The discussion focuses in particular on the purpose of the project, its place in the information system and the conditions anticipated for its dissemination. Each operation must be examined to ensure it is in the general interest and does not duplicate existing sources of information, in other words to ensure that it is suitable. It provides an opinion on suitability.<br />- The quality label committee, within the CNIS, ensures that it meets the criteria of statistical quality. The committee checks that the survey meets the statistical quality criteria in so far as concerns the collection and sampling method (survey design, data correction method, handling of non-responses guaranteeing the reliability of results..), relevance of the questions and adaptation of the distribution to the objectives announced. It also checks that the survey does not place an excessive burden on the respondents, that consultations have been held with the partners concerned and that any wishes expressed by the CNIS during the debate on suitability were taken into account. It gives a quality label of general interest and statistical quality.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of Short-Term Economic Trends Survey Section</p>"@en , "<p>Cheffe de la division des enqu&ecirc;tes de conjoncture</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>About 4,000 units</p>"@en , "<p>4&nbsp;000 unit&eacute;s environ</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.11.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quaterly outlook survey on investment in industry is part of the harmonised European Union programme of business and consumer surveys to which the 28 Member States of the European Union contribute.</p>\n<p>Thus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system.</p>\n<p>Questions are formulated so that they can be answered quickly.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.3>
                    <http://bauhaus/qualite/attribut/1929/S.10.3/texte> , <http://bauhaus/qualite/attribut/1929/S.10.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The main themes addressed are: <br />- investments: business leaders are asked about the amounts of their investments over the last 3 years;<br />- their motivation;<br />- the factors influencing investment decisions;<br />- their production capacities.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The French survey on industrial investment: methodology (Insee M&eacute;thodes N&deg;119)<br /><a href=\"https://www.insee.fr/en/information/2579485\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/en/information/2579485</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1109>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire for October (fr)"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-06-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_INVT_MODELE3_2019.pdf> .
    
    <http://bauhaus/documents/document/418>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête sur les investissements dans l’industrie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-05-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_CONJ_INVEST_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te est une enqu&ecirc;te par sondage aupr&egrave;s d&rsquo;environ 4&nbsp;000 entreprises industrielles de 20 salari&eacute;s ou plus. La base de sondage est le fichier de donn&eacute;es structurelles des entreprises (Syst&egrave;me d&rsquo;immatriculation au r&eacute;pertoire des unit&eacute;s statistiques - r&eacute;f&eacute;rentiel Sirus). Des strates sont d&eacute;finies selon le code d'activit&eacute; de la NAF r&eacute;v.2 et les effectifs.</p>\n<p>Les entreprises d'au moins 500 salari&eacute;s ou 150 millions d'euros de chiffre d'affaires sont interrog&eacute;es en totalit&eacute;. Pour les autres strates, l&rsquo;&eacute;chantillon est constitu&eacute; &agrave; partir d&rsquo;un sondage stratifi&eacute; sans remise avec allocation proportionnelle au chiffre d&rsquo;affaires.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.8.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.2>
                    <http://bauhaus/qualite/attribut/1929/S.8.2/texte> , <http://bauhaus/qualite/attribut/1929/S.8.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1929/S.3.3/text> , <http://bauhaus/qualite/attribut/1929/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.7.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>In so far as concerns collection via the Internet, the collection site is totally secure and the standards in terms of managing survey access codes are strict and standardized for all surveys. For enterprises that choose to use paper, the managers are responsible for the input, and must strictly respect the confidentiality of any data collected.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1929/S.7.2/text> , <http://bauhaus/qualite/attribut/1929/S.7.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2019-06-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les utilisateurs sont les conjoncturistes et pr&eacute;visionnistes de l&rsquo;Insee, de la direction g&eacute;n&eacute;rale du Tr&eacute;sor et d&rsquo;autres instituts, fran&ccedil;ais et &eacute;trangers, ainsi que des organismes internationaux, des statisticiens d&rsquo;entreprise, les d&eacute;cideurs, les &eacute;conomistes et les chercheurs, les journalistes de la presse &eacute;conomique, etc.<br />L&rsquo;enqu&ecirc;te trimestrielle de conjoncture sur les investissements dans l&rsquo;industrie apporte une information irrempla&ccedil;able pour l&rsquo;analyse et la pr&eacute;vision &agrave; court terme de l&rsquo;investissement des entreprises industrielles. L&rsquo;enqu&ecirc;te permet en outre de mesurer r&eacute;guli&egrave;rement la mani&egrave;re dont les anticipations d&rsquo;investissement des entrepreneurs &eacute;voluent dans le temps, ce qui est tr&egrave;s pr&eacute;cieux pour l&rsquo;analyse et la pr&eacute;vision conjoncturelles.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/P> , <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Myriam Broin</p>"@fr , "<p>Myriam Broin</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1929/I.18.10/texte> , <http://bauhaus/qualite/attribut/1929/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Law n&deg;51-711 of 7 June 1951 on obligations, co-ordination and confidentiality in respect of statistics. Available from <a href=\"https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573</a>.</p>\n<p>Article 6 concerns statistical confidentiality: Subject to the provisions of Articles 40, 56, 76, 97 and 99 of the Code of Criminal Procedure and those of Article L.&nbsp;213-3 of the French Heritage Code, the individual information contained in the questionnaires endorsed as provided for in Article 2 of this Law and relating to private and family life and, in general, to private acts and conduct can not, unless decided by the Archives Administration, after examining the opinion of the Statistical Confidentiality Committee and relating to a request made for the purposes of public statistics or scientific or historical research, be the subject of any communication by the depositary service before the expiry of a period of seventy-five years following the date of completion of the survey or a period of twenty-five years from the death of the person concerned, whichever is the shorter.<br />A Statistical Confidentiality Committee is set up. This committee is called upon to rule on any question relating to the confidentiality of statistics. It expresses its opinion on requests for the communication of individual data collected pursuant to this law. The committee is chaired by a State Councillor, appointed by the Vice-President of the Council of State. It includes in particular representatives of the French National Assembly and Senate. The composition and operating methods of the committee are set by decree of the Council of State. Recipients of the data communications resulting from Ministerial decisions made after consulting the Statistical Confidentiality Committee agree to not communicate these data to anyone. Any violation of the provisions of this paragraph is punishable by the penalties provided for in Article 226-13 of the Penal Code.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers manufacturing industry and extraction industries; divisions 08 to 33 of French Nomenclature of Activities (NAF Rev.&nbsp;2)&nbsp; (except 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1929/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Some data have been available since 1963.</p>"@en , "<p>Certaines donn&eacute;es sont disponibles depuis 1963.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Users are conjoncturits from Insee, general direction of Treasor and other institutes in France or abroad, economist, journalists...</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1108>
