    <http://bauhaus/qualite/attribut/1601/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/416> , <http://bauhaus/documents/document/418> , <http://bauhaus/documents/document/417> .
    
    <http://bauhaus/qualite/rapport/1601>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Quarterly business outlook survey on investment in industry 2007"@en , "Rapport qualité : Enquête trimestrielle sur les investissements dans l'industrie 2007"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1125> .
    
    <http://bauhaus/qualite/attribut/1601/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1601/I.18.10/texte> , <http://bauhaus/qualite/attribut/1601/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quarterly survey on investment in industry is part of the European system to harmonise European Commission business outlook&nbsp;surveys, and to which the 27 Member States of the European Union contribute.</p>\n<p>Thus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1601/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers 4,000 industrial companies with 20 employees or more.</p>\n<p>All companies with at least 500 employees or 150 million euros in turnover are questioned.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/416>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Prévoir l'investissement des entreprises : Un indicateur des révisions dans l'enquête de conjoncture sur les investissements dans l'industrie "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/prevoir_invest_entreprises_G2005_09.pdf> .
    
    <http://bauhaus/qualite/attribut/1601/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te trimestrielle sur les investissements dans l'industrie fait partie du syst&egrave;me europ&eacute;en harmonis&eacute; des enqu&ecirc;tes de conjoncture de la Commission europ&eacute;enne, auquel contribuent les vingt-sept &Eacute;tats membres de l'Union europ&eacute;enne.</p>\n<p>&Agrave; ce titre, les questionnaires, les nomenclatures et les m&eacute;thodes de traitement sont largement harmonis&eacute;s dans les instituts nationaux des pays adh&eacute;rant &agrave; ce syst&egrave;me.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1601/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1601/S.19/text> , <http://bauhaus/qualite/attribut/1601/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1601/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enqu&ecirc;te par sondage aupr&egrave;s de 4 000 entreprises industrielles de 20 salari&eacute;s ou plus.</p>\n<p>Toutes les entreprises d'au moins 500 salari&eacute;s ou 150 millions d'euros de chiffre d'affaires sont interrog&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1601/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted every quarter. This is done in January, April, July and October, i.e. the month after the end of each quarter.</p>\n<p>Data collection is by post and via the internet from the end of the month preceding the survey month to the end of the survey month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1601/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quarterly business outlook survey on investment in industry records the opinion of industrialists on trends in the economic&nbsp;climate in investment, in the destination of investment (replacement, modernisation, capacity extension, etc.), trends in production capacity and displacement of facilities, investments abroad, and factors influencing their decision to invest.</p>\n<p>As well as qualitative questions, the survey is unusual in that it also includes quantitative questions. Annual amounts of investment by the company over two years and the current year are collected and also investment distribution according to destination.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1601/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1601/S.3.6/text> , <http://bauhaus/qualite/attribut/1601/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1601/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1601/S.18.3/text> , <http://bauhaus/qualite/attribut/1601/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te trimestrielle sur les investissements dans l'industrie a pour objet de transcrire l'opinion des industriels sur l'&eacute;volution conjoncturelle de l'investissement, la destination de l'investissement (remplacement, modernisation, extension de capacit&eacute;, etc.), l'&eacute;volution de la capacit&eacute; de production et des d&eacute;classements d'&eacute;quipements, les investissements &agrave; l'&eacute;tranger, les facteurs influen&ccedil;ant la d&eacute;cision d'investissement.</p>\n<p>Outre des questions qualitatives, l'enqu&ecirc;te pr&eacute;sente la particularit&eacute; de contenir &eacute;galement des questions quantitatives. Sont ainsi collect&eacute;s les montants annuels d'investissement de l'entreprise relatifs &agrave; deux ann&eacute;es et &agrave; l'ann&eacute;e courante ou encore la r&eacute;partition des investissements selon leur destination.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/documents/document/414>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2007"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Investissement_francais.pdf> .
    
    <http://bauhaus/qualite/attribut/1601/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/414> .
    
    <http://bauhaus/qualite/attribut/1601/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1601/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e tous les trimestres. Elle est effectu&eacute;e en janvier, avril, juillet et octobre, soit le premier mois de chaque trimestre.</p>\n<p>La collecte se fait par voie postale et par internet de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te jusqu'&agrave; la fin du mois de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1601/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre l'industrie manufacturière et les industries extractives ; divisions 08 à 33 de la NAF rév. 2 (hors 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1601/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1601/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1867> {
    <http://bauhaus/qualite/attribut/1867/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.18.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The Survey on Labour Activity and Conditions of Employment, conducted quarterly by the Research, Study and Statistics Directorate (Dares) among establishments with 10 or more employees in the commercial, private and semi-public sectors, services to private individuals, public administrations, hospitals, non-market education and social action governed by the law of 1901, and giving information on wages and salaries and working time.<br />The quarterly survey, the main one, provides, among other results, indices of changes in the constant structure of the basic salary. These indices are widely used by forecasters and companies for indexing contracts and calculating the revaluation of the Smic each year on July&nbsp;1. There is also an annual \"Smic\" survey conducted in July that estimates the proportion of employees paid at this rate.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1867/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Quatre secteurs de la NACE R&eacute;v.&nbsp;1 :<br />- les industries m&eacute;caniques et &eacute;lectriques (NAF28 &agrave; 35)&nbsp;;<br />- les industries de l'habillement-cuir (NAF18-19)&nbsp;;<br />- les industries textiles (NAF17)&nbsp;;<br />- les services fournis principalement aux entreprises (NAF74).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1867/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1867/S.3.3/texte> , <http://bauhaus/qualite/attribut/1867/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.3.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.9>
                    "<p>1997</p>"@fr , "<p>1997</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Four sectors of NACE Rev.&nbsp;1;<br />- mechanical and electrical industries (NAF28 to 35);<br />- the clothing and leather industries (NAF18-19);<br />- textile industries (NAF17);<br />- services supplied mainly to enterprises (NAF74).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1867/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of Wages and Incomes Section</p>"@en , "<p>Chef de la division salaires et revenus d&rsquo;activit&eacute;</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/rapport/1867>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Indice du coût horaire du travail - tous salariés (base 1997 - séries arrêtées)"@fr , "Quality report: Hourly Labour Cost Index - all employees (base 1997 - series discontinued)"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1666> .
    
    <http://bauhaus/qualite/attribut/1867/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te sur l'activit&eacute; et les conditions d'emploi de la main d'oeuvre, r&eacute;alis&eacute;e chaque trimestre par la Direction de l'animation de la recherche, des &eacute;tudes et des statistiques (Dares) aupr&egrave;s des &eacute;tablissements de 10 salari&eacute;s et plus des secteurs marchands, priv&eacute;s et semi-publics, hors agriculture, services domestiques aux particuliers, administrations publiques, h&ocirc;pitaux, &eacute;ducation non marchande et action sociale r&eacute;gie par la loi de 1901, et donnant des informations sur les salaires et la dur&eacute;e du travail.<br />L'enqu&ecirc;te trimestrielle, la principale, fournit entre autres r&eacute;sultats, des indices d'&eacute;volution &agrave; structure constante du salaire de base. Ces indices sont tr&egrave;s utilis&eacute;s par les conjoncturistes et par les entreprises pour l'indexation des contrats et le calcul de la revalorisation du Smic chaque ann&eacute;e au 1er juillet. Il existe aussi une enqu&ecirc;te annuelle \" Smic \" r&eacute;alis&eacute;e en juillet qui permet d'estimer la proportion de salari&eacute;s r&eacute;mun&eacute;r&eacute;s &agrave; ce taux.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1867/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Fabien Guggemos</p>"@fr , "<p>Fabien Guggemos</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1867/S.3.1/texte> , <http://bauhaus/qualite/attribut/1867/S.3.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F201> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Informations-rapides mensuels</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1867/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Insee calculates an index of the hourly cost of labour for all employees, a gross hourly wage index and an index of employers' contributions based on the Survey of Labour Activity and Conditions of Employment (Acemo) and social security contributions.<br />The hourly labour cost index is a constant structure index, that is, it measures the cost of labour without taking into account possible changes in job qualifications.<br />It is non-revisable.<br />It is mainly used in contract escalation clauses.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1867/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1867/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1867/S.18.1/texte> , <http://bauhaus/qualite/attribut/1867/S.18.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-F001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1867> .
    
    <http://bauhaus/qualite/attribut/1867/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'Insee calcule un indice du co&ucirc;t horaire du travail tous salari&eacute;s, un indice de salaire horaire brut et un indice de charges patronales &agrave; partir de l'Enqu&ecirc;te sur l'activit&eacute; et les conditions d'emploi de la main d'oeuvre (Acemo) et des taux de charges sociales.<br />L'indice de co&ucirc;t horaire du travail est un indice &agrave; structure constante, c'est-&agrave;-dire qu'il mesure le co&ucirc;t du travail sans tenir compte des changements &eacute;ventuels de qualification des emplois.<br />Il est non r&eacute;visable.<br />Il est principalement utilis&eacute; dans des clauses d'indexation de contrat.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

