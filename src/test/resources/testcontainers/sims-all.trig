                    "2015-07-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_CONJ_INDUSTRIE_2014.pdf> .
    
    <http://bauhaus/qualite/attribut/1589/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1589/I.18.10/texte> , <http://bauhaus/qualite/attribut/1589/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1589> .
    
    <http://bauhaus/qualite/attribut/1589/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1589/S.18.3/text> , <http://bauhaus/qualite/attribut/1589/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
