    <http://bauhaus/qualite/attribut/1755/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collecting is annual, in December n + 1 The latest data are provisional. The data are n-1 are semi-final, and the data n-2 and n-3 are final.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
