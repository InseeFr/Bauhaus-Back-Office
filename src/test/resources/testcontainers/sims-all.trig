    <http://bauhaus/qualite/attribut/1954/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1954/I.20/text> , <http://bauhaus/qualite/attribut/1954/I.20/texte> ;
