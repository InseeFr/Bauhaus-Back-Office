                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1880/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1880/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1880> .
    
    <http://bauhaus/qualite/attribut/1880/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/416> , <http://bauhaus/documents/document/418> , <http://bauhaus/documents/document/417> .
    
    <http://bauhaus/qualite/attribut/1880/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quarterly survey on investment in industry is part of the European system to harmonise European Commission business outlook&nbsp;surveys, and to which the 27 Member States of the European Union contribute.</p>\n<p>Thus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1880/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/419> .
    
