    <http://bauhaus/qualite/attribut/1953/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1953/I.18.12/text> , <http://bauhaus/qualite/attribut/1953/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Dossier ch&ocirc;mage</p>\n<p><a href=\"https://www.insee.fr/fr/information/2022025\">https://www.insee.fr/fr/information/2022025 </a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1953/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire est&nbsp; joint ci-dessous&nbsp;:</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1173> .
    
    <http://bauhaus/qualite/attribut/1953/I.20/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Unemployment file</p>\n<p><a href=\"https://www.insee.fr/fr/information/2022025\"> https://www.insee.fr/fr/information/2022025 </a><br /><br /></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1953/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The LFS Mayotte questionnaire is structured around the following themes:<br />- a description of the household and its members;<br />- the status of an activity according to the ILO definition;<br />- a detailed description of the current main job (occupation, working time, kind of contract, etc.).<br />- the description of the employing institution<br />- The caracteristics of job search activities<br />- the level of education and participation in training;<br />- the situation one year before the survey (place of residence, labour market situation, etc.);<br />- the past and desired geographic mobility&nbsp;;<br />- casual activities&nbsp;;<br />- incomes.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1953/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-F001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/S.13.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le taux de ch&ocirc;mage annuel &agrave;&nbsp; Mayotte est estim&eacute; avec un intervalle de confiance &agrave; 95 % de &plusmn; 2 points.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1953/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1953/S.3.6/text> , <http://bauhaus/qualite/attribut/1953/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/rapport/1953>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Labour force survey (LFS)  Mayotte 2016"@en , "Rapport qualité : Enquête Emploi annuelle de Mayotte 2016"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1509> .
    
    <http://bauhaus/qualite/attribut/1953/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey provides a measurement of activity, employment and unemployment according to the ILO definition. It provides a description of the job (status, occupation, working time&hellip;) according to european classifications / definitions.</p>\n<p><a href=\"https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology#EU-LFS_concept_of_labour_force_status\">https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology#EU-LFS_concept_of_labour_force_status</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1953/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>Each year, around 3 000 dwellings are surveyed.</p>"@en , "<p>Chaque ann&eacute;e, environ 3 000 logements sont enqu&ecirc;t&eacute;s.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un fichier &agrave; destination des chercheurs est accessible par le r&eacute;seau Qu&eacute;telet&nbsp;:</p>\n<p><a href=\"https://quetelet.casd.eu/fr/utilisateur/connexion\">https://quetelet.casd.eu/fr/utilisateur/connexion</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1953/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Individus"@fr , "Persons"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2016A063EC"@fr , "2016A063EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data collection is conducted from march to june. With some exceptions, the interview is usually conducted in the 2 weeks and 2 days following the reference week.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1953/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Persons aged 15 or more, living in a private household.<br />Link towards definition</p>\n<p><a href=\"https://www.insee.fr/fr/metadonnees/definition/c2056\">https://www.insee.fr/fr/metadonnees/definition/c2056</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1953/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est une base d&rsquo;adresses. Cette base d&rsquo;adresses est actualis&eacute;e via une enqu&ecirc;te cartographique r&eacute;alis&eacute;e chaque ann&eacute;e sur un cinqui&egrave;me du territoire. Les &icirc;lots mahorais ont &eacute;t&eacute; r&eacute;partis en 5 groupes de rotation &agrave; partir des donn&eacute;es du recensement de 2012. Ces groupes de rotation sont stratifi&eacute;s selon le groupement g&eacute;ographique de l&rsquo;ensemble des communes et ils sont &eacute;quilibr&eacute;s selon le nombre de logements. <br /><br />Le plan de sondage est stratifi&eacute; selon le type d&rsquo;adresse (mono-logements, petites adresses et grandes adresses). <br />Le tirage de l&rsquo;&eacute;chantillon est &eacute;quilibr&eacute; selon le type de b&acirc;ti (en dur ou autre), selon la localisation g&eacute;ographique et enfin selon une variable de classification des villages (celle-ci &eacute;tant bas&eacute;e sur des crit&egrave;res socio-&eacute;conomiques et d&eacute;mographiques).<br /><br />L&rsquo;&eacute;chantillon est rotatif. Il est renouvel&eacute; au tiers chaque ann&eacute;e. <br /><br />L'&eacute;chantillon est uniform&eacute;ment r&eacute;parti sur les 17 semaines de &laquo;&nbsp;r&eacute;f&eacute;rence&nbsp;&raquo;. <br /><br />Le taux de sondage moyen est de 1/66.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1953/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/S.13.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The unemployment rate in Mayotte is estimated with a confidence interval at 95&nbsp;% of &plusmn; 2 pt.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1953/S.10.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.4>
                    <http://bauhaus/qualite/attribut/1953/S.10.4/texte> , <http://bauhaus/qualite/attribut/1953/S.10.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1953/I.18.10/text> , <http://bauhaus/qualite/attribut/1953/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/H> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1711> {
    <http://bauhaus/qualite/attribut/1711/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Enseigne et contr&ocirc;le de l'entreprise &agrave; la t&ecirc;te du r&eacute;seau ;<br />- &Eacute;tendue et caract&eacute;ristiques du r&eacute;seau : nombre de points de vente en France et &agrave; l'&eacute;tranger, r&eacute;partition des points de vente selon le type d'organisation (vente en propre, sous contrat de franchise...), chiffre d'affaires par type d'organisation ;<br />- Organisation du r&eacute;seau : existence de marque propre, existence de centrales d'achats, de centrales de r&eacute;f&eacute;rencement...</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1711>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey of Retail Networks in 2005-2006"@en , "Rapport qualité : Enquête sur les Réseaux du commerce de détail en 2005-2006"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1360> .
    
    <http://bauhaus/qualite/attribut/1711/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1711/S.18.3/texte> , <http://bauhaus/qualite/attribut/1711/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/documents/document/219>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête Réseaux du commerce de détail en 2005-2006"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-03-26"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Reseaux_commerce_2005_2006_Methodologie.pdf> .
    
    <http://bauhaus/qualite/attribut/1711/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Corporate name and control of the enterprise at the head of the network;<br />- Extent of the network: number of retail outlets in France and abroad, distribution of retail outlets according to the type of&nbsp;organisation (own-brand sales, under franchise contract, etc.) and turnover per type of organisation;<br />- Organisation of network: existence of own brand, existence of buying groups, referencing centres, etc.).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1711/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/219> .
    
    <http://bauhaus/qualite/attribut/1711/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les entreprises enqu&ecirc;t&eacute;es sont &agrave; la t&ecirc;te d&rsquo;un ou plusieurs r&eacute;seaux d'enseignes de 7 &eacute;tablissements ou plus du commerce de d&eacute;tail en magasin (hors pharmacie) et de l'artisanat commercial.</p>\n<p>Secteurs enqu&ecirc;t&eacute;s en NAF r&eacute;v. 1 niveau 700 :<br />151F, 158B, 158C, 158D, 521A, 521B, 521C, 521D, 521E, 521F, 521H, 521J, 522A, 522C, 522G, 522J, 522N, 522P, 523C, 523E, 524A, 524E, 524F, 524C, 524H, 524J, 524L, 524N, 524P, 524R, 524T, 524U 524V, 524W, 524X,&nbsp;524Z et 525Z.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1711/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey plan does not include a sampling plan: it exhaustively covers the field of networks of more than seven shops.</p>\n<p>A database listing the networks (and network heads) was thus created on the basis of varied sources, both internal to INSEE (Annual Business Survey of enterprises in the trade sector, supplemented by the 2000 survey of chain store networks), and external networks (professional press and company websites).</p>\n<p>This database was created with the cooperation of professional bodies.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1711/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te ne pr&eacute;sente pas de plan de sondage : elle est exhaustive sur le champ des r&eacute;seaux de plus de sept magasins.</p>\n<p>Ainsi, une base recensant les r&eacute;seaux (et des t&ecirc;tes de r&eacute;seaux) a &eacute;t&eacute; &eacute;labor&eacute;e d'apr&egrave;s diverses sources, internes &agrave; l'Insee (enqu&ecirc;te annuelle d'entreprises aupr&egrave;s des entreprises du commerce et en compl&eacute;ment l'enqu&ecirc;te r&eacute;alis&eacute;e en 2000 sur les r&eacute;seaux d'enseignes) et externes (presse professionnelle, sites Internet des entreprises).</p>\n<p>La r&eacute;alisation de cette base a b&eacute;n&eacute;fici&eacute; de la collaboration des organisations professionnelles.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1711/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/220> .
    
    <http://bauhaus/documents/document/220>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête Réseaux du commerce de détail"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-03-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_enquete.pdf> .
    
    <http://bauhaus/qualite/attribut/1711/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1711/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1711/S.3.6/text> , <http://bauhaus/qualite/attribut/1711/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enterprises surveyed are at the head of one or more networks of 7 establishments or more in the retail (excluding pharmacies) and small-scale commercial fields.</p>\n<p>Sectors surveyed in the NAF rev. 1 700 level classification:<br />151F, 158B, 158C, 158D, 521A, 521B, 521C, 521D, 521E, 521F, 521H,&nbsp;521J, 522A, 522C, 522G, 522J, 522N, 522P, 523C, 523E, 524A, 524E, 524F, 524C, 524H, 524J, 524L, 524N, 524P, 524R, 524T, 524U 524V, 524W, 524X, 524Z and 525Z.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1711/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1711/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e en deux vagues portant sur les ann&eacute;es 2005 (21 secteurs d'activit&eacute;s concern&eacute;s - hors habillement et chaussures) et 2006 (16 secteurs d'activit&eacute; restants).</p>\n<p>Le mode de collecte diff&egrave;re selon que l'entreprise interrog&eacute;e est &agrave; la t&ecirc;te d'un seul ou de plusieurs r&eacute;seaux : questionnaire papier adress&eacute; par voie postale aux entreprises rep&eacute;r&eacute;es comme &eacute;tant les t&ecirc;tes de r&eacute;seaux d'un seul r&eacute;seau recens&eacute;, suivi personnalis&eacute; des entreprises &agrave; la t&ecirc;te de plusieurs r&eacute;seaux recens&eacute;s.</p>\n<p>Toutes les t&ecirc;tes de r&eacute;seaux recens&eacute;es sont interrog&eacute;es, mais uniquement dans le cadre de leurs r&eacute;seaux du commerce de d&eacute;tail.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1711/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1711/I.18.10/text> , <http://bauhaus/qualite/attribut/1711/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1711/S.3.4/texte> , <http://bauhaus/qualite/attribut/1711/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1711> .
    
    <http://bauhaus/qualite/attribut/1711/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey was carried out in two waves focusing on the years 2005 (21 business sectors concerned - excluding clothing and footwear) and 2006 (16 remaining business sectors).</p>\n<p>The collection method differed according to whether the enterprise surveyed was the head of a single network or several networks: paper questionnaire sent by post to the enterprises identified as being the&nbsp;heads of networks of a single listed network, and customised monitoring of enterprises at the head of several listed networks.</p>\n<p>All of the listed network heads were surveyed, but only in the framework of their retail trade networks.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1505> {
    <http://bauhaus/qualite/attribut/1505/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Personne r&eacute;sidant, travaillant ou connaissant un &eacute;v&eacute;nement d'&eacute;tat-civil sur le territoire national.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/589>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'échantillon démographique permanent de l'Insee"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2006-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/echantillon_demograp_permanent_courrier_stat117_119.pdf> .
    
    <http://bauhaus/qualite/attribut/1505/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Birth rate;<br />- Mortality;<br />- Marriages and partnerships;<br />- Social origins;<br />- Family situation;<br />- Qualification and level of studies;<br />- Profession;<br />- Status of activity;<br />- Housing;<br />- Place of residence.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1505/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1505/S.3.4/texte> , <http://bauhaus/qualite/attribut/1505/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1505/S.10.6/texte> , <http://bauhaus/qualite/attribut/1505/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1505/I.18.10/text> , <http://bauhaus/qualite/attribut/1505/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The general principle is to record the information featuring in the civil register or in census returns for all persons born on&nbsp;one of the designated EDP days.<br /><br />All persons born in France on one of these days are integrated into the EDP at birth, and the information given on their birth certificate is recorded.<br /><br />Other residents, those not born in France, are integrated into the EDP after each census, on the basis of information taken from census declarations.<br /><br />Once a person is registered in the Permanent Demographic Sample, any new information concerning them is added to their records.&nbsp;This includes events recorded on the civil register (marriages, births, deaths) and census information (details of the person, their housing and, where relevant, those living at the same address: partners, parents, children).<br /><br />Data comparison is carried out within the rules stipulated in Decree n&deg;84-393 of May 23rd 1984, by agreement with the National Commission for Information Technology and Liberties (CNIL).<br /><br />Data concerning deceased individuals for whom a death certificate has been received by INSEE will remain in the EDP.<br /><br />The sample will thus continue to grow over the years. Data storage and access to information which has had all identities removed are governed by strict conditions intended to guarantee confidentiality.<br /><br /></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1505/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'&eacute;chantillonnage s'apparente &agrave; un tirage al&eacute;atoire simple, mis en &oelig;uvre simplement en fonction de la date de naissance de la personne.</p>\n<p>Il correspond grosso modo &agrave; un sondage au 100&egrave;me de la population (4 jours de naissance) pour la p&eacute;riode 1967-1999 puis &agrave; un sondage au 4/100&egrave;me pour la p&eacute;riode r&eacute;cente, suite au quadruplement de l'&eacute;chantillon (16 jours de naissance).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1505/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Persons residing on French territory</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1505/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- F&eacute;condit&eacute; ;<br />- Mortalit&eacute; ;<br />- Nuptialit&eacute; ;<br />- Origines sociales ;<br />- Situation familiale ;<br />- Qualification et niveau de dipl&ocirc;me ;<br />- Profession ;<br />- Situation d'activit&eacute; ;<br />- Niveau de vie ;<br />- Revenu salarial ;<br />- Logement ;<br />- Lieu de r&eacute;sidence ;<br />- Inscriptions &eacute;lectorales.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1505/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/rapport/1505>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Échantillon démographique permanent"@fr , "Quality report: Permanent Demographic Sample"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1166> .
    
    <http://bauhaus/qualite/attribut/1505/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le principe g&eacute;n&eacute;ral consiste &agrave; conserver pour les individus appartenant &agrave; l'&eacute;chantillon des informations collect&eacute;es dans les cinq sources statistiques qui alimentent l'EDP.<br />Les personnes n&eacute;es en France sont int&eacute;gr&eacute;es &agrave; leur naissance, avec l'enregistrement d'informations issues de leur bulletin de naissance.<br />Les autres personnes, n&eacute;es hors de France, sont int&eacute;gr&eacute;es dans l'EDP &agrave; l'occasion d'un recensement, d'une activit&eacute; salari&eacute;e, d'une d&eacute;claration fiscale, d'un mariage ou de la naissance d'un enfant.<br />Quand la personne est d&eacute;j&agrave; dans l'&eacute;chantillon d&eacute;mographique permanent, les nouvelles informations viennent compl&eacute;ter celles d&eacute;j&agrave; accumul&eacute;es.<br />Quand la personne d&eacute;c&egrave;de, sa trajectoire est interrompue mais les donn&eacute;es sont conserv&eacute;es pour pouvoir &eacute;tudier les trajectoires pass&eacute;es. La taille de l'&eacute;chantillon ne fait donc que cro&icirc;tre au fil des ann&eacute;es.<br />Le rapprochement des informations est fait dans le cadre de l'arr&ecirc;t&eacute; du 6 ao&ucirc;t 2014 \" portant cr&eacute;ation d'un traitement automatis&eacute; de donn&eacute;es &agrave; caract&egrave;re personnel relatif &agrave; l'&eacute;chantillon d&eacute;mographique permanent de l'INSEE \" , apr&egrave;s accord de la Commission&nbsp;nationale de l'informatique et des libert&eacute;s (Cnil).<br />La conservation des donn&eacute;es et l'acc&egrave;s aux informations anonymis&eacute;es s'effectuent dans des conditions strictes de fa&ccedil;on &agrave; garantir leur confidentialit&eacute;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/589> .
    
    <http://bauhaus/qualite/attribut/1505/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1505/S.3.6/text> , <http://bauhaus/qualite/attribut/1505/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1505> .
    
    <http://bauhaus/qualite/attribut/1505/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sample is selected by a simple random process, based solely on a person's date of birth, in line with the amended decree of&nbsp;May 23rd 1984.</p>\n<p>The sample corresponds broadly to a survey of 1% of the population (4 dates of birth in the year). A decree of December 21st 2006 authorised a quadrupling of the sample size (16 dates of birth).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
