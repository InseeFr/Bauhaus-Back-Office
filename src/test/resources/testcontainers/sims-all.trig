<http://rdf.insee.fr/graphes/qualite/rapport/1861> {
    <http://bauhaus/qualite/attribut/1861/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est effectu&eacute;e en janvier, avril, juillet et octobre.<br />Il s'agit d'une enqu&ecirc;te par panel : on interroge les occupants du logement pendant 5 trimestres cons&eacute;cutifs.<br />La premi&egrave;re et la derni&egrave;re interrogation d'un m&eacute;nage sont r&eacute;alis&eacute;es par visite (et apr&egrave;s tout changement de locataire ou en cas&nbsp;de difficult&eacute; &eacute;ventuelle d'obtention des informations par t&eacute;l&eacute;phone). Les interrogations interm&eacute;diaires sont men&eacute;es par t&eacute;l&eacute;phone.<br /><br />Enqu&ecirc;te en Guadeloupe depuis octobre 2010.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Since 1958</p>"@en , "<p>Depuis 1958</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/documents/document/241>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Pourquoi les ménages pauvres paient-ils des loyers plus ou moins élevés ? L’incidence des aides au logement en France"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-10-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/enq_loyer_charges_incidences_revenus.pdf> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Caract&eacute;ristiques de l'immeuble, du logement (dont les &eacute;l&eacute;ments de confort) ;<br />- Mode de location et aides per&ccedil;ues ;<br />- Montants des loyers et des charges.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Characteristics of the residential building and accommodation (including conveniences);<br />- Rental method and benefits received;<br />- Total amounts of rents and charges.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/rapport/1861>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Rents and Charges Survey 2016"@en , "Rapport qualité : Enquête Loyers et charges 2016"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1414> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Ensemble des r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation.<br />Depuis 2013 pour la m&eacute;tropole et depuis juillet 2017 pour la Guadeloupe, l'enqu&ecirc;te&nbsp;porte uniquement sur les loyers du secteur libre (les logements du secteur HLM sont interrog&eacute;s via l'enqu&ecirc;te ELBS).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1861/S.3.6/texte> , <http://bauhaus/qualite/attribut/1861/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Collection is carried out in January, April, July and October.<br />This is a panel survey: the occupants of the accommodation are interviewed during 5 consecutive quarters.<br />The first and last interviews of a household are conducted by visits (and after any&nbsp;change of tenant, or in the event of any difficulties in obtaining information by telephone). Intermediate surveys are conducted by telephone.<br /><br />Survey in Guadeloupe since October 2010.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1861/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/241> .
    
    <http://bauhaus/qualite/attribut/1861/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1861/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Each quarter, approximately 3,700 homes in Metropolitan France and 600 in Guadeloupe form part of the sample to be surveyed.<br />These are main residences rented in an unfurnished state, whose main purpose is residential: the accommodation concerned must not have more than 50% of its surface area used for a professional activity.<br />Sub-let accommodation, leases with purchase options (or rental/purchase schemes) and accommodation occupied on a free basis, are excluded from the field of the survey.<br />The sample is drawn from the INSEE master sample (derived from the population census).<br />One fifth of the sample is renewed each quarter: the outgoing sample consists of accommodation surveyed 5 times and accommodation which fell outside the scope of the previous survey.<br />Each quarter, the outgoing sub-sample is replaced by an incoming sub-sample.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1861/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1861/I.18.10/texte> , <http://bauhaus/qualite/attribut/1861/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Chaque trimestre, environ 3 700 logements en m&eacute;tropole et 600 en Guadeloupe font partie de l'&eacute;chantillon &agrave; enqu&ecirc;ter.<br />Il s'agit de r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation : les logements concern&eacute;s ne doivent pas avoir plus de 50 % de leur surface consacr&eacute;e &agrave; une activit&eacute; professionnelle.<br />Sont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occup&eacute;s &agrave; titre gratuit.<br />L'&eacute;chantillon est tir&eacute; dans l'&eacute;chantillon ma&icirc;tre de l'Insee (issu du recensement de la population).<br />Un cinqui&egrave;me de l'&eacute;chantillon est renouvel&eacute; chaque trimestre : l'&eacute;chantillon sortant se compose des logements interrog&eacute;s 5 fois&nbsp;et des logements hors champ &agrave; l'enqu&ecirc;te pr&eacute;c&eacute;dente.<br />On effectue chaque trimestre le remplacement du sous-&eacute;chantillon sortant par un sous &eacute;chantillon entrant.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1861/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "-dg75-F330@insee.fr"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1861/S.3.4/text> , <http://bauhaus/qualite/attribut/1861/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All main residences rented in an unfurnished state which essential reason for the rental is housing.<br />Since 2013 for metropolitan France and since July 2017 for Guadeloupe, the scope of the survey has been restricted to the private sector (social sector is collected through the quarterly survey on the rents of the social sector).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1861/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017T012EC"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
    
    <http://bauhaus/qualite/attribut/1861/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1861/S.18.3/texte> , <http://bauhaus/qualite/attribut/1861/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1861> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1740> {
    <http://bauhaus/qualite/attribut/1740/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/P> , <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1740/I.18.10/texte> , <http://bauhaus/qualite/attribut/1740/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F340> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey is consistent with regulation no. 808/2004 adopted on 21 April 2004 by the European Parliament and Council of Ministers concerning the implementation of the eEurope 2005 action plan dedicated to ICTs.</p>\n<p>This framework Regulation provides for the conduct of an annual survey, for the purpose of collecting data concerning the equipment and behaviour of households and individuals with regard to information and communication technologies (ICTs).<br />Each Member State must provide approximately 130 indicators for EUROSTAT.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1740/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1740/S.3.6/texte> , <http://bauhaus/qualite/attribut/1740/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey investigates:</p>\n<p>- The extent to which households are equipped with internet access (including internet via mobile phone, computer or tablet;<br />- Their uses and frequencies of use and their use of eGovernment and e-commerce.</p>\n<p>Every year, the Information and Communication Technologies Survey assesses an item thanks to a specific module:</p>\n<p>- In 2009, E-commerce and trust<br />- In 2010, internet security<br />- In 2011, people's skills in information technology and internet (&ldquo;e-skills&rdquo;) and how they have learned them<br />- In 2012, the mobile use of the internet<br />- In 2013, the use of e-Government<br />- In 2014, the use of Cloud Services<br />- In 2015, Internet security<br />- In 2016, confidentiality and protection of privacy<br />- In 2017, questions on the use of the Internet and the use of e-commerce have been expanded, and an extension is carried out in the DOM<br />- In 2018, ICT at work<br />- In 2019, E-skills</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1740/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1740/S.19/texte> , <http://bauhaus/qualite/attribut/1740/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-F001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>From 2007 to 2010 the sampling base consisted of the telephone numbers of subscribers listed in the France Telecom directory. The following were excluded: households without a telephone, those listed as ex-directory or included on the \"liste orange\" (anti-canvassing list) and people solely equipped with a GSM telephone (cellular and mobile), or whose line is completely unbundled. Approximately 7,000 households residing in metropolitan France were surveyed. The survey is also administered by telephone to about 100 households in each French Overseas Department (DOM).</p>\n<p>From 2011 to 2018, the sample of the ICT survey in metropolitan France&nbsp;consists of households taken from the French Local Residence Tax. Since 2019, the sample has been selected in Fid&eacute;li.</p>\n<p>The survey was conducted according to two modes of collection:<br />- a sample of households whose phone number is in the directory \"white pages\" is surveyed by phone;<br />- a sample of households not present in the \"white pages\" directory is interviewed by Internet/paper. A mail is sent to the households and they can respond to it either by completing a paper questionnaire or by logging on to a website where the respondent can complete the questionnaire online.</p>\n<p>In the DOM, the same protocol was established for Reunion and Martinique in 2011, and Guadeloupe and French Guyana in 2014.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1740/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1740/S.3.4/texte> , <http://bauhaus/qualite/attribut/1740/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1740/S.18.3/texte> , <http://bauhaus/qualite/attribut/1740/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>INSEE / DG, 88 avenue Verdier, CS 70058, 92541 MONTROUGE CEDEX</p>"@fr , "<p>INSEE / DG, 88 avenue Verdier, CS 70058, 92541 MONTROUGE CEDEX</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>M&eacute;nages dans lesquels une personne au moins est &acirc;g&eacute;e de 15 ans ou plus.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1740/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted by telephone in April and May of each year. A computer-assisted data collection method (CAPI) is used. In 2008, households that were not registered in the France Telecom directory were interviewed on a face-to-face basis, as part of a supplementary scheme with a methodological purpose.</p>\n<p>Since 2010, a supplementary survey by internet and paper enables to cover all the population (see &ldquo;Sampling plan&rdquo;). It replaces the face to face survey conducted in 2008.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1740/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Entre 2007 et 2010, la base de sondage &eacute;tait constitu&eacute;e des num&eacute;ros de t&eacute;l&eacute;phone d'abonn&eacute;s figurant dans l'annuaire de France T&eacute;l&eacute;com. &Eacute;taient donc exclus les m&eacute;nages n'ayant pas le t&eacute;l&eacute;phone, ceux inscrits sur la liste rouge ou orange, ceux disposant uniquement d'un t&eacute;l&eacute;phone GSM (cellulaire, portable) ou dont la ligne est totalement d&eacute;group&eacute;e. Environ 7&nbsp;000 m&eacute;nages r&eacute;sidant en France m&eacute;tropolitaine &eacute;taient interrog&eacute;s. L'enqu&ecirc;te &eacute;tait &eacute;galement r&eacute;alis&eacute;e, par t&eacute;l&eacute;phone, &agrave; hauteur d'une centaine de m&eacute;nages dans chaque d&eacute;partement d'outre-mer (DOM).</p>\n<p>De 2011 &agrave; 2018, l'&eacute;chantillon de l'enqu&ecirc;te TIC en m&eacute;tropole est constitu&eacute; de m&eacute;nages tir&eacute;s dans la Taxe d'Habitation.<br />Depuis 2019, l&rsquo;&eacute;chantillon est tir&eacute; dans Fid&eacute;li.</p>\n<p>L'enqu&ecirc;te s'est faite selon deux modes de collecte&nbsp;:<br />- un &eacute;chantillon de m&eacute;nages dont le num&eacute;ro de t&eacute;l&eacute;phone se trouve dans l'annuaire \"&nbsp;pages blanches&nbsp;\" sont enqu&ecirc;t&eacute;s par t&eacute;l&eacute;phone&nbsp;;<br />- un &eacute;chantillon de m&eacute;nages non pr&eacute;sents dans l'annuaire \"&nbsp;pages blanches&nbsp;\" sont interrog&eacute;s par Internet/papier&nbsp;: un courrier est envoy&eacute; aux m&eacute;nages et ils peuvent r&eacute;pondre soit en remplissant un questionnaire papier, soit en se connectant sur un site Internet o&ugrave; le r&eacute;pondant peut remplir le questionnaire en ligne.</p>\n<p>Dans les DOM, le m&ecirc;me protocole a &eacute;t&eacute; mis en place en 2011 pour la R&eacute;union et la Martinique, et en 2014 pour la Guadeloupe et la Guyane.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1740/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Households in which at least one person is aged 15 or over.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1740/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'interrogation porte&nbsp;:</p>\n<p>- sur l'&eacute;quipement des m&eacute;nages en&nbsp;acc&egrave;s &agrave; Internet (y compris par smartphone, ordinateur ou tablette&nbsp;;<br />- leurs usages et fr&eacute;quence d'utilisation, le recours &agrave; l'administration et au commerce en ligne.</p>\n<p>Chaque ann&eacute;e, l'enqu&ecirc;te sur les technologies de l'information et de la communication (TIC) &eacute;value un sujet particulier &agrave; travers un module sp&eacute;cifique&nbsp;:</p>\n<p>- en 2009, l'achat en ligne de biens par internet<br />- en 2010, la s&eacute;curit&eacute; sur internet<br />- en 2011, les comp&eacute;tences en informatique et en internet des individus et leurs modes d'acquisition<br />- en 2012, l&rsquo;utilisation de l&rsquo;internet mobile<br />- en 2013, l&rsquo;utilisation des sites administratifs<br />- en 2014, l&rsquo;utilisation des sites de partage ou de stockage de fichier (cloud)<br />- en 2015, la s&eacute;curit&eacute; internet<br />- en 2016, la confidentialit&eacute; et protection de la vie priv&eacute;e<br />- en 2017, les questions sur l'utilisation d'internet et le recours au e-commerce sont &eacute;toff&eacute;es, et une extension est conduite dans les DOM<br />- en 2018, l'usage des TIC au travail<br />- en 2019, les comp&eacute;tences en informatique</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1740/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2019-04-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/H> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>In 2018, the telephone survey sample consists of 3,500 households in metropolitan France and about 100 households in each of the four overseas departments. The sample of the internet/paper survey is composed of 22,000 households in metropolitan France and 1,000 households in the four French overseas departments.</p>"@en , "<p>En 2018, l'&eacute;chantillon de l'enqu&ecirc;te t&eacute;l&eacute;phonique est compos&eacute; de 3&nbsp;500 m&eacute;nages en m&eacute;tropole et d'une centaine de m&eacute;nages dans chacun des quatre DOM. L'&eacute;chantillon de l'enqu&ecirc;te internet/papier est compos&eacute; de 22&nbsp;000 m&eacute;nages en m&eacute;tropole et de 1&nbsp;000 m&eacute;nages pour les quatre DOM.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/attribut/1740/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te a lieu en avril et mai de chaque ann&eacute;e par t&eacute;l&eacute;phone. La collecte est assist&eacute;e par informatique (Capi). Les m&eacute;nages non pr&eacute;sents dans l'annuaire ont &eacute;t&eacute; enqu&ecirc;t&eacute;s en face &agrave; face en 2008, dans le cadre d'un dispositif compl&eacute;mentaire &agrave; but m&eacute;thodologique.</p>\n<p>Depuis 2010, une enqu&ecirc;te compl&eacute;mentaire par internet et par voie postale est r&eacute;alis&eacute;e pour couvrir l'ensemble de&nbsp;la population (cf. plan de sondage). Elle remplace l'enqu&ecirc;te en face &agrave; face r&eacute;alis&eacute;e en 2008.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1740/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te s'inscrit dans le cadre du r&egrave;glement n&deg;808/2004 adopt&eacute; en date du 21 avril 2004 par le Parlement europ&eacute;en et le Conseil des ministres concernant la mise en &oelig;uvre du plan d'action eEurope 2005 consacr&eacute; aux TIC.</p>\n<p>Ce r&egrave;glement cadre pr&eacute;voit la r&eacute;alisation d'une enqu&ecirc;te annuelle destin&eacute;e &agrave; collecter des donn&eacute;es sur l'&eacute;quipement et les comportements des m&eacute;nages et des individus en mati&egrave;re de technologies de l'information et de la communication (TIC).<br />Chaque &Eacute;tat membre doit fournir &agrave; Eurostat environ 130 indicateurs.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1740/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1740> .
    
    <http://bauhaus/qualite/rapport/1740>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport de métadonnées 1740"@fr , "Metadata report 1740"@en .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1534> {
    <http://bauhaus/qualite/attribut/1534/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1534/S.18.3/text> , <http://bauhaus/qualite/attribut/1534/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/526> .
    
    <http://bauhaus/qualite/attribut/1534/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1534/S.3.4/text> , <http://bauhaus/qualite/attribut/1534/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The coverage is all the groups for which the main center of decision is in France and controlling at least a company implanted outside France. The selection of the groups to be investigated is made from the file stemming from the survey on financial links (Lifi) which gives the outlines of groups and an information on the foreign subsidiaries. INSEE questions yearly about 2,500 groups of the non-financial sectors with at least one subsidiary outside France. The results of the survey are statistically adjusted for partial and total non-response. Due to the dominant role of major groups in the global economy, the largest groups that have not responded are subject to a specific treatment, based on information about their foreign affiliates available in their yearly reports."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1534/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1534/S.19/text> , <http://bauhaus/qualite/attribut/1534/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey contains the three variables to be necessarily supplied, as from 2011 concerning 2009, for France: the turnover, the staff and the number of subsidiaries by country of presence of subsidiaries and by business sector. It also integrates some additional variables among which the costs of staff and the physical investment. This OFATS survey questions the French groups on the same parameters of their locations abroad: number of affiliates by country and activity sector, and turnover and manpower of these subsidiaries. The survey includes three variables that appear in the FATS regulation and are necessarily required: the number of subsidiaries, their number of employees and their turnover by country and activity sector."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/517>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Les investissements directs français à l'étranger et étrangers en France en 2009 "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Etudes_Banque_France_OFATS.pdf> .
    
    <http://bauhaus/qualite/attribut/1534/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/documents/document/526>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2009 de l'enquête européenne sur l'activité des filiales étrangers des groupes français / OFATS"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-06-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_OFATS_2009.pdf> .
    
    <http://bauhaus/qualite/attribut/1534/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1534/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection is made from May for large MNE and from September for the others. The units \"UCI\" are questioned either by (via) Internet, or by an Excel file for large companies."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1534/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Cette enquête comporte les trois variables à fournir obligatoirement, à compter de 2011 sur l'exercice 2009, pour la France : le chiffre d'affaires, les effectifs et le nombre de filiales par pays d'implantation des filiales et par secteur d'activité. Elle intègre également quelques variables additionnelles dont les coûts de personnel et l'investissement corporel."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1534/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1534/I.18.10/text> , <http://bauhaus/qualite/attribut/1534/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte s'effectue à compter du mois de juin pour les très grands groupes et à compter de septembre pour les autres. Les unités UCI sont interrogés par (via) Internet. Le support excel est toutefois proposé aux plus grands groupes."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1534/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1534/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All merchant activity sectors are concerned (excluded financial sector).</p>\n<p>\" UCI \" : Ultimate Controlling Institutional unit.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1534/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Tous les secteurs d'activit&eacute; marchands sont concern&eacute;s, &agrave; l'exception du secteur bancaire du ressort de la Banque de France.</p>\n<p>L'unit&eacute; enqu&ecirc;t&eacute;e est l' \" UCI \" : Ultimate Controlling Institutional unit. Cette unit&eacute; d&eacute;finie par Eurostat correspond &agrave; l'unit&eacute; qui exerce le contr&ocirc;le des filiales d&eacute;clar&eacute;es dans l'enqu&ecirc;te. Ce contr&ocirc;le se caract&eacute;rise par le pouvoir de nommer les dirigeants des soci&eacute;t&eacute;s ou des business units en charge des activit&eacute;s op&eacute;rationnelles. L'UCI est aussi l'unit&eacute; qui dispose des donn&eacute;es de toutes les filiales du groupe.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1534>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête européenne sur l'activité des filiales étrangères des groupes français 2009"@fr , "Quality report: European survey on activities of subsidiaries under national control implanted in foreign countries 2009"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1058> .
    
    <http://bauhaus/qualite/attribut/1534/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1534/S.3.6/texte> , <http://bauhaus/qualite/attribut/1534/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
    
    <http://bauhaus/qualite/attribut/1534/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ est l'ensemble des groupes dont le principal centre de décision (UCI) est en France et contrôlant au moins une société implantée hors de France. La sélection des groupes à enquêter est faite à partir du fichier issu de l'enquête sur les liaisons financières (Lifi) qui donne les contours de groupes et une information sur les implantations étrangères de rang 1. Tous les ans, ce sont environ 2 500 groupes français ayant au moins une filiale hors de France quel que soit le secteur d'activité du groupe (à l'exception du secteur bancaire couvert par la Banque de France) qui sont sélectionnés pour être interrogés au titre de l'enquête OFATS. Conformément au règlement Eurostat, aucun seuil de taille de chiffre d'affaires ou d'effectifs n'a été appliqué."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1534/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "For groups of the financial sector, the Banque de France produces the required statistics from the data it collects through its own surveys and prudential enquiries. The Banque de France transmits their results to Insee which is in charge of the treatment of confidentiality and the sent to Eurostat."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1534/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte de l'enquête est réalisée par le SSNE (Service de Statistiques National d'Entreprises) en DR Basse-Normandie. Le règlement n° 716/2007 relatif aux FATS impose à chaque Etat membre de fournir annuellement les données OFATS en laissant le choix de la méthode. Certains pays utilisent les données FDI (flux directs d'investissements). Les données OFATS relatives au secteur bancaire sont élaborées par la banque de France puis transmises à l'Insee qui est responsable du traitement de la confidentialité de l'ensemble des données et de la transmission du fichier finalisé à Eurostat."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/518>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête OFATS, méthodologie et premiers résultats de l'enquête pilote 2007"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-07-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_enquete_pilote_OFATS.pdf> .
    
    <http://bauhaus/qualite/attribut/1534/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/517> , <http://bauhaus/documents/document/518> .
    
    <http://bauhaus/qualite/attribut/1534/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/G> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1534> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1776> {
    <http://bauhaus/documents/document/115>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Une meilleure prise en compte de la démographie d’entreprises dans les indices mensuels de chiffre d’affaires via une exploitation de l'exhaustivité des déclarations mensuelles de TVA"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/ICA_demographie_entreprises.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Since January 2009, the turnover indices have been calculated according to the NA aggregated classification based on NAF rev. 2, which came into force on January 1st, 2008.<br />They cover the following sectors:<br />- Wholesale trade (Division 46), excluding cars and motorcycles;<br />- Transport and warehousing (Section H);<br />- Information and communication (Section J);<br />- Real-estate activities (Section L);<br />- Specialised scientific and technical activities (Section M);<br />- Administrative services and support activities (Section N).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/626>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "A better taking into account of companies demography in monthly turnover indexes by a complete exploitation of monthly VAT returns"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/ICA_demographie_entreprises_en.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de chiffre d'affaires sont construits &agrave; partir d'une source fiscale, le formulaire CA3, que doivent remplir les entreprises pour le paiement de la taxe sur la valeur ajout&eacute;e (TVA) tous les mois ou tous les trimestres.<br /><br />Les d&eacute;clarations trimestrielles sont mensualis&eacute;es par l'Insee en r&eacute;partissant leur montant sur chaque mois du trimestre.<br /><br />Population statistique&nbsp;: France enti&egrave;re (&agrave; l'exception de la Guyane et de Mayotte non assujettis &agrave; la TVA)</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1776/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/documents/document/85>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indice de chiffre d'affaires dans le commerce de gros et divers services aux entreprises base 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-04-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_ICA_Commerce_Gros_Services_Entreprises_2010.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A partir de janvier 2009, les indices de chiffre d'affaires dans le commerce de gros et divers services aux entreprises sont calcul&eacute;s selon la nomenclature NAF r&eacute;v. 2, entr&eacute;e en vigueur le 1er janvier 2008.<br />Ils couvrent les secteurs suivants :<br />- Commerce de gros (Division 46), &agrave; l'exception des automobiles et motocycles ;<br />- Transport et entreposage (Section H) ;<br />- Information et communication (Section J) ;<br />- Activit&eacute;s immobili&egrave;res (Section L) ;<br />- Activit&eacute;s sp&eacute;cialis&eacute;es, scientifiques et techniques (Section M) ;<br />- Activit&eacute;s de services administratifs et de soutien (Section N).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1776/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1776/S.3.6/text> , <http://bauhaus/qualite/attribut/1776/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/documents/document/114>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rénovation de la méthodologie de calcul des indices de chiffre d’affaires –  Présentation et analyse des impacts"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/ICA_Analyse_impacts_nouvelle_methodologie_2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The turnover indices are calculated based on tax data, i.e. the CA3 form, which businesses must fill in for the payment of value-added tax (VAT) on a monthly or quarterly basis.<br /><br />The quarterly declarations are converted into monthly figures by INSEE by breaking down the amount over each month of the quarter.<br /><br />Statistical population: \"Whole France\" (except French Guyana and Mayotte which are not liable to VAT)</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1776/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les entreprises déclarant mensuellement la TVA sont celles relevant du régime fiscal réel normal. Ce régime concerne les entreprises prestataires de services réalisant un chiffre d'affaires supérieur à 236 000 euros ainsi que les entreprises de vente de marchandises et de fourniture de logement réalisant un chiffre d'affaire supérieur à 783 000 euros. Les entreprises dont le montant de TVA exigible annuellement ne dépasse pas 4 000 euros dans l'année peuvent toutefois effectuer des déclarations trimestrielles."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1776/S.18.3/text> , <http://bauhaus/qualite/attribut/1776/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/documents/document/89>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indice de chiffre d'affaires dans le commerce de gros et divers services aux entreprises rénové base 2010 "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-04-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICA_GROS_2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>&Agrave; compter du 1er avril 2017, la m&eacute;thodologie change :&nbsp; voir Indice de production dans les services, Indice de chiffre d'affaires dans les services, Volume des ventes dans le commerce et Indice de chiffre d'affaires dans le commerce<br /><br />&Agrave; compter de 2016 le calcul des indices de chiffre d'affaires est r&eacute;alis&eacute; &agrave; partir de l'exhaustivit&eacute; des d&eacute;clarations mensuelles de la source fiscale. Cette nouvelle m&eacute;thodologie de calcul des indices a &eacute;t&eacute; mise en &oelig;uvre pour mieux prendre en compte la d&eacute;mographie des entreprises et ainsi refl&eacute;ter plus pr&eacute;cis&eacute;ment la r&eacute;alit&eacute; &eacute;conomique. En effet les indices de chiffre d'affaires d'une ann&eacute;e N pr&eacute;c&eacute;demment calcul&eacute;s ne prenaient pas en compte les cr&eacute;ations d'entreprises, cessations, entr&eacute;es et sorties de champ et changement de secteur survenues au cours de l'ann&eacute;e N, l'&eacute;chantillon &eacute;tant tir&eacute; au 31/12 de l'ann&eacute;e N-1. Dans le cadre d'un projet de r&eacute;novation des indices de chiffres d'affaires, des solutions ont &eacute;t&eacute; mises en &oelig;uvre pour corriger ce biais et produire des indices de chiffre d'affaires de meilleure qualit&eacute;. Il s'agit, d'une part, de s'affranchir des &eacute;chantillons annuels en exploitant la totalit&eacute; des d&eacute;clarations mensuelles de TVA, les progr&egrave;s de l'informatique permettant aujourd'hui de traiter de tr&egrave;s&nbsp;gros volumes de donn&eacute;es, d'autre part de s'appuyer sur le r&eacute;pertoire statistique Sirus &agrave; la place du r&eacute;pertoire administratif Sirene, de mani&egrave;re &agrave; b&eacute;n&eacute;ficier d'une mise &agrave; disposition beaucoup plus rapide et automatis&eacute;e des &eacute;v&eacute;nements d&eacute;mographiques les plus r&eacute;cents ayant affect&eacute; les entreprises.<br />Les indices de chiffre d'affaires dans le commerce de gros et divers services aux entreprises sont des indices mensuels en valeur (en euros courants hors taxe). Ces indices sont calcul&eacute;s en r&eacute;f&eacute;rence 100 en 2010 (les indices ont pour moyenne 100 en 2010). Ils sont calcul&eacute;s comme des indices de Laspeyres, &agrave; pond&eacute;rations constantes dans le temps des indices les plus fins, et font l'objet d'un rebasement tous les 5 ans.<br />Les indices de chiffre d'affaires et de volume des ventes sont corrig&eacute;s des variations saisonni&egrave;res (CVS) et des effets de calendrier (correction des jours ouvrables &ndash; CJO).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/116> , <http://bauhaus/documents/document/115> , <http://bauhaus/documents/document/89> , <http://bauhaus/documents/document/85> , <http://bauhaus/documents/document/114> .
    
    <http://bauhaus/qualite/attribut/1776/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Companies which are monthly declaring VAT are those falling under the \"actual normal tax system\". This system applies to service provider companies generating a turnover of more than € 236,000 as well as to companies selling goods or dwellings and generating a turnover of more than € 783,000. Companies for which value added tax due amount doesn't exceed € 4,000 for a given year may however present VAT declarations quarterly."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1776/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1776/S.18.1/texte> , <http://bauhaus/qualite/attribut/1776/S.18.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1776/S.19/text> , <http://bauhaus/qualite/attribut/1776/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/documents/document/619>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Turnover in the wholesale trade and business services"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-08-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_EN_BREF_GROS_2016_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Turnover indices are calculated based on tax data, i.e. the CA3 declaration, the form which businesses must fill in each month or each quarter for the payment of VAT;<br />They include the full turnover of declaring businesses, all activities included, classified according to the business's principal activity.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1776/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Effective April 1, 2017, the methodology changes:&nbsp; See Services Production index, Turnover index in services, Sales volume index in trade and Turnover index in trade.<br /><br />From 2016 the calculation of the turnover indices is realised from the exhaustivity of the monthly declarations of the fiscal source. This new methodology of calculation of the indices was implemented to take better into account the demography of companies and so it shows more precisely the economic reality. Indeed the indices of turnover of one year N previously calculated did not take into account new business start-ups, terminations, entrances into the statistic&nbsp;sphere, exits of the statistic sphere, and changes of sector which happened during the year N, the sample being done the 31/12 of the year N-1. Within the framework of a project for a renovation of the turnovers indices, solutions were implemented to correct this bias and to produce turnover indices with better quality. On one hand, annual samples will not be used anymore and all of the monthly declarations of VAT will be exploited, the progress of the computing allowing to handle very big volumes of data nowadays; on the other hand,&nbsp; the statistical directory Sirus will be used instead of the administrative directory Siren, so as to benefit from a provision much faster and automated of the most recent demographic events companies have been affected.<br />Turnover indices in wholesale trade and business services are monthly indices of value in current euros excluding VAT. These indices are calculated in relation to a reference of 100 in 2010 (the indices had a mean of 100 in 2010).<br />They are calculated as Laspeyres indices, with constant weightings over time of the most discriminating indices, and are rebased every five years.<br />Turnover indices in wholesale trade and business services are adjusted for seasonal variations (SDA) and for calendar effects (adjustment for working days &ndash; WDA).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/627> , <http://bauhaus/documents/document/626> , <http://bauhaus/documents/document/619> .
    
    <http://bauhaus/qualite/rapport/1776>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Indice de chiffre d'affaires dans le commerce de gros et divers services aux entreprises"@fr , "Quality report: Turnover index in the wholesale trade and business services"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1635> .
    
    <http://bauhaus/qualite/attribut/1776/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/documents/document/116>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Ce qui a changé pour les indices de chiffre d’affaires depuis le 31 mars 2016"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-04-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICA_chgt2016_note_methodo_FR.pdf> .
    
    <http://bauhaus/documents/document/627>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "What changed for turnover indexes since March 31st"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICA_chgt2016_note_methodo_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1776/S.10.6/text> , <http://bauhaus/qualite/attribut/1776/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de chiffre d'affaires sont construits &agrave; partir d'une source fiscale, la d&eacute;claration CA3, formulaire que doivent remplir les entreprises pour le paiement de la taxe sur la valeur ajout&eacute;e (TVA).<br />Ils comprennent l'ensemble du chiffre d'affaires des entreprises d&eacute;clarantes, toutes activit&eacute;s confondues, class&eacute;es selon l'activit&eacute; principale de l'entreprise.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1776/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1897> {
    <http://bauhaus/qualite/attribut/1897/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par les codes NAF r&eacute;v. 2 : 55.10Z (h&ocirc;tels et h&eacute;bergement similaire).<br /><br />L&rsquo;enqu&ecirc;te concerne les h&ocirc;tels &agrave; vocation touristique, qu'ils soient class&eacute;s ou non.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/documents/document/948>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice relative à l'enquête de fréquentation dans l'hôtellerie 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_explicative_hotel_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1897/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le Comit&eacute; de Coordination des Statistiques du Tourisme (CCST), anim&eacute; par l'Insee, int&egrave;gre les principaux acteurs nationaux du tourisme : DGE, Atout France, f&eacute;d&eacute;rations professionnelles des h&ocirc;teliers et repr&eacute;sentants des comit&eacute;s d&eacute;partementaux et r&eacute;gionaux du tourisme (FNCRT, RN2D). <br />Les besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon national d'environ 12 000 h&ocirc;tels sur un total de 18 000.</p>"@fr , "<p>The survey is conducted on a national sample of about 12,000 hotels from 18,000.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling frame is the file of tourism hotels managed by INSEE.<br />The stratification criteria for the national sample are:<br />- the geographical focus (regions, national tourist areas (ETNs))<br />- hotel category (1 to 5 stars or unclassified)<br />- type of hotel (chain or independent)<br />Within the strata, the draw is random.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/951>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire Réunion - Mayotte de l'enquête de fréquentation dans l'hôtellerie 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_hotel_réunion_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/rapport/1897>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Hotel occupancy survey 2017"@en , "Rapport qualité : Enquête de fréquentation dans l'hôtellerie 2017"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1457> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey covers the activities defined by the NAF rev.2 codes: 55.10Z (hotels and similar accommodation).<br /><br />The survey covers all tourist-oriented hotels, whether classified or not.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1897/S.3.6/texte> , <http://bauhaus/qualite/attribut/1897/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/948> , <http://bauhaus/documents/document/950> , <http://bauhaus/documents/document/949> , <http://bauhaus/documents/document/951> .
    
    <http://bauhaus/documents/document/950>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire France métropolitaine de l'enquête de fréquentation dans l'hôtellerie 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_hotel_métropole_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1897/I.18.10/texte> , <http://bauhaus/qualite/attribut/1897/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e par voie postale ou par internet, ainsi qu'une collecte centralis&eacute;e aupr&egrave;s de certaines enseignes (exemple ACCOR).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concerning the expansion to include overseas departments (DOM), two specific questionnaires were introduced: one for the three DOM in the French Antilles and one for Reunion Island.</p>\n<p>This provides a statistical observation of tourism across the entire French territory.</p>\n<p>This survey falls within the scope of European reglement 692/2011 on the collection of statistical information in the field of tourism in Eurostat.</p>\n<p>It also meets the needs of the national department of tourism and of local and regional actors and decision-makers in the field of tourism.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est le fichier des h&ocirc;tels de tourisme g&eacute;r&eacute; par l'Insee.<br />Les crit&egrave;res de stratification de l'&eacute;chantillon national sont&nbsp;:<br />- l'axe g&eacute;ographique (r&eacute;gions, espaces touristiques nationaux (ETN))<br />- la cat&eacute;gorie d'h&ocirc;tel (1 &agrave; 5 &eacute;toiles ou non class&eacute;)<br />- le type d'h&ocirc;tel (cha&icirc;ne ou ind&eacute;pendant)<br />Au sein des strates, le tirage est al&eacute;atoire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant l'extension aux d&eacute;partements d'outre-mer (DOM), deux questionnaires sp&eacute;cifiques ont &eacute;t&eacute; mis en place : un pour les trois DOM antillais et un pour la R&eacute;union.</p>\n<p>Elle permet ainsi une observation statistique du tourisme sur l'ensemble du territoire fran&ccedil;ais.</p>\n<p>Cette enqu&ecirc;te rentre dans le cadre du r&egrave;glement europ&eacute;en 692/2011 concernant la production d'informations statistiques sur le tourisme &agrave; Eurostat.</p>\n<p>Elle r&eacute;pond &eacute;galement aux besoins nationaux de la direction du tourisme et locaux pour les acteurs et d&eacute;cideurs r&eacute;gionaux du tourisme.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1897/S.3.4/texte> , <http://bauhaus/qualite/attribut/1897/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017M029EC"@fr , "2017M029EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Hotel stock is measured every year on 31 December and occupancy is measured every month.<br /><br />The main topics considered are:<br />- characteristics of the establishment;<br />- accommodation capacity;<br />- daily room occupancy;<br />- arrivals and nights spent by country of residence of tourists;<br />- average length of stay;<br />- proportion of business tourism.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The Comit&eacute; de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry&nbsp;: DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D). <br />The needs of local partners are taken into account through partnership agreements with the tourism sites of Insee.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1897/S.18.3/text> , <http://bauhaus/qualite/attribut/1897/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1897/S.19/texte> , <http://bauhaus/qualite/attribut/1897/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is by post or internet, and&nbsp; centralized collection at some enterprises (example ACCOR).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le parc est mesur&eacute; au 31 d&eacute;cembre de chaque ann&eacute;e et la fr&eacute;quentation sur chaque mois.<br /><br />Les principaux th&egrave;mes abord&eacute;s sont les suivants :<br />- caract&eacute;ristiques de l'&eacute;tablissement ;<br />- capacit&eacute; d'accueil ;<br />- occupation quotidienne des chambres ;<br />- arriv&eacute;es et nuit&eacute;es selon le pays de r&eacute;sidence des touristes ;<br />- dur&eacute;e moyenne de s&eacute;jour ;<br />- proportion de tourisme d'affaires.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2018-07-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1897/S.12.1/text> , <http://bauhaus/qualite/attribut/1897/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/documents/document/949>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire Antilles - Guyane de l'enquête de fréquentation dans l'hôtellerie 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_hotel_antilles_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1897/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1655> {
    <http://bauhaus/qualite/attribut/1655/S.13.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Errors that do not result from sampling are mainly due to total and partial non-response. Measures to reduce these errors include follow-up and controls during collection and the inclusion of non-response in adjustments.</p>"@en ;
