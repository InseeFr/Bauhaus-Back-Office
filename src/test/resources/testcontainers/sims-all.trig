            <http://schema.org/url>  <http://ec.europa.eu/eurostat/statistics-explained/index.php/Lifelong_learning_statistics/fr> .
    
    <http://bauhaus/qualite/attribut/1537/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample consists in 20,000 ordinary housings, It was sampled within the population census. In the end, 13,857 people answered on the various training courses followed during the twelve months preceding the survey (maximum 3 courses were sampled for each person)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
