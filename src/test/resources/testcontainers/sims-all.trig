                    <http://bauhaus/qualite/rapport/1895> .
    
    <http://bauhaus/qualite/attribut/1895/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1895/S.19/texte> , <http://bauhaus/qualite/attribut/1895/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1895> .
    
    <http://bauhaus/qualite/attribut/1895/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1895/S.3.6/text> , <http://bauhaus/qualite/attribut/1895/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1895> .
    
    <http://bauhaus/qualite/attribut/1895/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1895> .
    
    <http://bauhaus/qualite/attribut/1895/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1895/I.18.10/texte> , <http://bauhaus/qualite/attribut/1895/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1895> .
    
    <http://bauhaus/qualite/attribut/1895/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Approximately 7,500 companies are involved in the survey (hypermarkets, supermarkets and multi-commerce stores).</p>\n<p>The sample is about 400 companies; It is exhaustive for companies with a turnover of more than 300 million euros (inclusive of VAT). In the other strata, a draw coordinated positively with the previous editions is implemented.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1895/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ de l'enqu&ecirc;te concerne les entreprises qui g&egrave;rent des supermarch&eacute;s, des hypermarch&eacute;s et/ou des magasins multi-commerces. Environ 9&nbsp;000&nbsp;entreprises entrent dans ce champ. La couverture g&eacute;ographique porte sur la France enti&egrave;re. &nbsp;<br /><br />L'enqu&ecirc;te couvre les activit&eacute;s principales suivantes d&eacute;finies par les codes de la nomenclature d&rsquo;activit&eacute;s fran&ccedil;aise (NAF r&eacute;v. 2 2008)&nbsp;: 47.11D (Supermarch&eacute;s), 47.11E (Magasins multi-commerces) et 47.11F (Hypermarch&eacute;s).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1895/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/941> , <http://bauhaus/documents/document/942> , <http://bauhaus/documents/document/987> , <http://bauhaus/documents/document/988> .
    
    <http://bauhaus/qualite/attribut/1895/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted monthly by Internet : (http://entreprises.insee.fr/).</p>\n<p><br />Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1895/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1895/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1895> .
}

