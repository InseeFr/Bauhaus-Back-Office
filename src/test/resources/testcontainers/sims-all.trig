                    "<p>Octobre 2020 &ndash; juin 2021</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1969/S.11.2>
