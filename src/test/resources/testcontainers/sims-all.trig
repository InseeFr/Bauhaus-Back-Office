            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.7>
                    <http://bauhaus/qualite/attribut/1560/S.10.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
