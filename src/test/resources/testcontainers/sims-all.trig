                    "Rapport qualité : Enquête emploi en continu 2020"@fr , "Quality report: Labour force survey 2020"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1459> .
    
    <http://bauhaus/qualite/attribut/1979/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2018-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Chlo&eacute; Tavan</p>"@fr , "<p>Chlo&eacute; Tavan</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The LFS is defined by the regulation n&deg;577/1998 of the Council of 9 march 1998. This text has been modified and amended. In particular, the regulation n&deg;1991/2002 imposed to have from 2003 a continuous survey, covering all the weeks of the year.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1979/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>The complete year.</p>"@en , "<p>L&rsquo;ensemble de l&rsquo;ann&eacute;e.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1979/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1120> .
    
    <http://bauhaus/qualite/attribut/1979/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1979/S.6.1/texte> , <http://bauhaus/qualite/attribut/1979/S.6.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont collect&eacute;es tout au long de l&rsquo;ann&eacute;e.</p>\n<p>La collecte est effectu&eacute;e sous collecte assist&eacute;e par informatique (Capi), en face-&agrave;-face pour la premi&egrave;re et la derni&egrave;re interrogations, et par t&eacute;l&eacute;phone pour les interrogations interm&eacute;diaires.<br />Si une personne ne peut (ou ne veut) pas r&eacute;pondre, une autre personne peut le faire &agrave; sa place (proxy).</p>\n<p>Une enqu&ecirc;te annuelle sp&eacute;cifique a lieu &agrave; Mayotte.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1979/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1979/I.18.7/text> , <http://bauhaus/qualite/attribut/1979/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
}

