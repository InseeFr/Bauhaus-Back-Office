    <http://bauhaus/qualite/attribut/1589/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers manufacturing industry and extraction industries; divisions 08 to 33 of NAF Rev. 2 (except 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z).<br />Industrial enterprise</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
