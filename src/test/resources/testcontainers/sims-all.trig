                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0028-11-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/S.13.3.Effetredressement_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1889/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1889> .
    
    <http://bauhaus/qualite/attribut/1889/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1889/S.3.6/texte> , <http://bauhaus/qualite/attribut/1889/S.3.6/text> ;
