            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IRL_base_1998_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1799/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1799/S.10.6/texte> , <http://bauhaus/qualite/attribut/1799/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1799> .
    
    <http://bauhaus/qualite/attribut/1799/S.1.1>
