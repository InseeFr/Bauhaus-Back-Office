    <http://bauhaus/qualite/attribut/1889/S.13.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.13.3.3>
                    <http://bauhaus/qualite/attribut/1889/S.13.3.3/text> , <http://bauhaus/qualite/attribut/1889/S.13.3.3/texte> ;
