                    "La collecte est réalisée par voie postale."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Documents-collecte</p>\n<p>Notice relative &agrave; l'enqu&ecirc;te de fr&eacute;quentation dans l'h&ocirc;tellerie 2016</p>\n<p>23/05/2016</p>\n<p>Notice_explicative_Hotel_2016.pdf</p>\n<p>73 Ko</p>\n<p>Pdf</p>\n<p>Documents-collecte</p>\n<p>Questionnaire Antilles - Guyane de l'enqu&ecirc;te de fr&eacute;quentation dans l'h&ocirc;tellerie 2016</p>\n<p>23/05/2016</p>\n<p>Questionnaire_Hotel_Antilles_2016.pdf</p>\n<p>133 Ko</p>\n<p>Pdf</p>\n<p>Documents-collecte</p>\n<p>Questionnaire France m&eacute;tropolitaine de l'enqu&ecirc;te de fr&eacute;quentation dans l'h&ocirc;tellerie 2016</p>\n<p>23/05/2016</p>\n<p>Questionnaire_Hotel_Metro_2016.pdf</p>\n<p>60 Ko</p>\n<p>Pdf</p>\n<p>Documents-collecte</p>\n<p>Questionnaire R&eacute;union - Mayotte de l'enqu&ecirc;te de fr&eacute;quentation dans l'h&ocirc;tellerie 2016</p>\n<p>23/05/2016 Questionnaire_Hotel_Reunion_2016.pdf</p>\n<p>164 Ko</p>\n<p>Pdf</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concerning the expansion to include overseas departments (DOM), two specific questionnaires were introduced: one for the three DOM in the French Antilles and one for Reunion Island.</p>\n<p>This provides a statistical observation of tourism across the entire French territory.</p>\n<p>This survey falls within the scope of European reglement 692/2011 on the collection of statistical information in the field of tourism in Eurostat.</p>\n<p>It also meets the needs of the national department of tourism and of local and regional actors and decision-makers in the field of tourism.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1815/S.3.4/text> , <http://bauhaus/qualite/attribut/1815/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1815/I.18.10/text> , <http://bauhaus/qualite/attribut/1815/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2016M027EC"@fr , "2016M027EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/263> .
    
    <http://bauhaus/qualite/rapport/1815>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête de fréquentation dans l'hôtellerie 2013"@fr , "Quality report: Hotel occupancy survey 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1089> .
    
    <http://bauhaus/qualite/attribut/1815/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Comité de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry : DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D). \nThe needs of local partners are taken into account through partnership agreements with the tourism sites of Insee."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is by post."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-09-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey covers the activities defined by the NAF rev.2 codes: 55.10Z (hotels and similar accommodation).</p>\n<p>The survey covers all tourist-oriented hotels, whether classified or not.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le parc est mesur&eacute; au 31 d&eacute;cembre de chaque ann&eacute;e et la fr&eacute;quentation sur chaque mois.</p>\n<p>Les principaux th&egrave;mes abord&eacute;s sont les suivants :</p>\n<p>- caract&eacute;ristiques de l'&eacute;tablissement ;</p>\n<p>- capacit&eacute; d'accueil ;</p>\n<p>- occupation quotidienne des chambres ;</p>\n<p>- arriv&eacute;es et nuit&eacute;es selon le pays de r&eacute;sidence des touristes ;</p>\n<p>- dur&eacute;e moyenne de s&eacute;jour ;</p>\n<p>- proportion de tourisme d'affaires.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling frame is the file of tourism hotels managed by INSEE.</p>\n<p>The stratification criteria for the national sample are:</p>\n<p>- the geographical focus (regions, national tourist areas (ETNs))</p>\n<p>- hotel category (1 to 5 stars or unclassified)</p>\n<p>- type of hotel (chain or independent) Within the strata, the draw is random.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/263>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-01-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_FREQ_HOTELLERIE_2013.pdf> .
    
    <http://bauhaus/qualite/attribut/1815/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1815/S.18.3/text> , <http://bauhaus/qualite/attribut/1815/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par les codes NAF r&eacute;v. 2 : 55.10Z (h&ocirc;tels et h&eacute;bergement similaire).</p>\n<p>L'enqu&ecirc;te concerne les h&ocirc;tels &agrave; vocation touristique, qu'ils soient class&eacute;s ou non.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant l'extension aux d&eacute;partements d'outre-mer (DOM), deux questionnaires sp&eacute;cifiques ont &eacute;t&eacute; mis en place : un pour les trois DOM antillais et un pour la R&eacute;union.</p>\n<p>Elle permet ainsi une observation statistique du tourisme sur l'ensemble du territoire fran&ccedil;ais.</p>\n<p>Cette enqu&ecirc;te rentre dans le cadre du r&egrave;glement europ&eacute;en 692/2011 concernant la production d'informations statistiques sur le tourisme &agrave; Eurostat.</p>\n<p>Elle r&eacute;pond &eacute;galement aux besoins nationaux de la direction du tourisme et locaux pour les acteurs et d&eacute;cideurs r&eacute;gionaux du tourisme.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1815/S.19/texte> , <http://bauhaus/qualite/attribut/1815/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1815/S.3.6/text> , <http://bauhaus/qualite/attribut/1815/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1815/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1815/S.12.1/texte> , <http://bauhaus/qualite/attribut/1815/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le Comité de Coordination des Statistiques du Tourisme (CCST), animé par l'Insee, intègre les principaux acteurs nationaux du tourisme : DGE, Atout France, fédérations professionnelles des hôteliers et représentants des comités départementaux et régionaux du tourisme (FNCRT, RN2D). \nLes besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1815/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est le fichier des h&ocirc;tels de tourisme g&eacute;r&eacute; par l'Insee.</p>\n<p>Les crit&egrave;res de stratification de l'&eacute;chantillon national sont&nbsp;:</p>\n<p>- l'axe g&eacute;ographique (r&eacute;gions, espaces touristiques nationaux (ETN)) - la cat&eacute;gorie d'h&ocirc;tel (1 &agrave; 5 &eacute;toiles ou non class&eacute;)</p>\n<p>- le type d'h&ocirc;tel (cha&icirc;ne ou ind&eacute;pendant) Au sein des strates, le tirage est al&eacute;atoire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Hotel stock is measured every year on 31 December and occupancy is measured every month.</p>\n<p>The main topics considered are:</p>\n<p>- characteristics of the establishment;</p>\n<p>- accommodation capacity;</p>\n<p>- daily room occupancy;</p>\n<p>- arrivals and nights spent by country of residence of tourists;</p>\n<p>- average length of stay;</p>\n<p>- proportion of business tourism.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1924> {
    <http://bauhaus/qualite/attribut/1924/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>L&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e chaque mois, de janvier &agrave; d&eacute;cembre pour les 3 types d&rsquo;&eacute;tablissements. <br />Cependant, pour les campings, seuls les r&eacute;sultats des mois d&rsquo;avril &agrave; septembre sont diffus&eacute;s en 2019.</p>"@fr , "<p>The survey is conducted every month, from January to December for the 3 types of establishments.<br />However, for campings, only the results from April to September are broadcast in 2019.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
                    <http://bauhaus/qualite/attribut/1924/S.8.1/texte> , <http://bauhaus/qualite/attribut/1924/S.8.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/documents/document/1068>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire France métropolitaine de l'enquête de fréquentation dans les hôtels et AHCT 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questio_HTL_AHCT_METRO_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Deux statuts de diffusion&nbsp;: donn&eacute;es provisoires et d&eacute;finitives <br />- diffusion des donn&eacute;es provisoires&nbsp;: en d&eacute;but de mois M+2 pour le mois M<br />- diffusion des donn&eacute;es d&eacute;finitives&nbsp;: en fin de mois M+3 pour le mois M</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1924/S.7.1/text> , <http://bauhaus/qualite/attribut/1924/S.7.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte se fait en d&eacute;but de mois M+1 pour les donn&eacute;es du mois M.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1924/I.18.12/text> , <http://bauhaus/qualite/attribut/1924/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The Coordinating Committee for Tourism Statistics (CCST), led by Insee, integrates the main national tourism stakeholders: Directorate General for Enterprise (DGE) - Minister for the Economy and Finance , Atout France, professional federations of hoteliers and representatives of departmental and regional tourism committees (FNCRT, RN2D) .<br />The needs of local partners are taken into account in partnership agreements with Insee tourism sites.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1924/S.18.3/text> , <http://bauhaus/qualite/attribut/1924/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1924/S.3.1/texte> , <http://bauhaus/qualite/attribut/1924/S.3.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/documents/document/1067>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête de fréquentation dans les campings 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questio_CPG_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Month elapsed</p>"@en , "<p>Mois &eacute;coul&eacute;</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1924/S.19/text> , <http://bauhaus/qualite/attribut/1924/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.7.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Aucun r&eacute;sultat n'est publi&eacute; s'il concerne moins de trois entreprises, ni aucune donn&eacute;e pour laquelle une seule entreprise repr&eacute;sente 85% ou plus de la valeur obtenue.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>Pour les h&ocirc;tels&nbsp;: l&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon national d'environ 12&nbsp;000 h&ocirc;tels sur un total de 18&nbsp;000.<br />Pour les campings&nbsp;: l&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d&rsquo;un &eacute;chantillon de 6&nbsp;000 campings sur 8&nbsp;000.<br />Pour les AHCT&nbsp;: l'enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon d'environ 2&nbsp;500 &eacute;tablissements sur un total de 3&nbsp;500.</p>"@fr , "<p>Hotels: survey is conducted with a national sample of approximately 12,000 hotels out of a total of 18,000.<br />Campsites: survey is conducted with a sample of 6,000 campsites out of 8,000.<br />AHCT: survey is conducted with a sample of approximately 2,500 establishments out of a total of 3,500.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te de fr&eacute;quentation dans les autres h&eacute;bergements collectifs touristiques compl&egrave;te les informations concernant la fr&eacute;quentation touristique d&eacute;j&agrave; produites par :<br />- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie de tourisme ;<br />- les enqu&ecirc;tes de fr&eacute;quentation dans l'h&ocirc;tellerie de plein air.<br />Cette enqu&ecirc;te rentre dans le cadre du r&eacute;glement europ&eacute;en n&deg;692/2011 concernant la production d'informations statistiques sur le tourisme &agrave; Eurostat.<br />Elle r&eacute;pond &eacute;galement aux besoins nationaux de la Direction G&eacute;n&eacute;rale des Entreprises (DGE) et locaux pour les acteurs et d&eacute;cideurs r&eacute;gionaux du tourisme.<br />Le dispositif comporte deux extensions r&eacute;gionales dans les deux r&eacute;gions o&ugrave; existaient d&eacute;j&agrave; cette enqu&ecirc;te (Rh&ocirc;ne-Alpes, Languedoc-Roussillon).<br />Dans les DOM, les autres h&eacute;bergements collectifs sont enqu&ecirc;t&eacute;s dans l'enqu&ecirc;te de fr&eacute;quentation h&ocirc;teli&egrave;re.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire envoy&eacute; aux campings est diff&eacute;rent de celui envoy&eacute; aux h&ocirc;tels et autres h&eacute;bergements collectifs de tourisme&nbsp;: il permet de rendre compte de la nature des emplacements occup&eacute;s (emplacements nus ou emplacements &eacute;quip&eacute;s).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1066> , <http://bauhaus/documents/document/1069> , <http://bauhaus/documents/document/1068> , <http://bauhaus/documents/document/1067> .
    
    <http://bauhaus/documents/document/1066>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice relative à l'enquête de fréquentation dans les hébergements collectifs de tourisme 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_explicative_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le Comit&eacute; de Coordination des Statistiques du Tourisme (CCST), anim&eacute; par l'Insee, int&egrave;gre les principaux acteurs nationaux du tourisme&nbsp;: la Direction G&eacute;n&eacute;rale des Entreprises &ndash; Minist&egrave;re de l'Economie et des Finances (DGE), Atout France, les f&eacute;d&eacute;rations professionnelles des h&ocirc;teliers et repr&eacute;sentants des comit&eacute;s d&eacute;partementaux et r&eacute;gionaux du tourisme (FNCRT, RN2D). <br />Les besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The occupancy survey in other collective tourist accommodation supplements the tourist occupancy information already produced by:<br />- Occupancy surveys of tourist hotels<br />- Occupancy surveys of campsites<br />This survey relates to European reglement n&deg;692/2011 concerning the production of statistical information on tourism at EUROSTAT.<br />It also meets the French national needs of the Enterprise Directorate General&nbsp; and the local needs of regional tourism stakeholders and decision makers.<br />The scheme includes two regional extensions in the two regions already covered by this survey (Rh&ocirc;ne-Alpes, Languedoc-Roussillon).<br />In the overseas departments, other collective tourist accomodation are in the hotel occupancy survey.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Une &laquo;&nbsp;Informations rapides&nbsp;&raquo; est publi&eacute;e chaque trimestre.<br />Un bilan de saison d&rsquo;&eacute;t&eacute; est publi&eacute; en d&eacute;cembre.<br />Un bilan de saison d&rsquo;hiver est publi&eacute; en juin.<br />Un bilan annuel est publi&eacute; en avril.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The main topics are:<br />- characteristics of the establishment;<br />- reception capacities;<br />- daily occupancy of rooms;<br />- Arrivals and overnight stays according to the country of residence of the tourists;<br />- duration of stay;<br />- proportion of business tourism.<br />The park is measured on December 31 of each year and the attendance on each month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1924/I.18.10/texte> , <http://bauhaus/qualite/attribut/1924/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Statistics requested relate to customer stays."@en , "Les statistiques demandées concernent les séjours de la clientèle."@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2019M018EC"@fr , "2019M018EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour les h&ocirc;tels, l'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par les codes de la nomenclature d&rsquo;activit&eacute; fran&ccedil;aise (NAF r&eacute;v.&nbsp;2) suivants&nbsp;: 55.10Z (h&ocirc;tels et h&eacute;bergement similaire), c&rsquo;est &agrave; dire les h&ocirc;tels &agrave; vocation touristique, qu'ils soient class&eacute;s ou non.</p>\n<p>Pour les campings, l'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par le code NAF r&eacute;v.&nbsp;2&nbsp;: 55.30Z (terrains de camping et parcs pour caravanes ou v&eacute;hicules de loisirs). Sont exclus les campings &agrave; vocation exclusivement r&eacute;sidentielle.</p>\n<p>Pour les autres h&eacute;bergements collectifs de tourisme (AHCT), les unit&eacute;s enqu&ecirc;t&eacute;es sont les h&eacute;bergements collectifs touristiques faisant l'objet d'une r&eacute;glementation&nbsp;: auberges de jeunesse, centres internationaux de s&eacute;jour, centres sportifs, r&eacute;sidences de tourisme et r&eacute;sidences h&ocirc;teli&egrave;res, maisons familiales de vacances et villages de vacances.</p>\n<p>L'unit&eacute; &eacute;conomique interrog&eacute;e est l'exploitant de l'h&eacute;bergement (NAF r&eacute;v.&nbsp;2&nbsp;: codes 55.10Z et 55.20Z).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection is done at the beginning of month M + 1 for the data of month M.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Hotels: the sampling frame is the index of tourism hotels, index managed by Insee.<br />The stratification criteria of the national sample are:<br />- the geographical axis&nbsp;(regions, national tourist areas (ETN));<br />- hotel category (1 to 5 stars or unclassified);<br />- the type of hotel (chain or independent).<br />Within the strata, the draw is random.</p>\n<p>Campings: the sampling frame is the file of establishments offering at least one location, file managed by Insee.<br />In small regions, the survey is comprehensive. For other regions, the stratification criteria of the sample are:<br />- the geographical axis (national tourist areas (ETN));<br />- the category of camping (1 to 5 stars, not classified);<br />- the size in number of locations.<br />Inside the strata, the draw is random.</p>\n<p>Other collective tourist accommodations: the sampling frame is the file of other collective accommodation, file managed by Insee. The stratification criteria of the national sample are:<br />- the geographical axis (regions, national tourist areas (ETN));<br />- the type of establishment.<br />Within the strata, the draw is random.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>No results are published if it concerns less than three companies, or no data for which a single company represents 85% or more of the value obtained.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1924/S.10.2/text> , <http://bauhaus/qualite/attribut/1924/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For hotels, the survey covers the activities defined by the French classification of activities (NAF rev.&nbsp;2): 55.10Z codes (hotels and similar accommodation), i.e. tourist-oriented hotels, whether classified or not.</p>\n<p>For campings, the survey covers activities defined by NAF rev.&nbsp;2: 55.30Z (campsites and parks for caravans or recreational vehicles). Outdoor accommodations exclusively for residential use are excluded.</p>\n<p>For other collective tourist accommodations, the units surveyed are collective tourist accommodation subject to regulation: youth hostels, international centers of stay, sports centers, tourist residences and residential hotels, family holiday homes and holiday villages.</p>\n<p>The economic unit questioned is the operator of the accommodation (NAF rev.&nbsp;2: 55.10Z and 55.20Z).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1924/S.14.1/text> , <http://bauhaus/qualite/attribut/1924/S.14.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1924/I.18.7/text> , <http://bauhaus/qualite/attribut/1924/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour les h&ocirc;tels&nbsp;: la base de sondage est le fichier des h&ocirc;tels de tourisme g&eacute;r&eacute; par l'Insee.<br />Les crit&egrave;res de stratification de l'&eacute;chantillon national sont&nbsp;:<br />- l'axe g&eacute;ographique (r&eacute;gions, espaces touristiques nationaux (ETN))&nbsp;;<br />- la cat&eacute;gorie d'h&ocirc;tel (1 &agrave; 5 &eacute;toiles ou non class&eacute;)&nbsp;;<br />- le type d'h&ocirc;tel (cha&icirc;ne ou ind&eacute;pendant).<br />Au sein des strates, le tirage est al&eacute;atoire.</p>\n<p>Pour les campings&nbsp;: la base de sondage est le fichier des campings offrant au moins un emplacement de passage g&eacute;r&eacute; par l'Insee. <br />Dans les r&eacute;gions de petite taille,&nbsp;l'enqu&ecirc;te est exhaustive. Pour les autres r&eacute;gions, les crit&egrave;res de stratification de l'&eacute;chantillon sont&nbsp;:<br />- l'axe g&eacute;ographique (espaces touristiques nationaux (ETN))&nbsp;;<br />- la cat&eacute;gorie de camping (1 &agrave; 5 &eacute;toiles, non class&eacute;)&nbsp;;<br />- la taille en nombre d'emplacements.<br />A l'int&eacute;rieur des strates, le tirage est al&eacute;atoire.</p>\n<p>Pour les AHCT&nbsp;: la base de sondage est le fichier des autres h&eacute;bergements collectifs, fichier g&eacute;r&eacute; par l'Insee. Les crit&egrave;res de stratification de l'&eacute;chantillon national sont&nbsp;:<br />- l'axe g&eacute;ographique (r&eacute;gions, espaces touristiques nationaux (ETN))&nbsp;;<br />- le type d'&eacute;tablissement.<br />Au sein des strates, le tirage est al&eacute;atoire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1924/S.12.1/text> , <http://bauhaus/qualite/attribut/1924/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The questionnaire sent to campings is different from that sent to hotels and other collective tourist accommodation, it allows to report the nature of the occupied sites (bare pitches or equipped pitches).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les r&eacute;sultats relatifs au mois M sont publi&eacute;s en deux temps&nbsp;:<br />- r&eacute;sultats provisoires&nbsp;: d&eacute;lai de 30 &agrave; 35 jours&nbsp;;<br />- r&eacute;sultats d&eacute;finitifs&nbsp;: d&eacute;lai d&rsquo;environ 60 jours.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.8.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Two dissemination statuses: provisional and final data<br />- Provisional data dissemination: at the beginning of the month M+2 for the month M<br />- dissemination of definitive data: at the end of the month M+3 for the month M</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.14.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The results for month M are published in two stages:<br />- provisional results: delay from 30 to 35 days;<br />- final results: about 60 days.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1924>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly attendance survey in collective tourist accommodation 2019"@en , "Rapport qualité : Enquête mensuelle de fréquentation dans les hébergements collectifs de tourisme 2019"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1480> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les principaux th&egrave;mes abord&eacute;s sont&nbsp;:<br />- les caract&eacute;ristiques de l&rsquo;&eacute;tablissement&nbsp;;<br />- les capacit&eacute;s d&rsquo;accueil&nbsp;;<br />- l&rsquo;occupation quotidienne des chambres ou emplacements&nbsp;;<br />- les arriv&eacute;es et nuit&eacute;es selon le pays de r&eacute;sidence des touristes&nbsp;;<br />- la dur&eacute;e de s&eacute;jour&nbsp;;<br />- la proportion de tourisme d&rsquo;affaires.<br />Le parc est mesur&eacute; au 31 d&eacute;cembre de chaque ann&eacute;e et la fr&eacute;quentation sur chaque mois.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Envoi d&rsquo;un courrier postal et/ou envoi d&rsquo;un mail.</p>\n<p>Unit&eacute;s de mesure&nbsp;: nombre d&rsquo;arriv&eacute;es et nombre de nuit&eacute;es</p>\n<p>Zone g&eacute;ographique de r&eacute;f&eacute;rence&nbsp;:<br />- pour les h&ocirc;tels&nbsp;: France <br />- pour les campings et les AHCT&nbsp;: France m&eacute;tropolitaine</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Sending a mail and / or sending an email.</p>\n<p>Units of measurement: number of arrivals and number of nights</p>\n<p>Reference geographical area:<br />- For hotels: France <br />- For campings and other collective tourist accommodations: Metropolitan France</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1924/S.3.3/text> , <http://bauhaus/qualite/attribut/1924/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/documents/document/1069>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire DOM de l'enquête de fréquentation dans l'hôtellerie 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questio_HTL_DOM_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2019-03-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>An \"Information rapide\" published quarterly.<br />A summer season report published in December.<br />A winter season report published in June.<br />An annual report published in April.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

