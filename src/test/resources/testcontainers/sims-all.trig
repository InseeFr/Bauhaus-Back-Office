            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MethodologieDéchets2016industrie.pdf> .
    
    <http://bauhaus/qualite/attribut/1843/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1843/S.7.1/texte> , <http://bauhaus/qualite/attribut/1843/S.7.1/text> ;
