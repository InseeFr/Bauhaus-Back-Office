<http://rdf.insee.fr/graphes/qualite/rapport/1729> {
    <http://bauhaus/qualite/attribut/1729/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1729/S.18.3/text> , <http://bauhaus/qualite/attribut/1729/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1729> .
    
    <http://bauhaus/qualite/attribut/1729/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/148> .
    
    <http://bauhaus/qualite/rapport/1729>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on information and communication technologies in business 2017"@en , "Rapport qualité : Enquête sur les technologies de l'information et de la communication dans les entreprises 2017"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1061> .
    
    <http://bauhaus/qualite/attribut/1729/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte, effectu&eacute;e par internet depuis 2012 (ou par questionnaire papier sur demande), est lanc&eacute;e au premier trimestre de l'ann&eacute;e consid&eacute;r&eacute;e.<br />L'enqu&ecirc;te couvre la France enti&egrave;re (g&eacute;ographie &agrave; la date de la collecte).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1729/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A consultation committee met to take an active part in the questionnaire&rsquo;s design. Its member are experts and representatives of public policies interested in ICT and e-commerce questions (SOeS, SSP, DGE, CCIP, ARCEP, SGMAP, T&eacute;l&eacute;com Paris Tech&hellip;), as well as representatives for syndicates of businesses and trade unions (FEVAD, Syntec Num&eacute;rique, Medef, CCIP, CGPME, CGT, FO&hellip;).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1729/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1729/S.19/texte> , <http://bauhaus/qualite/attribut/1729/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1729> .
    
    <http://bauhaus/qualite/attribut/1729/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1729/S.3.4/texte> , <http://bauhaus/qualite/attribut/1729/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1729> .
    
    <http://bauhaus/qualite/attribut/1729/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1729> .
    
    <http://bauhaus/qualite/attribut/1729/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The following categories of the NACE Rev. 2 : sections C, D, E, F, G, H, I, J, L, N, divisions 69 to 74, group 95.1.</p>"@en ;
            <http://purl.org/dc/terms/language>
