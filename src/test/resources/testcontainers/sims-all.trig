    <http://bauhaus/qualite/attribut/1800/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The IRL \"corresponds to the mean of consumer prices excluding tobacco and excluding rents over the last twelve months\".</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/598> .
    
    <http://bauhaus/qualite/attribut/1800/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'IRL &laquo;correspond &agrave; la moyenne sur les douze derniers mois de l'&eacute;volution des prix &agrave; la consommation hors tabac et hors loyers&raquo;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/21> .
    
