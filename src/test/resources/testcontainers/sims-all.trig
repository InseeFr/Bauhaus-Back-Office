    <http://bauhaus/qualite/attribut/1950/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1950/S.3.1/text> , <http://bauhaus/qualite/attribut/1950/S.3.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont publi&eacute;es principalement dans la collection Insee Premi&egrave;re et sont disponibles sur insee.fr.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "0187696150"@fr , "0187696150"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The committees that have given Insee the right and legitimacy to collect its data are:-<br />- The CNIS, which examines each new project, whether it is a survey, a directory or the exploitation of administrative files ... These projects are presented by all the institutions that contribute by their work to producing public statistics. The discussion focuses in particular on the purpose of the project, its place in the information system and the conditions anticipated for its dissemination. Each operation must be examined to ensure it is in the general interest and does not duplicate existing sources of information, in other words to ensure that it is suitable. It provides an opinion on suitability.<br />- The quality label committee, within the CNIS, ensures that it meets the criteria of statistical quality. The committee checks that the survey meets the statistical quality criteria in so far as concerns the collection and sampling method (survey design, data correction method, handling of non-responses guaranteeing the reliability of results..), relevance of the questions and adaptation of the distribution to the objectives announced. It also checks that the survey does not place an excessive burden on the respondents, that consultations have been held with the partners concerned and that any wishes expressed by the CNIS during the debate on suitability were taken into account. It gives a quality label of general interest and statistical quality.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1950/S.3.6/text> , <http://bauhaus/qualite/attribut/1950/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1950/S.10.2/texte> , <http://bauhaus/qualite/attribut/1950/S.10.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey file is created thanks to previous network surveys, professional press and contact with professional organisations.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te couvre les&nbsp; divisions 10, 45 et 47, pour le commerce, sections I &agrave; S (hors sections K, O) pour les services&nbsp; de la nomenclature d&rsquo;activit&eacute; fran&ccedil;aise (NAF r&eacute;v. 2) .</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage de l&rsquo;enqu&ecirc;te est &eacute;tablie principalement &agrave; partir des enqu&ecirc;tes pr&eacute;c&eacute;dentes sur les r&eacute;seaux, de la presse professionnelle et par contact avec les organisations professionnelles.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s des t&ecirc;tes de r&eacute;seau (unit&eacute;s l&eacute;gales) sur l'ensemble de leurs points de vente.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1950/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Law n&deg; 51-711 of 7 June 1951 on obligations, co-ordination and confidentiality in respect of statistics. Available from</p>\n<p><a href=\"https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573\">https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573</a><br /><br />Article 6 concerns statistical confidentiality: Subject to the provisions of Articles 40, 56, 76, 97 and 99 of the Code of Criminal Procedure and those of Article L. 213-3 of the French Heritage Code, the individual information contained in the questionnaires endorsed as provided for in Article 2 of this Law and relating to private and family life and, in general, to private acts and conduct can not, unless decided by the Archives Administration, after examining the opinion of the Statistical Confidentiality Committee and relating to a request made for the purposes of public statistics or scientific or historical research, be the subject of any communication by the depositary service before the expiry of a period of seventy-five years following the date of completion of the survey or a period of twenty-five years from the death of the person concerned, whichever is the shorter.<br />A Statistical Confidentiality Committee is set up. This committee is called upon to rule on any question relating to the confidentiality of statistics. It expresses its opinion on requests for the communication of individual data collected pursuant to this law. The committee is chaired by a State Councillor, appointed by the Vice-President of the Council of State. It includes in particular representatives of the French National Assembly and Senate. The composition and operating methods of the committee are set by decree of the Council of State. Recipients of the data communications resulting from Ministerial decisions made after consulting the Statistical Confidentiality Committee agree to not communicate these data to anyone. Any violation of the provisions of this paragraph is punishable by the penalties provided for in Article 226-13 of the Penal Code.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2018A076EC"@fr , "2018A076EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/documents/document/1169>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice d’aide au remplissage du questionnaire de l'enquête réseaux d’enseigne dans le commerce de détail et les services 2018"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/2018_Notice_aidequestionnaire_EnqueteReseaux.pdf> .
    
    <http://bauhaus/qualite/attribut/1950/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les comit&eacute;s qui ont donn&eacute; &agrave; l'Insee le droit et la l&eacute;gitimit&eacute; pour collecter ses donn&eacute;es sont&nbsp;:<br />- Le Cnis qui examine chaque nouveau projet, qu&rsquo;il s&rsquo;agisse d&rsquo;une enqu&ecirc;te, d&rsquo;un r&eacute;pertoire ou d&rsquo;une exploitation de fichiers administratifs&hellip; Ces projets sont pr&eacute;sent&eacute;s par toutes les institutions qui contribuent par leurs travaux &agrave; la construction de la statistique publique. La discussion porte notamment sur la finalit&eacute; du projet, sa place dans le syst&egrave;me d&rsquo;information et les conditions pr&eacute;vues de sa diffusion. Il convient de v&eacute;rifier que chaque op&eacute;ration r&eacute;pond &agrave; un besoin d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et ne fait pas double emploi avec les sources d&rsquo;information existantes, en d&rsquo;autres termes de s&rsquo;assurer de son opportunit&eacute;. Il donne un un avis d&rsquo;opportunit&eacute;.<br />- Le comit&eacute; du label, au sein du Cnis, veille &agrave; ce qu&rsquo;il respecte les crit&egrave;res de qualit&eacute; statistique. Celui-ci s&rsquo;assure que l&rsquo;enqu&ecirc;te r&eacute;pond aux crit&egrave;res de qualit&eacute; statistique en ce qui concerne la m&eacute;thode de collecte et d&rsquo;&eacute;chantillonnage (plan de sondage, m&eacute;thode de redressement des donn&eacute;es, traitement des non-r&eacute;ponses garantissant la fiabilit&eacute; des r&eacute;sultats...), de pertinence du questionnement et d&rsquo;adaptation de la diffusion aux objectifs annonc&eacute;s. Il s&rsquo;assure &eacute;galement que l&rsquo;enqu&ecirc;te n&rsquo;entra&icirc;ne pas de charge excessive sur les enqu&ecirc;t&eacute;s, qu&rsquo;une concertation a &eacute;t&eacute; men&eacute;e avec les partenaires concern&eacute;s et que les souhaits exprim&eacute;s par le Cnis lors du d&eacute;bat d&rsquo;opportunit&eacute; ont bien &eacute;t&eacute; pris en compte. Il donne un label d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et de qualit&eacute; statistique.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier,&nbsp; CS 70 058, 92 541 Montrouge Cedex.</p>"@fr , "<p>Insee, 88 avenue Verdier,&nbsp; CS 70 058, 92 541 Montrouge Cedex.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data collected are mainly the location of stores organized in a brand network and the form of organization that links the establishment to the head of the network: subsidiary or branch if the store is not financially independent, franchise, cooperative group, commission-affiliation, concession, brand license, rental-management or other form of contract.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La p&eacute;riodicit&eacute; est biennale. La collecte est r&eacute;alis&eacute;e de mai &agrave; octobre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1950/S.3.4/text> , <http://bauhaus/qualite/attribut/1950/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/documents/document/1170>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les réseaux d’enseigne du commerce de détail et des services 2018"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Reseaux_questionnaire2018.xls> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1962> {
    <http://bauhaus/qualite/attribut/1962/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The questionnaire dealt with:<br />- the profile of the creator and the conditions for the start-up of the enterprise;<br />- the development of the enterprise's activity, type of clientele, cooperation with other enterprises;<br />- changes to employee numbers (hiring, dismissals, occasional staff);<br />- investments and their form of financing;<br />- training and advice after start-up;<br />- the difficulties encountered by the enterprise;<br />- the enterprise's strategy;<br />- the conditions for its development.</p>\n<p>&nbsp;</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
