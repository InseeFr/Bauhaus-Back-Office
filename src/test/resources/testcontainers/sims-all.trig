    <http://bauhaus/qualite/attribut/1720/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1720/S.12.1/texte> , <http://bauhaus/qualite/attribut/1720/S.12.1/text> ;
