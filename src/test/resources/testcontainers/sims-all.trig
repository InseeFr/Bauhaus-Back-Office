    <http://bauhaus/qualite/attribut/1764/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Coût, construction"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1631> {
    <http://bauhaus/qualite/attribut/1631/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1631/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ de l'enqu&ecirc;te r&eacute;alis&eacute;e &agrave; l'Insee en 2016 est le suivant :<br />&Eacute;tablissements exploitants, implant&eacute;s en France (y compris Dom), ayant 20 salari&eacute;s ou plus, dont l'activit&eacute; principale est industrielle (y compris r&eacute;cup&eacute;ration de d&eacute;chets), hors artisanat commercial et hors certaines industries de l'&eacute;nergie. Plus pr&eacute;cis&eacute;ment, le champ couvre les activit&eacute;s suivantes de la nomenclature NAF r&eacute;v.2 : 07, 08, 09.9, 38.3 et 10 &agrave; 33 (sauf l'artisanat commercial : 10.13B, 10.71B, 10.71C, 10.71D, la cok&eacute;faction-raffinage : 19.10Z, 19.20Z et l'enrichissement, le retraitement, l'&eacute;laboration ou la transformation de mati&egrave;res nucl&eacute;aires : 20.13A, 24.46Z).<br />A partir de 2013, le champ a &eacute;t&eacute; restreint aux &eacute;tablissements de 20 salari&eacute;s ou plus pour tous les secteurs. Auparavant &eacute;taient&nbsp;interrog&eacute;s &agrave; partir de 10 salari&eacute;s : les industries agro-alimentaires (IAA) jusqu'en 2011, et le secteur de la Fabrication de gaz industriels (2011Z) jusqu'en 2012.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/366>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2013 (et notice explicative) de l'enquête sur les consommations d'énergie dans l'industrie / EACEI"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONSO_ENERGIE_INDUSTRIE_EACEI_NOTICE.pdf> .
    
    <http://bauhaus/qualite/rapport/1631>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur les consommations d'énergie dans l'industrie 2013"@fr , "Quality report: Annual survey on industrial energy consumption 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1292> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is via the internet with the option of sending in a paper version of the questionnaire.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1631/S.3.6/text> , <http://bauhaus/qualite/attribut/1631/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/365>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête annuelle sur les consommations d'énergie dans l'industrie (EACEI)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-10-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_EACEI_2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1631/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1631/S.19/texte> , <http://bauhaus/qualite/attribut/1631/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1631/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Since 2013, about 8,500 establishments are interviewed each year.<br />&nbsp;The sampling method is as follows:<br />- Completeness for establishments of 250 employees or more and for strata sizing less than 10 establishments;<br />- For other strata: a survey optimised by a Neyman allocation (on energy consumption), with stress on the precision of estimates by activity.<br />From the EACEI 2013, the sample frame of EACEI is drawn from the new statistical Sirus directory (this directory&nbsp;is used as a frame for all thematic surveys). This change has led to a sharp increase in the number of units belonging to the scope of the survey between 2012 and 2013 : this fact impacts the results level.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/364>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête annuelle sur les consommations d'énergie dans les industries agricoles et alimentaires et les scieries en 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-09-21"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/eacei_methodo_2010.pdf> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope of the survey conducted by INSEE in 2016 is :<br />Establishments operators located in France (including overseas), with 20 employees or more, whose main activity is industrial (including recovery), excluding commercial crafts and excluding a part&nbsp;of energy industry. In code NAF rev. 2 this corresponds to: 07, 08, 09.9, 38.3 and 10 to 33 (except commercial crafts: 10.13B, 10.71B, 10.71C, 10.71D, manufacture of coke and refined petroleum products : 19.10Z, 19.20Z, enrichment, reprocessing and processing of nuclear fuel : 20.13A, 24.46 Z).<br />From 2013, the scope was restricted to establishments with 20 or more employees in all&nbsp;sectors. Previously establishments with 10 employees at least were interviewed: agrifood industries until 2011 and 2011Z sector&nbsp;until 2012.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1631/S.3.4/texte> , <http://bauhaus/qualite/attribut/1631/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This type of monitoring of industrial energy consumption is specific to all developed countries. The International Energy Agency (IEA) requires and assembles information on these subjects. \nFor European Union countries, Community regulation 58/97 concerning structural business statistics sets out additional obligations in this field."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e par internet avec envoi possible de questionnaire papier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1631/S.10.6/texte> , <http://bauhaus/qualite/attribut/1631/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/363>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-07-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_CONSO_ENERGIE_INDUSTRIE_EACEI_2013_bis.pdf> .
    
    <http://bauhaus/qualite/attribut/1631/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The EACEI survey is conducted among establishments, as this is where the energy consuming materials are implanted, and where the electricity meters and gas and fuel tanks are. Since the reporting year 2009, the survey has been conducted online (a paper version of the questionnaire may be sent upon request). Approximately 95% of the establishments surveyed respond oneline."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1631/I.18.10/text> , <http://bauhaus/qualite/attribut/1631/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ce suivi des consommations d'énergies industrielles est propre à tous les pays développés. L'Agence internationale de l'énergie (AIE) demande et rassemble l'information sur ces sujets. \nDe plus, pour les pays de l'Union européenne, le règlement communautaire 58/97 sur les statistiques structurelles d'entreprises fixe des obligations complémentaires dans ce domaine."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Environ 8 500 &eacute;tablissements sont interrog&eacute;s. La m&eacute;thode de sondage est la suivante :<br />&nbsp;- Exhaustivit&eacute; pour les &eacute;tablissements de 250 salari&eacute;s ou plus et pour les strates de taille inf&eacute;rieure &agrave; 10 &eacute;tablissements ;<br />- Pour les autres strates : sondage optimis&eacute; par une allocation de Neyman (sur les consommations d'&eacute;nergie pass&eacute;es), avec contrainte sur la pr&eacute;cision des estimations par activit&eacute;.<br />A partir de l'EACEI 2013, la base de sondage de l'EACEI est constitu&eacute;e &agrave; partir du nouveau r&eacute;pertoire statistique Sirus (Syst&egrave;me d'informations du r&eacute;pertoire des unit&eacute;s statistiques : r&eacute;pertoire servant&nbsp;de base de sondage &agrave; toutes les enqu&ecirc;tes th&eacute;matiques). Cette modification a entrain&eacute; une forte augmentation du nombre d'unit&eacute;s appartenant au champ de l'enqu&ecirc;te entre 2012 et 2013, ce qui a impact&eacute; les r&eacute;sultats en niveau.<br />Lors de l'EACEI 2015, collect&eacute;e en 2016, l'&eacute;chantillon a &eacute;t&eacute; exceptionnellement compl&eacute;t&eacute; par 5 500 unit&eacute;s (appartenant au m&ecirc;me champ des &eacute;tablissements industriels de 20 salari&eacute;s ou plus) &eacute;galement interrog&eacute;s sur leurs consommations d'&eacute;nergie en 2015, interrog&eacute;s au second semestre 2016. Ce compl&eacute;ment, portant exceptionnellement l'&eacute;chantillon &agrave; 14 000 unit&eacute;s, permettra de produire des statistiques plus d&eacute;taill&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/363> .
    
    <http://bauhaus/qualite/attribut/1631/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-01-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes de cette enqu&ecirc;te sont l'observation des consommations d'&eacute;nergie dans l'industrie en volume, en valeur et sur les usages.<br />L'interrogation utilise une typologie d'&eacute;nergies compatible avec les d&eacute;finitions internationales.<br />Ces th&egrave;mes abordent :<br />- la consommation de combustible ;<br />- la consommation totale d'&eacute;nergie ;<br />- l'autoproduction ;<br />- les achats et la consommation d'&eacute;lectricit&eacute; ;<br />- les achats, stocks et consommation de produits &eacute;nerg&eacute;tiques en unit&eacute; propre ;<br />- l'achat en valeur, le prix moyen d'achat et la r&eacute;partition de la consommation de combustible par usage ;<br />- la r&eacute;partition de la consommation d'&eacute;lectricit&eacute; par usage.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The topics covered by this survey are the observation of industrial energy consumption by volume, by value and by use.<br />During the questioning stage an energy typology was used which was compatible with international definitions.<br />Topics covered are :<br />- fuel consumption;<br />- total energy consumption;<br />- self-production;<br />- electricity purchase and consumption;<br />- purchase, storage and consumption of energy products by industrial unit;<br />- value of purchases, average purchase price and distribution of fuel consumption by use;<br />- distribution of electricity consumption by use.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1631/S.18.3/text> , <http://bauhaus/qualite/attribut/1631/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/366> .
    
    <http://bauhaus/qualite/attribut/1631/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'EACEI est une enqu&ecirc;te r&eacute;alis&eacute;e aupr&egrave;s des &eacute;tablissements, car c'est l&agrave; que sont implant&eacute;s les mat&eacute;riels consommant de l'&eacute;nergie, o&ugrave; se trouvent les compteurs d'&eacute;lectricit&eacute; ou de gaz et les cuves de combustibles. Depuis l'ann&eacute;e de constat 2009, l'enqu&ecirc;te est effectu&eacute;e par internet (un questionnaire papier peut &ecirc;tre envoy&eacute; sur demande). Plus de 95 % des &eacute;tablissements interrog&eacute;s&nbsp;r&eacute;pondent par internet.<br />Pour en savoir plus : Cf. note m&eacute;thodologique de l'EACEI sur le site de l'Insee (rubrique \" Sources et&nbsp;m&eacute;thodes \").</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/364> , <http://bauhaus/documents/document/365> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1510> {
    <http://bauhaus/qualite/attribut/1510/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1510/S.3.4/texte> , <http://bauhaus/qualite/attribut/1510/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/documents/document/573>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Fichier Général de l'État / FGE"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-04-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_Fichier_General_Agents_Etat_FGE.pdf> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Metropolitan France, French Overseas Departments (DOM) and French civil servants posted abroad.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Civil servants belonging to the Central Civil Service in the broad sense of the term (including certain Public Industrial and Commercial Institutions (EPIC)).</p>\n<p>The survey covers metropolitan France, French Overseas Departments (DOM) and French civil servants posted abroad.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>France m&eacute;tropolitaine, d&eacute;partements d'outre-mer (DOM) et agents de l'Etat en poste &agrave; l'&eacute;tranger.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Les salari&eacute;s, leurs caract&eacute;ristiques et celles de leurs emploi ;</p>\n<p>- Les r&eacute;mun&eacute;rations et leurs composantes.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2013-05-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1510/S.10.6/text> , <http://bauhaus/qualite/attribut/1510/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Lorsque la confrontation de cet ensemble de sources avec les r&eacute;sultats des ann&eacute;es pr&eacute;c&eacute;dentes r&eacute;v&eacute;le des lacunes, ces derni&egrave;res&nbsp;sont combl&eacute;es en reprenant les m&ecirc;mes agents (ou leurs pr&eacute;d&eacute;cesseurs) dans le dernier poste de travail o&ugrave; ils sont effectivement&nbsp;recens&eacute;s.<br /><br />Leurs r&eacute;mun&eacute;rations font aussi l'objet de mises &agrave; jour, bas&eacute;es sur les augmentations g&eacute;n&eacute;rales de traitement et les variations de pr&eacute;l&egrave;vements sociaux &eacute;ventuellement intervenues entre les deux dates.<br /><br />Les fonctionnaires d'&Eacute;tat dans les COM font l'objet d'estimations chaque ann&eacute;e depuis 2000.<br /><br />Par ailleurs, la confrontation de l'ensemble des donn&eacute;es d'une ann&eacute;e avec la base de donn&eacute;es compl&egrave;te de l'ann&eacute;e pr&eacute;c&eacute;dente permet, si n&eacute;cessaire, de r&eacute;cup&eacute;rer des informations qui n'avaient pu &ecirc;tre obtenues (par exemple : statut, indice de traitement, emploi d&eacute;crit pr&eacute;cis&eacute;ment, commune de travail).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Agents de la fonction publique de l'&Eacute;tat au sens large (y compris certains &eacute;tablissements publics &agrave; caract&egrave;re industriel ou commercial (EPIC)).</p>\n<p>L'enqu&ecirc;te couvre la France m&eacute;tropolitaine, les d&eacute;partements d'outre-mer (DOM) et les agents de l'Etat en poste &agrave; l'&eacute;tranger.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/rapport/1510>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: File on central civil servants"@en , "Rapport qualité : Fichier général de l'État"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1171> .
    
    <http://bauhaus/qualite/attribut/1510/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>When gaps in the data are revealed by comparing all of these sources with the results of previous years, why the missing information is replaced by data for the same civil servants (or their predecessors) in the last post of employment in which they were actually surveyed.<br /><br />Their remunerations are also updated, based on the general salary increases and the variations in payroll taxes that may have occurred between the two dates.<br /><br />Estimates have been provided for civil servants in the COMs each year since 2000.<br /><br />In addition, by comparing all of the data for one year with the complete database for the previous year, it becomes possible, if necessary, to gather information which was previously impossible to obtain (e.g. status, salary index, specific job description, municipality in which the job is based).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Plusieurs sources permettent d'&eacute;laborer ce syst&egrave;me d'information sur les agents de l'&Eacute;tat :<br />- des fichiers de paie annuels provenant de la Direction g&eacute;n&eacute;rale des Finances Publiques (DGFiP) pour les agents civils des minist&egrave;res et de certains &eacute;tablissements publics ;<br />- le fichier annuel provenant du minist&egrave;re de la D&eacute;fense pour les militaires&nbsp; ;<br />- les d&eacute;clarations annuelles de donn&eacute;es sociales (DADS) pour les agents de la FPE absents de la source DGFiP.</p>\n<p>Ces donn&eacute;es sont fournies par les administrations et organismes suivants :<br />- Les tr&eacute;soreries g&eacute;n&eacute;rales (TG) de m&eacute;tropole et de 2 des 4 d&eacute;partements d'outre-mer (Antilles-Guyane, R&eacute;union);<br />- La Tr&eacute;sorerie g&eacute;n&eacute;rale pour l'&Eacute;tranger (TGE) ;<br />- Les d&eacute;clarations annuelles de donn&eacute;es sociales (DADS) ;<br />- Le minist&egrave;re charg&eacute; de la D&eacute;fense.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/573> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Employees, their descriptions and the nature of the work;</p>\n<p>- Remunerations and their components.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Several sources are used to create this information system :<br /><br />-Data originating from the General Directorate for Public Finances (DGFiP) for civil servants (excluding military personnel) of ministries and employees of certain public establishments;<br /><br />-This information base is supplemented by the \"Annual Declarations of Social Data\" (DADS);<br /><br />-Data concerning military personnel whose pay is managed by the Ministry for Defence.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1510/S.3.6/texte> , <http://bauhaus/qualite/attribut/1510/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1510/S.18.3/text> , <http://bauhaus/qualite/attribut/1510/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1510/S.19/texte> , <http://bauhaus/qualite/attribut/1510/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1548> {
    <http://bauhaus/qualite/attribut/1548/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te de 2016-2017 se d&eacute;roule en 6 vagues d'environ 8 semaines chacune, de septembre 2016 &agrave; septembre 2017. A Mayotte, l'enqu&ecirc;te est r&eacute;alis&eacute;e avec un d&eacute;calage d'un an.</p>\n<p>L'enqu&ecirc;te Budget de Famille utilise deux instruments de collecte :</p>\n<p>- un questionnaire de collecte assist&eacute;e par informatique, r&eacute;parti sur 2 visites, qui enregistre les d&eacute;penses importantes ou r&eacute;guli&egrave;res effectu&eacute;es au cours des 12 derniers mois, ainsi que des informations socio-d&eacute;mographiques, les caract&eacute;ristiques du logement et des questions qualitatives illustrant la situation financi&egrave;re du m&eacute;nage ;</p>\n<p>- un carnet auto-administr&eacute; pour chaque membre du m&eacute;nage &acirc;g&eacute; de plus de 14 ans dans lequel consigner toutes ses d&eacute;penses durant&nbsp;7 jours.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1548/S.18.3/texte> , <http://bauhaus/qualite/attribut/1548/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Ensemble des m&eacute;nages ordinaires de France enti&egrave;re (m&eacute;tropole et Dom).<br />Repr&eacute;sentativit&eacute; g&eacute;ographique : ZEAT (Zone d'&eacute;tudes et d'am&eacute;nagement du territoire) pour la m&eacute;tropole, d&eacute;partementale pour les Dom.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1548/I.18.10/text> , <http://bauhaus/qualite/attribut/1548/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The 2016-2017 survey is conducted in 6 waves of approximately 8 weeks each, from September 2016 to September 2017.</p>\n<p>The Household Budget Survey uses two data collection instruments:</p>\n<p>- a questionnaire using computer-assisted data collection, broken down over 2 visits, which records income over the last 12 months and major or regular expenditure, also socio-demographic information, characteristics of the dwelling and qualitative questions about the household's financial situation;</p>\n<p>- a self-completed diary in which all members of the household aged over 14 record all their expenditure over 7 days.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1548/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-10-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/U> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te s&rsquo;&eacute;tend de septembre 2016 &agrave; septembre 2017 et se d&eacute;roule en deux visites aupr&egrave;s de toutes les unit&eacute;s de vie du m&eacute;nage.</p>\n<p>Tous les 5 ans</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All ordinary households in the whole of France (mainland and overseas departments).<br />Geographic representation: Zones for study and development (ZEAT) in Metropolitan France, departmental in the overseas departments.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/H> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1548/S.3.6/text> , <http://bauhaus/qualite/attribut/1548/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>&Eacute;chantillon (al&eacute;atoire &agrave; taux de sondage uniforme) d'environ 20 700 logements en France m&eacute;tropolitaine, et 8 000 dans les Dom.</p>\n<p>Dans l'enqu&ecirc;te 2016-2017, les familles monoparentales sont sur-&eacute;chantillonn&eacute;es : 2 000 logements suppl&eacute;mentaires ont &eacute;t&eacute; tir&eacute;s en France m&eacute;tropolitaine &agrave; partir des fichiers d'allocataires de la CNAF.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1548/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Sample (random self-weighted sample) of about 20,700 dwellings in Metropolitan France, 8,000 in the overseas departments.</p>\n<p>The survey 2016-2017 includes an upsample of single-parent families of 2,000 dwellings from administrative data source (CNAF)&nbsp;</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1548/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Consommation, dépenses, ressources, opinion sur la situation financière, caractéristiques socio-démographiques et équipement. L'édition 2016-2017 de l'enquête comporte en outre pour la première fois des questions sur l'économie du partage (covoiturage par exemple). "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1548>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
