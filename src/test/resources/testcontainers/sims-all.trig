    <http://bauhaus/documents/document/148>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête sur les technologies de l'information et de la communication auprès des entreprises / TIC"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-04-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologique_TIC_Entreprises_2012.pdf> .
    
    <http://bauhaus/qualite/attribut/1930/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1930/I.18.7/texte> , <http://bauhaus/qualite/attribut/1930/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1930> .
    
    <http://bauhaus/qualite/attribut/1930/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te communautaire sur&nbsp;&laquo; l'utilisation des TIC et le commerce &eacute;lectronique &raquo; dans les entreprises est un ensemble d'enqu&ecirc;tes r&eacute;alis&eacute;es par les instituts nationaux de la statistique des pays membres de l'union europ&eacute;enne.</p>\n<p>Elle s'inscrit dans le r&egrave;glement n&deg;&nbsp;808/2004 adopt&eacute; en date du 21 avril 2004 dans le cadre de la mise en &oelig;uvre du plan d'action&nbsp;eEurope 2005 consacr&eacute; aux technologies de l'information et de la communication, r&egrave;glement amend&eacute; par le r&egrave;glement europ&eacute;en n&deg;&nbsp;1006/2009 du 16 septembre 2009. Dans ce cadre, les enqu&ecirc;tes sur les TIC et le commerce &eacute;lectronique dans les entreprises r&eacute;alis&eacute;es par les pays de l'Union europ&eacute;enne suivent une m&eacute;thodologie commune et un m&ecirc;me mod&egrave;le de questionnaire.</p>\n<p>Chaque ann&eacute;e, un ou plusieurs th&egrave;mes, d&eacute;termin&eacute;s par le r&egrave;glement europ&eacute;en annuel d'application du r&egrave;glement cadre, fait l'objet d'un d&eacute;veloppement particulier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1930/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Voir les documents</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1146> , <http://bauhaus/documents/document/1145> .
    
    <http://bauhaus/qualite/attribut/1930/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1930/S.12.1/text> , <http://bauhaus/qualite/attribut/1930/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1930> .
    
    <http://bauhaus/qualite/attribut/1930/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection, conducted by internet since 2012, is launched in the first quarter of the year in question.<br />The survey covers the whole of France (geography at the time of collection).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1930/S.9>
