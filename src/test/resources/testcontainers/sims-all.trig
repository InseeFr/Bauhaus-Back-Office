    <http://bauhaus/qualite/attribut/1961/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La comitologie est organis&eacute;e au niveau europ&eacute;en autour d'un groupe de travail o&ugrave; l'Insee repr&eacute;sente la France.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te fait l&rsquo;objet d&rsquo;une publication dans la collection Insee R&eacute;sultat annuel et disponible sous insee.fr.&nbsp;; &laquo;&nbsp;L&rsquo;usage des technologies de l'information et de la communication par les m&eacute;nages entre 2009 et 2019&nbsp;&raquo;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-F001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>En 2020, l'&eacute;chantillon de l'enqu&ecirc;te t&eacute;l&eacute;phonique est compos&eacute; de 3900 m&eacute;nages (en m&eacute;tropole et dans les quatre DOM). L'&eacute;chantillon de l'enqu&ecirc;te internet/papier est compos&eacute; de 27 000 m&eacute;nages.</p>"@fr , "<p>In 2020, the telephone survey sample size is 3900 households (in metropolitan France and the four overseas departments). The internet/paper survey sample is composed of 27,000 households.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1961/S.3.6/texte> , <http://bauhaus/qualite/attribut/1961/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.15.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.2>
                    <http://bauhaus/qualite/attribut/1961/S.15.2/text> , <http://bauhaus/qualite/attribut/1961/S.15.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Voir le questionnaire papier joint (la notice de remplissage incluse) disponible.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1218> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/P> , <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is based on a sample of 39,000 households drawn from the Demographic Files on Housing and Individuals (Fid&eacute;li de l'ann&eacute;e 2018). <br />Two sub-samples are constituted: on the one hand, the 30,000 households found in the directory or with a known telephone number in Fid&eacute;li and, on the other hand, the 9,000 households without a telephone number.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1218>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête annuelle auprès des ménages sur les technologies de l'information et de la communication – 2020"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/QuestionnairepostalTIC2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te repose sur un &eacute;chantillon de 39 000 m&eacute;nages tir&eacute; dans le &laquo;&nbsp;Fichiers d&eacute;mographiques sur les logements et les individus -Fid&eacute;li de l'ann&eacute;e 2018).&nbsp;&raquo;<br />Deux sous-&eacute;chantillons sont constitu&eacute;s : d&rsquo;une part des 30 000 m&eacute;nages retrouv&eacute;s dans l'annuaire ou avec un num&eacute;ro de t&eacute;l&eacute;phone connu dans Fid&eacute;li et d&rsquo;autre part des 9 000 m&eacute;nages sans num&eacute;ro de t&eacute;l&eacute;phone.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "stephane.legleye@insee.fr"@fr , "stephane.legleye@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1961/S.18.1/text> , <http://bauhaus/qualite/attribut/1961/S.18.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>In 2020, the French edition of the ICT survey was canceled due to the Coronavirus pandemic.</p>\n<p>The survey would have investigated :<br />- Access to Information and Communication Technologies (including internet via mobile phone or portable computers);<br />- The uses of the Internet and frequencies;<br />- The uses of e-government;<br />- The uses of e-commerce;<br />- The privacy and protection of personal data;<br />- The trust, security and privacy;<br />- Internet of things.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.17.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.1>
                    <http://bauhaus/qualite/attribut/1961/S.17.1/texte> , <http://bauhaus/qualite/attribut/1961/S.17.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.17.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;Insee r&eacute;vise les valeurs de ses statistiques pour qu&rsquo;elles refl&egrave;tent la r&eacute;alit&eacute; de la mani&egrave;re la plus exacte possible et pour garantir leur pertinence et leur fiabilit&eacute;. Il a recours &agrave; des proc&eacute;dures bien &eacute;tablies, normalis&eacute;es et planifi&eacute;es suivant les standards internationaux. Il annonce les r&eacute;visions simultan&eacute;ment &agrave; leur diffusion ou &agrave; l&rsquo;avance selon un protocole adapt&eacute; &agrave; la source des r&eacute;visions, &agrave; leur ampleur et &agrave; la sensibilit&eacute; des statistiques publi&eacute;es. Toutes les explications n&eacute;cessaires &agrave; la compr&eacute;hension de ces r&eacute;visions accompagnent la diffusion des sources statistiques concern&eacute;es sur le site Insee.fr.</p>\n<p><a title=\"https://www.insee.fr/fr/information/4175126#titre-bloc-13\" href=\"https://www.insee.fr/fr/information/4175126#titre-bloc-13\">https://www.insee.fr/fr/information/4175126#titre-bloc-13</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.15.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Certains indicateurs sont comparables (par exemple le taux d&rsquo;&eacute;quipement en internet) et certains indicateurs n&rsquo;ont pas la m&ecirc;me p&eacute;riode de r&eacute;f&eacute;rences et ne sont donc pas comparables.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1961/I.18.10/texte> , <http://bauhaus/qualite/attribut/1961/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "L’équipement internet est recueilli au niveau du ménage et les autres caractéristiques au niveau d’un individu du ménage, tiré aléatoirement pour répondre au questionnaire : cet individu est l’ « individu Kish »."@fr , "Internet equipment is collected at the household level and other characteristics at the level of an individual member of the household, will be randomly selected to answer the questionnaire: this individual is the \"Kish\"."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Comitology is organized at the European level around a working group in which INSEE represents France.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1961/S.10.2/text> , <http://bauhaus/qualite/attribut/1961/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2020A061EC"@fr , "2020A061EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Household level: internet access equipment and type of connection.<br />Individual level: frequency of internet use, actions carried out on the internet, use of online storage space, learning via the internet. use of e-government services, requesting help with online procedures, not carrying out online procedures, carrying out procedures other than via the internet. Carrying out and date of online purchases, number of purchases, sum of purchases, type of purchase, origin of purchases, carrying out purchases from private individuals, purchasing services from private individuals, booking transport and accommodation services online, carrying out financial activities online. carrying out actions related to online confidentiality, knowledge and use of privacy protection tools. Use of online identification procedures, use of smartphone and mobile phone, use of antivirus software on smartphone, loss of documents due to a virus, restriction of access to personal data. Use of internet of things.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Paper questionnaire (instructions for filling in included) available.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1218> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1961/I.18.7/text> , <http://bauhaus/qualite/attribut/1961/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.17.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Revisions are generally defined as any change in the value of a statistic that is already published. These may include regular or one-off changes to items of data related to certain statistical processes (e.g. indices, national accounts, etc.). Revisions are necessary where amendments or additions to input data occur after their initial release, or due to changes in concepts, classification or methodology that may be brought about for a variety of reasons. Restructuring actions present an opportunity to add multiple underlying sources of revisions at the same time (e.g. changes in methodology, base period, etc.). Revisions do not include corrections to errors in production, which are addressed specifically according to the nature and scale of the correction.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1961/S.12.1/texte> , <http://bauhaus/qualite/attribut/1961/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>In 2020, Data collection was supposed to be carried out from 30 March 2020 to 17 June 2020. But the French edition of the ICT survey was canceled due to the Coronavirus pandemic.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te TIC est une enqu&ecirc;te multimode. Trois modes d'administration sont propos&eacute;s &agrave; travers deux protocoles distincts : enqu&ecirc;te t&eacute;l&eacute;phonique&nbsp; et Internet-papier.<br />Les non-r&eacute;pondants &agrave; l&rsquo;enqu&ecirc;te t&eacute;l&eacute;phonique sont ensuite interrog&eacute;s par internet/papier. <br />Les m&eacute;nages qui ont un num&eacute;ro de t&eacute;l&eacute;phone (pr&eacute;sents dans l'annuaire et Fid&eacute;li) sont enqu&ecirc;t&eacute;s par t&eacute;l&eacute;phone. La collecte est assist&eacute;e par informatique (Capi).<br />Les m&eacute;nages sans num&eacute;ro de t&eacute;l&eacute;phone sont enqu&ecirc;t&eacute;s par internet et papier. Certaines m&eacute;nages avec num&eacute;ro de t&eacute;l&eacute;phone sont enqu&ecirc;t&eacute;s par internet/papier dans le cadre d'un dispositif compl&eacute;mentaire &agrave; but m&eacute;thodologique.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1961/S.3.4/text> , <http://bauhaus/qualite/attribut/1961/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Internet equipment: Households in which at least one person is aged 15 or over and living in France (metropolitan France and overseas departments excluding Mayotte).<br />Other statistics: Individuals over 15 years old and living in France (metropolitan France and overseas departments excluding Mayotte).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/rapport/1961>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête annuelle auprès des ménages sur les technologies de l'information et de la communication 2020"@fr , "Quality report: Household annual survey on information and communication technologies 2020"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1519> .
    
    <http://bauhaus/qualite/attribut/1961/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of Household Living Conditions Section</p>"@en , "<p>Chef de la division Conditions de vie des m&eacute;nages</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.18.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Aggregate statistics are derived directly from the responses to the ICT questionnaire after treatments and calibrations.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te s'inscrit dans le cadre du r&egrave;glement n&deg;808/2004 adopt&eacute; en date du 21 avril 2004 par le Parlement europ&eacute;en et le Conseil des ministres concernant la mise en &oelig;uvre du plan d'action eEurope 2005 consacr&eacute; aux TIC.<br />Le plan d'action eEurope 2005 est l'instrument qui stimule l'utilisation des TIC, en particulier qui a pour but de d&eacute;velopper le recours aux services &eacute;lectroniques dans le cadre de l'interaction entre gouvernements et citoyens.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2020-02-26"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>En 2020, la collecte de donn&eacute;es devait &ecirc;tre r&eacute;alis&eacute;e du 30 mars 2020 au 17 juin 2020. Elle a &eacute;t&eacute; annul&eacute;e en raison de la pand&eacute;mie de Coronavirus. </p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>St&eacute;phane Legleye</p>"@fr , "<p>St&eacute;phane Legleye</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un fichier &agrave; destination des chercheurs est accessible par le r&eacute;seau Quetelet : <a title=\"https://quetelet.casd.eu/fr/utilisateur/connexion\" href=\"https://quetelet.casd.eu/fr/utilisateur/connexion\">https://quetelet.casd.eu/fr/utilisateur/connexion</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour l&rsquo;&eacute;quipement en internet, l&rsquo;enqu&ecirc;te porte sur les m&eacute;nages dans lesquels une personne au moins est &acirc;g&eacute;e de 15 ans ou plus et r&eacute;sidant en France (m&eacute;tropole et DOM hors Mayotte).<br />Pour les autres statistiques, les informations recueillies portent sur les Individus de plus de 15 ans et r&eacute;sidant en France (m&eacute;tropole et DOM hors Mayotte).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>2019-2020</p>"@fr , "<p>2019-2020</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>En 2020, la collecte de l'enqu&ecirc;te TIC a &eacute;t&eacute; annul&eacute;e en France, en raison de la pand&eacute;mie de Coronavirus.</p>\n<p>L&rsquo;enqu&ecirc;te portait sur :<br />- L&rsquo;acc&egrave;s aux technologies de l&rsquo;information et de la communication (y compris l&rsquo;internet mobile via un t&eacute;l&eacute;phone ou ordinateur portable) ;<br />- L&rsquo;usage d&rsquo;internet et sa fr&eacute;quence&nbsp;;<br />- L&rsquo;utilisation des services administratifs en ligne&nbsp;;<br />- Les habitudes de consommation sur internet&nbsp;; <br />- La confidentialit&eacute; et la protection de la vie priv&eacute;e&nbsp;;<br />- La s&eacute;curit&eacute; et confiance dans les TIC&nbsp;;<br />- Les objets connect&eacute;s.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The ICT survey is a multi-mode survey. Three modes of administration are proposed through two distinct protocols: telephone survey (sub-sample \"known telephone number\") and Internet-paper survey (sub-samples \"known telephone number\" and \"unknown telephone number\").<br />Non-respondents to the telephone survey are then questioned by internet/paperHouseholds with a telephone number (listed in the telephone book and Fideli) are surveyed by telephone. Collection is computer-assisted (Capi).<br />Households without a telephone number are surveyed by internet and paper. Some households with a telephone number are surveyed by internet/paper as part of a complementary methodological system.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les statistiques agr&eacute;g&eacute;es sont issues directement des r&eacute;ponses au questionnaire TIC apr&egrave;s traitements et calages.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Au niveau du m&eacute;nage : les questions portent sur l&rsquo;&eacute;quipement en acc&egrave;s internet et le type de connexion.<br /><br />Au niveau de l&rsquo;individu : fr&eacute;quences d&rsquo;utilisation d&rsquo;internet, actions r&eacute;alis&eacute;es sur internet, utilisation d&rsquo;espace de stockage en ligne, apprentissage par internet. utilisations des services administratifs, demande d&rsquo;aide pour les d&eacute;marches en ligne, renoncement &agrave; effectuer des d&eacute;marches en ligne, r&eacute;alisation autre que par internet de ces d&eacute;marches. <br />R&eacute;alisation et date d&rsquo;achat en ligne, nombre d&rsquo;achats, somme des achats, type d&rsquo;achat, origine des achats, r&eacute;alisations d&rsquo;achats aupr&egrave;s de particuliers, achat de services aupr&egrave;s de particuliers, r&eacute;servation de service de transport et de logement en ligne, r&eacute;alisation d&rsquo;activit&eacute; financi&egrave;res en ligne. r&eacute;alisation d&rsquo;action li&eacute;es &agrave; la confidentialit&eacute; en ligne, connaissance et utilisation d&rsquo;outils de protection de la vie priv&eacute;e. <br />Utilisation de proc&eacute;dures d&rsquo;identification en ligne, utilisation de smartphone et de t&eacute;l&eacute;phone portable, utilisation d&rsquo;antivirus sur smartphone, perte de documents suite &agrave; un virus, restriction d&rsquo;acc&egrave;s aux donn&eacute;es personnelles. Utilisation d&rsquo;objets connect&eacute;s.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1961/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Annual Insee R&eacute;sultat: Household use of information and communication technologies between 2009 and 2019.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1961/S.18.3/text> , <http://bauhaus/qualite/attribut/1961/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey is consistent with regulation n&deg;808/2004 adopted on 21 April 2004 by the European Parliament and Council of Ministers concerning the implementation of the eEurope 2005 action plan dedicated to ICTs.<br />The eEurope 2005 Action Plan is the instrument that encourages the use of ICTs, in particular with a view to increasing the use of e-services in the interaction between governments and citizens.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1961/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1961/S.6.1/text> , <http://bauhaus/qualite/attribut/1961/S.6.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1961> .
    
    <http://bauhaus/qualite/attribut/1961/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
