                    "Questionnaire de l'enquête mensuelle de conjoncture dans l'industrie des autres mois de l'année 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_ACTI_MODELE2_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1928/S.1.5>
