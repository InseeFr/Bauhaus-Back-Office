            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1598/S.3.4/texte> , <http://bauhaus/qualite/attribut/1598/S.3.4/text> ;
