    <http://bauhaus/qualite/attribut/1719/S.18.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont contr&ocirc;l&eacute;es et valid&eacute;es par le service ESANE de Nantes et la division ESANE de la direction g&eacute;n&eacute;rale.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/P> , <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>120 000 unit&eacute;s l&eacute;gales (essentiellement) et entreprises</p>"@fr , "<p>120 000 legal units (principaly) and enterprises</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Enterprise"@en , "Entreprise"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Plus pr&eacute;cis&eacute;ment, en mati&egrave;re de secteurs d&rsquo;activit&eacute;, le champ de l&rsquo;enqu&ecirc;te en m&eacute;tropole comprend les secteurs des exploitations foresti&egrave;res et des scieries, des industries agroalimentaires, du commerce, de la construction, des transports, et enfin des autres services principalement marchands (hors secteur financier).<br />Il existe &eacute;galement un questionnaire sp&eacute;cifique aux DOM, portant sur l'ensemble de ces secteurs auxquels s'ajoute l'industrie.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017A045EC"@fr , "2017A045EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ de l&rsquo;enqu&ecirc;te comprend les secteurs &eacute;conomiques marchands du commerce, des services marchands hors secteur financier, des industries agroalimentaires, des transports, de la construction et le secteur des exploitations foresti&egrave;res et des scieries (classe 02.20). S'y rajoute l'industrie, pour la partie collecte des &eacute;l&eacute;ments comptables relatifs aux entreprises profil&eacute;es d&rsquo;une part, et pour les DOM d&rsquo;autre part.</p>\n<p>Toutes les tailles d'entreprise sont dans le champ de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1719/S.19/text> , <http://bauhaus/qualite/attribut/1719/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La refonte des statistiques structurelles d'entreprises a conduit &agrave; l'exploitation syst&eacute;matique des sources administratives (fiscales et sociales).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/194>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Commerce de gros (Questionnaire 2016)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-02-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_esa2016_commerce_de_gros.pdf> .
    
    <http://bauhaus/qualite/attribut/1719/S.7.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant la collecte internet, le site de collecte est enti&egrave;rement s&eacute;curis&eacute; et les normes en termes de gestion des codes d&rsquo;acc&egrave;s &agrave; l&rsquo;enqu&ecirc;te sont strictes et standardis&eacute;es pour toutes les enqu&ecirc;tes entreprises. Pour les entreprises choisissant d&rsquo;utiliser le support papier, la saisie est assur&eacute;e par les gestionnaires, dans le strict respect de la confidentialit&eacute; des donn&eacute;es r&eacute;colt&eacute;es.<br />Avant la diffusion des donn&eacute;es le secret est appliqu&eacute;. Pour les donn&eacute;es relatives aux entreprises : on ne publie aucun r&eacute;sultat qui concerne moins de trois entreprises ou &eacute;tablissements. De m&ecirc;me, un r&eacute;sultat ne sera diffus&eacute; que si aucune entreprise ou &eacute;tablissement ne contribue &agrave; plus de 85 % de ce r&eacute;sultat. Les suppression primaire correspondent aux cases ne r&eacute;pondant pas au crit&egrave;re ci-dessus. Le secret secondaire supprime d'autres cases pour que les donn&eacute;es ne puissent pas &ecirc;tre retrouv&eacute;es par addition soustraction avec les marge des tableaux. Le secret statistique est d&eacute;fini dans la loi n&deg; 51-711 du 7 juin 1951.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex.</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70 058, 92 541 Montrouge Cedex.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Law n&deg; 51-711 of 7 June 1951 on obligations, co-ordination and confidentiality in respect of statistics. Available from https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573.</p>\n<p>Article 6 concerns statistical confidentiality: Subject to the provisions of Articles 40, 56, 76, 97 and 99 of the Code of Criminal Procedure and those of Article L. 213-3 of the French Heritage Code, the individual information contained in the questionnaires endorsed as provided for in Article 2 of this Law and relating to private and family life and, in general, to private acts and conduct can not, unless decided by the Archives Administration, after examining the opinion of the Statistical Confidentiality Committee and relating to a request made for the purposes of public statistics or scientific or historical research, be the subject of any communication by the depositary service before the expiry of a period of seventy-five years following the date of completion of the survey or a period of twenty-five years from the death of the person concerned, whichever is the shorter.<br />A Statistical Confidentiality Committee is set up. This committee is called upon to rule on any question relating to the confidentiality of statistics. It expresses its opinion on requests for the communication of individual data collected pursuant to this law. The committee is chaired by a State Councillor, appointed by the Vice-President of the Council of State. It includes in particular representatives of the French National Assembly and Senate. The composition and operating methods of the committee are set by decree of the Council of State. Recipients of the data communications resulting from Ministerial decisions made after consulting the Statistical Confidentiality Committee agree to not communicate these data to anyone. Any violation of the provisions of this paragraph is punishable by the penalties provided for in Article 226-13 of the Penal Code.</p>\n<p>Act no. 78-17 of 6 January 1978(amended), relating to information technology, files and civil freedoms.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data are published in the INSEE Results section and available at insee.fr.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Comptabilité nationale, SSM, chercheurs"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont publi&eacute;es &agrave; la rubrique Insee R&eacute;sultats sous insee.fr.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1719/I.18.10/texte> , <http://bauhaus/qualite/attribut/1719/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Il s'agit d'un sondage al&eacute;atoire simple stratifi&eacute; en grappes selon des classes de taille crois&eacute;es avec les secteurs &eacute;conomiques. Au dessus de certains seuils de taille &ndash; seuils de chiffre d&rsquo;affaires et d&rsquo;effectifs salari&eacute;s &ndash;, variables avec les secteurs, le tirage est exhaustif.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes addressed in the survey are as follows: <br />-The business's principal activity;<br />-The events occurring during the accounting year (merger-absorption, full transfert of assets, partial transfer of assets, split off);<br />-The details of the restructuring (increases and decreases in fixed assets);<br />-Tangible investments and sales;<br />-Employment (non-employeed staff, temporary staff, staff leased to other companies, etc.);<br />-Breakdown of turnover by product or detailed activity;<br />-Professional expenses (non-stored purchases, incorporated sub-contracting, etc.);</p>\n<p>Sectoral characteristics such as:<br />- Breakdown of the turnover of the form of sales like company retail;<br />- Analysis of the customer base (breakdown of turnover by type of customer);<br />- Analysis of the providers retail;<br />- Other charges and external charges (general sub-contracting, rent and rental charges, maintenance expenses, etc.) for transport&nbsp;companies;<br />- Long-term assets, a for agri-food companies and agricultural cooperative;<br />- Work performed on existing or future buildings;<br />- Localisation of sites, work performed on existing or future buildings, type of work performed;<br />- The list of establishments registered on the Business Register Sirene, subcontracting capacity, financial leasing for forestry companies.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/193>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Construction (Questionnaire 2016)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-02-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_esa2016_construction.pdf> .
    
    <http://bauhaus/qualite/attribut/1719/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1719/S.10.2/text> , <http://bauhaus/qualite/attribut/1719/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.18.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Une cha&icirc;ne de contr&ocirc;les et redressements automatiques sp&eacute;cifique a &eacute;t&eacute; mise en &oelig;uvre. Cette cha&icirc;ne assure en outre la coh&eacute;rence des donn&eacute;es de l'enqu&ecirc;te avec les donn&eacute;es fiscales de l'entreprise.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of Structural Business Statistics Section</p>"@en , "<p>Chef de la Division &eacute;laboration des statistiques annuelles d'entreprises</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.18.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data and resultats are checked and validated by the ESANE teams in Nantes and Paris.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling design is a two-stage stratified clustered simple ramdom sampling, according to strata defined by the size classes crossed with the economic sectors. Above given size thresholds &ndash; thresholds on tunover and on number of employees &ndash;, which are variable according to the economic sector, the strata are take-all strata.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1719/I.18.7/texte> , <http://bauhaus/qualite/attribut/1719/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
}

