    <http://bauhaus/qualite/attribut/1697/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1697/S.3.6/texte> , <http://bauhaus/qualite/attribut/1697/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/documents/document/241>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Pourquoi les ménages pauvres paient-ils des loyers plus ou moins élevés ? L’incidence des aides au logement en France"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-10-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/enq_loyer_charges_incidences_revenus.pdf> .
    
    <http://bauhaus/qualite/attribut/1697/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/P> , <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Each quarter, approximately 3,700 homes in Metropolitan France and 600 in Guadeloupe form part of the sample to be surveyed.<br />These are main residences rented in an unfurnished state, whose main purpose is residential: the accommodation concerned must not have more than 50% of its surface area used for a professional activity.<br />Sub-let accommodation, leases with purchase options (or rental/purchase schemes) and accommodation occupied on a free basis, are excluded from the field of the survey.<br />The sample is drawn from the INSEE master sample (derived from the population census).<br />One fifth of the sample is renewed each quarter: the outgoing sample consists of accommodation surveyed 5 times and accommodation which fell outside the scope of the previous survey.<br />Each quarter, the outgoing sub-sample is replaced by an incoming sub-sample.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/240>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_loyers_et_charges_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1697/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1697/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/rapport/1697>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête Loyers et charges 2015"@fr , "Quality report: Rents and Charges Survey 2015"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1351> .
    
    <http://bauhaus/qualite/attribut/1697/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Chaque trimestre, environ 3 700 logements en m&eacute;tropole et 600 en Guadeloupe font partie de l'&eacute;chantillon &agrave; enqu&ecirc;ter.<br />Il s'agit de r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation : les logements concern&eacute;s ne doivent pas avoir plus de 50 % de leur surface consacr&eacute;e &agrave; une activit&eacute; professionnelle.<br />Sont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occup&eacute;s &agrave; titre gratuit.<br />L'&eacute;chantillon est tir&eacute; dans l'&eacute;chantillon ma&icirc;tre de l'Insee (issu du recensement de la population).<br />Un cinqui&egrave;me de l'&eacute;chantillon est renouvel&eacute; chaque trimestre : l'&eacute;chantillon sortant se compose des logements interrog&eacute;s 5 fois&nbsp;et des logements hors champ &agrave; l'enqu&ecirc;te pr&eacute;c&eacute;dente.<br />On effectue chaque trimestre le remplacement du sous-&eacute;chantillon sortant par un sous &eacute;chantillon entrant.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1697/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "-dg75-F330@insee.fr"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1697/S.3.4/texte> , <http://bauhaus/qualite/attribut/1697/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/documents/document/245>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2015 de l'enquête Loyers et charges"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-04-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1697/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All main residences rented in an unfurnished state which essential reason for the rental is housing.<br />Since 2013 for metropolitan France and since July 2017 for Guadeloupe, the scope of the survey has been restricted to the private sector (social sector is collected through the quarterly survey on the rents of the social sector).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1697/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017T012EC"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/244> , <http://bauhaus/documents/document/245> .
    
    <http://bauhaus/qualite/attribut/1697/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Collection is carried out in January, April, July and October.<br />This is a panel survey: the occupants of the accommodation are interviewed during 5 consecutive quarters.<br />The first and last interviews of a household are conducted by visits (and after any&nbsp;change of tenant, or in the event of any difficulties in obtaining information by telephone). Intermediate surveys are conducted by telephone.<br /><br />Survey in Guadeloupe since October 2010.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/244>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2015 de l'enquête Loyers et charges (complet avec contrôles)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-04-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire2015controles.pdf> .
    
    <http://bauhaus/qualite/attribut/1697/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/240> .
    
    <http://bauhaus/qualite/attribut/1697/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Caract&eacute;ristiques de l'immeuble, du logement (dont les &eacute;l&eacute;ments de confort) ;<br />- Mode de location et aides per&ccedil;ues ;<br />- Montants des loyers et des charges.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1697/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1697/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1697/S.18.3/texte> , <http://bauhaus/qualite/attribut/1697/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-07-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est effectu&eacute;e en janvier, avril, juillet et octobre.<br />Il s'agit d'une enqu&ecirc;te par panel : on interroge les occupants du logement pendant 5 trimestres cons&eacute;cutifs.<br />La premi&egrave;re et la derni&egrave;re interrogation d'un m&eacute;nage sont r&eacute;alis&eacute;es par visite (et apr&egrave;s tout changement de locataire ou en cas&nbsp;de difficult&eacute; &eacute;ventuelle d'obtention des informations par t&eacute;l&eacute;phone). Les interrogations interm&eacute;diaires sont men&eacute;es par t&eacute;l&eacute;phone.<br /><br />Enqu&ecirc;te en Guadeloupe depuis octobre 2010.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1697/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Depuis 1958</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1697/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1697> .
    
    <http://bauhaus/qualite/attribut/1697/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Ensemble des r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation.<br />Depuis 2013 pour la m&eacute;tropole et depuis juillet 2017 pour la Guadeloupe, l'enqu&ecirc;te&nbsp;porte uniquement sur les loyers du secteur libre (les logements du secteur HLM sont interrog&eacute;s via l'enqu&ecirc;te ELBS).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1697/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/241> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1564> {
    <http://bauhaus/qualite/attribut/1564/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1564> .
    
    <http://bauhaus/qualite/attribut/1564/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-G120> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1564> .
    
    <http://bauhaus/qualite/attribut/1564/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1564/S.3.6/text> , <http://bauhaus/qualite/attribut/1564/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1564> .
    
    <http://bauhaus/qualite/attribut/1564/S.10.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/467> .
    
    <http://bauhaus/qualite/attribut/1564/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e tous les trimestres (en janvier, avril, juillet et octobre, soit le mois suivant la fin de chaque trimestre).</p>\n<p>La collecte s'effectue par voie postale et par internet de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la fin du mois de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1564/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1564> .
    
    <http://bauhaus/qualite/attribut/1564/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-G001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1564> .
    
    <http://bauhaus/qualite/attribut/1564/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quarterly outlook survey in the building trades aims to transcribe the opinion of craftspeople in the sector on their recent activity and activity prospects.</p>\n<p>This opinion is tracked by monitoring activity and related variables such as changes in workforce.</p>\n<p>The entrepreneurs also provide their opinion on their investments and their cash flow.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/473>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête trimestrielle dans l'artisanat du bâtiment"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-11-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/methodo_enq_trim_artisanat_bat_13112015.pdf> .
    
    <http://bauhaus/qualite/attribut/1564/I.18.8>
