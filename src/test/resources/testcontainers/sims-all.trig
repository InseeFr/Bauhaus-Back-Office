    <http://bauhaus/documents/document/966>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête achats des entreprises 2017 - Services 1 - IAA"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-08-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Achats2017_questionnaire_Services1_IAA.pdf> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>From september to december 2018</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Secteurs marchands (y-c financier), hors secteur agricole</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey sample is drawn from a sampling frame constructed from the Sirus directory (directory of statistical units).</p>\n<p>The sample size is 20,000 legal units out of a population of about 850,000 legal units.</p>\n<p>The objective is to gather information on intermediate consumption (IC).</p>\n<p>The exhaustive stratum is constructed with a criterion of number of employees (more than 250 employees) or minimum amount of intermediate consumption (28.14 million euros). Finally, units with a \"CI/Sales turnover\" ratio greater than 3 and a headcount greater than 10 are added to the exhaustive stratum.</p>\n<p>The non-exhaustive strata are first defined by the sector of activity, then the IC amount (adaptively to the sectors).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/documents/document/986>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Activités couvertes par chaque version du questionnaire de l'enquête achats des entreprises 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-09-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Achats2017_questionnaires_activites_couvertes.pdf> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1901/S.3.6/texte> , <http://bauhaus/qualite/attribut/1901/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/documents/document/965>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête achats des entreprises 2017 - Industrie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-08-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Achats2017_questionnaire_Industrie.pdf> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1901/I.18.7/texte> , <http://bauhaus/qualite/attribut/1901/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/qualite/attribut/1901/S.16/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The response time depends on the unit size and on the internal organization for procurement and charge tracking. The estimated median response time is one hour.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.16>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.16>
                    <http://bauhaus/qualite/attribut/1901/S.16/text> , <http://bauhaus/qualite/attribut/1901/S.16/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The main themes addressed are:<br />- purchases to be deducted from purchases and changes in stocks of raw materials: goods resold in their original state, subcontracting;<br />- purchases and changes in stocks of raw materials, other supplies and supplies (this part is broken down into eight variants, depending on the company's sector of activity);<br />- other external expenses.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Legal unit"@en , "Unité légale"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Market sector (including financial sector), excepting agricultural sector</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ de l'enqu&ecirc;te est d&eacute;fini &agrave; partir de nombreux crit&egrave;res dont les principaux sont&nbsp;: <br />- pour les soci&eacute;t&eacute;s non financi&egrave;res, &agrave; partir du sous-champ 1 d&rsquo;ESANE (donc du champ r&eacute;uni des ESA et des EAP), ne retenir que les unit&eacute;s marchandes au sens de la comptabilit&eacute; nationale&nbsp;;<br />- pour les soci&eacute;t&eacute;s financi&egrave;res, le champ est construit &agrave; partir du r&eacute;f&eacute;rentiel de la Banque de France, intitul&eacute; &laquo;&nbsp;Protides&nbsp;&raquo;. Ce r&eacute;f&eacute;rentiel rassemble les registres des soci&eacute;t&eacute;s ayant obtenu un agr&eacute;ment de la Banque de France. Il s&rsquo;agit de soci&eacute;t&eacute;s relevant des secteurs institutionnels (de la comptabilit&eacute; nationale) 121-122-125 et 128.</p>\n<p>Les entreprises avec un faible effectif sont exclues du champ, le seuil est adapt&eacute; &agrave; chaque secteur d&rsquo;activit&eacute;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1901/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2018X077EC"@fr , "2018X077EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/documents/document/964>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête achats des entreprises 2017 - Construction"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-08-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Achats2017_questionnaire_Construction.pdf> .
    
    <http://bauhaus/qualite/attribut/1901/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection takes place from September to December 2018, it is carried out by Internet with the possibility of sending a paper questionnaire on request.<br />The survey is new and could take place every five years.<br />The survey is conducted in metropolitan France and overseas departments (DOM), excluding Mayotte.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte se d&eacute;roule de septembre &agrave; d&eacute;cembre 2018, elle s&rsquo;effectue par internet avec possibilit&eacute; d&rsquo;envoi d&rsquo;un questionnaire papier sur demande.<br />L'enqu&ecirc;te est nouvelle, elle pourrait avoir lieu tous les cinq ans.<br />L'enqu&ecirc;te a lieu en France m&eacute;tropolitaine et d&eacute;partements d'outre-mer (DOM), &agrave; l&rsquo;exclusion de Mayotte.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les principaux th&egrave;mes abord&eacute;s portent sur :<br />- les achats &agrave; d&eacute;duire des achats et variations de stocks de mati&egrave;res premi&egrave;res&nbsp;: marchandises revendues en l&rsquo;&eacute;tat, sous traitance&nbsp;;<br />- les achats et variations de stocks de mati&egrave;res premi&egrave;res, autres approvisionnements et fournitures&nbsp;(cette partie est d&eacute;clin&eacute;e en huit variantes, selon le secteur d&rsquo;activit&eacute; de l&rsquo;entreprise)&nbsp;;<br />- les autres charges externes.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope of the survey is defined on the basis of numerous criteria, the main ones being: <br />- for non-financial corporations, from subfield 1 of ESANE (i.e. the combined field of ESAs and EAPs), only market units within the meaning of national accounts;<br />- for financial companies, the field is constructed on the basis of the Banque de France's reference framework, entitled \"Protides\". This repository gathers the registers of companies that have obtained approval from the Banque de France. These are companies in the institutional (national accounts) sectors 121-122-125 and 128.</p>\n<p>Companies with a small workforce are excluded from the scope, the threshold is adapted to each sector of activity.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/968> , <http://bauhaus/documents/document/963> , <http://bauhaus/documents/document/986> , <http://bauhaus/documents/document/965> , <http://bauhaus/documents/document/967> , <http://bauhaus/documents/document/962> , <http://bauhaus/documents/document/969> , <http://bauhaus/documents/document/964> , <http://bauhaus/documents/document/961> , <http://bauhaus/documents/document/966> .
    
    <http://bauhaus/documents/document/969>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête achats des entreprises 2017 - Transport"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-08-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Achats2017_questionnaire_Transport.pdf> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1901/S.3.4/text> , <http://bauhaus/qualite/attribut/1901/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1913> {
    <http://bauhaus/documents/document/1021>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2019 de l'enquête Loyers et charges (complet avec contrôles)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire2019controles.pdf> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>6,100 homes are surveyed every quarter.</p>"@en , "<p>6 100 logements sont enqu&ecirc;t&eacute;s chaque trimestre.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1913/I.18.7/texte> , <http://bauhaus/qualite/attribut/1913/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "-dg75-F330@insee.fr"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte dure environ 3 semaines et demi par trimestre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1913/S.3.4/texte> , <http://bauhaus/qualite/attribut/1913/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection lasts about 3.5 weeks per quarter.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1913/I.18.10/text> , <http://bauhaus/qualite/attribut/1913/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>All main residences rented in an unfurnished state which essential reason for the rental is housing.<br />Since 2013 for metropolitan France and since July 2017 for Guadeloupe, the scope of the survey has been restricted to the private sector (social sector is collected through the quarterly survey on the rents of the social sector).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1913/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est effectu&eacute;e en janvier, avril, juillet et octobre.<br />Il s'agit d'une enqu&ecirc;te par panel : on interroge les occupants du logement pendant 5 trimestres cons&eacute;cutifs.<br />La premi&egrave;re et la derni&egrave;re interrogation d'un m&eacute;nage sont r&eacute;alis&eacute;es par visite avec un enqu&ecirc;teur (et apr&egrave;s tout changement de locataire ou en cas&nbsp;de difficult&eacute; &eacute;ventuelle d'obtention des informations par t&eacute;l&eacute;phone). Les interrogations interm&eacute;diaires sont men&eacute;es par t&eacute;l&eacute;phone.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1913/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2019T002EC"@fr , "2019T002EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The questionnaires for the Rent and Expenses 2019 survey are attached below:</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1021> , <http://bauhaus/documents/document/1022> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Chaque trimestre, environ 3 700 logements en m&eacute;tropole et 600 dans chaque DOM (Guadeloupe, Guyane, Martinique, la R&eacute;union) font partie de l'&eacute;chantillon &agrave; enqu&ecirc;ter.&nbsp;</p>\n<p>Il s'agit de r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation : les logements concern&eacute;s ne doivent pas avoir plus de 50 % de leur surface consacr&eacute;e &agrave; une activit&eacute; professionnelle.</p>\n<p>Sont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occup&eacute;s &agrave; titre gratuit.</p>\n<p>En m&eacute;tropole et en Guadeloupe, l'&eacute;chantillon est tir&eacute; dans l'&eacute;chantillon ma&icirc;tre de l'Insee (issu du recensement de la population). Pour les autres DOM (Guyane, Martinique, la R&eacute;union), l&rsquo;&eacute;chantillon est tir&eacute; dans les fichiers fiscaux (fichier Fideli).</p>\n<p>Un cinqui&egrave;me de l'&eacute;chantillon est renouvel&eacute; chaque trimestre : l'&eacute;chantillon sortant se compose des logements interrog&eacute;s 5 fois et des logements hors champ &agrave; l'enqu&ecirc;te pr&eacute;c&eacute;dente.</p>\n<p>On effectue chaque trimestre le remplacement du sous-&eacute;chantillon sortant par un sous &eacute;chantillon entrant.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1913/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Since 1958</p>"@en , "<p>Depuis 1958</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Collection is carried out in January, April, July and October.<br />This is a panel survey: the occupants of the accommodation are interviewed during 5 consecutive quarters.<br />The first and last interviews of a household are conducted by visits with an interviewer (and after any&nbsp;change of tenant, or in the event of any difficulties in obtaining information by telephone). Intermediate surveys are conducted by telephone.<br /><br />Survey in Guadeloupe since October 2010</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1913>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Rents and Charges Survey 2019"@en , "Rapport qualité : Enquête Loyers et charges 2019"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1470> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les questionnaires de l'enqu&ecirc;te Loyers et charges 2019 sont joints ci-dessous&nbsp;:</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1021> , <http://bauhaus/documents/document/1022> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes de l&rsquo;enqu&ecirc;te sont les suivants&nbsp;:<br />- Caract&eacute;ristiques de l'immeuble, du logement (dont les &eacute;l&eacute;ments de confort) ;<br />- Mode de location et aides per&ccedil;ues ;<br />- Montants des loyers et des charges.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes of the survey are as follows:<br />- Characteristics of the residential building and accommodation (including conveniences);<br />- Rental method and benefits received;<br />- Total amounts of rents and charges.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Each quarter, approximately 3,700 housing units in metropolitan France and 600 in each French overseas department (Guadeloupe, French Guiana, Martinique, Reunion Island) are included in the sample to be surveyed.&nbsp;</p>\n<p>These are main residences rented in an unfurnished state, whose main purpose is residential: the accommodation concerned must not have more than 50% of its surface area used for a professional activity.</p>\n<p>Sub-let accommodation, leases with purchase options (or rental/purchase schemes) and accommodation occupied on a free basis, are excluded from the field of the survey.</p>\n<p>The sample is drawn from the INSEE master sample (derived from the population census).</p>\n<p>One fifth of the sample is renewed each quarter: the outgoing sample consists of accommodation surveyed 5 times and accommodation which fell outside the scope of the previous survey.</p>\n<p>Each quarter, the outgoing sub-sample is replaced by an incoming sub-sample.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1913/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1913/S.18.3/text> , <http://bauhaus/qualite/attribut/1913/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Elle est constitu&eacute;e de l&rsquo;ensemble des r&eacute;sidences principales lou&eacute;es vides dont l'objet essentiel de la location est l'habitation : les logements concern&eacute;s ne doivent pas avoir plus de 50 % de leur surface consacr&eacute;e &agrave; une activit&eacute; professionnelle. Sont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occup&eacute;s &agrave; titre gratuit.<br />Depuis 2013 pour la m&eacute;tropole et depuis juillet 2017 pour la Guadeloupe, l'enqu&ecirc;te&nbsp;porte uniquement sur les loyers du secteur libre. Les logements du secteur HLM sont interrog&eacute;s via l'enqu&ecirc;te conjoncturelle sur les loyers aupr&egrave;s des bailleurs sociaux (ELBS).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1913/I.18.12/texte> , <http://bauhaus/qualite/attribut/1913/I.18.12/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/documents/document/1022>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2019 de l'enquête Loyers et charges"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1913/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1913/S.3.6/texte> , <http://bauhaus/qualite/attribut/1913/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/P> , <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
    
    <http://bauhaus/qualite/attribut/1913/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1913> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1925> {
    <http://bauhaus/qualite/attribut/1925/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The results are published every two months in &laquo;&nbsp;Informations Rapides&nbsp;&raquo; series.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1925/S.11.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.1>
                    <http://bauhaus/qualite/attribut/1925/S.11.1/texte> , <http://bauhaus/qualite/attribut/1925/S.11.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.11.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Questions are formulated so that they can be answered quickly (most of the questions are qualitative with three response options expressed in the form \"higher, lower, stable\", or \"more than normal, normal, less than normal\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1925/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1925/S.3.4/text> , <http://bauhaus/qualite/attribut/1925/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.8.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The broadcasting schedule is available under: <a href=\"https://www.insee.fr/fr/information/1405540?debut=0\">https://www.insee.fr/fr/information/1405540?debut=0</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1925/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>3,000 units.</p>"@en , "<p>3&nbsp;000 unit&eacute;s.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of Short-Term Economic Trends Survey Section</p>"@en , "<p>Cheffe de la division des enqu&ecirc;tes de conjoncture</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/documents/document/1075>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire des mois de mars, mai, septembre et novembre"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0006-10-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_COMMERCE_GROS_MODELE2_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1925/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te de conjoncture dans le commerce de gros est r&eacute;alis&eacute;e tous les deux mois (janvier, mars, mai, juillet, septembre, novembre). Les r&eacute;sultats sont publi&eacute;s entre le 20 et le 25 du mois de r&eacute;f&eacute;rence.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1925/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1925/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.10.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Individual response files are stored annually. Any request for access to these individual data shall be subject to the authorisation of the Committee on Statistical Confidentiality. The data is then made available to users outside INSEE via the CASD (Centre d'acc&egrave;s s&eacute;curis&eacute; aux donn&eacute;es), after passing through the Secret Committee.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1925/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les fichiers de r&eacute;ponses individuelles sont mis en conservation annuellement. Toute demande d&rsquo;acc&egrave;s &agrave; ces donn&eacute;es individuelles est soumise &agrave; l&rsquo;autorisation du comit&eacute; du secret statistique. Les donn&eacute;es sont alors mises &agrave; disposition des utilisateurs ext&eacute;rieurs &agrave; l&rsquo;Insee via le CASD (Centre d&rsquo;acc&egrave;s s&eacute;curis&eacute; aux donn&eacute;es), apr&egrave;s passage au Comit&eacute; du secret.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1925/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Users are conjoncturits from Insee, general direction of Treasor and other institutes in France or abroad, economist, journalists.&hellip;</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1925/S.8.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.2>
                    <http://bauhaus/qualite/attribut/1925/S.8.2/text> , <http://bauhaus/qualite/attribut/1925/S.8.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1925/S.3.3/texte> , <http://bauhaus/qualite/attribut/1925/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e tous les deux mois mais toutes les questions ne sont pas pos&eacute;es chaque mois.</p>\n<p>En pratique, deux mod&egrave;les de questionnaires ont &eacute;t&eacute; cr&eacute;&eacute;s pour tenir compte de ces sp&eacute;cificit&eacute;s au mois le mois&nbsp;: <br />- le premier questionnaire mensuel correspond aux mois de janvier et juillet&nbsp;; <br />- le second correspond aux mois de mars, mai, septembre et novembre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1074> , <http://bauhaus/documents/document/1075> .
    
    <http://bauhaus/qualite/attribut/1925/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les utilisateurs sont les conjoncturistes et pr&eacute;visionnistes de l&rsquo;Insee, de la direction g&eacute;n&eacute;rale du Tr&eacute;sor et d&rsquo;autres instituts, fran&ccedil;ais et &eacute;trangers, ainsi que des organismes internationaux, des statisticiens d&rsquo;entreprise, les d&eacute;cideurs, les &eacute;conomistes et les chercheurs, les journalistes de la presse &eacute;conomique, etc.<br />L&rsquo;enqu&ecirc;te bimestrielle de conjoncture dans le commerce de gros permet de disposer d&rsquo;une vue pr&eacute;coce, compl&egrave;te et coh&eacute;rente de l&rsquo;activit&eacute; du secteur du commerce de gros, &eacute;clairant des domaines qui ne sont pas couverts, ou plus tardivement, par les autres sources statistiques conjoncturelles comme les indices de volume des ventes ou les comptes trimestriels.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1925/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les r&eacute;sultats sont publi&eacute;s tous les deux mois dans les &laquo;&nbsp;Informations rapides&nbsp;&raquo; sur insee.fr.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1925/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1925/S.7.2/text> , <http://bauhaus/qualite/attribut/1925/S.7.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1925/I.18.10/texte> , <http://bauhaus/qualite/attribut/1925/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Myriam Broin</p>"@fr , "<p>Myriam Broin</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/documents/document/1074>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire des mois de janvier et juillet"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0006-10-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_COMMERCE_GROS_MODELE1_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1925/S.7.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Loi n&deg;51-711 du 7 juin 1951 sur l'obligation, la coordination et le secret en mati&egrave;re de statistiques. Disponible &agrave; l'adresse <a href=\"https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573</a>.</p>\n<p>L'article 6 concerne le secret statistique&nbsp;: sous r&eacute;serve des dispositions des articles 40, 56, 76, 97 et 99 du code de proc&eacute;dure p&eacute;nale et de celles de l'article L.&nbsp;213-3 du code du patrimoine, les renseignements individuels figurant dans les questionnaires rev&ecirc;tus du visa pr&eacute;vu &agrave; l'article 2 de la pr&eacute;sente loi et ayant trait &agrave; la vie personnelle et familiale et, d'une mani&egrave;re g&eacute;n&eacute;rale, aux faits et comportements d'ordre priv&eacute; ne peuvent, sauf d&eacute;cision de l'administration des archives, prise apr&egrave;s avis du comit&eacute; du secret statistique et relative &agrave; une demande effectu&eacute;e &agrave; des fins de statistique publique ou de recherche scientifique ou historique, faire l'objet d'aucune communication de la part du service d&eacute;positaire avant l'expiration d'un d&eacute;lai de soixante-quinze ans suivant la date de r&eacute;alisation de l'enqu&ecirc;te ou d'un d&eacute;lai de vingt-cinq ans &agrave; compter de la date du d&eacute;c&egrave;s de l'int&eacute;ress&eacute;, si ce dernier d&eacute;lai est plus bref.<br />Il est institu&eacute; un comit&eacute; du secret statistique. Ce comit&eacute; est appel&eacute; &agrave; se prononcer sur toute question relative au secret en mati&egrave;re de statistiques. Il donne son avis sur les demandes de communication de donn&eacute;es individuelles collect&eacute;es en application de la pr&eacute;sente loi. Le comit&eacute; est pr&eacute;sid&eacute; par un conseiller d'&Eacute;tat, d&eacute;sign&eacute; par le vice-pr&eacute;sident du Conseil d&rsquo;&Eacute;tat. Il comprend notamment des repr&eacute;sentants de l'Assembl&eacute;e nationale et du S&eacute;nat. La composition et les modalit&eacute;s de fonctionnement du comit&eacute; sont fix&eacute;es par d&eacute;cret en Conseil d'&Eacute;tat. Les b&eacute;n&eacute;ficiaires des communications de donn&eacute;es r&eacute;sultant des d&eacute;cisions minist&eacute;rielles prises apr&egrave;s avis du comit&eacute; du secret statistique s'engagent &agrave; ne communiquer ces donn&eacute;es &agrave; quiconque. Toute infraction aux dispositions de cet alin&eacute;a est punie des peines pr&eacute;vues &agrave; l'article 226-13 du code p&eacute;nal.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1925/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Certaines donn&eacute;es sont disponibles depuis 1972.</p>"@fr , "<p>Some data have been available since 1972.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers 3,000 companies.</p>\n<p>All companies with more than 200 employees are questioned, and all those with a turnover of more than a certain threshold, depending on their sub-sector of activity.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1925/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1925/S.18.3/texte> , <http://bauhaus/qualite/attribut/1925/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1925> .
    
    <http://bauhaus/qualite/attribut/1925/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
