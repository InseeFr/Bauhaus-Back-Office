    <http://bauhaus/qualite/attribut/1558/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted on around 4,000 industrial companies with more than 20 employees. All companies with at least 500 employees or 150 million euros in turnover are surveyed (identical sample to that used for the monthly manufacturing industry survey)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1558/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1558/S.3.6/text> , <http://bauhaus/qualite/attribut/1558/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
