    <http://bauhaus/qualite/attribut/1604/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1604/I.18.10/text> , <http://bauhaus/qualite/attribut/1604/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1604/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Questions are formulated so that they can be answered quickly (most of the questions are qualitative with three response options expressed in the form \"higher, same, lower\", or \"strong, normal, weak\")."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1604/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The quarterly business outlook survey in real estate development records the opinion of developers and housing rental companies&nbsp;on their recent activity and on their future planned activity.</p>\n<p>This opinion is obtained by tracking the demand for new housing for sale or rent, unsold housing stock, housing sale prices. Data about future trends are provided in particular by monitoring opinions on housing starts.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1604/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1604/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1604/S.3.4/texte> , <http://bauhaus/qualite/attribut/1604/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted every quarter (in January, April, July and October, i.e. the month after the end of each quarter).</p>\n<p>Data collection is by post from the end of the month preceding the survey month to the end of the survey month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1604>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Quarterly business outlook survey in real estate development 2014"@en , "Rapport qualité : Enquête trimestrielle de conjoncture dans la promotion immobilière 2014"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1110> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te trimestrielle de conjoncture dans la promotion immobili&egrave;re permet de transcrire l'opinion des promoteurs et des entreprises r&eacute;alisant de la location immobili&egrave;re sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.</p>\n<p>Cette opinion est retrac&eacute;e au moyen du suivi de la demande en logements neufs &agrave; acheter et &agrave; louer, des stocks de logements invendus, du prix de vente des logements. Les donn&eacute;es sur les perspectives sont fournies notamment par le suivi des opinions sur les mises en chantier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1604/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1604/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1725> {
    <http://bauhaus/qualite/attribut/1725/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The surveying of a new set is launched every 4 years.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/175> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    ""@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-09-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>SINE est un syst&egrave;me permanent d'observation et de suivi d'une g&eacute;n&eacute;ration (ou cohorte) de nouvelles entreprises tous les quatre ans.</p>\n<p>Une g&eacute;n&eacute;ration correspond ici aux entreprises cr&eacute;&eacute;es au cours de la m&ecirc;me p&eacute;riode (le premier semestre) d'une ann&eacute;e donn&eacute;e. Chaque g&eacute;n&eacute;ration d'entreprises est donc repr&eacute;sent&eacute;e par les seules cr&eacute;ations du premier semestre de l'ann&eacute;e.</p>\n<p>Pour chaque g&eacute;n&eacute;ration, le recueil d'information repose sur trois interrogations :<br />- la premi&egrave;re, quelques mois apr&egrave;s la cr&eacute;ation de l'entreprise ;<br />- la deuxi&egrave;me, au bout de la troisi&egrave;me ann&eacute;e d'existence de l'entreprise ;<br />- la troisi&egrave;me, cinq ans apr&egrave;s la cr&eacute;ation.</p>\n<p>&nbsp;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1725/S.18.3/texte> , <http://bauhaus/qualite/attribut/1725/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1725/I.18.10/texte> , <http://bauhaus/qualite/attribut/1725/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/rapport/1725>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: New enterprises information system 2002"@en , "Rapport qualité : Système d'information sur les nouvelles entreprises 2002"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1081> .
    
    <http://bauhaus/qualite/attribut/1725/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Each generation (or set) of businesses responds to three surveys using two different questionnaires: a questionnaire for the first survey upon start-up and a second questionnaire for the second and third surveys, after three years and five years of activity."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/175>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête auprès des entreprises créées ou reprises en 2002 : Situation initiale"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-12-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_SINE_Initial_2002.pdf> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/U> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The economic coverage of the SINE programme matches the businesses' demographic scope: all market activities, excluding agricultural activities.</p>\n<p>Until the 2002 set, the SINE system only covered the \"ICS\" scope (Industry, the building industry, Trade and Services).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire porte sur :<br />- le profil du cr&eacute;ateur et les conditions de d&eacute;marrage de l'entreprise ;<br />- l'&eacute;volution de l'activit&eacute; de l'entreprise, le type de client&egrave;le, la coop&eacute;ration avec les autres entreprises ;<br />- l'&eacute;volution des effectifs (embauches, licenciements, personnel occasionnel) ;<br />- les investissements et leur mode de financement ;<br />- la formation et les conseils apr&egrave;s la cr&eacute;ation ;<br />- les difficult&eacute;s rencontr&eacute;es par l'entreprise ;<br />- la strat&eacute;gie de l'entreprise ;<br />- les conditions de son d&eacute;veloppement.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1725/S.3.6/texte> , <http://bauhaus/qualite/attribut/1725/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1725/S.19/text> , <http://bauhaus/qualite/attribut/1725/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'interrogation d'une nouvelle cohorte est initialis&eacute;e tous les 4 ans.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Chaque génération (ou cohorte) d'entreprises fait l'objet de trois enquêtes par le biais de deux questionnaires différents : un questionnaire pour la première interrogation dès la création et un second questionnaire pour la deuxième et la troisième interrogation, après trois ans et cinq ans d'activité."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La couverture &eacute;conomique du dispositif SINE correspond au champ de la d&eacute;mographie d'entreprises : l'ensemble des activit&eacute;s marchandes, hormis les activit&eacute;s agricoles.</p>\n<p>Jusqu'&agrave; la cohorte 2002, le dispositif SINE ne couvrait que le champ dit \"ICS\" (de l'Industrie, de la construction, du Commerce et des Services).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>SINE is an ongoing system to observe and monitor a generation (or set) of new enterprises every four years.</p>\n<p>In this case, a generation is a group of enterprises created over the same period (the first half) of a given year. Each generation of enterprises is therefore only represented by the companies created in the first half of the year.</p>\n<p>For each generation, the information is collected using three surveys:<br />- the first, a few months after the creation of the enterprise;<br />- the second, at the end of the third year of existence of the enterprise;<br />- the third, five years after its creation.</p>\n<p>&nbsp;</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1725/S.3.4/texte> , <http://bauhaus/qualite/attribut/1725/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The questionnaire dealt with:<br />- the profile of the creator and the conditions for the start-up of the enterprise;<br />- the development of the enterprise's activity, type of clientele, cooperation with other enterprises;<br />- changes to employee numbers (hiring, dismissals, occasional staff);<br />- investments and their form of financing;<br />- training and advice after start-up;<br />- the difficulties encountered by the enterprise;<br />- the enterprise's strategy;<br />- the conditions for its development.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1725/I.18.7/text> , <http://bauhaus/qualite/attribut/1725/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Toutes les nouvelles entreprises ne sont pas enqu&ecirc;t&eacute;es.</p>\n<p>Les &eacute;chantillons de la cohorte 2002 du dispositif SINE sont tir&eacute;s &agrave; partir des cr&eacute;ations d'entreprises enregistr&eacute;es dans le r&eacute;pertoire Sirene au cours du premier semestre 2002 r&eacute;parties en strates selon la r&eacute;gion, l&rsquo;activit&eacute; et l&rsquo;origine de la cr&eacute;ation (cr&eacute;ation pure ou reprise).</p>\n<p>Rappel : sur les cohortes 2006 et ant&eacute;rieures, le r&eacute;gime de l&rsquo;auto-entrepreneur n&rsquo;existait pas encore. Il n&rsquo;y a donc qu&rsquo;un seul questionnaire.</p>\n<p>Attention, la notion de reprise n'est plus appr&eacute;hend&eacute;e de la m&ecirc;me fa&ccedil;on avec les concepts europ&eacute;ens de d&eacute;mographie d'entreprises, adopt&eacute;s en France &agrave; partir de 2007.</p>\n<p>D&egrave;s lors, on n'interroge plus, dans SINE, &agrave; compter le la cohorte 2010, que des cr&eacute;ations selon la d&eacute;finition europ&eacute;enne.</p>\n<p>La cohorte 2002 fait donc encore appel &agrave; l&rsquo;ancienne d&eacute;finition de cr&eacute;ation avant cette harmonisation europ&eacute;enne.</p>\n<p>Le mode de tirage de l'&eacute;chantillon permet une repr&eacute;sentativit&eacute; nationale et r&eacute;gionale des r&eacute;sultats.</p>\n<p>Seules les entreprises survivantes sont ensuite r&eacute;interrog&eacute;es apr&egrave;s trois ans et cinq ans d'existence.</p>\n<p>L'&eacute;chantillon total SINE 2002 (premi&egrave;re interrogation de la g&eacute;n&eacute;ration 2002) compte environ 47 600 cr&eacute;ateurs (dont environ 7 500 au titre d&rsquo;extensions r&eacute;gionales).</p>\n<p>La deuxi&egrave;me interrogation de cette cohorte a eu lieu en 2005 et la troisi&egrave;me en 2007.</p>\n<p>L&rsquo;&eacute;chantillon couvre la France enti&egrave;re, DOM compris.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1725/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1955> {
    <http://bauhaus/qualite/attribut/1955/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The LFS Mayotte questionnaire is structured around the following themes:<br />- a description of the household and its members;<br />- the status of an activity according to the ILO definition;<br />- a detailed description of the current main job (occupation, working time, kind of contract, etc.).<br />- the description of the employing institution<br />- The caracteristics of job search activities<br />- the level of education and participation in training;<br />- the situation one year before the survey (place of residence, labour market situation, etc.);<br />- the past and desired geographic mobility&nbsp;;<br />- casual activities&nbsp;;<br />- incomes.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>From March to July</p>"@en , "<p>De mars&nbsp; &agrave;&nbsp; juillet</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data collection is conducted from march to june. With some exceptions, the interview is usually conducted in the 2 weeks and 2 days following the reference week.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is joined above&nbsp;:</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.2>
                    <http://bauhaus/qualite/attribut/1955/S.3.2/texte> , <http://bauhaus/qualite/attribut/1955/S.3.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.13.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The unemployment rate in Mayotte is estimated with a confidence interval at 95&nbsp;% of &plusmn; 2 pt.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.18.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.4>
                    <http://bauhaus/qualite/attribut/1955/S.18.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>Each year, around 3 000 dwellings are surveyed.</p>"@en , "<p>Chaque ann&eacute;e, environ 3 000 logements sont enqu&ecirc;t&eacute;s.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/documents/document/1175>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire EEM 2014"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/QuestionnaireEEM2014.doc> .
    
    <http://bauhaus/qualite/attribut/1955/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1955/S.6.1/text> , <http://bauhaus/qualite/attribut/1955/S.6.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F230> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data has been updated due to the new&nbsp; population census. This one occured in 2017, and data from 2013 to 2017 have been updated.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/region/0e9f9adc-742d-4ab7-90bd-30e5aaf7b2ab> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>See the link</p>\n<p><a href=\"https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology\">https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.13.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Response rate&nbsp;: 86,5&nbsp;%</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1955/S.3.1/text> , <http://bauhaus/qualite/attribut/1955/S.3.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire est&nbsp; joint ci-dessous&nbsp;:</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1955/S.13.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le taux de ch&ocirc;mage annuel &agrave;&nbsp; Mayotte est estim&eacute; avec un intervalle de confiance &agrave; 95 % de &plusmn; 2 points.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1955/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "0187696291"@fr , "0187696291"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es ont &eacute;t&eacute; r&eacute;vis&eacute;es apr&egrave;s le dernier recensement exhaustif de la population. Celui-ci a eu lieu en 2017, ainsi les donn&eacute;es 2013-2017 sont r&eacute;vis&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1955/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1955/I.18.10/texte> , <http://bauhaus/qualite/attribut/1955/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Individus de 15 ans ou plus vivant en logement ordinaire. <br />Lien vers d&eacute;finition</p>\n<p><a href=\"https://www.insee.fr/fr/metadonnees/definition/c2056\">https://www.insee.fr/fr/metadonnees/definition/c2056</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1955/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-F001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le questionnaire de l&rsquo;enqu&ecirc;te Emploi annuelle Mayotte est structur&eacute; autour des th&egrave;mes suivants&nbsp;:<br />- la description du m&eacute;nage et des personnes qui le composent&nbsp;;<br />- le statut d&rsquo;activit&eacute; au sens du BIT&nbsp;;<br />- la description des activit&eacute;s professionnelles (profession, dur&eacute;e du travail, type de contrat&hellip;)&nbsp;;<br />- la description de l&rsquo;&eacute;tablissement employeur ou dirig&eacute;&nbsp;;<br />- les caract&eacute;ristiques de la recherche d&rsquo;emploi&nbsp;;<br />- le niveau d&rsquo;&eacute;tudes et la participation &agrave; des formations&nbsp;;<br />- la situation un an avant l&rsquo;enqu&ecirc;te (lieu de r&eacute;sidence, situation par rapport au march&eacute; du travail&hellip;)&nbsp;;<br />- la mobilit&eacute; pass&eacute;e et souhait&eacute;e&nbsp;;<br />- les activit&eacute;s occasionnelles&nbsp;;<br />- les revenus.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1955>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête Emploi annuelle de Mayotte 2014"@fr , "Quality report: Labour force survey (LFS) Mayotte 2014"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1511> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1955/S.3.6/texte> , <http://bauhaus/qualite/attribut/1955/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e entre mars et juin. Elle s&rsquo;effectue, sauf exception, dans les 2 semaines et 2 jours apr&egrave;s la fin de la semaine de r&eacute;f&eacute;rence.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey provides a measurement of activity, employment and unemployment according to the ILO definition. It provides a description of the job (status, occupation, working time&hellip;) according to european classifications / definitions.</p>\n<p><a href=\"https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology#EU-LFS_concept_of_labour_force_status\">https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology#EU-LFS_concept_of_labour_force_status</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.10.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.4>
