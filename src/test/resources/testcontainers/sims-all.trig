    <http://bauhaus/qualite/attribut/1909/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1909/I.18.12/texte> , <http://bauhaus/qualite/attribut/1909/I.18.12/text> ;
