                    "2015-10-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ECMOSS_2015.pdf> .
    
    <http://bauhaus/documents/document/339>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2013 Établissement privé / format structure des salaires ESS"@fr ;
