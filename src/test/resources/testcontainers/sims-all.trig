    <http://bauhaus/qualite/rapport/1609>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête trimestrielle de conjoncture dans la promotion immobilière 2008"@fr , "Quality report: Quarterly business outlook survey in real estate development 2008"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1115> .
    
    <http://bauhaus/qualite/attribut/1609/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e tous les trimestres (en janvier, avril, juillet et octobre, soit le mois suivant la fin de chaque trimestre).</p>\n<p>La collecte s'effectue par voie postale de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la fin du mois de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1609/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1609/S.3.6/texte> , <http://bauhaus/qualite/attribut/1609/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
    <http://bauhaus/qualite/attribut/1609/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête par sondage auprès de 1 000 entreprises de promotion immobilière de logements et de location de logements."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1609/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1609/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
    <http://bauhaus/qualite/attribut/1609/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/406> .
    
    <http://bauhaus/qualite/attribut/1609/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted every quarter (in January, April, July and October, i.e. the month after the end of each quarter).</p>\n<p>Data collection is by post from the end of the month preceding the survey month to the end of the survey month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1609/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-G001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
    <http://bauhaus/documents/document/399>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2008"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2009-03-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Promotion_francais_2008.pdf> .
    
    <http://bauhaus/qualite/attribut/1609/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te trimestrielle de conjoncture dans la promotion immobili&egrave;re permet de transcrire l'opinion des promoteurs et des entreprises r&eacute;alisant de la location immobili&egrave;re sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.</p>\n<p>Cette opinion est retrac&eacute;e au moyen du suivi de la demande en logements neufs &agrave; acheter et &agrave; louer, des stocks de logements invendus, du prix de vente des logements. Les donn&eacute;es sur les perspectives sont fournies notamment par le suivi des opinions sur les mises en chantier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1609/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1609/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
    <http://bauhaus/qualite/attribut/1609/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
