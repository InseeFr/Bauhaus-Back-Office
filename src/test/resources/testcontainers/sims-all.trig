    <http://bauhaus/documents/document/355>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice relative au questionnaire de l'enquête sur les contours des réseaux du commerce de détail et des services"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-09-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_notice_contours_reseaux_2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1635/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey is carried out among network heads (legal units) on all of their outlets. This survey is used to populate a register and should cover the exhaustiveness of the 1 500 retail networks and services to the end. The sectors surveyed are, in the NAF rev. 2, divisions 10 and 47 for retail networks and sectors I to S (except sectors K, O) for services networks."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1635>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on networks scope in retail and services 2016"@en , "Rapport qualité : Enquête sur les contours des réseaux du commerce de détail et des services 2016"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1308> .
    
