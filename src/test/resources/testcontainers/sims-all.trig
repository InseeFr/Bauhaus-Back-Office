                    <http://bauhaus/qualite/rapport/1611> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1611/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1611> .
    
    <http://bauhaus/qualite/attribut/1611/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans les services fait partie du syst&egrave;me europ&eacute;en harmonis&eacute; des enqu&ecirc;tes de conjoncture de la Commission europ&eacute;enne, auquel contribuent les vingt-sept &Eacute;tats membres de l'Union europ&eacute;enne.<br /><br />&Agrave; ce titre, les questionnaires, les nomenclatures et les m&eacute;thodes de traitement sont largement harmonis&eacute;s dans les instituts nationaux des pays adh&eacute;rant &agrave; ce syst&egrave;me.<br /><br />La formulation des questions est con&ccedil;ue de mani&egrave;re &agrave; faciliter une r&eacute;ponse rapide (la&nbsp;plupart des questions sont qualitatives &agrave; trois modalit&eacute;s exprim&eacute;es sous la forme \"hausse, baisse, stable\", ou \"sup&eacute;rieur &agrave; la normale, normal, inf&eacute;rieur &agrave; la normale\").</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1611>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête mensuelle de conjoncture dans les services 2015"@fr , "Quality report: Monthly outlook survey in services 2015"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1155> .
    
    <http://bauhaus/qualite/attribut/1611/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in services is part of the harmonised European Union programme of business and consumer surveys to which the 27 Member States of the European Union contribute.<br /><br />As such, the questionnaires, classifications and processing methods are largely harmonised in the national institutes of the countries belonging to the system.<br /><br />The wording of the questions is designed in such a way as to facilitate quick answers (most of the questions are qualitative with three possible answers in the form \"up, down, same\", or \"higher than normal, normal, lower than normal\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1611/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1611/S.3.6/text> , <http://bauhaus/qualite/attribut/1611/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1611> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1950> {
    <http://bauhaus/qualite/attribut/1950/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es recueillies sont principalement la localisation des magasins organis&eacute;s en r&eacute;seau d&rsquo;enseigne et la forme d&rsquo;organisation qui lie l&rsquo;&eacute;tablissement &agrave; la t&ecirc;te du r&eacute;seau&nbsp;: filiale ou succursale si le magasin n&rsquo;est pas financi&egrave;rement ind&eacute;pendant, franchise, groupement coop&eacute;ratif, commission-affiliation, concession, licence de marque, location-g&eacute;rance ou autre forme de contrat.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Biennial. Data is collected from may to october.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.7.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>In so far as concerns collection via the Internet, the Coltrane collection site is totally secure and the standards in terms of managing survey access codes are strict and standardized for all surveys. For enterprises that choose to use paper, the managers are responsible for the input, and must strictly respect the confidentiality of any data collected.<br />This confidentiality applies before any data is disseminated. For data relating to enterprises &ndash; no results are published that relates to less than three enterprises or establishments. Similarly, a result will only be disseminated if no enterprise or institution contributes more than 85% of this result. Primary suppressions correspond to boxes that do not meet the above criteria. Secondary confidentiality removes other boxes so that the data can not be retrieved by adding and subtracting with the margins of the tables. Statistical confidentiality is defined in law n&deg; 51-711 of 7 June 1951.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.7.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant la collecte internet, le site de collecte est enti&egrave;rement s&eacute;curis&eacute; et les normes en termes de gestion des codes d&rsquo;acc&egrave;s &agrave; l&rsquo;enqu&ecirc;te sont strictes et standardis&eacute;es pour toutes les enqu&ecirc;tes entreprises. Pour les entreprises choisissant d&rsquo;utiliser le support papier, la saisie est assur&eacute;e par les gestionnaires, dans le strict respect de la confidentialit&eacute; des donn&eacute;es r&eacute;colt&eacute;es.<br />Avant la diffusion des donn&eacute;es le secret est appliqu&eacute;. Pour les donn&eacute;es relatives aux entreprises : on ne publie aucun r&eacute;sultat qui concerne moins de trois entreprises ou &eacute;tablissements. De m&ecirc;me, un r&eacute;sultat ne sera diffus&eacute; que si aucune entreprise ou &eacute;tablissement ne contribue &agrave; plus de 85 % de ce r&eacute;sultat. Les suppression primaire correspondent aux cases ne r&eacute;pondant pas au crit&egrave;re ci-dessus. Le secret secondaire supprime d'autres cases pour que les donn&eacute;es ne puissent pas &ecirc;tre retrouv&eacute;es par addition soustraction avec les marges des tableaux. Le secret statistique est d&eacute;fini dans la loi n&deg; 51-711 du 7 juin 1951.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un r&eacute;seau d&rsquo;enseigne est un ensemble de points de vente qui pr&eacute;sentent des caract&eacute;ristiques communes (vente de m&ecirc;mes produits, offre de m&ecirc;mes services) en apposant notamment le logo de l&rsquo;enseigne sur leur vitrine et qui sont coordonn&eacute;s par une m&ecirc;me soci&eacute;t&eacute;, la &laquo;&nbsp;t&ecirc;te de r&eacute;seau&nbsp;&raquo;.<br />Les informations recherch&eacute;es sur les membres du r&eacute;seau sont essentiellement, outre l'enseigne et le lien, l'identifiant Siret et l'adresse.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A brand network is a set of points of sale that have common characteristics (sale of the same products, offer of the same services) by affixing the brand's logo on their window and which are coordinated by the same company, the \"network head\".<br />The main information collected about the members of the network are : brand name, link, a fourteen-figure identification number and mailing address.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data are published mainly in the Insee Premi&egrave;re collection and are available at insee.fr.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of the Trade section</p>"@en , "<p>Cheffe de la division Commerce</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1950/I.18.10/text> , <http://bauhaus/qualite/attribut/1950/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sectors surveyed are, in the NAF&nbsp;rev. 2, divisions 10, 45 and 47 for retail networks and sectors I to S (except sectors K, O) for services networks.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1950/S.3.3/texte> , <http://bauhaus/qualite/attribut/1950/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1950/S.18.3/text> , <http://bauhaus/qualite/attribut/1950/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey is carried out among network heads (legal units) on all of their outlets.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1950/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1950/S.7.2/text> , <http://bauhaus/qualite/attribut/1950/S.7.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/qualite/attribut/1950/S.2.3>
