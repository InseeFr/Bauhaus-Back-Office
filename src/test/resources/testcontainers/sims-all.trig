    <http://bauhaus/qualite/attribut/1934/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Chlo&eacute; Tavan</p>"@fr , "<p>Chlo&eacute; Tavan</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Le statut d&rsquo;activit&eacute; au sens du BIT est mesur&eacute; en r&eacute;f&eacute;rence &agrave; une semaine donn&eacute;e fixe, dite &laquo;&nbsp;semaine de r&eacute;f&eacute;rence&nbsp;&raquo;.</p>"@fr , "<p>The ILO status of activity is measured according to a fixed week, named reference week.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1934> .
    
    <http://bauhaus/qualite/attribut/1934/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
