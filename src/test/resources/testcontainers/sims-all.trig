                    <http://bauhaus/qualite/rapport/1781> .
    
    <http://bauhaus/qualite/attribut/1781/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1781/S.11.2/texte> , <http://bauhaus/qualite/attribut/1781/S.11.2/text> ;
