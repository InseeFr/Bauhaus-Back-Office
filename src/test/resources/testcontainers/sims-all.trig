    <http://bauhaus/qualite/rapport/1812>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Hotel occupancy survey 2016"@en , "Rapport qualité : Enquête de fréquentation dans l'hôtellerie 2016"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1325> .
    
    <http://bauhaus/qualite/attribut/1812/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "L'enquête est réalisée auprès d'un échantillon national d'environ 12.000 hôtels sur un total de 18.000."@fr , "The survey is conducted on a national sample of about 12,000 hotels from 18,000."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1812> .
    
    <http://bauhaus/qualite/attribut/1812/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Hotel stock is measured every year on 31 December and occupancy is measured every month.</p>\n<p>The main topics considered are:</p>\n<p>- characteristics of the establishment;</p>\n<p>- accommodation capacity;</p>\n<p>- daily room occupancy;</p>\n<p>- arrivals and nights spent by country of residence of tourists;</p>\n<p>- average length of stay;</p>\n<p>- proportion of business tourism.</p>\n<p>&nbsp;</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1812/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
