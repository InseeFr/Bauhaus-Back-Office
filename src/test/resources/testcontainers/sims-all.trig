                    <http://bauhaus/qualite/rapport/1748> .
    
    <http://bauhaus/documents/document/133>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La présentation de l'enquête Vie quotidienne et Santé de 2007/ VQS"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-01-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/presentation_enq_vie_quotidienne_sante2007.pdf> .
    
    <http://bauhaus/qualite/attribut/1748/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/133> .
    
    <http://bauhaus/qualite/attribut/1748/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted by mail and internet between September and November 2014 and then by telephone for non-respondents between November 2014 and February 2015."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1748/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1748/S.3.4/texte> , <http://bauhaus/qualite/attribut/1748/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1748> .
    
    <http://bauhaus/qualite/attribut/1748/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- l'&eacute;tat de sant&eacute; g&eacute;n&eacute;ral (mini-module europ&eacute;en) ;<br />- les difficult&eacute;s sensorielles ;<br />- les difficult&eacute;s motrices ;<br />- les difficult&eacute;s cognitives ;<br />- le recours &agrave; de l'aide humaine(professionnelle ou de l'entourage) ;<br /> - le recours &agrave; des aides techniques ou des am&eacute;nagements du logement ;<br />- la reconnaissance officielle d'un handicap ou de la d&eacute;pendance.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1748/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1748/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1748> .
    
    <http://bauhaus/qualite/attribut/1748/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1748/I.18.10/text> , <http://bauhaus/qualite/attribut/1748/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1748> .
    
    <http://bauhaus/qualite/attribut/1748/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- general health condition (European mini-module) ;<br />- sensory difficulties ;<br />- motor difficulties ;<br />- cognitive difficulties ;<br />- home care (provided by professional workers or by friends and relatives) ;<br />- the use of technical aids or housing adaptation ;<br />- the official recognition of disability.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1748/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>M&eacute;nages dits \" ordinaires \", c'est-&agrave;-dire hors m&eacute;nages vivant en collectivit&eacute; (maisons de retraite, EHPAD, foyers, prisons, h&ocirc;pitaux&hellip;) et vivant dans des habitations mobiles (mariniers, sans-abri&hellip;).<br />Ont &eacute;t&eacute; inclus les personnes vivant dans des logement-foyers.<br />Logements dans lesquels habite au moins un individu n&eacute; avant le 02/05/1955. Les r&eacute;pondants sont tous les habitants du logement &acirc;g&eacute;s de plus de 15 ans.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1748/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1748> .
    
    <http://bauhaus/qualite/attribut/1748/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon comporte environ 210 000 ménages (dont 10 000 dans les DOM)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1748/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample includes approximately 210,000 households (10,000 in the French Overseas Departments)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1748>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
