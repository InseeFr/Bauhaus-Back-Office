    <http://bauhaus/documents/document/586>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Révision des estimations de population nationale par sexe, âge et situation matrimoniale du 1er janvier 2000 au 1er janvier 2006pour tenir compte des résultats du recensement 2006"@fr ;
            <http://purl.org/dc/elements/1.1/language>
