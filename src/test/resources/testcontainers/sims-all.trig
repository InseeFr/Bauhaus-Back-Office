    <http://bauhaus/documents/document/140>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "De l'instantané au long métrage - l'enquête Cadre de Vie et Sécurité dans la série des données sur la victimation"@fr ;
