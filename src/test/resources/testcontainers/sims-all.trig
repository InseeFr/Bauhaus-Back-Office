                    "Site internet de l'OCDE"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Les indicateurs de conjoncture de l'OCDE"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://www.oecd.org/fr/france> .
    
    <http://bauhaus/qualite/attribut/1626/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/documents/document/374>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2007"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-07-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Tresorerie_francais.pdf> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1626/S.3.4/text> , <http://bauhaus/qualite/attribut/1626/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enqu&ecirc;te par sondage aupr&egrave;s de 4 000 entreprises industrielles de 20 salari&eacute;s ou plus.</p>\n<p>Toutes les entreprises d'au moins 500 salari&eacute;s ou 150 millions d'euros de chiffre d'affaires sont interrog&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The half-yearly survey of the cash flow situation in industry aims to transcribe the opinion of entrepreneurs on their cash flow and factors explaining changes in that situation, such as: operating profits, prices, sales volumes, wage contributions, financial expenses, investment expenses...</p>\n<p>This survey also provides some items of information on financing terms. Lastly, industrialists indicate their prospects in these areas.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1626>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête semestrielle sur la situation de trésorerie dans l'industrie 2007"@fr , "Quality report: Half-yearly survey of the cash flow situation in industry 2007"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1101> .
    
    <http://bauhaus/documents/page/26>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet du CIRET, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Centre international de recherche sur les enquêtes tendancielles - CIRET"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.ciret.org> .
    
    <http://bauhaus/qualite/attribut/1626/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1626/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1626/I.18.10/text> , <http://bauhaus/qualite/attribut/1626/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Survey of a sample of 4,000 industrial enterprises with 20 employees or more.</p>\n<p>All enterprises with at least 500 employees of turnover of &euro;150 million are surveyed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1626/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/27> , <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/26> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1626/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-07-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted twice a year, in June and December.</p>\n<p>Data collection is by post and online over a period stretching from the end of the month prior to the month of the survey to the date of publication of the survey, in the first ten days of the&nbsp;month following the month of the survey.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1626/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e deux fois par an, en juin et en d&eacute;cembre.</p>\n<p>La collecte s'effectue par voie postale et par internet sur une p&eacute;riode qui s'&eacute;tend de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la date de publication de l'enqu&ecirc;te, dans les 10 premiers jours du mois suivant le mois de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/381>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête de trésorerie dans l’industrie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-07-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_TRESORERIE_FR_2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1626/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1626/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te semestrielle sur la situation de tr&eacute;sorerie dans l'industrie a pour objet de transcrire l'opinion des chefs d'entreprise sur leur tr&eacute;sorerie et les facteurs expliquant l'&eacute;volution de cette derni&egrave;re tels que : les r&eacute;sultats d'exploitation, les prix, le volume des ventes, les charges salariales, les frais financiers, les d&eacute;penses d'&eacute;quipement...</p>\n<p>Cette enqu&ecirc;te fournit &eacute;galement des &eacute;l&eacute;ments sur les conditions de financement. Les industriels indiquent enfin leurs perspectives dans ces domaines.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1626/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La formulation des questions est conçue de manière à faciliter une réponse rapide (la plupart des questions sont qualitatives à trois modalités exprimées sous la forme \"hausse, baisse, stable\", ou \"supérieur à la normale, normal, inférieur à la normale\")."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1626/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1626/S.18.3/texte> , <http://bauhaus/qualite/attribut/1626/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1626/S.19/text> , <http://bauhaus/qualite/attribut/1626/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/374> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers manufacturing industry and the extraction industries; divisions 08 to 33 of NAF Rev. 2 (except 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre l'industrie manufacturière et les industries extractives; divisions 08 à 33 de la NAF rév. 2 (hors 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1626/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The wording of the questions is designed in such a way as to facilitate quick answers (most of the questions are qualitative with three possible answers in the form \"up, down, same\", or \"higher than normal, normal, lower than normal\")."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1626/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1626/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/S> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1626/S.3.6/texte> , <http://bauhaus/qualite/attribut/1626/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1965> {
    <http://bauhaus/qualite/attribut/1965/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of Use of Administrative Records on Employment and Incomes Section</p>"@en , "<p>Chef de la Division synth&egrave;se et conjoncture du march&eacute; du travail</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores couvre la totalit&eacute; des secteurs d&rsquo;activit&eacute;, &agrave; l&rsquo;exception des activit&eacute;s du minist&egrave;re des Arm&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores makes it possible to describe paid employment across all industries and employers. The variables describe the number of employees and gross earnings for year N and year N-1, making it possible to calculate changes over one year.</p>\n<p>The final product includes 5 files :</p>\n<p>- the \"companies\" file, in which each row represents a legal unit identified by a Siren number ;</p>\n<p>- the \"establishment\" file, in which each row represents an establishment (local unit of a company) identified by a Siret number;</p>\n<p>- the \"job count\" file, in which each row corresponds to a cross-reference between an establishment and various characteristics of the jobs and/or the persons occupying them (gender, socio-professional category, etc.);</p>\n<p>- the \"TOP 20\" file, which groups together establishments with more than 20 employees, for the purpose of distributing lists of establishments by the regional directorates;</p>\n<p>- the \"flow of employees\" file, in which each row represents a grouped transfer of employees between two establishments</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores couvre la totalit&eacute; des employeurs (fonction publique, employeurs priv&eacute;s, y compris les particuliers employeurs), &agrave; l&rsquo;exception des activit&eacute;s du minist&egrave;re des Arm&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les r&eacute;sultats de Flores sont coh&eacute;rents, mais pas identiques, aux r&eacute;sultats des autres sources comparables : fichier &laquo; Tous salari&eacute;s &raquo;, fichier &laquo; SIASP &raquo; et Estimations annuelles d&rsquo;emploi.</p>\n<p>Les &eacute;carts observables proviennent principalement de diff&eacute;rences de concepts statistiques. En particulier :</p>\n<p>- les Estimations d&rsquo;emploi comptabilisent le nombre de personnes en emploi, alors que Flores permet de compter des &laquo; postes de travail &raquo;. Certaines personnes peuvent occuper plusieurs postes de travail (multiactivit&eacute;), ce qui entraine des diff&eacute;rences en niveau et en &eacute;volution entre ces agr&eacute;gats.</p>\n<p>- les donn&eacute;es de Flores sont tr&egrave;s proches de celles du fichier &laquo; Tous salari&eacute;s &raquo; et de SIASP. Elles peuvent en diff&eacute;rer ponctuellement en raison de corrections destin&eacute;es &agrave; am&eacute;liorer la localisation g&eacute;ographique de l&rsquo;emploi dans Flores.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1965/S.3.3/text> , <http://bauhaus/qualite/attribut/1965/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Tables from Flores are put online on Insee.fr at all geographical levels down to the municipal level, in the \"Complete File\" category or in the \"Territory Portraits\" of the \"local statistics\" website. They present the number of establishments and the number of salaried positions at the end of the year by sector of activity and workforce size ranges.</p>\n<p>Downloadable Excel tables give access to the number of establishments and the number of salaried positions at the end of the year up to the level of the municipality and the sector of activity in 88 positions (\"Database\" category, product \"Characteristics of the establishments of 31 December 20XX\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.3>
                    <http://bauhaus/qualite/attribut/1965/S.15.3/texte> , <http://bauhaus/qualite/attribut/1965/S.15.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Larrieu Sylvain</p>"@fr , "<p>Larrieu Sylvain</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.18.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores is built from the \"All employees\" file. The \"All employees\" file itself is the result of a synthesis of administrative sources: personal social declarations (DSN), annual social data declarations (DADS), payroll files specific to the State and declarations specific to individual employers.</p>\n<p>Flores is therefore a \"secondary\" statistical source, derived from a first statistical file and not directly from administrative declarations.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores covers all industries, with the exception of the activities of the Ministry of the Armed Forces.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Chaque jeu de fichier couvre deux ann&eacute;es cons&eacute;cutives, N-1 et N. L&rsquo;exercice 2017 couvre ainsi les ann&eacute;es 2016 et 2017.</p>"@fr , "<p>Each file set covers two consecutive years, N-1 and N. Year 2017 thus covers the years 2016 and 2017.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The main variables used to characterize establishments in Flores are :</p>\n<p>- the main activity of the establishment (nomenclature NAF 732);</p>\n<p>- the location down to the municipality level (geographical nomenclature on 1 January 2017);</p>\n<p>- the legal category of the legal unit (nomenclature of legal categories, level III).</p>\n<p>The counts of salaried positions are also described according to the nomenclature of socio-professional categories (PCS 1 position).</p>\n<p>All these nomenclatures are available on Insee.fr, section &laquo; Nomenclatures &raquo;.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores est construit &agrave; partir du fichier &laquo; Tous salari&eacute;s &raquo;. Le fichier &laquo; Tous salari&eacute;s &raquo; lui-m&ecirc;me est issu d&rsquo;une synth&egrave;se de sources administratives : d&eacute;clarations sociales nominatives (DSN), d&eacute;clarations annuelles de donn&eacute;es sociales (DADS), fichiers de paie sp&eacute;cifiques &agrave; l&rsquo;&Eacute;tat et d&eacute;clarations sp&eacute;cifiques aux particuliers employeurs.</p>\n<p>Flores est donc une source statistique &laquo; secondaire &raquo;, issue d&rsquo;un premier fichier statistique et pas directement de d&eacute;clarations administratives.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.2>
                    <http://bauhaus/qualite/attribut/1965/S.3.2/text> , <http://bauhaus/qualite/attribut/1965/S.3.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les utilisateurs sont principalement des charg&eacute;s d&rsquo;&eacute;tude au sein de l&rsquo;Insee, dans les services statistiques minist&eacute;riels (SSM) ou dans des organismes de recherche. A partir de Flores, ils souhaitent r&eacute;aliser des &eacute;tudes nationales, ou le plus souvent, locales, pour d&eacute;crire le tissu &eacute;conomique d&rsquo;un territoire donn&eacute; jusqu&rsquo;au niveau de la commune.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data sources used and processing are homogeneous throughout the geographical area (France excluding Mayotte).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.2>
                    <http://bauhaus/qualite/attribut/1965/S.15.2/texte> , <http://bauhaus/qualite/attribut/1965/S.15.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F201> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores permet de d&eacute;crire l&rsquo;emploi salari&eacute; sur l&rsquo;ensemble des secteurs d&rsquo;activit&eacute; et des employeurs. Les variables d&eacute;crivent les effectifs salari&eacute;s et les r&eacute;mun&eacute;rations brutes de l&rsquo;ann&eacute;e N et celles de l&rsquo;ann&eacute;e N-1, ce qui permet de r&eacute;aliser des calculs d&rsquo;&eacute;volution sur un an.</p>\n<p>Le produit final comprend 5 fichiers :</p>\n<p>- le fichier &laquo; entreprises &raquo;, dans lequel chaque ligne repr&eacute;sente une unit&eacute; l&eacute;gale identifi&eacute;e par un num&eacute;ro Siren ;</p>\n<p>- le fichier &laquo; &eacute;tablissements &raquo;, dans lequel chaque ligne repr&eacute;sente un &eacute;tablissement identifi&eacute; par un num&eacute;ro Siret ;</p>\n<p>- le fichier &laquo; comptage de postes &raquo;, dans lequel chaque ligne correspond &agrave; un croisement d&rsquo;un &eacute;tablissement et de diff&eacute;rentes caract&eacute;ristiques des postes et/ou des personnes les occupant (sexe, cat&eacute;gorie socio-professionnelle etc.) ;</p>\n<p>- le fichier &laquo; TOP 20 &raquo; qui regroupe les &eacute;tablissements de plus de 20 salari&eacute;s, &agrave; des fins de diffusion de listes d&rsquo;&eacute;tablissements par les directions r&eacute;gionales ;</p>\n<p>- le fichier &laquo; flux de salari&eacute;s &raquo;, dans lequel chaque ligne repr&eacute;sente un transfert group&eacute; de salari&eacute;s entre deux &eacute;tablissements entre les ann&eacute;es N-1 et N.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>2016 et 2017&nbsp;</p>"@fr , "<p>2016 and 2017</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores sert &agrave; mesurer :&nbsp;</p>\n<p>- les effectifs en fin d&rsquo;ann&eacute;e, &agrave; savoir le nombre de postes salari&eacute;s pr&eacute;sents la derni&egrave;re semaine de d&eacute;cembre. Un poste de travail est d&eacute;fini comme le croisement entre une personne salari&eacute;e et un &eacute;tablissement lieu de travail. Une m&ecirc;me personne peut donc occuper plusieurs postes de travail dans plusieurs &eacute;tablissements, soit successivement dans l&rsquo;ann&eacute;e (changement d&rsquo;emploi), soit simultan&eacute;ment (multi-activit&eacute;) ;</p>\n<p>- les effectifs en &eacute;quivalent temps plein (EQTP). Le calcul des EQTP tient compte de la quotit&eacute; de travail temps complet / temps partiel : les emplois &agrave; temps complet comptent directement pour leur nombre de jours dans l&rsquo;ann&eacute;e, sans tenir compte du nombre d&rsquo;heures travaill&eacute;es ; pour les temps partiels, le nombre d&rsquo;heures travaill&eacute;es est divis&eacute; par une r&eacute;f&eacute;rence horaire annuelle, bas&eacute;e sur la m&eacute;diane des temps complets pr&eacute;sents toute l&rsquo;ann&eacute;e dans le secteur et la cat&eacute;gorie sociale du poste consid&eacute;r&eacute; ;</p>\n<p>- les r&eacute;mun&eacute;rations brutes. Elles correspondent &agrave; la totalit&eacute; des salaires et primes des salari&eacute;s vers&eacute;es au cours de l&rsquo;ann&eacute;e d&rsquo;exercice.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1965/S.18.1/texte> , <http://bauhaus/qualite/attribut/1965/S.18.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les sources de donn&eacute;es utilis&eacute;es et les traitements sont homog&egrave;nes sur l&rsquo;ensemble du champ g&eacute;ographique (France hors Mayotte).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores is used to measure :</p>\n<p>- the number of employees at the end of the year, i.e. the number of salaried positions in the last week of December. A salaried position is defined as the intersection between an employee and a workplace establishment. The same person can therefore occupy several positions in several establishments, either successively during the year (change of job) or simultaneously (multi-activity);</p>\n<p>- the number of employees in full-time equivalent (FTE). The calculation of FTE takes into account the ratio of full-time/part-time work: full-time jobs count directly for the number of days in the year, without taking into account the number of hours worked; for part-time jobs, the number of hours worked is divided by an annual hourly reference, based on the median of full-time jobs present all year round in the sector and social category of the job in question;</p>\n<p>- gross earnings. They correspond to all employee wages and bonuses paid during the financial year.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1965/S.3.1/text> , <http://bauhaus/qualite/attribut/1965/S.3.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores' results are consistent, but not identical, with the results of other comparable sources: \"All employees\" file, \"SIASP\" file and Annual Employment Estimates.</p>\n<p>Observable differences are mainly due to differences in statistical concepts. In particular :</p>\n<p>- the Employment Estimates count the number of persons in employment, whereas Flores counts \"positions\". Some people may occupy several positions (multiactivity), which leads to differences in level and evolution between these aggregates.</p>\n<p>- The data in Flores are very close to those in the \"All employees\" file and SIASP. They may differ from them from time to time due to corrections designed to improve the geographical location of employment in Flores.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "0187696267"@fr , "0187696267"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Each Flores file presents two years N-1 and N whose comparability is guaranteed (homogeneous sources and methodology). On the other hand, comparability between two years from two different vintages is not guaranteed. Indeed, changes in the source data used or improvements in their statistical treatment may occur between the different vintages and disturb the comparability of the data. As a result of these changes, the data for year N-1 are generally not identical to those for year N of the previous vintage.&nbsp;</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.1>
                    <http://bauhaus/qualite/attribut/1965/S.15.1/texte> , <http://bauhaus/qualite/attribut/1965/S.15.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1965/S.10.2/text> , <http://bauhaus/qualite/attribut/1965/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The number of salaried positions at the end of the year, in full-time equivalent and the gross remuneration by establishment are obtained by aggregating the information contained in the \"All employees\" file. Geographical and sectoral location information is taken from the Statistical business register (Sirus) and the Business Register Identification System (Sirene) when available, and from the \"All employees\" file otherwise.</p>\n<p>Additional processing is applied to improve the quality of the location (geographical and sectoral) of paid employment.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Des tableaux issus de Flores sont mis en ligne sur Insee.fr &agrave; tous les niveaux g&eacute;ographiques jusqu&rsquo;&agrave; l&rsquo;&eacute;chelon communal, dans la cat&eacute;gorie &laquo; Dossier Complet &raquo; ou dans les &laquo; Portraits de territoire &raquo; du site &laquo; statistiques locales &raquo;. Ils pr&eacute;sentent le nombre d&rsquo;&eacute;tablissements et le nombre de postes salari&eacute;s en fin d&rsquo;ann&eacute;e par secteur d&rsquo;activit&eacute; et tranches d&rsquo;effectifs.</p>\n<p>Des tableaux Excel en t&eacute;l&eacute;chargement permettent d&rsquo;acc&eacute;der au nombre d&rsquo;&eacute;tablissements et nombre de postes salari&eacute;s en fin d&rsquo;ann&eacute;e jusqu&rsquo;au niveau de la commune et du secteur d&rsquo;activit&eacute; en 88 postes (cat&eacute;gorie &laquo; Base de donn&eacute;es &raquo;, produit &laquo; Caract&eacute;ristiques des &eacute;tablissements du 31 d&eacute;cembre 20XX &raquo;).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1965/S.3.6/text> , <http://bauhaus/qualite/attribut/1965/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Flores covers all employers (public service, private employers, including individual employers), with the exception of the activities of the Ministry of the Armed Forces.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1965/S.12.1/text> , <http://bauhaus/qualite/attribut/1965/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Users are mainly research officers at INSEE, in ministerial statistical offices (SSM), or in research organizations. From Flores, they wish to carry out national or local studies to describe the economic fabric of a given territory down to the municipality level.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1965/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.18.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les effectifs en fin d&rsquo;ann&eacute;e, en &eacute;quivalent temps plein et les r&eacute;mun&eacute;rations brutes par &eacute;tablissements sont obtenues en agr&eacute;geant les informations contenues dans le fichier &laquo; Tous salari&eacute;s &raquo;. Les informations de localisation g&eacute;ographique et sectorielles sont reprises du Syst&egrave;me d&rsquo;immatriculation au r&eacute;pertoire des unit&eacute;s statistiques (Sirus) et du Syst&egrave;me d'identification du r&eacute;pertoire des entreprises (Sirene)&nbsp; quand elles y sont disponibles, et du fichier &laquo; Tous salari&eacute;s &raquo; sinon.</p>\n<p>Des traitements compl&eacute;mentaires sont appliqu&eacute;s pour am&eacute;liorer la qualit&eacute; de la localisation (g&eacute;ographique et sectorielle) de l&rsquo;emploi salari&eacute;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.18.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.5>
                    <http://bauhaus/qualite/attribut/1965/S.18.5/texte> , <http://bauhaus/qualite/attribut/1965/S.18.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les principales variables permettant de caract&eacute;riser les &eacute;tablissements dans Flores sont :</p>\n<p>- l&rsquo;activit&eacute; principale de l&rsquo;&eacute;tablissement (nomenclature NAF 732) ;</p>\n<p>- la localisation &agrave; la commune (nomenclature g&eacute;ographique au 1er janvier 2017) ;</p>\n<p>- la cat&eacute;gorie juridique de l&rsquo;unit&eacute; l&eacute;gale (nomenclature des cat&eacute;gories juridiques, niveau III).&nbsp;</p>\n<p>Les comptages de postes salari&eacute;s sont &eacute;galement d&eacute;crits suivant la nomenclature des cat&eacute;gories socio-professionnelles (PCS &agrave; 1 position).</p>\n<p>Toutes ces nomenclatures sont accessibles sur Insee.fr, rubrique &laquo; Nomenclatures &raquo;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Flores presents results at the level of enterprises (legal units) and establishments (local units), as well as at the sub-establishment level for certain cross-tabulations of individual characteristics (gender, socio-professional category, etc.)."@en , "Flores présente les résultats au niveau des entreprises (unités légales) et établissements, ainsi qu’au niveau infra-établissement pour certains croisements de caractéristiques individuelles (sexe, catégorie socio-professionnelle etc.)."@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.15.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Chaque exercice de Flores pr&eacute;sente deux ann&eacute;es N-1 et N dont la comparabilit&eacute; est garantie (sources et m&eacute;thodologie homog&egrave;nes). En revanche, la comparabilit&eacute; entre deux ann&eacute;es issues de deux mill&eacute;simes diff&eacute;rents n&rsquo;est pas garantie. En effet, des changements dans les donn&eacute;es sources utilis&eacute;es ou des am&eacute;liorations de leur traitement statistique peuvent intervenir entre les diff&eacute;rents mill&eacute;simes et perturber la comparabilit&eacute; des donn&eacute;es. Du fait de ces changements, les donn&eacute;es de l&rsquo;ann&eacute;e N-1 ne sont en g&eacute;n&eacute;ral pas identiques &agrave; celles de l&rsquo;ann&eacute;e N du mill&eacute;sime pr&eacute;c&eacute;dent.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1965/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex&nbsp;</p>"@fr , "<p>Insee, 88 avenue Verdier, CS 70058 92541 Montrouge cedex&nbsp;</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/rapport/1965>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Fichier localisé des rémunérations et de l’emploi salarié 2017"@fr , "Quality report: Pay and salaried employment localized file 2017"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1523> .
    
    <http://bauhaus/qualite/attribut/1965/S.8.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.8.3>
                    "<p>Flores files are not intended for the general public. They are mainly intended for use in INSEE's regional offices.</p>\n<p>Ministerial statistical services (SSM) or researchers may request access to Flores by submitting a request to the Statistical Confidentiality Committee.&nbsp;</p>"@en , "<p>Les fichiers Flores ne sont pas destin&eacute;s au grand public. Ils visent principalement un usage dans les directions r&eacute;gionales de l&rsquo;Insee.</p>\n<p>Les services statistiques minist&eacute;riels (SSM) ou chercheurs peuvent demander &agrave; acc&eacute;der &agrave; Flores via une demande au Comit&eacute; du secret statistique .</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
    
    <http://bauhaus/qualite/attribut/1965/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1965/S.3.4/text> , <http://bauhaus/qualite/attribut/1965/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1965> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1977> {
    <http://bauhaus/qualite/attribut/1977/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Metropolitan France, Departments of Reunion and Martinique</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1977/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes are:<br />- Levels, disparities and inequalities in the distribution of declared income by unit of consumption and living standards of individuals;<br />- Categories income share in disposable income;<br />- Poverty (poverty rate and poverty intensity);<br />- Characteristics of the sub-population below 60% of median income per unit of consumption <br />These themes are apprehended at local level through a number of usual analysis indicators (median, disparity and inequality indicators) and are broken down by various sociodemographic variables.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1977/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le dispositif FiLoSoFi est &eacute;tabli &agrave; partir des fichiers suivants&nbsp;:<br />- le fichier des d&eacute;clarations de revenus fiscaux (Pote), contenant les donn&eacute;es relatives aux d&eacute;clarations des revenus des contribuables. Ce fichier r&eacute;pertorie des foyers fiscaux ;<br />- le fichier de la taxe d'habitation (PLFC), dont on extrait les observations correspondant aux redevables de la taxe d'habitation (TH) reli&eacute;s &agrave; des logements d&rsquo;habitation&nbsp;;<br />- le fichier des personnes physiques (Fip) qui r&eacute;pertorie tous les d&eacute;clarants aux services fiscaux&nbsp;;<br />- les fichiers sociaux contenant les donn&eacute;es exhaustives sur les prestations sociales vers&eacute;es par les principaux organismes gestionnaires de ces prestations (Cnaf, Cnav et CCMSA), de niveau famille ou allocataire. <br />Le rapprochement des fichiers Pote et PLFC permet de constituer des m&eacute;nages fiscaux lorsqu'une ann&eacute;e donn&eacute;e co&iuml;ncident au moins&nbsp;une d&eacute;claration ind&eacute;pendante de revenus (un, deux foyers fiscaux ou plus) et l'occupation d'un m&ecirc;me logement connu &agrave; la taxe d'habitation. Le rapprochement du fichier Fip avec les fichiers sociaux permet de reconstituer pour chaque m&eacute;nage fiscal l&rsquo;ensemble des prestations sociales per&ccedil;ues.<br />Le \"redevable TH\" est identifi&eacute; de la m&ecirc;me mani&egrave;re que le foyer fiscal qu'il constitue dans le fichier Pote. Il n&rsquo;existe par contre pas d&rsquo;identifiant unique entre les fichiers fiscaux et sociaux&nbsp;: le rapprochement est&nbsp;r&eacute;alis&eacute; &agrave; partir d&rsquo;informations communes dans les fichiers (nom, pr&eacute;nom, date de naissance, commune de r&eacute;sidence, etc.). Une fois les fichiers appari&eacute;s, les informations nominatives ne sont pas conserv&eacute;es.<br />Le fichier des personnes physiques (Fip) contient les donn&eacute;es personnelles de chaque redevable, utiles pour l&rsquo;appariement avec les fichiers sociaux. Le rapprochement des fichiers fiscaux et sociaux permet de ne plus imputer compl&egrave;tement sur bar&egrave;me les prestations sociales, comme cela &eacute;tait fait dans RDL. L&rsquo;Insee collecte via la CCMSA les montants annuels des prestations l&eacute;gales de&nbsp;la branche vieillesse et de la branche famille relevant du r&eacute;gime agricole. Pour le r&eacute;gime g&eacute;n&eacute;ral, la Cnaf fournit un fichier exhaustif des allocataires et du montant de leurs prestations sociales au cours de l&rsquo;ann&eacute;e et la Cnav fournit un fichier exhaustif des prestations vers&eacute;es en d&eacute;cembre. Les montants annuels des prestations sont ensuite reconstitu&eacute;s par extrapolation, en utilisant notamment les informations disponibles sur la composition des familles.<br />Dans FiLoSoFi, comme dans l&rsquo;ancien dispositif RDL, les revenus financiers non soumis &agrave; d&eacute;claration sont imput&eacute;s pour les m&eacute;nages de m&eacute;tropole selon un mod&egrave;le construit &agrave; partir de l&rsquo;enqu&ecirc;te Patrimoine de l&rsquo;Insee : une probabilit&eacute; de d&eacute;tention et un montant de d&eacute;tention sont estim&eacute;s en fonction d&rsquo;un certain nombre de caract&eacute;ristiques observables du m&eacute;nage (revenus, &acirc;ge, situation familiale&hellip;) pour sept&nbsp; produits financiers (livrets exon&eacute;r&eacute;s, LEP, livrets jeune, CEL, PEL, assurances-vie et PEA). <br />Les imp&ocirc;ts retenus pour le calcul du revenu disponible sont&nbsp;: l&rsquo;imp&ocirc;t sur le revenu, la taxe d&rsquo;habitation, la CSG, la CRDS et le pr&eacute;l&egrave;vement social sur les revenus du patrimoine.<br />L&rsquo;imp&ocirc;t sur le revenu utilis&eacute; pour le calcul est l&rsquo;imp&ocirc;t portant sur les revenus de l&rsquo;ann&eacute;e, pay&eacute; en r&eacute;alit&eacute; l&rsquo;ann&eacute;e suivante.<br />Comme dans l&rsquo;ancien dispositif RDL, le type de m&eacute;nage est construit &agrave; partir des &eacute;carts d&rsquo;&acirc;ge entre individus, notamment pour&nbsp;reconstituer les couples qui ne sont ni mari&eacute;s ni pacs&eacute;s ni concubins d&eacute;clar&eacute;s comme tels &agrave; la taxe d&rsquo;habitation.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1263> , <http://bauhaus/documents/document/1264> .
    
    <http://bauhaus/qualite/attribut/1977/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s sont :<br />- Niveaux, disparit&eacute;s et in&eacute;galit&eacute;s dans la distribution des revenus d&eacute;clar&eacute;s par unit&eacute; de consommation et des niveaux de vie des individus&nbsp;;<br />- Part revenus cat&eacute;goriels dans le revenu disponible ;<br />- Pauvret&eacute; (taux de pauvret&eacute; et intensit&eacute; de la pauvret&eacute;)&nbsp;;<br />- Caract&eacute;ristiques de la sous-population sous le seuil de 60% du revenu m&eacute;dian par UC.<br />Ces th&egrave;mes sont appr&eacute;hend&eacute;s au niveau local gr&acirc;ce &agrave; un certain nombre d'indicateurs usuels d'analyse (m&eacute;diane, indicateurs de disparit&eacute; et d'in&eacute;galit&eacute;) et d&eacute;clin&eacute;s selon diverses variables sociod&eacute;mographiques.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1977/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1977/S.3.4/texte> , <http://bauhaus/qualite/attribut/1977/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/qualite/attribut/1977/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/qualite/rapport/1977>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Localised disposable income system 2018"@en , "Rapport qualité : Dispositif sur les revenus localisés sociaux et fiscaux 2018"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1560> .
    
    <http://bauhaus/qualite/attribut/1977/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>M&eacute;nages fiscaux, hors collectivit&eacute;s (foyers, h&ocirc;pitaux, maisons de retraite,&hellip;) et hors sans-domicile.<br />Les m&eacute;nages ayant d&eacute;clar&eacute; des revenus l&rsquo;une des deux ann&eacute;es pr&eacute;c&eacute;dentes, mais n&rsquo;ayant pas d&eacute;clar&eacute; de revenu pour l&rsquo;ann&eacute;e en cours, ne sont pas retenus dans le champ FiLoSoFi (alors qu&rsquo;ils l&rsquo;&eacute;taient dans les dispositifs RFL et RDL). En revanche les m&eacute;nages&nbsp;faisant leur d&eacute;claration de revenu dans le d&eacute;partement o&ugrave; se trouve leur r&eacute;sidence secondaire&nbsp; sont pris en compte, alors qu&rsquo;ils &eacute;taient exclus des champs RFL et RDL. <br />Les indicateurs portant sur le revenu d&eacute;clar&eacute; sont calcul&eacute;s sur le champ des m&eacute;nages&nbsp;dont le revenu d&eacute;clar&eacute; est positif ou nul. <br />Les indicateurs portant sur le revenu disponible sont calcul&eacute;s sur le champ des m&eacute;nages dont le revenu disponible est positif ou nul.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1977/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The FiLoSoFi device is compiled from the following files:<br />- The file of the statement of fiscal income (POTE), containing the data relative to taxpayers income declarations. This file lists tax households;<br />- The local residence tax file (PLFC), from which details of those who have to pay the local residence tax are extracted (TH) and linked with dwellings;&nbsp; <br />- The file of individuals (Fip) that lists all individual reporting to the tax authorities;<br />- Social files containing comprehensive data on social benefits paid by the main bodies managing these services (CNAF, CNAV and&nbsp;CCMSA), at family level&nbsp; or beneficiary level.<br />The reconciliation of Pote and PLFC files allows to establish fiscal households when&nbsp; a given fiscal year coincides with at least one independent income declaration&nbsp; (one, two or more tax households) and the occupation of a dwelling identified for&nbsp; residence tax. The reconciliation of Fip file with social files can reconstruct for each tax household all the perceived social benefits. <br />The \"local residence tax payer\" is identified in the same way that the tax household is in the&nbsp; Pote file. There is&nbsp; no&nbsp; unique identifier between fiscal and social files: the reconciliation is made from common information in the files (name, surname, date of birth, municipality of residence, etc.). Once the files have been&nbsp;matched, personal information are not kept.<br />The file of individuals (Fip) contains personal data on each taxpayer which are useful for pairing with social files.&nbsp; Approximation of fiscal and social files enables to avoid&nbsp; total imputation on social benefits scale, as it was done in RDL. INSEE collects via CCMSA annual amounts of statutory benefits in the pension part and the family part within the agricultural system. For the general scheme, the CNAF provides a comprehensive file of recipients and benefits during the year and the CNAV provides a comprehensive file of benefits paid in December. The annual benefit amounts are then reconstituted by extrapolation, using available information on family composition.<br />In FiLoSoFi, as in the old RDL device, non-subject to declaration financial incomes are allocated _ for metropolitan households_ according to a pattern built from the Household Wealth Surveys (INSEE): a probability of detention and a detention amount are estimated according to various observable households characteristics (income, age, family situation ...) for&nbsp; seven financial products (tax-exempt savings deposits , LEP, youth passbook savings accounts , CEL, PEL, life-insurance&nbsp; and PEA.<br />The taxes retained to compute the disposable income are: income tax, local residence tax, CSG, CRDS and social levy on income from property.<br />The income tax used to calculate the disposable income is the tax on the income of the year, actually paid the following year.<br />As in the old device RDL, the household type is built from the age differences between individuals, especially to rebuild couples who are not married or civil partners or cohabitants reported as such to the local residence tax.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1263> , <http://bauhaus/documents/document/1264> .
    
    <http://bauhaus/qualite/attribut/1977/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Fiscal households not included in communities (residences, hospitals, retirement homes, ...) and excuding homeless.<br />The households having declared incomes perceived during one of the two previous years, but not having declared any income related to the undergoing year, are not retained in the FiLoSoFi field (whereas they were retained in the RFL and RDL devices). However the households declaring their income in the department where their second home is located are taken into account, whereas they were excluded from the RFL and RDL fields.<br />The indicators on the declared income are calculated for household field whose declared income is positive or zero.<br />The indicators on disposable income are based on household field whose disposable income is positive or zero.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1977/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1977/S.10.6/text> , <http://bauhaus/qualite/attribut/1977/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/qualite/attribut/1977/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>France m&eacute;tropolitaine, D&eacute;partements de la R&eacute;union et Martinique</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1977/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/qualite/attribut/1977/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1977/S.3.6/text> , <http://bauhaus/qualite/attribut/1977/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/documents/document/1264>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Guide d'analyse des évolutions de revenus 2018"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0027-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Guide_evolution_revenus_Filosofi_2018.pdf> .
    
    <http://bauhaus/qualite/attribut/1977/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/qualite/attribut/1977/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
