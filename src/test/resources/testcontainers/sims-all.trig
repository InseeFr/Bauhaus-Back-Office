            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_INVT_MODELE2_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1949/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
                    <http://bauhaus/qualite/attribut/1949/S.8.1/text> , <http://bauhaus/qualite/attribut/1949/S.8.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1949> .
    
    <http://bauhaus/qualite/attribut/1949/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te de conjoncture sur les investissements dans l&rsquo;industrie est r&eacute;alis&eacute;e le premier mois de chaque trimestre. Les r&eacute;sultats sont publi&eacute;s entre le 5 et le 10 du mois suivant le mois d&rsquo;enqu&ecirc;te. L&rsquo;enqu&ecirc;te conduite au mois de juillet est publi&eacute;e aux deux tiers du mois d&rsquo;ao&ucirc;t.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1949/S.8.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The broadcasting schedule is available under:<br /><a href=\"https://www.insee.fr/en/information/2107811?debut=0\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.insee.fr/en/information/2107811?debut=0</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1949/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1949/S.7.1/texte> , <http://bauhaus/qualite/attribut/1949/S.7.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1949> .
    
    <http://bauhaus/qualite/attribut/1949/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e tous les trimestres mais toutes les questions ne sont pas pos&eacute;es chaque trimestre.</p>\n<p>En pratique, trois mod&egrave;les de questionnaires ont &eacute;t&eacute; cr&eacute;&eacute;s pour tenir compte de ces sp&eacute;cificit&eacute;s&nbsp;: <br />- le premier questionnaire correspond aux mois de janvier et juillet&nbsp;; <br />- le deuxi&egrave;me correspond au mois d&rsquo;avril&nbsp;;<br />- le dernier correspond au mois d&rsquo;octobre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1167> , <http://bauhaus/documents/document/1168> , <http://bauhaus/documents/document/1166> .
    
