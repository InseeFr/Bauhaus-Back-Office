                    "2013-06-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1512> .
    
    <http://bauhaus/qualite/attribut/1512/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ensemble des salariés des particuliers."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1512/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is performed quarterly and annually, the first year for which data is available being 2008.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1512/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Les salari&eacute;s des particuliers, leurs caract&eacute;ristiques et celle de leur emploi.<br /><br />- Les r&eacute;mun&eacute;rations et les dur&eacute;es de travail des salari&eacute;s des particuliers.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1512/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1512> .
    
    <http://bauhaus/qualite/attribut/1512/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Geographic area covered by the survey is Metropolitan France and French Overseas Departments (DOM) partially.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1512/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F201> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1512> .
    
    <http://bauhaus/qualite/attribut/1512/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La fr&eacute;quence de collecte des donn&eacute;es est trimestrielle et annuelle, la premi&egrave;re ann&eacute;e disponible &eacute;tant 2008.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1512/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1512/S.3.6/texte> , <http://bauhaus/qualite/attribut/1512/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1512> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1972> {
    <http://bauhaus/qualite/attribut/1972/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s sont : le d&eacute;veloppement des nouvelles technologies et l'intensit&eacute; de leur utilisation au sein de l'entreprise ; les types d'utilisation des TIC (commerce &eacute;lectronique, partage et &eacute;change d'information, plus g&eacute;n&eacute;ralement les relations avec le monde externe &agrave; l'entreprise) ; les obstacles et l'impact de cette diffusion.<br /><br />Chaque ann&eacute;e, certains th&egrave;mes, d&eacute;termin&eacute;s par le r&egrave;glement europ&eacute;en annuel d'application du r&egrave;glement cadre, font l'objet d'un d&eacute;veloppement particulier. En 2021, les th&egrave;mes abord&eacute;s sont le partage &eacute;lectronique de l&rsquo;information au sein de l&rsquo;entreprise, les services de cloud computing, l&rsquo;internet des objets, l&rsquo;intelligence artificielle.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.11.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The different stages of the survey ensure that the process meets the requirements for statistical production:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br />- stratified sampling<br />- reminders and controls of data being collected <br />- data cleaning<br />- correction of&nbsp; overall non-response <br />- calibration<br />- correction of partial non-response<br />- Winsorisation</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.15.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.3>
                    <http://bauhaus/qualite/attribut/1972/S.15.3/text> , <http://bauhaus/qualite/attribut/1972/S.15.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.4>
                    <http://bauhaus/qualite/attribut/1972/S.10.4/texte> , <http://bauhaus/qualite/attribut/1972/S.10.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.15.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data from the ICT survey can be supplemented by data from the ICT-VSE survey in enterprises with less than 10 persons employed, but be careful to be aware of the differences in scope between the two surveys. The latest ICT-VSE survey covers 2016 data.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es sont publi&eacute;es dans la collection &laquo;&nbsp;Insee R&eacute;sultats&nbsp;&raquo; et disponibles sur le site insee.fr.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La base de sondage est le r&eacute;pertoire Sirus (Syst&egrave;me d&rsquo;identification au r&eacute;pertoire des unit&eacute;s statistiques).<br /><br />L'&eacute;chantillon est stratifi&eacute; par secteur d'activit&eacute;, par taille et, depuis 2012, par chiffre d&rsquo;affaire. Selon l'ann&eacute;e d'enqu&ecirc;te, environ 12 500 entreprises sont interrog&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.15.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The differences of ICT by years surveys can be compared. Nevertheless, it may happen that the wording of a question is slightly modified. The evolution of adjustment methods may affect certain developments at the margin.<br />As for comparisons with ICT surveys&nbsp; in enterprises with less than 10 persons employed, in addition to the differences in scope, the user should also pay attention to the time difference with the chosen ICT vintage, depending on the modules of the questionnaire he is interested in.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1972/S.3.4/text> , <http://bauhaus/qualite/attribut/1972/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For dissemination, in addition to publications, there are also data quality indicators.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/148> .
    
    <http://bauhaus/qualite/attribut/1972/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.17.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.2>
                    <http://bauhaus/qualite/attribut/1972/S.17.2/texte> , <http://bauhaus/qualite/attribut/1972/S.17.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte, effectu&eacute;e par internet depuis 2012, est lanc&eacute;e au premier trimestre de l'ann&eacute;e consid&eacute;r&eacute;e.<br />L'enqu&ecirc;te couvre la France enti&egrave;re (g&eacute;ographie &agrave; la date de la collecte).<br />Il s&rsquo;agit d&rsquo;une enqu&ecirc;te collect&eacute;e essentiellement sur le portail Internet de l&rsquo;Insee (98&nbsp;% des retours) et &agrave; la demande de l&rsquo;entreprise, par courriel ou voie postale.<br />L&rsquo;unit&eacute; d&rsquo;interrogation est l&rsquo;unit&eacute; l&eacute;gale (UL), identifi&eacute;e par son num&eacute;ro SIREN, &agrave; l'exception de 10 unit&eacute;s qui sont interrog&eacute;es en entreprises profil&eacute;es (EP).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.15.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.2>
                    <http://bauhaus/qualite/attribut/1972/S.15.2/text> , <http://bauhaus/qualite/attribut/1972/S.15.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.3>
                    <http://bauhaus/qualite/attribut/1972/S.10.3/text> , <http://bauhaus/qualite/attribut/1972/S.10.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.16/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le temps de r&eacute;ponse m&eacute;dian (estim&eacute; apr&egrave;s redressement) est de 20 minutes.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A consultation committee met to take an active part in the questionnaire&rsquo;s design. Its member are experts and representatives of public policies interested in ICT and e-commerce questions (SDeS, SSP, DGE, CCIP, Arcep, SGMAP, T&eacute;l&eacute;com Paris Tech&hellip;), as well as representatives for syndicates of businesses and trade unions (Fevad, Syntec Num&eacute;rique, Medef, CCIP, CPME, CGT, FO&hellip;).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te communautaire sur \" l'utilisation des TIC et le commerce &eacute;lectronique \" dans les entreprises est un ensemble d'enqu&ecirc;tes r&eacute;alis&eacute;es par les instituts nationaux de la statistique des pays membres de l'union europ&eacute;enne.<br /><br />Elle s'inscrit dans le r&egrave;glement n&deg; 808/2004 adopt&eacute; en date du 21 avril 2004 dans le cadre de la mise en &oelig;uvre du plan d'action&nbsp;eEurope 2005 consacr&eacute; aux technologies de l'information et de la communication, r&egrave;glement amend&eacute; par le r&egrave;glement europ&eacute;en n&deg; 1006/2009 du 16 septembre 2009. Dans ce cadre, les enqu&ecirc;tes sur les TIC et le commerce &eacute;lectronique dans les entreprises r&eacute;alis&eacute;es par les pays de l'Union europ&eacute;enne suivent une m&eacute;thodologie commune et un m&ecirc;me mod&egrave;le de questionnaire.<br /><br />Chaque ann&eacute;e, un ou plusieurs th&egrave;mes, d&eacute;termin&eacute;s par le r&egrave;glement europ&eacute;en annuel d'application du r&egrave;glement cadre, fait l'objet d'un d&eacute;veloppement particulier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pas de r&eacute;vision pr&eacute;vue sur les donn&eacute;es de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1972/S.3.3/text> , <http://bauhaus/qualite/attribut/1972/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.15.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les donn&eacute;es de l'enqu&ecirc;te TIC peuvent &ecirc;tre compl&eacute;t&eacute;es par celles de l'enqu&ecirc;te TIC-TPE sur les entreprises de moins de 10 personnes occup&eacute;es, en &eacute;tant toutefois vigilant sur les diff&eacute;rences de champ entre les deux enqu&ecirc;tes. La derni&egrave;re enqu&ecirc;te TIC-TPE porte sur les donn&eacute;es 2016.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1972/S.7.2/texte> , <http://bauhaus/qualite/attribut/1972/S.7.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.17.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>No planned revisions to the survey data.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2020-11-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.17.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.1>
                    <http://bauhaus/qualite/attribut/1972/S.17.1/text> , <http://bauhaus/qualite/attribut/1972/S.17.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/documents/document/148>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête sur les technologies de l'information et de la communication auprès des entreprises / TIC"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-04-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologique_TIC_Entreprises_2012.pdf> .
    
    <http://bauhaus/qualite/attribut/1972/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The ICT 2020 survey complies with the European Regulation n&deg;2019/1910 of 7 November 2019 implementing, for the reference year 2020, Regulation (EC) n&deg;808/2004 of the European Parliament and of the Council concerning Community statistics on the information society.<br />This survey was financed by the European Union.<br /><br />The committees that have given Insee the right and legitimacy to collect its data are:<br />- The CNIS, which examines each new project, whether it is a survey, a directory or the exploitation of administrative files ... These projects are presented by all the institutions that contribute by their work to producing public statistics. The discussion focuses in particular on the purpose of the project, its place in the information system and the conditions anticipated for its dissemination. Each operation must be examined to ensure it is in the general interest and does not duplicate existing sources of information, in other words to ensure that it is suitable. It provides an opinion on suitability.<br />- The quality label committee, within the CNIS, ensures that it meets the criteria of statistical quality. The committee checks that the survey meets the statistical quality criteria in so far as concerns the collection and sampling method (survey design, data correction method, handling of non-responses guaranteeing the reliability of results..), relevance of the questions and adaptation of the distribution to the objectives announced. It also checks that the survey does not place an excessive burden on the respondents, that consultations have been held with the partners concerned and that any wishes expressed by the CNIS during the debate on suitability were taken into account. It gives a quality label of general interest and statistical quality.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.16/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The median response time (estimated after recovery) is 20 minutes.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.16>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.16>
                    <http://bauhaus/qualite/attribut/1972/S.16/texte> , <http://bauhaus/qualite/attribut/1972/S.16/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.7.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Loi n&deg; 51-711 du 7 juin 1951 sur l'obligation, la coordination et le secret en mati&egrave;re de statistiques. Disponible &agrave; l'adresse <a href=\"https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573\">https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573</a>. <br /><br />L'article 6 concerne le secret statistique&nbsp;: Sous r&eacute;serve des dispositions des articles 40,&nbsp; 56, 76,&nbsp; 97 et 99 du code de proc&eacute;dure p&eacute;nale et de celles de l'article L. 213-3 du code du patrimoine, les renseignements individuels figurant dans les questionnaires rev&ecirc;tus du visa pr&eacute;vu &agrave; l'article 2 de la pr&eacute;sente loi et ayant trait &agrave; la vie personnelle et familiale et, d'une mani&egrave;re g&eacute;n&eacute;rale, aux faits et comportements d'ordre priv&eacute; ne peuvent, sauf d&eacute;cision de l'administration des archives, prise apr&egrave;s avis du comit&eacute; du secret statistique et relative &agrave; une demande effectu&eacute;e &agrave; des fins de statistique publique ou de recherche scientifique ou historique, faire l'objet d'aucune communication de la part du service d&eacute;positaire avant l'expiration d'un d&eacute;lai de soixante-quinze ans suivant la date de r&eacute;alisation de l'enqu&ecirc;te ou d'un d&eacute;lai de vingt-cinq ans &agrave; compter de la date du d&eacute;c&egrave;s de l'int&eacute;ress&eacute;, si ce dernier d&eacute;lai est plus bref. <br />Il est institu&eacute; un comit&eacute; du secret statistique. Ce comit&eacute; est appel&eacute; &agrave; se prononcer sur toute question relative au secret en mati&egrave;re de statistiques. Il donne son avis sur les demandes de communication de donn&eacute;es individuelles collect&eacute;es en application de la pr&eacute;sente loi. Le comit&eacute; est pr&eacute;sid&eacute; par un conseiller d'Etat, d&eacute;sign&eacute; par le vice-pr&eacute;sident du Conseil d'Etat. Il comprend notamment des repr&eacute;sentants de l'Assembl&eacute;e nationale et du S&eacute;nat. La composition et les modalit&eacute;s de fonctionnement du comit&eacute; sont fix&eacute;es par d&eacute;cret en Conseil d'Etat. Les b&eacute;n&eacute;ficiaires des communications de donn&eacute;es r&eacute;sultant des d&eacute;cisions minist&eacute;rielles prises apr&egrave;s avis du comit&eacute; du secret statistique s'engagent &agrave; ne communiquer ces donn&eacute;es &agrave; quiconque. Toute infraction aux dispositions de cet alin&eacute;a est punie des peines pr&eacute;vues &agrave; l'article 226-13 du code p&eacute;nal.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Janvier &agrave; avril</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>January to April</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1972/S.10.2/texte> , <http://bauhaus/qualite/attribut/1972/S.10.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te fait l'objet d'une proc&eacute;dure d'archivage interne des bases de donn&eacute;es.<br />Les fichiers individuels de l&rsquo;enqu&ecirc;te sont mis &agrave; disposition des utilisateurs ext&eacute;rieurs &agrave; l&rsquo;Insee via le Centre d&rsquo;acc&egrave;s s&eacute;curis&eacute; des donn&eacute;es (CASD), apr&egrave;s passage au Comit&eacute; du secret.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1972/I.18.7/texte> , <http://bauhaus/qualite/attribut/1972/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>12500</p>"@fr , "<p>12500</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The EC survey on the \"use of ICT and electronic commerce\" in business is a set of surveys conducted by the national institutes of statistics of the member countries of the European Union.<br /><br />It complies with regulation n&deg;808/2004 adopted on April 21, 2004&nbsp;as part of the implementation of the 2005 eEurope action plan devoted to information and communication technologies: this regulation was amended by European regulation n&deg; 1006/2009 of September 16, 2009. Accordingly, the surveys on ICT and electronic commerce in business conducted by the countries of the European Union follow a common methodology and the same model of questionnaire.<br /><br />Each year, one or more topics, determined by the annual European regulation for&nbsp;the implementation of the framework regulation, are developed in particular.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1972/S.7.1/text> , <http://bauhaus/qualite/attribut/1972/S.7.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1972/S.12.1/texte> , <http://bauhaus/qualite/attribut/1972/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.18.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Contr&ocirc;les pendant la phase de collecte<br />- Relances pendant la phase de collecte&nbsp;: relances par courrier exhaustives sur les non-r&eacute;pondants, relances t&eacute;l&eacute;phoniques prioris&eacute;es sur les non-r&eacute;pondants de grande taille<br />- Apurement&nbsp;pour assurer la coh&eacute;rence des r&eacute;ponses au sein de chaque questionnaire<br />- Winsorisation&nbsp;: contr&ocirc;le de l'influence des unit&eacute;s atypiques<br />- Calcul d'indicateurs de pr&eacute;cision</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.7.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>In so far as concerns collection via the Internet, the Coltrane collection site is totally secure and the standards in terms of managing survey access codes are strict and standardized for all surveys. For enterprises that choose to use paper, the managers are responsible for the input, and must strictly respect the confidentiality of any data collected.<br />This confidentiality applies before any data is disseminated. For data relating to enterprises - no results are published that relates to less than three enterprises or establishments. Similarly, a result will only be disseminated if no enterprise or institution contributes more than 85% of this result. Primary suppressions correspond to boxes that do not meet the above criteria. Secondary confidentiality removes other boxes so that the data can not be retrieved by adding and subtracting with the margins of the tables. Statistical confidentiality is defined in law n&deg; 51-711 of 7 June 1951.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1972/S.6.1/text> , <http://bauhaus/qualite/attribut/1972/S.6.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>No planned revisions to the survey data.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.11.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.1>
                    <http://bauhaus/qualite/attribut/1972/S.11.1/texte> , <http://bauhaus/qualite/attribut/1972/S.11.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Law n&deg; 51-711 of 7 June 1951 on obligations, co-ordination and confidentiality in respect of statistics. Available from <a href=\"https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573\">https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573</a>.<br /><br />Article 6 concerns statistical confidentiality: Subject to the provisions of Articles 40, 56, 76, 97 and 99 of the Code of Criminal Procedure and those of Article L. 213-3 of the French Heritage Code, the individual information contained in the questionnaires endorsed as provided for in Article 2 of this Law and relating to private and family life and, in general, to private acts and conduct can not, unless decided by the Archives Administration, after examining the opinion of the Statistical Confidentiality Committee and relating to a request made for the purposes of public statistics or scientific or historical research, be the subject of any communication by the depositary service before the expiry of a period of seventy-five years following the date of completion of the survey or a period of twenty-five years from the death of the person concerned, whichever is the shorter.<br />A Statistical Confidentiality Committee is set up. This committee is called upon to rule on any question relating to the confidentiality of statistics. It expresses its opinion on requests for the communication of individual data collected pursuant to this law. The committee is chaired by a State Councillor, appointed by the Vice-President of the Council of State. It includes in particular representatives of the French National Assembly and Senate. The composition and operating methods of the committee are set by decree of the Council of State. Recipients of the data communications resulting from Ministerial decisions made after consulting the Statistical Confidentiality Committee agree to not communicate these data to anyone. Any violation of the provisions of this paragraph is punishable by the penalties provided for in Article 226-13 of the Penal Code.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Businesses of the following sectors of NACE rev.2 divisions:<br />- manufacturing (section C)<br />- electricity, gas, steam and air conditioning supply (section D)<br />- water supply; sewerage, waste management and remediation activities (section E)<br />- construction (section F)<br />- wholesale and retail trade; repair of motor vehicles and motorcycles (section G)<br />- transportation and storage (section H)<br />- accommodation and food service activities (section I)<br />- information and communication (section J)<br />- real estate activities (section L)<br />- professional, scientific and technical activities (section M)<br />- administrative and support service activities (section N)<br />- repair of computers and communication equipment (group 951)</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>La p&eacute;riode de r&eacute;f&eacute;rence est 2021 pour la plupart des questions&nbsp;; le dernier exercice comptable (2020) pour le commerce &eacute;lectronique.</p>"@fr , "<p>The reference period is mainly 2021 except for the characteristics referring to the previous accounting year (turnover, websales).</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1972/I.18.10/texte> , <http://bauhaus/qualite/attribut/1972/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les entreprises appartiennent aux secteurs suivants de la NACE r&eacute;v. 2&nbsp;:<br />- l'industrie manufacturi&egrave;re (section C)<br />- la production et la distribution d'&eacute;lectricit&eacute;, de gaz, de vapeur et d'air conditionn&eacute; (section D)<br />- la production et la distribution d'eau, l'assainissement, la gestion des d&eacute;chets et la d&eacute;pollution (section E)<br />- la construction (section F)<br />- le commerce, la r&eacute;paration d'automobiles et de motocycles (section G)<br />- les transports et l'entreposage (section H)<br />- l'h&eacute;bergement et la restauration (section I)<br />- l'information et la communication (section J)<br />- les activit&eacute;s immobili&egrave;res (section L)<br />- les activit&eacute;s sp&eacute;cialis&eacute;es, scientifiques et techniques (section M)<br />- les activit&eacute;s de services administratifs et de soutien (section N)<br />- la r&eacute;paration d'ordinateurs et d'&eacute;quipements de communication (groupe 951)</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour se rapprocher des concepts utilis&eacute;s dans l'enqu&ecirc;te europ&eacute;enne, depuis l'&eacute;dition 2011 de l'enqu&ecirc;te TIC, la taille des unit&eacute;s interrog&eacute;es n'est plus mesur&eacute;e en nombre de salari&eacute;s, mais en nombre de personnes occup&eacute;es : les personnes non-salari&eacute;es sont incluses dans les effectifs. L'enqu&ecirc;te TIC 2011 porte ainsi sur les soci&eacute;t&eacute;s d'au moins 10 personnes occup&eacute;es, - ce qui comprend&nbsp;notamment les unit&eacute;s employant 9 salari&eacute;s et dont le dirigeant est non salari&eacute; - les enqu&ecirc;tes pr&eacute;c&eacute;dentes sur celles d'au moins&nbsp;10 salari&eacute;s. L'une des cons&eacute;quences de cette modification sur les r&eacute;sultats est une augmentation de l'influence des plus petites soci&eacute;t&eacute;s.<br />A partir de l'enqu&ecirc;te TIC2011, le champ couvre les entreprises-unit&eacute;s l&eacute;gales appartenant aux secteurs suivants de la NACE&nbsp; r&eacute;v. 2 : l'industrie manufacturi&egrave;re (section C), la production et la distribution d'&eacute;lectricit&eacute;, de gaz, de vapeur et&nbsp;d'air conditionn&eacute; (section D), la production et la distribution d'eau, l'assainissement, la gestion des d&eacute;chets et la d&eacute;pollution (section E), la construction (section F), le commerce, la r&eacute;paration d'automobiles et de motocycles (section G), les transports et l'entreposage (section H), l'h&eacute;bergement et la restauration (section I), l'information et la communication (section J), les activit&eacute;s immobili&egrave;res (section L), les activit&eacute;s sp&eacute;cialis&eacute;es, scientifiques et techniques (section M), les activit&eacute;s de services administratifs et de soutien (section N), la r&eacute;paration d'ordinateurs et d'&eacute;quipements de communication (groupe 95.1).<br />A partir de l'enqu&ecirc;te 2011, les soci&eacute;t&eacute;s financi&egrave;res et d'assurance sont exclues. Les secteurs d'activit&eacute; suivants ne font plus partie du champ de l'enqu&ecirc;te, contrairement aux ann&eacute;es pr&eacute;c&eacute;dentes :<br />- les autres interm&eacute;diations mon&eacute;taires et les autres distributions de cr&eacute;dit (classes 64.19 et 64.92 de la NAF r&eacute;v. 2) ;<br />- l'assurance et la r&eacute;assurance (groupes 65.1 et 65.2) ;<br />- l'administration de march&eacute;s financiers et les autres activit&eacute;s auxiliaires de services financiers, hors assurance et caisses de retraite (classes 66.11 et 66.19).&nbsp; Les unit&eacute;s l&eacute;gales sous forme de soci&eacute;t&eacute; civile immobili&egrave;re sont exclues du champ de l'enqu&ecirc;te (cat&eacute;gorie juridique &lsquo;6540'). En effet, l'enqu&ecirc;te TIC-TPE 2012 a fait appara&icirc;tre que l'enqu&ecirc;te n'est pas pertinente pour ces unit&eacute;s sans activit&eacute; &eacute;conomique et m&ecirc;me le plus souvent sans salari&eacute;.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1972/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection, conducted by internet since 2012, is launched in the first quarter of the year in question.<br />The survey covers the whole of France (geography at the time of collection).<br />The survey is collected mainly on the INSEE Internet portal (98% of returns) and at the request of the company, by e-mail or post.<br />The interrogation unit is the legal unit (UL), identified by its SIREN number, with the exception of 10 units which are interrogated in profiled enterprises (EP).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.7.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Concernant la collecte internet, le site de collecte est enti&egrave;rement s&eacute;curis&eacute; et les normes en termes de gestion des codes d&rsquo;acc&egrave;s &agrave; l&rsquo;enqu&ecirc;te sont strictes. Pour les entreprises choisissant d&rsquo;utiliser le support papier, la saisie est assur&eacute;e par les gestionnaires, dans le strict respect de la confidentialit&eacute; des donn&eacute;es r&eacute;colt&eacute;es.<br />Avant la diffusion des donn&eacute;es le secret est appliqu&eacute;. Pour les donn&eacute;es relatives aux entreprises : on ne publie aucun r&eacute;sultat qui concerne moins de trois entreprises ou &eacute;tablissements. De m&ecirc;me, un r&eacute;sultat ne sera diffus&eacute; que si aucune entreprise ou &eacute;tablissement ne contribue &agrave; plus de 85 % de ce r&eacute;sultat. Les suppressions primaires correspondent aux cases ne r&eacute;pondant pas au crit&egrave;re ci-dessus. Le secret secondaire supprime d'autres cases pour que les donn&eacute;es ne puissent pas &ecirc;tre retrouv&eacute;es par addition soustraction avec les marge des tableaux. Le secret statistique est d&eacute;fini dans la loi n&deg; 51-711 du 7 juin 1951.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un comit&eacute; de concertation, compos&eacute; des experts et repr&eacute;sentants des politiques publiques concern&eacute;es par les questions de technologie de l&rsquo;information, de la communication et de commerce &eacute;lectronique (SDeS, SSP, DGE, CCIP, Arcep, SGMAP, T&eacute;l&eacute;com Paris Tech&hellip;) ainsi que des repr&eacute;sentants d&rsquo;organisations professionnelles, ou de syndicats de salari&eacute;s (Fevad, Syntec Num&eacute;rique, Medef, CCIP, CPME, CGT, FO&hellip;) s'est r&eacute;uni pour participer &agrave; la conception du questionnaire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Insee Premi&egrave;re, Insee R&eacute;sultats</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Insee Premi&egrave;re, Insee R&eacute;sultats</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1972/S.3.6/text> , <http://bauhaus/qualite/attribut/1972/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.18.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.4>
                    <http://bauhaus/qualite/attribut/1972/S.18.4/text> , <http://bauhaus/qualite/attribut/1972/S.18.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour la diffusion,&nbsp;en plus des publications, il y a &eacute;galement&nbsp;des indicateurs de qualit&eacute; des donn&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The topics covered are: the development of new technologies and the intensity of their use in business; the types of use of ICT&nbsp;(electronic commerce, sharing and exchanging of information and, more generally, relations with the world outside the business); the obstacles and impacts of this dissemination.<br /><br />Each year, some topics, determined by the annual European regulation for the implementation of the framework regulation, are developed in particular. In 2021: sharing of information electronically within the enterprise, use of cloud computing services, internet of Things, artificial Intelligence.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te TIC 2020 r&eacute;pond au r&egrave;glement europ&eacute;en n&deg;2019/1910 du 7 novembre 2019 portant application, pour l'ann&eacute;e de r&eacute;f&eacute;rence 2020, du r&egrave;glement (CE) n&deg;808/2004 du Parlement europ&eacute;en et du Conseil concernant les statistiques communautaires sur la soci&eacute;t&eacute; de l'information.<br />Cette enqu&ecirc;te a &eacute;t&eacute; financ&eacute;e par l'Union europ&eacute;enne.<br /><br />Les comit&eacute;s qui ont donn&eacute; &agrave; l'Insee le droit et la l&eacute;gitimit&eacute; pour collecter ces donn&eacute;es sont&nbsp;:<br />- Le Cnis qui examine chaque nouveau projet, qu&rsquo;il s&rsquo;agisse d&rsquo;une enqu&ecirc;te, d&rsquo;un r&eacute;pertoire ou d&rsquo;une exploitation de fichiers administratifs&hellip; Ces projets sont pr&eacute;sent&eacute;s par toutes les institutions qui contribuent par leurs travaux &agrave; la construction de la statistique publique. La discussion porte notamment sur la finalit&eacute; du projet, sa place dans le syst&egrave;me d&rsquo;information et les conditions pr&eacute;vues de sa diffusion. Il convient de v&eacute;rifier que chaque op&eacute;ration r&eacute;pond &agrave; un besoin d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et ne fait pas double emploi avec les sources d&rsquo;information existantes, en d&rsquo;autres termes de s&rsquo;assurer de son opportunit&eacute;. Il donne un avis d&rsquo;opportunit&eacute;.<br />- Le comit&eacute; du label, au sein du Cnis, veille &agrave; ce qu&rsquo;il respecte les crit&egrave;res de qualit&eacute; statistique. Celui-ci s&rsquo;assure que l&rsquo;enqu&ecirc;te r&eacute;pond aux crit&egrave;res de qualit&eacute; statistique en ce qui concerne la m&eacute;thode de collecte et d&rsquo;&eacute;chantillonnage (plan de sondage, m&eacute;thode de redressement des donn&eacute;es, traitement des non-r&eacute;ponses garantissant la fiabilit&eacute; des r&eacute;sultats...), de pertinence du questionnement et d&rsquo;adaptation de la diffusion aux objectifs annonc&eacute;s. Il s&rsquo;assure &eacute;galement que l&rsquo;enqu&ecirc;te n&rsquo;entra&icirc;ne pas de charge excessive sur les enqu&ecirc;t&eacute;s, qu&rsquo;une concertation a &eacute;t&eacute; men&eacute;e avec les partenaires concern&eacute;s et que les souhaits exprim&eacute;s par le Cnis lors du d&eacute;bat d&rsquo;opportunit&eacute; ont bien &eacute;t&eacute; pris en compte. Il donne un label d&rsquo;int&eacute;r&ecirc;t g&eacute;n&eacute;ral et de qualit&eacute; statistique.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1972/S.19/text> , <http://bauhaus/qualite/attribut/1972/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sampling base is the Sirus register (Identification system for the Statistical Units in the Register).<br /><br />The sample is stratified by business sector and by size and, since 2012, by turnover. Depending on the survey year, approximately 12,500 businesses are surveyed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.5>
                    <http://bauhaus/qualite/attribut/1972/S.10.5/texte> , <http://bauhaus/qualite/attribut/1972/S.10.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is subject to an internal database archiving procedure.<br />Individual files are made available to users outside Insee via the Secure Data Access Centre (CASD), after being reviewed by the Committee on Statistical Confidentiality.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.18.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Checks during the collection phase<br />- Follow-ups during the collection phase: exhaustive reminders by mail on non-respondents, priority telephone reminders on large non-respondents<br />- Data cleaning to ensure consistency of answers within each questionnaire<br />- Winsorisation: control of the influence of atypical units<br />- Calculation of precision indicators</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/S.11.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les diff&eacute;rentes &eacute;tapes de l'enqu&ecirc;te garantissent que le processus r&eacute;pond aux exigences en mati&egrave;re de production statistique&nbsp;: <br />- tirage stratifi&eacute; de l'&eacute;chantillon <br />- relances et contr&ocirc;les des donn&eacute;es en cours de collecte <br />- apurement <br />- redressement de la non-r&eacute;ponse totale <br />- calage <br />- redressement de la non r&eacute;ponse partielle <br />- winsorisation</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.17.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pas de r&eacute;vision pr&eacute;vue sur les donn&eacute;es de l'enqu&ecirc;te.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Legal unit enterprise"@en , "Unités légales"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1972/S.18.3/text> , <http://bauhaus/qualite/attribut/1972/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/attribut/1972/S.15.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les diff&eacute;rents mill&eacute;simes des enqu&ecirc;tes TIC peuvent &ecirc;tre compar&eacute;s. N&eacute;anmoins il peut arriver que la formulation d'une question soit l&eacute;g&egrave;rement modifi&eacute;e. L'&eacute;volution des m&eacute;thodes de redressement peuvent affecter &agrave; la marge certaines &eacute;volutions.<br />Quant aux comparaisons avec les enqu&ecirc;tes TIC sur les entreprises de moins de 10 personnes occup&eacute;es, outre les diff&eacute;rences de champ, l'utilisateur devra &eacute;galement faire attention &agrave; l'&eacute;cart temporel avec le mill&eacute;sime de TIC choisi, selon les modules du questionnaire auxquels il s'int&eacute;resse.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1972/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>To get closer with concepts used in the European survey, since the survey ICT 2011, the size of the questioned units is not any&nbsp;more measured in number of employees, but in number of occupied persons: the non-salaried persons are included in staff. The survey ICT concerns the companies of at least 10 occupied persons, - what includes in particular the units using 9 employees and whose manager is not salaried - the previous survey on those of at least 10 employees. One of the consequences of this modification on the results is an increase of the influence of the smallest companies.<br /><br />Since the ICT 2011 survey, the scope has covered businesses with ten employees or more belonging to the following sectors of NACE rev. 2: manufacturing industry (section C), production and distribution of electricity, gas, steam and conditioned air (section D), production and distribution of water, sewerage, waste management and cleanup (section E), the building industry (section F), trade, repair of automobiles and motorcycles (section G), transport and warehousing (section H), accommodation and catering (section I), information and communication (section J), real-estate activities (section L), specialist scientific and technical activities (sectionM), administrative service and support activities (section N),&nbsp;repair of computers and communications equipment (group 95.1).<br /><br />Since the ICT 2011 survey, the scope doesn't covered financial and insurance societies. The following sectors are excluded :<br />- other monetary intermediations and other distributions of credit (classes 64.19 and 64.92),<br />- insurance and re-insurance (groups 65.1 and 65.2),<br />- auxiliary financial service activities, excluding insurance, pension funds and financial market administration (classes 66.12 and 66.19).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1972/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2021A001EC"@fr , "2021A001EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1972> .
    
    <http://bauhaus/qualite/rapport/1972>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on information and communication technologies in business 2021"@en , "Rapport qualité : Enquête sur les technologies de l'information et de la communication dans les entreprises 2021"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1555> .
    
    <http://bauhaus/qualite/attribut/1972/S.10.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The data are published in the collections \"Insee R&eacute;sultats\" and are available on the insee.fr website.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1984> {
    <http://bauhaus/qualite/attribut/1984/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Regional extensions take place in the Pays-de-Loire and Nord-Pas-de-Calais regions.<br /><br />The IVQ survey was also conducted in Martinique in 2006, Reunion Island in 2007 and Guadeloupe in 2008, with representative samples of the population aged between 16 and 65 years old.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour obtenir l'implication de la personne interrog&eacute;e, les supports des exercices sont vari&eacute;s, peu scolaires, mais au contraire plut&ocirc;t proches des documents de la vie quotidienne (un programme de t&eacute;l&eacute;vision, un CD de musique&hellip;).<br /><br />Le niveau de difficult&eacute; des exercices est adapt&eacute; au niveau de comp&eacute;tences de la personne, gr&acirc;ce &agrave; une proc&eacute;dure d'orientation apr&egrave;s les premi&egrave;res questions.<br /><br />Ainsi, si la personne enqu&ecirc;t&eacute;e ne rencontre pas de difficult&eacute;s particuli&egrave;res, elle est orient&eacute;e&nbsp;vers des exercices plus complexes qui permettent de d&eacute;finir des comp&eacute;tences telles que la capacit&eacute; &agrave; s&eacute;lectionner les informations essentielles d'un texte.<br /><br />En revanche, si les r&eacute;sultats &agrave; l'issue de la proc&eacute;dure sont faibles, l'enqu&ecirc;t&eacute; passe un test compos&eacute; d'exercices assez simples permettant d'affiner le diagnostic sur ses difficult&eacute;s face &agrave; l'&eacute;crit.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te a &eacute;t&eacute; collect&eacute;e entre octobre d&eacute;cembre 2004.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1984/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1984/S.3.4/texte> , <http://bauhaus/qualite/attribut/1984/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Individuals aged 18 to 65 in &laquo;&nbsp;ordinary\" households, i.e. excluding institutional collective housing units (prisons, hospitals, etc.).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey was collected October to December 2004.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1984/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1984/S.19/text> , <http://bauhaus/qualite/attribut/1984/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1984/I.18.7/text> , <http://bauhaus/qualite/attribut/1984/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Des extensions r&eacute;gionales ont lieu en Pays de la Loire et en Nord-Pas-de-Calais.<br /><br />L'enqu&ecirc;te IVQ est &eacute;galement r&eacute;alis&eacute;e en Martinique en 2006, &agrave; la R&eacute;union en 2007, en Guadeloupe en 2008, sur des &eacute;chantillons repr&eacute;sentatifs de la population &acirc;g&eacute;e de 16 &agrave; 65 ans.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sample consisted of approximately 10,400 households.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'&eacute;chantillon comporte environ 10&nbsp;400 m&eacute;nages.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1984/I.20/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Measuring Adult Skills with the \"Information and daily life\" survey (Information et vie quotidienne: IVQ)<br />Economie et Statistique n&deg;424-425<br /><a title=\"https://www.epsilon.insee.fr/jspui/handle/1/116505\" href=\"https://www.epsilon.insee.fr/jspui/handle/1/116505\">https://www.epsilon.insee.fr/jspui/handle/1/116505</a><br /><br />Adult literacy, numeracy and oral comprehension skills<br />Insee Premi&egrave;re N&deg;1044<br /><a title=\"https://www.epsilon.insee.fr/jspui/handle/1/224\" href=\"https://www.epsilon.insee.fr/jspui/handle/1/224\">https://www.epsilon.insee.fr/jspui/handle/1/224</a><br /><br />Numbers for men, letters for women<br />Insee Premi&egrave;re N&deg;1071<br /><a title=\"https://www.epsilon.insee.fr/jspui/handle/1/192\" href=\"https://www.epsilon.insee.fr/jspui/handle/1/192\">https://www.epsilon.insee.fr/jspui/handle/1/192</a><br /><br />Writing, arithmetic and listening comprehension abilities according to age<br />Donn&eacute;es sociales&nbsp;: la soci&eacute;t&eacute; fran&ccedil;aise, &eacute;dition 2006<br /><a title=\"https://www.insee.fr/en/statistiques/1372030?sommaire=1372117\" href=\"https://www.insee.fr/en/statistiques/1372030?sommaire=1372117\">https://www.insee.fr/en/statistiques/1372030?sommaire=1372117</a></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1984/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>To obtain the implication of the person questioned, the supports of the exercises are varied, not very academic, but on the contrary rather close to the documents of daily life (a television program, a music CD&hellip;).<br /><br />The level of difficulty of the exercises is adapted to the skill level of the person, thanks to an orientation procedure after the first questions.<br /><br />Thus, if the respondent does not encounter any particular difficulties, they are directed towards more complex exercises which make it possible to define competences such as the ability to select the essential information of a text.<br /><br />On the other hand, if the results at the end of the orientation process are weak, the respondent takes a test consisting of fairly simple exercises allowing the diagnosis to be refined on his difficulties towards written matters.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1984/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/rapport/1984>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Information and daily life survey in 2004"@en , "Rapport qualité : Enquête Information et vie quotidienne en 2004"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1388> .
    
    <http://bauhaus/qualite/attribut/1984/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Les comp&eacute;tences en lecture, en num&eacute;ratie et en compr&eacute;hension orale ;<br />- Les langues maternelles, d'apprentissage de la lecture, et parl&eacute;e actuellement ;<br />- Les difficult&eacute;s durant le parcours scolaire ;<br />- Les d&eacute;marches pour trouver du travail ;<br />- Les loisirs li&eacute;s &agrave; la lecture ;<br />- Le cas &eacute;ch&eacute;ant, le processus de contournement des difficult&eacute;s rencontr&eacute;es dans la vie quotidienne.<br /><br />Afin de mieux conna&icirc;tre le parcours de vies des personnes enqu&ecirc;t&eacute;es, un questionnaire biographique est propos&eacute;. Il porte sur leurs origines, les lieux o&ugrave; ils vivent, la scolarisation en France ou ailleurs&hellip;</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1984/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>- Reading, numeracy and oral comprehension skills;<br />- Mother tongues, languages that people learn to read and currently speak;<br />- Difficulties during school careers;<br />- Job finding procedures;<br />- Reading-related leisure activities;<br />- If necessary, the procedures used to circumvent difficulties encountered in daily life.<br /><br />In order to achieve a better understanding of the pathways through life of the people surveyed, a background questionnaire is proposed, which covers their origins, their places of residence, schooling in France or elsewhere, etc.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1984/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1984/S.18.3/texte> , <http://bauhaus/qualite/attribut/1984/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1984/I.18.10/text> , <http://bauhaus/qualite/attribut/1984/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1984/S.3.6/texte> , <http://bauhaus/qualite/attribut/1984/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1984/I.20/text> , <http://bauhaus/qualite/attribut/1984/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Personnes de 18 &agrave; 65 ans r&eacute;sidant en logement \"ordinaire\" (c'est-&agrave;-dire hors collectivit&eacute; (foyers, prisons, h&ocirc;pitaux&hellip;)).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1984/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1984> .
    
    <http://bauhaus/qualite/attribut/1984/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Mesurer les comp&eacute;tences des adultes avec l'enqu&ecirc;te Information et vie quotidienne / IVQ<br />Economie et Statistique n&deg;424-425<br /><a title=\"https://www.epsilon.insee.fr/jspui/handle/1/116505\" href=\"https://www.epsilon.insee.fr/jspui/handle/1/116505\">https://www.epsilon.insee.fr/jspui/handle/1/116505</a><br /><br />Les comp&eacute;tences des adultes &agrave; l&rsquo;&eacute;crit, en calcul et en compr&eacute;hension orale<br />Insee Premi&egrave;re N&deg;1044<br /><a title=\"https://www.epsilon.insee.fr/jspui/handle/1/224\" href=\"https://www.epsilon.insee.fr/jspui/handle/1/224\">https://www.epsilon.insee.fr/jspui/handle/1/224</a><br /><br />Des chiffres pour les hommes, des lettres pour les femmes<br />Insee Premi&egrave;re N&deg;1071<br /><a title=\"https://www.epsilon.insee.fr/jspui/handle/1/192\" href=\"https://www.epsilon.insee.fr/jspui/handle/1/192\">https://www.epsilon.insee.fr/jspui/handle/1/192</a><br /><br />Comp&eacute;tences en &eacute;criture, en arithm&eacute;tique et en compr&eacute;hension orale selon l'&acirc;ge<br />Donn&eacute;es sociales&nbsp;: la soci&eacute;t&eacute; fran&ccedil;aise, &eacute;dition 2006<br /><a title=\"https://www.insee.fr/fr/statistiques/1372029?sommaire=1372045\" href=\"https://www.insee.fr/fr/statistiques/1372029?sommaire=1372045\">https://www.insee.fr/fr/statistiques/1372029?sommaire=1372045</a></p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1875> {
    <http://bauhaus/qualite/attribut/1875/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1875/S.19/texte> , <http://bauhaus/qualite/attribut/1875/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1875/S.18.3/text> , <http://bauhaus/qualite/attribut/1875/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes addressed are:<br /><br />- total turnover incl. VAT and breakdown per type of sale (supermarkets/hypermarkets);<br /><br />- breakdown of sales per product type: food, non-food, fuel;<br /><br />- any modifications to the stock of stores: openings, closures, modifications in floor area.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s sont :<br /><br />- le chiffre d'affaires total TTC et sa ventilation par forme de vente (supermarch&eacute;s/hypermarch&eacute;s) ;<br /><br />- la r&eacute;partition des ventes par type de produits : alimentaires, non alimentaires, carburants ;<br /><br />- les modifications &eacute;ventuelles du parc de magasins : ouvertures, fermetures, modifications de surface.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "From 1997"@en , "à partir de 1997"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Environ 7&nbsp;500 entreprises entrent dans le champ de l'enqu&ecirc;te (hypermarch&eacute;s, supermarch&eacute;s et magasins multi-commerces).</p>\n<p>L'&eacute;chantillon est d'environ 400 entreprises&nbsp;; il est exhaustif pour les entreprises ayant un chiffre d'affaires sup&eacute;rieur &agrave; 300&nbsp;millions d'euros TTC annuel. Dans les autres strates, un tirage coordonn&eacute; positivement avec les pr&eacute;c&eacute;dentes &eacute;ditions est mis en&nbsp;&oelig;uvre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ concerne les entreprises qui g&egrave;rent des supermarch&eacute;s, des hypermarch&eacute;s et/ou des magasins multi-commerces.</p>\n<p>L'enqu&ecirc;te couvre les activit&eacute;s principales d&eacute;finies par les codes NAF r&eacute;v. 2 : 47.11D, 47.11E et 47.11F.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1875/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey meets strong demand for outlook analysis at both sector and macro-economic level alike (preoccupations expressed by the members of the Commission for the Commercial Accounts of the Nation - CCCN).<br /><br />The survey also takes into account the frequent restructuring and demographic changes in the sector; The breakdown by family of&nbsp;products also makes it possible to establish a cyclical diagnosis.<br /><br />Finally, the survey provides a quicker result than the mobilization of tax sources: in this respect, the Emagsa survey is an indispensable link in establishing the early index at 30 days of the volume of sales in commerce Which is required by the European&nbsp;Regulation. </p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The opening of each monthly campaign takes place just days after the end of retail month investigated. Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1875/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1875/I.18.10/texte> , <http://bauhaus/qualite/attribut/1875/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1875/S.3.6/text> , <http://bauhaus/qualite/attribut/1875/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Approximately 7,500 companies are involved in the survey (hypermarkets, supermarkets and multi-commerce stores).</p>\n<p>The sample is about 400 companies; It is exhaustive for companies with a turnover of more than 300 million euros (inclusive of VAT). In the other strata, a draw coordinated positively with the previous editions is implemented.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1875/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope includes the companies managing supermarkets, hypermarkets and/or multi-commerce stores.</p>\n<p>The survey covers the main activities defined by NAF rev. 2 codes: 47.11D, 47.11E and 47.11F.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1875/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e mensuellement par Internet &agrave; partir du Portail de R&eacute;ponse aux Enqu&ecirc;tes Entreprises : (http://entreprises.insee.fr/).</p>\n<p>La collecte se d&eacute;roule mensuellement par internet via le portail de r&eacute;ponse aux enqu&ecirc;tes &laquo; entreprise &raquo; de l&rsquo;Insee. L&rsquo;entreprise re&ccedil;oit par courrier ou par courriel un code d&rsquo;acc&egrave;s et un mot de passe afin de s&rsquo;identifier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1875/I.18.7/texte> , <http://bauhaus/qualite/attribut/1875/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/rapport/1875>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête mensuelle sur l'activité des grandes surfaces alimentaires 2013"@fr , "Quality report: Monthly survey of large-scale food retail activities 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1421> .
    
    <http://bauhaus/qualite/attribut/1875/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1875/S.3.4/texte> , <http://bauhaus/qualite/attribut/1875/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1875> .
    
    <http://bauhaus/qualite/attribut/1875/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te r&eacute;pond &agrave; une forte demande d'analyse conjoncturelle, au niveau du secteur d'activit&eacute; comme au niveau macro-&eacute;conomique&nbsp;(pr&eacute;occupations exprim&eacute;es par les membres de la Commission des Comptes Commerciaux de la Nation - CCCN).<br /><br />L'enqu&ecirc;te permet &eacute;galement de prendre en compte les fr&eacute;quentes restructurations et l'&eacute;volution d&eacute;mographique du secteur ; le d&eacute;tail par famille de produits permet &eacute;galement de d&eacute;gager un&nbsp;diagnostic conjoncturel.<br /><br />Enfin, l'enqu&ecirc;te permet surtout de disposer d'un r&eacute;sultat plus rapide que la mobilisation des sources fiscales : &agrave; cet &eacute;gard, l'enqu&ecirc;te Emagsa est un maillon indispensable pour &eacute;tablir l'indice pr&eacute;coce &agrave; 30 jours du volume des ventes dans le commerce de d&eacute;tail qui est requis par le r&egrave;glement europ&eacute;en.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1875/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'ouverture de chaque campagne mensuelle a lieu quelques jours après la fin du mois d'affaires enquêté. Les entreprises ayant transmis une adresse électronique sont informées par courriel de l'ouverture de la campagne."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1875/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted monthly by Internet : (http://entreprises.insee.fr/).</p>\n<p><br />Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1754> {
    <http://bauhaus/qualite/attribut/1754/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Estimations annuelles de la validit&eacute; N&nbsp;:<br />- estimations provisoires&nbsp;: 9 mois environ apr&egrave;s la fin de l&rsquo;ann&eacute;e N<br />- estimations d&eacute;finitives&nbsp;: 2 ans et 3 mois apr&egrave;s la fin de l&rsquo;ann&eacute;e N</p>\n<p>Estimations trimestrielles de la validit&eacute; T&nbsp;:<br />- Emploi national&nbsp;: 70 jours environ (45 jours pour l&rsquo;estimation &laquo;&nbsp;flash&nbsp;&raquo;) apr&egrave;s la fin du trimestre T<br />- Emploi&nbsp; r&eacute;gional et d&eacute;partemental&nbsp;: 90 jours environ apr&egrave;s la fin du trimestre T</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1754/S.15.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Time series are built to ensure time-consistency.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1754/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Decree No. 85-1343 of 16 December 1985, as amended, provides for the transmission of annual social data declarations to INSEE for the production of statistics on employment and wages. The decree of 11 December 2014 sets out the data from the nominative social declaration to be sent to INSEE.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1754/S.17.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.2>
                    <http://bauhaus/qualite/attribut/1754/S.17.2/text> , <http://bauhaus/qualite/attribut/1754/S.17.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.12.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.12.3>
                    "<p>Les Estimations d&rsquo;emploi couvrent la totalit&eacute; de l&rsquo;emploi, salari&eacute; comme non-salari&eacute;, public et priv&eacute;.</p>"@fr , "<p>Employment Estimates cover the whole of employment, employed and self-employed, in public and private sectors.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/documents/document/1070>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Les estimations d'emploi"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Doc_Estimations_emploi_fr.pdf> .
    
    <http://bauhaus/qualite/attribut/1754/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The Estel process synthesizes the different sources on employment, both salaried and non-salaried. A certain number of processes are carried out in order to obtain a homogeneous measurement of employment between year N and year N-1: selection of positions present in the last week of December, unbundling, correction of possible delivery errors, automatic adjustments and validation, manual adjustments and validation as part of an appraisal campaign, by comparing the data by establishment with the quarterly source \"Epure\" (salaried field only).</p>\n<p>At the end of Estel, the elaboration of the Employment Estimates is carried out in 4 steps:<br />1) Calculation of the N-1/N rate of change in paid employment by sector of activity (A88) and department<br />2) Application of the evolution rates to the annual estimates for year N-1, to calculate the levels for year N<br />3) By aggregation, calculation of diffusion employment levels (example: departments x sectors A38)<br />4) Constitution of the time-series, by concatenation with the previous series<br />For non-employees, the procedure is largely similar, but at department level x business sector A5. Finally, employment levels by employment area are calculated in a similar way, but then adjusted to the \"encompassing area\" (usually the region), so as to ensure the consistency of the different geographical levels. The male/female distribution of salaried employment is calculated only on the Estel data for year N (by department x sector A38), and applied to the Employment Estimates for year N.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1754/S.8.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.8.3>
                    "<p>General public</p>"@en , "<p>Grand public</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1754/S.3.4/texte> , <http://bauhaus/qualite/attribut/1754/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.18.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le processus Estel r&eacute;alise la synth&egrave;se entre les diff&eacute;rentes sources sur l&rsquo;emploi, salari&eacute; comme non salari&eacute;. Un certain nombre de traitements sont r&eacute;alis&eacute;s dans le but d&rsquo;obtenir une mesure homog&egrave;ne de l&rsquo;emploi entre l&rsquo;ann&eacute;e N et l&rsquo;ann&eacute;e N-1&nbsp;: s&eacute;lection des postes pr&eacute;sents la derni&egrave;re semaine de d&eacute;cembre, d&eacute;groupements, corrections d&rsquo;&eacute;ventuelles erreurs de livraisons, redressements et validation automatique, redressements et validation manuelle dans le cadre d&rsquo;une campagne d&rsquo;expertise, en confrontant les donn&eacute;es par &eacute;tablissement avec la source conjoncturelle &laquo;&nbsp;Epure&nbsp;&raquo; (champ salari&eacute; uniquement).</p>\n<p><span style=\"font-family: Arial,sans-serif;\"><span style=\"font-size: small;\"><span style=\"font-family: Arial,sans-serif;\">&Agrave;</span></span></span> l&rsquo;issue d&rsquo;Estel, l&rsquo;&eacute;laboration des Estimations d&rsquo;emploi est r&eacute;alis&eacute;e en 4 &eacute;tapes&nbsp;:<br />1) Calcul du taux d&rsquo;&eacute;volution N-1/N de l&rsquo;emploi salari&eacute; par secteur d&rsquo;activit&eacute; (A88) et d&eacute;partement<br />2) Application des taux d&rsquo;&eacute;volution aux Estimations annuelles de l&rsquo;ann&eacute;e N-1, pour calculer les niveaux de l&rsquo;ann&eacute;e N<br />3) Par agr&eacute;gation, calcul des niveaux d&rsquo;emploi de diffusion (exemple&nbsp;: d&eacute;partements x secteurs A38)<br />4) Constitution des s&eacute;ries longues, par concat&eacute;nation avec les s&eacute;ries pr&eacute;c&eacute;dentes.<br />Pour les non-salari&eacute;s, la proc&eacute;dure est largement similaire, mais au niveau d&eacute;partement x secteur d&rsquo;activit&eacute; A5. Enfin, les niveaux d&rsquo;emploi par zone d&rsquo;emploi sont calcul&eacute;s d&rsquo;une mani&egrave;re similaire, mais cal&eacute;s ensuite sur la &laquo;&nbsp;zone englobante&nbsp;&raquo; (g&eacute;n&eacute;ralement la r&eacute;gion), de mani&egrave;re &agrave; assurer la coh&eacute;rence des diff&eacute;rents niveaux g&eacute;ographiques. La r&eacute;partition hommes/femmes de l&rsquo;emploi salari&eacute; est calcul&eacute;e uniquement sur les donn&eacute;es Estel de l&rsquo;ann&eacute;e N (par d&eacute;partement x secteur A38), et appliqu&eacute;e aux Estimations d&rsquo;emploi de l&rsquo;ann&eacute;e N.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1754/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Deux diffusions pour les estimations annuelles de la validit&eacute; N&nbsp;:<br />- &Agrave; l&rsquo;automne N+1 avec les estimations provisoires<br />- En mars N+3 avec les estimations d&eacute;finitives</p>\n<p>Trois diffusions pour les estimations trimestrielles de la validit&eacute; T&nbsp;:<br />- Environ 45 jours apr&egrave;s la fin du trimestre pour les estimations &laquo;&nbsp;flash&nbsp;&raquo; de l&rsquo;emploi national (salari&eacute;s du priv&eacute;)<br />- Environ 70 jours apr&egrave;s la fin du trimestre pour les estimations de l&rsquo;emploi national (tous salari&eacute;s)<br />- Environ 90 jours apr&egrave;s la fin du trimestre pour les estimations r&eacute;gionales et d&eacute;partementales (tous salari&eacute;s)</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1754/S.6.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Des conventions conclues entre l&rsquo;Insee et l&rsquo;Acoss r&eacute;gissent le partage des donn&eacute;es n&eacute;cessaires &agrave; la production des Estimations d&rsquo;emploi.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1754/S.15.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.2>
                    <http://bauhaus/qualite/attribut/1754/S.15.2/texte> , <http://bauhaus/qualite/attribut/1754/S.15.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.10.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.3>
                    <http://bauhaus/qualite/attribut/1754/S.10.3/text> , <http://bauhaus/qualite/attribut/1754/S.10.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Employment Estimates are the reference source for cyclical employment monitoring. They record, annually and quarterly, the number of people in employment in France (excluding Mayotte).</p>\n<p>Annual estimates measure total employment (employed and self-employed) over the last week of the year. Quarterly estimates determine paid employment at the end of the quarter. Employment Estimates provide employment levels and trends by sector of activity (up to level A88 of the Naf rev.&nbsp;2) and by geographical level (up to the employment area).</p>\n<p>They are based on a synthesis of several statistical sources of administrative origin. These sources are based on social declarations made by employers, or those of self-employed workers (in France excluding Mayotte). Any employment reported in the administrative data is recorded. In the Employment Estimates, persons who hold several jobs at the same time (either because they are employees and have several employers, or because they are both self-employed and employees) are counted only once, for their main job, which is the one that provides them with the highest remuneration over the year.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1754/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of division</p>"@en , "<p>Chef de division</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.14.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.2>
                    <http://bauhaus/qualite/attribut/1754/S.14.2/text> , <http://bauhaus/qualite/attribut/1754/S.14.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.15.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les s&eacute;ries temporelles sont construites pour assurer la coh&eacute;rence dans les temps des &eacute;volutions de l&rsquo;emploi.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1754/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Need for information on labour market developments, in particular on employment, for the general public, the media, regional and national public actors, etc.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1754/S.15.3.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.3.2>
                    <http://bauhaus/qualite/attribut/1754/S.15.3.2/text> , <http://bauhaus/qualite/attribut/1754/S.15.3.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1754> .
    
    <http://bauhaus/qualite/attribut/1754/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1754/S.18.1/texte> , <http://bauhaus/qualite/attribut/1754/S.18.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
