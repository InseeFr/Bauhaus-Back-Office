    <http://bauhaus/qualite/attribut/1754/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1754/S.14.1/text> , <http://bauhaus/qualite/attribut/1754/S.14.1/texte> ;
