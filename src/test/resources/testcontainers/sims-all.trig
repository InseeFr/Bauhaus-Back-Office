                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_dispositif_allege_AHCT_2021.pdf> .
    
    <http://bauhaus/qualite/attribut/1986/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1986/S.7.1/text> , <http://bauhaus/qualite/attribut/1986/S.7.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1986/I.18.7/texte> , <http://bauhaus/qualite/attribut/1986/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Deux statuts de diffusion&nbsp;: donn&eacute;es provisoires et d&eacute;finitives <br />- diffusion des donn&eacute;es provisoires&nbsp;: en d&eacute;but de mois M+2 pour le mois M<br />- diffusion des donn&eacute;es d&eacute;finitives&nbsp;: en fin de mois M+3 pour le mois M</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1986/S.3.1/text> , <http://bauhaus/qualite/attribut/1986/S.3.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The Coordinating Committee for Tourism Statistics (CCST), led by Insee, integrates the main national tourism stakeholders: Atout France, professional federations of hoteliers and representatives of departmental and regional tourism committees (FNCRT, RN2D).<br />The needs of local partners are taken into account in partnership agreements with Insee tourism sites.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1986/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1986/S.18.3/text> , <http://bauhaus/qualite/attribut/1986/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte se fait en d&eacute;but de mois M+1 pour les donn&eacute;es du mois M.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour les h&ocirc;tels&nbsp;: la base de sondage est le fichier des h&ocirc;tels de tourisme g&eacute;r&eacute; par l'Insee.<br />Les crit&egrave;res de stratification de l'&eacute;chantillon national sont&nbsp;:<br />- l'axe g&eacute;ographique (r&eacute;gions, espaces touristiques nationaux (ETN))&nbsp;;<br />- la cat&eacute;gorie d'h&ocirc;tel (1 &agrave; 5 &eacute;toiles ou non class&eacute;)&nbsp;;<br />- le type d'h&ocirc;tel (cha&icirc;ne ou ind&eacute;pendant).<br />Au sein des strates, le tirage est al&eacute;atoire.<br /><br />Pour les campings&nbsp;: la base de sondage est le fichier des campings offrant au moins un emplacement de passage g&eacute;r&eacute; par l'Insee. <br />Dans les r&eacute;gions de petite taille,&nbsp;l'enqu&ecirc;te est exhaustive. Pour les autres r&eacute;gions, les crit&egrave;res de stratification de l'&eacute;chantillon sont :<br />- l'axe g&eacute;ographique (espaces touristiques nationaux (ETN))&nbsp;;<br />- la cat&eacute;gorie de camping (1 &agrave; 5 &eacute;toiles, non class&eacute;)&nbsp;;<br />- la taille en nombre d'emplacements.<br />A l'int&eacute;rieur des strates, le tirage est al&eacute;atoire.<br /><br />Pour les AHCT&nbsp;: la base de sondage est le fichier des autres h&eacute;bergements collectifs, fichier g&eacute;r&eacute; par l'Insee. Les crit&egrave;res de stratification de l'&eacute;chantillon national sont&nbsp;:<br />- l'axe g&eacute;ographique (r&eacute;gions, espaces touristiques nationaux (ETN))&nbsp;;<br />- le type d'&eacute;tablissement&nbsp;;<br />Au sein des strates, le tirage est al&eacute;atoire.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Envoi d&rsquo;un courrier postal et/ou envoi d&rsquo;un mail.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "dr34-pole-tourisme@insee.fr"@fr , "dr34-pole-tourisme@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/documents/document/1299>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire enquête allégée hôtels 2021"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_dispositif_allege_HTL_2021.pdf> .
    
    <http://bauhaus/qualite/attribut/1986/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The main topics are:<br />- characteristics of the establishment;<br />- reception capacities;<br />- daily occupancy of rooms;<br />- Arrivals and overnight stays according to the country of residence of the tourists;<br />- duration of stay;<br />- proportion of business tourism.<br />The park is measured on December 31 of each year and the attendance on each month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1986/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Statistics requested relate to customer stays"@en , "Les statistiques demandées concernent les séjours de la clientèle"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2021M012EC"@fr , "2021M012EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>The past month</p>"@en , "<p>Le mois &eacute;coul&eacute;</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/documents/document/1298>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice d’aide au remplissage du questionnaire allégé 2021"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_dispositif_allege_2021.pdf> .
    
    <http://bauhaus/qualite/attribut/1986/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>No results are published if it concerns less than three companies, or no data for which a single company represents 85% or more of the value obtained.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1986/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>For hotels, the survey covers the activities defined by the French classification of activities (NAF rev. 2): 55.10Z codes (hotels and similar accommodation), i.e. tourist-oriented hotels, whether classified or not.<br /><br />For campings, the survey covers activities defined by NAF rev. 2: 55.30Z (campsites and parks for caravans or recreational vehicles). Outdoor accommodations exclusively for residential use are excluded.<br /><br />For other collective tourist accommodations, the units surveyed are collective tourist accommodation subject to regulation: youth hostels, international centers of stay, sports centers, tourist residences and residential hotels, family holiday homes and holiday villages.<br />The economic unit questioned is the operator of the accommodation (NAF rev. 2: 55.10Z and 55.20Z).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1986/S.7.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Aucun r&eacute;sultat n'est publi&eacute; s'il concerne moins de trois entreprises, ni aucune donn&eacute;e pour laquelle une seule entreprise repr&eacute;sente 85% ou plus de la valeur obtenue.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Pour les h&ocirc;tels, l'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par les codes de la nomenclature d&rsquo;activit&eacute; fran&ccedil;aise (NAF r&eacute;v. 2) suivants : 55.10Z (h&ocirc;tels et h&eacute;bergement similaire), c&rsquo;est &agrave; dire les h&ocirc;tels &agrave; vocation touristique, qu'ils soient class&eacute;s ou non.<br /><br />Pour les campings, l'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par le code NAF r&eacute;v. 2 : 55.30Z (terrains de camping et parcs pour caravanes ou v&eacute;hicules de loisirs). Sont exclus les campings &agrave; vocation exclusivement r&eacute;sidentielle.<br /><br />Pour les autres h&eacute;bergements collectifs de tourisme (AHCT), les unit&eacute;s enqu&ecirc;t&eacute;es sont les h&eacute;bergements collectifs touristiques faisant l'objet d'une r&eacute;glementation&nbsp;: auberges de jeunesse, centres internationaux de s&eacute;jour, centres sportifs, r&eacute;sidences de tourisme et r&eacute;sidences h&ocirc;teli&egrave;res, maisons familiales de vacances et villages de vacances.<br />L'unit&eacute; &eacute;conomique interrog&eacute;e est l'exploitant de l'h&eacute;bergement (NAF r&eacute;v.&nbsp;2 : codes 55.10Z et 55.20Z).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1986/I.18.12/texte> , <http://bauhaus/qualite/attribut/1986/I.18.12/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The collection is done at the beginning of month M+1 for the data of month M.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1986/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le Comit&eacute; de Coordination des Statistiques du Tourisme (CCST), anim&eacute; par l'Insee, int&egrave;gre les principaux acteurs nationaux du tourisme : Atout France, les f&eacute;d&eacute;rations professionnelles des h&ocirc;teliers et repr&eacute;sentants des comit&eacute;s d&eacute;partementaux et r&eacute;gionaux du tourisme (FNCRT, RN2D). <br />Les besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Une &laquo;&nbsp;Informations rapides&nbsp;&raquo; est publi&eacute;e chaque trimestre.<br />Un bilan de saison d&rsquo;&eacute;t&eacute; est publi&eacute; en d&eacute;cembre.<br />Un bilan de saison d&rsquo;hiver est publi&eacute; en juin.<br />Un bilan annuel est publi&eacute; en avril.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1986/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/rapport/1986>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête mensuelle de fréquentation dans les hébergements collectifs de tourisme 2021"@fr , "Quality report: Monthly attendance survey in collective tourist accommodation 2021"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1564> .
    
    <http://bauhaus/qualite/attribut/1986/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1986/S.10.2/texte> , <http://bauhaus/qualite/attribut/1986/S.10.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1986/S.14.1/texte> , <http://bauhaus/qualite/attribut/1986/S.14.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.8.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Two dissemination statuses: provisional and final data<br />- Provisional data dissemination: at the beginning of the month M+2 for the month M<br />- dissemination of definitive data: at the end of the month M+3 for the month M</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Hotels: the sampling frame is the index of tourism hotels, index managed by Insee.<br />The stratification criteria of the national sample are:<br />- the geographical axis&nbsp;(regions, national tourist areas (ETN));<br />- hotel category (1 to 5 stars or unclassified);<br />- the type of hotel (chain or independent).<br />Within the strata, the draw is random.<br /><br />Campings: the sampling frame is the file of establishments offering at least one location, file managed by Insee.<br />In small regions, the survey is comprehensive. For other regions, the stratification criteria of the sample are:<br />- the geographical axis (national tourist areas (ETN));<br />- the category of camping (1 to 5 stars, not classified);<br />- the size in number of locations.<br />Inside the strata, the draw is random.<br /><br />Other collective tourist accommodations: the sampling frame is the file of other collective accommodation, file managed by Insee. The stratification criteria of the national sample are:<br />- the geographical axis (regions, national tourist areas (ETN));<br />- the type of establishment.<br />Within the strata, the draw is random.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>Pour les h&ocirc;tels&nbsp;: l&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon national d'environ 12.000 h&ocirc;tels sur un total de 18.000.<br />Pour les campings&nbsp;: l&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d&rsquo;un &eacute;chantillon de 6.000 campings sur 8.000.<br />Pour les AHCT&nbsp;: l'enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon d'environ 2.500 &eacute;tablissements sur un total de 3.500.</p>"@fr , "<p>Hotels: survey is conducted with a national sample of approximately 12,000 hotels out of a total of 18,000.<br />Campsites: survey is conducted with a sample of 6,000 campsites out of 8,000.<br />AHCT: survey is conducted with a sample of approximately 2,500 establishments out of a total of 3,500.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1986/S.3.3/texte> , <http://bauhaus/qualite/attribut/1986/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1986/S.12.1/texte> , <http://bauhaus/qualite/attribut/1986/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2020-02-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1986> .
    
    <http://bauhaus/qualite/attribut/1986/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
