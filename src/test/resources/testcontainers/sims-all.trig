                    <http://bauhaus/qualite/attribut/1838/S.3.2/text> , <http://bauhaus/qualite/attribut/1838/S.3.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1838> .
    
    <http://bauhaus/qualite/attribut/1838/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey responds to the European Regulation on structural business statistics (EC N&deg;251/2009) of 11 March 2009, requesting environmental protection expenditure broken down by environmental domain, activity and size of enterprise.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
