                    <http://bauhaus/documents/document/416> , <http://bauhaus/documents/document/418> , <http://bauhaus/documents/document/417> .
    
    <http://bauhaus/qualite/rapport/1597>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Quarterly business outlook survey on investment in industry 2013"@en , "Rapport qualité : Enquête trimestrielle sur les investissements dans l'industrie 2013"@fr ;
