            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/151> , <http://bauhaus/documents/document/152> .
    
    <http://bauhaus/qualite/attribut/1731/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
