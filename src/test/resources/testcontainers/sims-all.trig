                    <http://bauhaus/operations/operation/s1121> .
    
    <http://bauhaus/qualite/attribut/1597/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1597/S.11.2/text> , <http://bauhaus/qualite/attribut/1597/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
