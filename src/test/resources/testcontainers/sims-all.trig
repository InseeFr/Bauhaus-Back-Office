                    "<p>Since 1958</p>"@en , "<p>Depuis 1958</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1912> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1815> {
    <http://bauhaus/qualite/attribut/1815/I.18.9>
