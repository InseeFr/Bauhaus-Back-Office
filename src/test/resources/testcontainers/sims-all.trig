                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1728/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/170> .
    
    <http://bauhaus/qualite/attribut/1728/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The ICT-TPE survey is an extension to firms employing less than 10 people from the annual ICT survey, extension requested by the Committee \"Business and market strategies\" of the National Council for Statistical Information (CNIS) on renewal of the general interest label of the ICT survey for the years 2011 to 2015.</p>\n<p>The ICT-TPE survey obtained the label of general interest and statistical quality with binding.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Web survey"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1728/S.3.4/text> , <http://bauhaus/qualite/attribut/1728/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les principaux thèmes abordés sont l'équipement en technologies de l'information et de la communication (TIC), l'accès à internet et son usage, le partage automatique de l'information et le commerce électronique."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1728/S.18.3/texte> , <http://bauhaus/qualite/attribut/1728/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Un comité de concertation, composé des experts et représentants des politiques publiques concernées par les questions de technologie de l'information, de la communication et de commerce électronique (SOeS, SSP, DGE, CCIP, ARCEP, SGMAP, Télécom Paris Tech…) ainsi que des représentants d'organisations professionnelles, ou de syndicats de salariés (FEVAD, Syntec Numérique, Medef, CCIP, CGPME, CGT, FO…) s'est réuni pour participer à la conception du questionnaire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/S.10.2/texte>
