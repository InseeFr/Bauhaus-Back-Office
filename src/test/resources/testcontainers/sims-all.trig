            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie d'élaboration des taux de chômage localisés (régions, départements et zones d’emploi)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-03-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_TAUX_CHOMAGE_LOCALISES_FR.pdf> .
    
