                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1571/S.3.6/text> , <http://bauhaus/qualite/attribut/1571/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1571/I.18.10/text> , <http://bauhaus/qualite/attribut/1571/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/62> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1571/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers the retail trade and automobile trading and repairs, excluding local food and specialised retailers, retail sales of flowers and pets, retail trade in used goods and out-of-store retail trade (except for the mail-order sector which is included in the scope of the survey).</p>\n<p>More precisely, the survey covers the sectors defined in the following NAF Rev. 2 codes: division 45, 47.1 (except 47.11A, 47.11B, 47.11C), 47.3, 47.4, 47.5, 47.6, 47.7 (except 47.76Z), 47.91A, 47.91B.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1571/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1571/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1571/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/documents/document/463>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête mensuelle de conjoncture dans le commerce de détail et le commerce et la réparation automobiles"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-06-23"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_COMMERCE_DETAIL_FR_2016.pdf> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1571/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans le commerce de d&eacute;tail et le commerce et la r&eacute;paration automobiles fait partie du syst&egrave;me europ&eacute;en harmonis&eacute; des enqu&ecirc;tes de conjoncture de la Commission europ&eacute;enne, auquel contribuent les vingt-sept &Eacute;tats membres de&nbsp;l'Union europ&eacute;enne.<br /><br />&Agrave; ce titre, les questionnaires, les nomenclatures et les m&eacute;thodes de traitement sont largement harmonis&eacute;s dans les instituts nationaux des pays adh&eacute;rant &agrave; ce syst&egrave;me.<br /><br />La formulation des questions est con&ccedil;ue de mani&egrave;re &agrave; faciliter&nbsp;une r&eacute;ponse rapide (la plupart des questions sont qualitatives &agrave; trois modalit&eacute;s exprim&eacute;es sous la forme \"hausse, baisse, stable\", ou \"sup&eacute;rieur &agrave; la normale, normal, inf&eacute;rieur &agrave; la normale\").</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1571/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Until 2007, the survey was carried out each month except in August. Since 2008 it has been carried out every month.<br /><br />Data collection is by post and online over a period stretching from the end of the month prior to the month of the survey to the date of publication of the survey, i.e. 4 working days before the end of the current month.<br /><br />The results of the survey are sent to the European Commission 5 working days before the end of the month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1571/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1571/S.3.4/texte> , <http://bauhaus/qualite/attribut/1571/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1571/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans le commerce de d&eacute;tail et le commerce et la r&eacute;paration automobiles a pour objet de transcrire l'opinion des d&eacute;taillants sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.<br /><br />Cette opinion est retrac&eacute;e au moyen du suivi du volume des ventes et de variables qui lui sont li&eacute;es, telles que les stocks, les intentions de commandes, l'&eacute;volution des effectifs ainsi que celle des prix.<br /><br />Les chefs d'entreprise fournissent &eacute;galement une opinion sur leur tr&eacute;sorerie et les d&eacute;lais de paiement.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1571/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Jusqu'en 2007, l'enqu&ecirc;te avait lieu chaque mois sauf au mois d'ao&ucirc;t. Depuis 2008, elle a lieu tous les mois.<br /><br />La collecte s'effectue par voie postale et par internet sur une p&eacute;riode qui s'&eacute;tend de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la fin du mois de l'enqu&ecirc;te, soit 4 jours ouvrables avant la fin du mois courant.<br /><br />Les r&eacute;sultats d'enqu&ecirc;te sont envoy&eacute;s &agrave; la Commission europ&eacute;enne 5 jours ouvrables avant la fin du mois.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1571/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1571/S.18.3/texte> , <http://bauhaus/qualite/attribut/1571/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/documents/page/62>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Insee Méthodes n° 110"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête de conjoncture dans le commerce de détail et le commerce et réparation automobile : méthodologie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://www.epsilon.insee.fr/jspui/handle/1/7263> .
    
    <http://bauhaus/qualite/attribut/1571/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in the retail trade and automobile trade and repairs aims to transcribe the opinion of retailers on their recent activity and business prospects.<br /><br />This opinion is tracked by monitoring sales volumes and related variables such as stocks, order intentions, changes in workforce and price trends.<br /><br />Entrepreneurs also provide an opinion on their cash flow and payment deadlines.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1571/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/456> .
    
    <http://bauhaus/qualite/attribut/1571/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre le commerce de d&eacute;tail et le commerce et la r&eacute;paration automobiles, &agrave; l'exclusion du commerce alimentaire de proximit&eacute; ou sp&eacute;cialis&eacute;, du commerce de d&eacute;tail de fleurs et animaux de compagnie, du commerce de d&eacute;tail de biens d'occasion, du commerce de d&eacute;tail hors magasin (&agrave; l'exception du secteur de la vente par correspondance, inclus dans le champ de l'enqu&ecirc;te).</p>\n<p>Plus pr&eacute;cis&eacute;ment, l'enqu&ecirc;te couvre les secteurs d&eacute;finis par les codes NAF r&eacute;v. 2 suivants : division 45, 47.1 (hors 47.11A, 47.11B, 47.11C), 47.3, 47.4, 47.5, 47.6, 47.7 (hors 47.76Z), 47.91A, 47.91B.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1571/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1571/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enqu&ecirc;te par sondage aupr&egrave;s de 3&nbsp;750 entreprises.</p>\n<p>Toutes les entreprises de plus de 100 salari&eacute;s sont interrog&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1571/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/rapport/1571>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly survey in the retail trade and in the trade and repair of motor vehicles 2008"@en , "Rapport qualité : Enquête mensuelle de conjoncture dans le commerce de détail et le commerce et la réparation automobiles 2008"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1153> .
    
    <http://bauhaus/qualite/attribut/1571/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1571/S.19/text> , <http://bauhaus/qualite/attribut/1571/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-03-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1571> .
    
    <http://bauhaus/qualite/attribut/1571/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly outlook survey in the retail trade and automobile trade and repairs is part of the harmonised European Union programme of business and consumer surveys to which the 27 Member States of the European Union contribute.<br /><br />As such, the questionnaires, classifications and processing methods are largely harmonised in the national institutes of the countries belonging to the system.<br /><br />The wording of the questions is designed in such a way as to facilitate quick answers (most of the questions are qualitative with three possible answers in the form \"up, down, same\", or \"higher than normal, normal, lower&nbsp;than normal\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1571/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/463> , <http://bauhaus/documents/document/444> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1583> {
    <http://bauhaus/qualite/attribut/1583/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1583/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/documents/document/437>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice  2012"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Batiment_francais_2012.pdf> .
    
    <http://bauhaus/qualite/attribut/1583/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly business outlook survey in the building industry covers companies working on the construction of individual houses and miscellaneous buildings, general building work, roofing, framing, fitting and finishing work.</p>\n<p>More precisely, the survey covers the sectors defined by the following NAF Rev. 2 codes: 41.2, 43.2, 43.3, 43.9</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1583/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/54> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1583/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly business outlook survey in the building industry is part of the European system to harmonise European Commission business outlook surveys, and to which the 27 Member States of the European Union contribute.<br /><br />Thus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system.<br /><br />Questions are formulated so that they can be answered quickly (most of the questions are qualitative with three response options expressed in the form \"higher, lower, stable\", or \"more than normal, normal, less than normal\").</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1583/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/443> , <http://bauhaus/documents/document/444> .
    
    <http://bauhaus/qualite/attribut/1583/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1583/S.3.4/texte> , <http://bauhaus/qualite/attribut/1583/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Enqu&ecirc;te par sondage aupr&egrave;s de 2 500 entreprises de plus de 10 salari&eacute;s.</p>\n<p>Toutes les entreprises de plus de 500 salari&eacute;s sont interrog&eacute;es.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1583/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey covers 2,500 companies with more than 10 employees.</p>\n<p>All companies with more than 500 employees are canvassed.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1583/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans l'industrie du b&acirc;timent fait partie du syst&egrave;me europ&eacute;en harmonis&eacute; des enqu&ecirc;tes de conjoncture de la Commission europ&eacute;enne, auquel contribuent les vingt-sept &Eacute;tats membres de l'Union europ&eacute;enne.<br /><br />&Agrave; ce titre, les questionnaires, les nomenclatures et les m&eacute;thodes de traitement sont largement harmonis&eacute;s dans les instituts nationaux des pays adh&eacute;rant &agrave; ce syst&egrave;me.<br /><br />La formulation des questions est con&ccedil;ue de mani&egrave;re &agrave; faciliter une r&eacute;ponse rapide (la&nbsp;plupart des questions sont qualitatives &agrave; trois modalit&eacute;s exprim&eacute;es sous la forme \"hausse, baisse, stable\", ou \"sup&eacute;rieur &agrave; la normale, normal, inf&eacute;rieur &agrave; la normale\").</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1583>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête mensuelle de conjoncture dans l'industrie du bâtiment 2012"@fr , "Quality report: Monthly business outlook survey in the building industry 2012"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1143> .
    
    <http://bauhaus/documents/page/54>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Insee Méthodes n° 115"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête de conjoncture sur la situation et les perspectives dans l'industrie du bâtiment : méthodologie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/7258> .
    
    <http://bauhaus/qualite/attribut/1583/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1583/S.18.3/text> , <http://bauhaus/qualite/attribut/1583/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Until 2007, the survey was conducted every month except August.<br /><br />Since 2008, it takes place every month.<br /><br />Data collection is by post and via the internet over a period that extends from the end of the month preceding the survey month&nbsp;to the survey publication date, i.e. 4 business days before the end of the current month.<br /><br />Survey results are sent to the European Commission 4 business days before the end of the month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1583/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1583/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans l'industrie du b&acirc;timent a pour objet de transcrire l'opinion des entrepreneurs du secteur sur leur activit&eacute; r&eacute;cente et sur leurs perspectives d'activit&eacute;.<br /><br />Cette opinion est retrac&eacute;e au moyen du suivi de la production elle-m&ecirc;me et de variables qui lui sont li&eacute;es, telles que les carnets de commandes, goulots de production, effectifs, difficult&eacute;s de recrutement...<br /><br />Les chefs d'entreprise fournissent &eacute;galement des estimations de leurs investissements et une opinion sur leur tr&eacute;sorerie.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1583/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1583/I.18.10/texte> , <http://bauhaus/qualite/attribut/1583/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1583/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The monthly business outlook survey in the building industry records the opinion of entrepreneurs in the sector on recent activity and on their future activity.<br /><br />This opinion is obtained by monitoring production itself and related variables, such as order books, production bottlenecks, workforce, difficulties with hiring workers, etc.<br /><br />Company chiefs also provide estimates of their investments and an opinion on their cash flow.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1583/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/documents/document/443>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête mensuelle de conjoncture dans l’industrie du bâtiment"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_BAT_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1583/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1583/S.19/text> , <http://bauhaus/qualite/attribut/1583/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te mensuelle de conjoncture dans l'industrie du b&acirc;timent est r&eacute;alis&eacute;e aupr&egrave;s d'entreprises travaillant dans la construction de maisons individuelles et de b&acirc;timents divers, les travaux de ma&ccedil;onnerie g&eacute;n&eacute;rale, la r&eacute;alisation de charpentes et de couvertures, les travaux d'installation et de finition.</p>\n<p>Plus pr&eacute;cis&eacute;ment, l'enqu&ecirc;te couvre les secteurs d&eacute;finis par les codes NAF r&eacute;v. 2 suivants : 41.2, 43.2, 43.3, 43.9.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1583/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Jusqu'en 2007, l'enqu&ecirc;te avait lieu chaque mois sauf au mois d'ao&ucirc;t.<br /><br />Depuis 2008, elle a lieu tous les mois.<br /><br />La collecte s'effectue par voie postale et par internet sur une p&eacute;riode qui s'&eacute;tend de la fin du mois pr&eacute;c&eacute;dant le mois de l'enqu&ecirc;te &agrave; la date de publication de l'enqu&ecirc;te, soit 4 jours ouvrables avant la fin du mois courant.<br /><br />Les r&eacute;sultats d'enqu&ecirc;te sont envoy&eacute;s &agrave; la Commission europ&eacute;enne 4 jours ouvrables avant la fin de mois.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1583/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1583/S.3.6/texte> , <http://bauhaus/qualite/attribut/1583/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
    
    <http://bauhaus/qualite/attribut/1583/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/437> .
    
    <http://bauhaus/qualite/attribut/1583/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1583> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1680> {
    <http://bauhaus/qualite/attribut/1680/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Un emplacement, consid&eacute;r&eacute; comme locatif, dispose d'un &eacute;quipement d'h&eacute;bergement de type bungalow, bungatoile, mobil-home, habitation l&eacute;g&egrave;re de loisir (HLL)&hellip;</p>\n<p>Les &eacute;ventuels emplacements pr&eacute;vus pour le stationnement des camping-cars sont consid&eacute;r&eacute;s comme des emplacements nus.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1680/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is carried out from May to September, by post."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1680/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Cette enqu&ecirc;te porte sur la fr&eacute;quentation des cinq mois d'&eacute;t&eacute;, de mai &agrave; septembre : le parc est mesur&eacute; chaque ann&eacute;e au 30 novembre.</p>\n<p>Elle aborde les th&egrave;mes suivants :</p>\n<p>- caract&eacute;ristiques du terrain ;</p>\n<p>- p&eacute;riode d'ouverture ;</p>\n<p>- capacit&eacute; d'accueil (emplacements nus et emplacements locatifs) ;</p>\n<p>- occupation des emplacements (nus et locatifs) ;</p>\n<p>- fr&eacute;quentation mensuelle (en termes de nombre d'arriv&eacute;es et de nuit&eacute;es) selon le type d'emplacements (nus et locatifs) et le pays de r&eacute;sidence habituelle des clients.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1680/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1680/S.3.6/texte> , <http://bauhaus/qualite/attribut/1680/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1680/S.18.3/text> , <http://bauhaus/qualite/attribut/1680/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1680/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>This survey concerns the occupancy in the five summer months, from May to September: the stock is measured on 30 November of each year.</p>\n<p>It covers the following topics:</p>\n<p>- Characteristics of the site</p>\n<p>- Opening period</p>\n<p>- Accommodation capacity (bare pitches and pitches with rental accommodation)</p>\n<p>- Occupancy of pitches (bare and with rental accommodation)</p>\n<p>- Monthly occupancy (in terms of the numbers of arrivals and nights) according to the type of pitch (bare and with rental accommodation) and the customers' normal country of residence.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1680/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre les activit&eacute;s d&eacute;finies par le code NAF r&eacute;v. 2 : 55.30Z (terrains de camping et parcs pour caravanes ou v&eacute;hicules de loisirs).</p>\n<p>Les unit&eacute;s enqu&ecirc;t&eacute;es sont des terrains de camping, class&eacute;s de 1 &agrave; 5 &eacute;toiles ou des terrains non class&eacute;s offrant au moins un emplacement de passage.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1680/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "From the 2013 season, the survey is no longer exhaustive: it is carried out with a sample of 6,000 campsites from 7500"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1680/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1680/S.3.4/text> , <http://bauhaus/qualite/attribut/1680/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/documents/document/273>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête de fréquentation dans l'hôtellerie de plein air 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaire_camping_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1680/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1680/I.18.10/texte> , <http://bauhaus/qualite/attribut/1680/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/qualite/attribut/1680/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée de mai à septembre, par voie postale."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1680/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>A pitch that is considered to have rental accommodation is equipped with a bungalow, \"Bungatent\", mobile home, leisure home, etc.</p>\n<p>Any pitches that may be reserved for campervans are considered to be bare pitches.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1680>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête de fréquentation dans l'hôtellerie de plein air 2015"@fr , "Quality report: Outdoor accommodation occupancy survey 2015"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1091> .
    
    <http://bauhaus/qualite/attribut/1680/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1680> .
    
    <http://bauhaus/documents/document/272>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
