    <http://bauhaus/documents/document/912>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Sales volume index base 2015"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-03-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/IVVC_methodo_20180330_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1887/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>VAT declarations of some companies may not be available when the indices are first published. This leads to revise raw indices or prices and SWDA indices when these declarations or prices are finally available.<br />Models used to correct seasonal and calendar effects are updated annually. Between two model updates, SWDA coefficients are updated monthly in order to take into account the most recent data &ndash; this includes raw data rectifications related to the previous months. At each publication, all SWDA indices disseminated on the INSEE website are updated from 2005.</p>\n<p>Sales volume indices on retail trade and wholesale trade are monthly disseminated at the latest 60 days after the month under review. For retail trade, an early estimate of sales volume is also published within 30 days.<br />This estimate is based on econometric equations for which the main explanatory variables are currently:<br />- results of the monthly INSEE survey on the activity of large-scale food retailing;<br />- results of Bank of France monthly survey in retail trade;<br />- results of the monthly survey of retail trade by the Bank of France household equipments and food products;<br />- household consumer price index for fuels.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1887/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1887/S.3.6/text> , <http://bauhaus/qualite/attribut/1887/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1887/S.14.1/texte> , <http://bauhaus/qualite/attribut/1887/S.14.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sales volume indices are calculated according to the nomenclature NAF rev. 2, which came into force on 1 January 2008.<br />They cover the following sectors:<br />Trade and repair of motor vehicles and motorcycles (Division 45);<br />Wholesale trade, except for motor vehicles and motorcycles (Division 46);<br />Retail trade, except motor vehicles and motorcycles (Division 47).<br /><br />Trade volume indices are constructed from a tax source, the \"CA3\" form, which must be completed by enterprises for the payment of value added tax (VAT) every month. These indexes cover &ldquo;whole France&rdquo; including overseas departments (excepted French Guyana and Mayotte, which are not liable for VAT). Price indices calculated by INSEE, mainly for &ldquo;whole France&rdquo; (including Overseas Departments) are used as deflators for indices in value.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1887/S.14.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 days"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/911>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indice de volume des ventes dans le commerce (base 2015) "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-03-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/IVVC_methodo_20180330.pdf> .
    
    <http://bauhaus/qualite/attribut/1887/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
                    <http://bauhaus/qualite/attribut/1887/S.8.1/texte> , <http://bauhaus/qualite/attribut/1887/S.8.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1887/S.18.3/texte> , <http://bauhaus/qualite/attribut/1887/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 jours"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les s&eacute;ries sont corrig&eacute;es des variations saisonni&egrave;res (CVS) et des effets de calendrier (CJO). L&rsquo;estimation de ces effets est effectu&eacute;e avec la m&eacute;thode X13-Arima sous JDemetra+ (disponible sur le site d&rsquo;Eurostat) au niveau des classes de la NAF r&eacute;v. 2 directement sur les ratios &laquo;&nbsp;volume&nbsp;&raquo; (c'est-&agrave;-dire indice brut de chiffre d'affaires en valeur/indice de prix brut). Les indices CVS-CJO des postes des niveaux sup&eacute;rieurs &agrave; la classe sont obtenus par agr&eacute;gation des indices CVS-CJO des classes qui les composent.<br />La moyenne annuelle des indices CVS-CJO peut diff&eacute;rer l&eacute;g&egrave;rement de celle des indices bruts notamment car elle tient compte des variations de la composition annuelle en jours ouvrables d&rsquo;une ann&eacute;e sur l&rsquo;autre&nbsp;: ann&eacute;es bissextiles, positionnement dans la semaine des diff&eacute;rents jours f&eacute;ri&eacute;s, etc.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de volume des ventes s&rsquo;appuient sur deux sources principales : <br />- Les indices de chiffre d&rsquo;affaires (en valeur) calcul&eacute;s par l&rsquo;Insee &agrave; partir d&rsquo;une source fiscale, le formulaire &laquo;&nbsp;CA3&nbsp;&raquo;, que les entreprises remplissent tous les mois1 pour le paiement de la TVA (cf. Note m&eacute;thodologique sur les indices de chiffre d&rsquo;affaires). Ces donn&eacute;es sont transmises &agrave; l&rsquo;Insee par la Direction g&eacute;n&eacute;rale des Finances publiques (DGFiP).<br />- Diff&eacute;rents types d&rsquo;indices de prix calcul&eacute;s par l&rsquo;Insee (d&eacute;flateurs)&nbsp;: indices de prix &agrave; la production, indices de prix &agrave; la consommation.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les d&eacute;clarations des entreprises ne sont pas toujours disponibles en totalit&eacute; au moment de la premi&egrave;re publication de l&rsquo;indice. L&rsquo;int&eacute;gration des r&eacute;ponses retardataires conduit &agrave; r&eacute;viser les donn&eacute;es brutes des valeurs comme celles de certains prix. Le calcul des coefficients CVS-CJO est mis &agrave; jour chaque mois sur l&rsquo;ensemble de la p&eacute;riode de diffusion (depuis janvier 2005). Tous les mod&egrave;les CVS-CJO sont r&eacute;vis&eacute;s annuellement. Cette mise &agrave; jour est susceptible de modifier &eacute;galement l&rsquo;ensemble des s&eacute;ries CVS-CJO.</p>\n<p>Les indices de chiffre d&rsquo;affaires et de volume des ventes dans le commerce sont publi&eacute;s 60 jours apr&egrave;s la fin du mois &eacute;tudi&eacute;. Pour le commerce de d&eacute;tail, une estimation pr&eacute;liminaire &agrave; 30 jours du volume des ventes est &eacute;galement publi&eacute;e.<br />Cette estimation est r&eacute;alis&eacute;e sur la base d&rsquo;&eacute;quations &eacute;conom&eacute;triques dont les principales variables explicatives sont&nbsp;:<br />- les r&eacute;sultats de l&rsquo;enqu&ecirc;te mensuelle de l&rsquo;Insee sur l&rsquo;activit&eacute; des grandes surfaces alimentaires ;<br />- les r&eacute;sultats de l&rsquo;enqu&ecirc;te mensuelle de conjoncture de la Banque de France correspondant &agrave; la grande distribution&nbsp;;<br />- les r&eacute;sultats de l&rsquo;enqu&ecirc;te mensuelle de conjoncture pour le commerce de d&eacute;tail de la Banque de France correspondant aux &eacute;quipements de la personne et aux produits alimentaires&nbsp;;<br />- l&rsquo;indice des prix &agrave; la consommation des carburants.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Two main sources are used to calculate sales volume indices:<br />- a tax source, the \"CA3\" form, which companies fill in for the value-added tax (VAT) every month (cf Methodology for Turnover indices). The tax authority (DGFIP) provides INSEE with VAT returns every month; <br />- price indices calculated by INSEE, as production price indices and consumer price indices.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1887/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les indices de volume des ventes dans le commerce sont diffus&eacute;s mensuellement au plus tard 60 jours apr&egrave;s le mois sous revue.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1887/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Calculation of indices in volume:</p>\n<p>The sales volume indices at a fine level are defined as the ratio of the turnover index in value to the associated price deflator. This is done for the 116 sub-classes in the retail sector. Once the indices at the finest level of nomenclature are calculated, the indices for higher levels are obtained by aggregating (cf infra). They are disseminated on the INSEE website from the class level. They are calculated since 2005, according to the availability of the prices.<br />In Retail trade and Trade and repair of motor vehicles and motorcycles, price indices used as deflators are obtained by aggregating the Consumer Price Indices (CPIs) of the products concerned. A cross-reference table is established between the sectors of the Naf rev 2 and the nomenclature of consumer function (Classification of Individual Consumption by Purpose &ndash; COICOP). The Consumer Price Index (CPI) is measured all taxes included, so it is necessary to correct the VAT rates to make it duty-free. <br />For sales volume indices in wholesale trade, different price indices are used according to the products: IPGA (Wholesale food price indices), IPAMPA (Monthly agricultural means of production purchasing price indices), IPPAP (Monthly agricultural producer price indinces), IPPI (French industry production price indices) and consumer price indices. The sectoral index is therefore a weighted average of the various indices representing the products making up the sales structure.</p>\n<p>Aggregation method, rebasing and reference chance to 2015:</p>\n<p>Sales volume indices are rebased every 5 years. From now on, they have reference year 2015, which means that they have for average 100 in 2015. Previously, indices had reference year 2010.<br />The 2015 rebasing implements an innovation, with the introduction of a two-weighting system (instead of a constant-weight system) in order to better take into account the structural evolutions. Until now, aggregation of elementary indices was done on the basis of constant weights representing the reference year &ndash; i.e. 2010 previously. From now on, 2010 weights are used for the aggregation of elementary indices between 1999 and 2012, whereas 2015 weights are used for the period after. The calculation on the whole period is then achieved by chaining both series (computation of a link coefficient on the year 2013). This change responds to a recommandation of Eurostat in order to increase the robustness of indices over a long period.<br />The estimation of annual weights is based primarily on output by industry at basic prices per branch calculated by the annual national accounts. By definition, output by industry at basic prices excludes taxes on products but includes subsidies on products. It does not include transport services. At the lower levels of the classification, weights are also based on INSEE&rsquo;s Esane device (structural business statistics).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/912> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>France enti&egrave;re (&agrave; l'exception de la Guyane et de Mayotte non assujettis &agrave; la TVA).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1887/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "month"@en , "mois"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.1>
                    <http://bauhaus/qualite/attribut/1887/S.18.1/texte> , <http://bauhaus/qualite/attribut/1887/S.18.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.3.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.9>
                    "<p>Year 2015</p>"@en , "<p>Ann&eacute;e 2015</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.18.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Series are seasonally adjusted &ndash; SA &ndash; and working-days adjusted &ndash; WDA. The computation is performed with the X13-Arima program available in JDemetra+ - supplied by Eurostat &ndash; at the NAF rev. 2 class level for the volume ratio (i.e. the turnover index in value/ price index). Upper SWDA levels are obtained by class level series aggregation (indirect SWDA correction).<br />The annual mean of SWDA indices may slightly differ from that of the unadjusted indices, mainly because it takes into account the variations from one year to the next of the annual composition in working days &ndash; presence of leap year, position in the week of the various bank holidays, etc.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1645> {
    <http://bauhaus/qualite/attribut/1645/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The scope includes the companies managing supermarkets, hypermarkets and/or multi-commerce stores.</p>\n<p>The survey covers the main activities defined by NAF rev. 2 codes: 47.11D, 47.11E and 47.11F.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1645/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1645/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Environ 7&nbsp;500 entreprises entrent dans le champ de l'enqu&ecirc;te (hypermarch&eacute;s, supermarch&eacute;s et magasins multi-commerces).</p>\n<p>L'&eacute;chantillon est d'environ 400 entreprises&nbsp;; il est exhaustif pour les entreprises ayant un chiffre d'affaires sup&eacute;rieur &agrave; 300&nbsp;millions d'euros TTC annuel. Dans les autres strates, un tirage coordonn&eacute; positivement avec les pr&eacute;c&eacute;dentes &eacute;ditions est mis en&nbsp;&oelig;uvre.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1645/I.18.10/text> , <http://bauhaus/qualite/attribut/1645/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e mensuellement par Internet &agrave; partir du Portail de R&eacute;ponse aux Enqu&ecirc;tes Entreprises : (http://entreprises.insee.fr/).</p>\n<p>La collecte se d&eacute;roule mensuellement par internet via le portail de r&eacute;ponse aux enqu&ecirc;tes &laquo; entreprise &raquo; de l&rsquo;Insee. L&rsquo;entreprise re&ccedil;oit par courrier ou par courriel un code d&rsquo;acc&egrave;s et un mot de passe afin de s&rsquo;identifier.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'ouverture de chaque campagne mensuelle a lieu quelques jours après la fin du mois d'affaires enquêté. Les entreprises ayant transmis une adresse électronique sont informées par courriel de l'ouverture de la campagne."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1645>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly survey of large-scale food retail activities 2014"@en , "Rapport qualité : Enquête mensuelle sur l'activité des grandes surfaces alimentaires 2014"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1177> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1645/S.3.4/texte> , <http://bauhaus/qualite/attribut/1645/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te r&eacute;pond &agrave; une forte demande d'analyse conjoncturelle, au niveau du secteur d'activit&eacute; comme au niveau macro-&eacute;conomique&nbsp;(pr&eacute;occupations exprim&eacute;es par les membres de la Commission des Comptes Commerciaux de la Nation - CCCN).<br /><br />L'enqu&ecirc;te permet &eacute;galement de prendre en compte les fr&eacute;quentes restructurations et l'&eacute;volution d&eacute;mographique du secteur ; le d&eacute;tail par famille de produits permet &eacute;galement de d&eacute;gager un&nbsp;diagnostic conjoncturel.<br /><br />Enfin, l'enqu&ecirc;te permet surtout de disposer d'un r&eacute;sultat plus rapide que la mobilisation des sources fiscales : &agrave; cet &eacute;gard, l'enqu&ecirc;te Emagsa est un maillon indispensable pour &eacute;tablir l'indice pr&eacute;coce &agrave; 30 jours du volume des ventes dans le commerce de d&eacute;tail qui est requis par le r&egrave;glement europ&eacute;en.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/330>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice  2014"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-03-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_emagsa_2014_v2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/330> .
    
    <http://bauhaus/qualite/attribut/1645/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey is conducted monthly by Internet : (http://entreprises.insee.fr/).</p>\n<p><br />Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The themes addressed are:<br /><br />- total turnover incl. VAT and breakdown per type of sale (supermarkets/hypermarkets);<br /><br />- breakdown of sales per product type: food, non-food, fuel;<br /><br />- any modifications to the stock of stores: openings, closures, modifications in floor area.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Les th&egrave;mes abord&eacute;s sont :<br /><br />- le chiffre d'affaires total TTC et sa ventilation par forme de vente (supermarch&eacute;s/hypermarch&eacute;s) ;<br /><br />- la r&eacute;partition des ventes par type de produits : alimentaires, non alimentaires, carburants ;<br /><br />- les modifications &eacute;ventuelles du parc de magasins : ouvertures, fermetures, modifications de surface.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1645/I.18.7/texte> , <http://bauhaus/qualite/attribut/1645/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "From 1997"@en , "à partir de 1997"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Approximately 7,500 companies are involved in the survey (hypermarkets, supermarkets and multi-commerce stores).</p>\n<p>The sample is about 400 companies; It is exhaustive for companies with a turnover of more than 300 million euros (inclusive of VAT). In the other strata, a draw coordinated positively with the previous editions is implemented.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1645/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le champ concerne les entreprises qui g&egrave;rent des supermarch&eacute;s, des hypermarch&eacute;s et/ou des magasins multi-commerces.</p>\n<p>L'enqu&ecirc;te couvre les activit&eacute;s principales d&eacute;finies par les codes NAF r&eacute;v. 2 : 47.11D, 47.11E et 47.11F.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1645/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey meets strong demand for outlook analysis at both sector and macro-economic level alike (preoccupations expressed by the members of the Commission for the Commercial Accounts of the Nation - CCCN).<br /><br />The survey also takes into account the frequent restructuring and demographic changes in the sector; The breakdown by family of&nbsp;products also makes it possible to establish a cyclical diagnosis.<br /><br />Finally, the survey provides a quicker result than the mobilization of tax sources: in this respect, the Emagsa survey is an indispensable link in establishing the early index at 30 days of the volume of sales in commerce Which is required by the European&nbsp;Regulation. </p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The opening of each monthly campaign takes place just days after the end of retail month investigated. Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1645/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1645/S.19/texte> , <http://bauhaus/qualite/attribut/1645/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1645/S.18.3/texte> , <http://bauhaus/qualite/attribut/1645/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
    
    <http://bauhaus/qualite/attribut/1645/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1645/S.3.6/texte> , <http://bauhaus/qualite/attribut/1645/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1645> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1524> {
    <http://bauhaus/qualite/attribut/1524/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>La collecte est r&eacute;alis&eacute;e chaque ann&eacute;e par voie postale.</p>\n<p>L'enqu&ecirc;te couvre la France m&eacute;tropolitaine.<br /><br />Les entreprises des d&eacute;partements d'outre-mer (DOM) sont interrog&eacute;es par ailleurs,&nbsp;dans le cadre d'un syst&egrave;me d'enqu&ecirc;tes annuelles d'entreprise sp&eacute;cifique &agrave; ces d&eacute;partements.</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1524/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Pour les secteurs de la communication, de la publicité et des médias, l'enquête est réalisée avec le concours du service statistique de la Direction du développement des médias (DDM)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1524/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1524/I.18.10/texte> , <http://bauhaus/qualite/attribut/1524/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1524/S.3.4/text> , <http://bauhaus/qualite/attribut/1524/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey provides information about the situation of the company (main declared activity, legal category, structural modifications), employment (including part-time and self-employed), profit and loss, investments and transfers, turnover and activities (breakdown of turnover by product, capitalised production costs, distribution of clientele, imports and exports), professional expenditure, and other information for certain sectors.<br /><br />Each questionnaire is customised and printed individually for the company it is destined for.<br /><br />The elements already available in the SIRENE register, or known from the answers to the previous survey, or coming from other sources (e.g. legal category, restructuration, list of establishments, activity code), are preprinted directly on the questionnaire.<br /><br />Additionally, each company is only asked questions relating to its activity with a well-defined questionnaire in terms of&nbsp;data on employment, product lines, individual expenditure, etc.</p>\n<p>&nbsp;</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1524/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/531> .
    
    <http://bauhaus/qualite/attribut/1524/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te par sondage est exhaustive pour les grandes entreprises, c'est-&agrave;-dire en r&egrave;gle g&eacute;n&eacute;rale pour celles employant au moins 30 salari&eacute;s ou r&eacute;alisant au moins 5 millions d'euros de chiffre d'affaires annuel.<br /><br />Au total, 42&nbsp;000 entreprises ont &eacute;t&eacute; interrog&eacute;es dans l'EAE 2007. L'&eacute;chantillon est optimis&eacute; au niveau national.<br /><br />Les petites entreprises sont interrog&eacute;es par alternance une ann&eacute;e sur deux.<br /><br />Ainsi, les petites entreprises (moins de 30 salari&eacute;s ou moins de 5 millions d'euros de chiffre d'affaires annuel) du secteur des services aux entreprises sont enqu&ecirc;t&eacute;es sur les ann&eacute;es d'exercice impair (par exemple en 2008 sur 2007) et les petites entreprises des services aux particuliers et de l'immobilier sur les ann&eacute;es d'exercice pair (par exemple en 2007 sur 2006).</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1524/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1524/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1524/S.19/text> , <http://bauhaus/qualite/attribut/1524/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The sample survey is exhaustive for large companies, that is, those employing at least 30 people or making annual turnover of at least 5 million euros.<br /><br />All in all, 42,000 businesses were surveyed in EAE 2007. The sample is optimised at national level.<br /><br />Small enterprises are surveyed every alternate year.<br /><br />Small businesses (less than 30 employees or making annual turnover of&nbsp;less than 5 million euros) in the B2B services sector are surveyed for odd trading years (e.g. in 2008 for 2007) and small B2C and real-estate companies for even years (e.g. in 2007 for 2006).</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1524/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2010-04-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Data collection is by post each year.</p>\n<p>The survey covers Metropolitan France.<br /><br />The companies in overseas departments (DOM) are surveyed elsewhere, as part of a system of annual business surveys specific to these departments.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1524/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te donne des informations sur la situation de l'entreprise (activit&eacute; principale d&eacute;clar&eacute;e, cat&eacute;gorie juridique, modifications de structure), l'emploi (y compris &agrave; temps partiel ou non salari&eacute;), le compte de r&eacute;sultat, les investissements et cessions,&nbsp;le chiffre d'affaires et activit&eacute;s (ventilation du chiffre d'affaires par produit, production immobilis&eacute;e, r&eacute;partition de la client&egrave;le, importations et exportations), les d&eacute;penses professionnelles, voire pour certains secteurs quelques informations compl&eacute;mentaires.<br /><br />Chaque questionnaire est compos&eacute; sur mesure et imprim&eacute; individuellement pour l'entreprise &agrave; laquelle il est destin&eacute;.<br /><br />Les &eacute;l&eacute;ments d&eacute;j&agrave; disponibles dans le r&eacute;pertoire Sirene ou connus sur la base des r&eacute;ponses &agrave; l'enqu&ecirc;te pr&eacute;c&eacute;dente ou provenant d'autres sources (par exemple : la cat&eacute;gorie juridique, les restructurations, la liste des &eacute;tablissements et leur code activit&eacute;)&nbsp;sont pr&eacute;-imprim&eacute;s directement sur le questionnaire.<br /><br />De plus, on ne pose &agrave; chaque entreprise que les questions en rapport avec son activit&eacute; avec un type de questionnaire bien d&eacute;fini en termes de donn&eacute;es d'emploi, de gammes de produits, de d&eacute;penses professionnelles particuli&egrave;res...</p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1524/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/rapport/1524>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête annuelle d'entreprise dans les services"@fr , "Quality report: Annual survey on service companies"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1187> .
    
    <http://bauhaus/qualite/attribut/1524/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1524/S.18.3/text> , <http://bauhaus/qualite/attribut/1524/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/qualite/attribut/1524/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1524> .
    
    <http://bauhaus/documents/document/531>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête EAE Services"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2009-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/methodologie_EAES.pdf> .
    
    <http://bauhaus/qualite/attribut/1524/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "For the communication, advertising and media sector, the survey is carried out with the help of the statistics department of the Media Development Department (DDM)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1536> {
    <http://bauhaus/qualite/attribut/1536/S.1.4>
