    <http://bauhaus/qualite/attribut/1944/S.8.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Le calendrier de diffusion est accessible sous&nbsp;: <a href=\"https://www.insee.fr/fr/information/1405540?debut=0\">https://www.insee.fr/fr/information/1405540?debut=0</a></p>"@fr ;
