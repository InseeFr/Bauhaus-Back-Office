            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaire_hotel2015_Reunion.pdf> .
    
    <http://bauhaus/qualite/attribut/1813/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1813/S.19/text> , <http://bauhaus/qualite/attribut/1813/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre les activités définies par les codes NAF rév. 2 : 55.10Z (hôtels et hébergement similaire).\n\nL'enquête concerne les hôtels à vocation touristique, qu'ils soient classés ou non."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1813/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
