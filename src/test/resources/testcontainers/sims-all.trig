    <http://bauhaus/qualite/attribut/1932/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Head of the division</p>"@en , "<p>Chef de division</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1932> .
    
    <http://bauhaus/qualite/attribut/1932/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2019-07-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1932> .
    
    <http://bauhaus/qualite/attribut/1932/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The survey on government employees collects, on its field of interest, the individual characteristics of employees relating to:<br />- the training level;<br />- the career path before and after entering the civil service;<br />- the actual working time, taking account of days off of various types and other days not worked;<br />- the family situation, the household income and information on origins.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1932/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1932> .
    
    <http://bauhaus/qualite/attribut/1932/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
