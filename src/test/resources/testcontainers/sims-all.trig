    <http://bauhaus/qualite/attribut/1591/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/424> .
    
    <http://bauhaus/documents/document/428>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Réponses individuelles aux enquêtes de conjoncture et prévision de la production manufacturière"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/resp_indiv_enq_conj_prodmanufacturiere2005.pdf> .
    
    <http://bauhaus/qualite/attribut/1591/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>L'enqu&ecirc;te couvre l'industrie manufacturi&egrave;re et les industries extractives ; divisions 08 &agrave; 33 de la NAF R&eacute;v. 2 (hors 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z).<br />Entreprise industrielle </p>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1591/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>Until 2007, the survey was carried out each month except in August. Since 2008 it has been carried out every month.</p>\n<p>Data collection is by post and online over a period stretching from the end of the month prior to the month of the survey to the date of publication of the survey, i.e. 4 working days before the end of the current month.</p>\n<p>The results of the survey are sent to the European Commission 4 working days before the end of the month.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1591/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1591/I.18.10/texte> , <http://bauhaus/qualite/attribut/1591/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1591> .
    
    <http://bauhaus/qualite/attribut/1591/I.18.9>
