    <http://bauhaus/qualite/attribut/1653/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1653/I.18.7/text> , <http://bauhaus/qualite/attribut/1653/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1653/I.18.12/text> , <http://bauhaus/qualite/attribut/1653/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p>The main topics studied through the survey are:<br />- characteristics of the resources of young adults aged 18 to 24 years : nature, frequency and amount;<br />- inventory of the aid received and provided by the parents of the young adult (and optionally by other households or individuals);<br />- the resources needed for young adults to become self-sufficient;<br />- the weight of support for young adults in the budget of parents;<br />- the relationship between young adults and their parents.</p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
