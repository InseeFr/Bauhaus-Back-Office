<http://rdf.insee.fr/graphes/qualite/rapport/1887> {
    <http://bauhaus/qualite/attribut/1887/S.8.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Sales volume indices in trade are monthly disseminated at the latest 60 days after the month under review."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1887/S.1.4>
