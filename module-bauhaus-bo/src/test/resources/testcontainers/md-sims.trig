    <http://bauhaus/qualite/rapport/1668>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on aerospace and space sector of the large Southwest region 2015"@en , "Rapport qualité : Enquête sur la filière aéronautique et spatiale dans le grand Sud-Ouest 2015"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1425> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Conventional perimeter of the aerospace industry is defined by the aeronautics and space industry's \"core\" units (3030Z, 5122Z), by the \"partial\" sectors units (2051Z, 2562B, 2651A, 3316Z), and the \"potential\" areas units (40 classes of activity NAF)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection takes from April to June of the given year."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1668/S.3.4/text> , <http://bauhaus/qualite/attribut/1668/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1668/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte se déroule d'avril à juin de l'année."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1668/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte se déroule par voie postale, avec possibilité de répondre au moyen d’un questionnaire par mail, courrier ou fax, d’avril à juin de l’année.  \nLe questionnaire est différent selon que l’entreprise est mono-régionale mono-établissement, mono-régionale multi-établissement ou multirégionale.  \nLa zone géographique de référence est le grand Sud-Ouest (départements 09, 12, 24, 31, 32, 33, 40, 46, 47, 64, 65, 81, 82)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1668> .
    
    <http://bauhaus/qualite/attribut/1668/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est exhaustive sur le champ du « noyau » de la filière AS (3030Z, 5122Z), des unités des secteurs « partiel » (2051Z, 2562B, 2651A, 3316Z), des unités de plus de 20 salariés appartenant aux secteurs « potentiel » (40 classes d'activités NAF). L'enquête interroge par sondage les unités de moins de 20 salariés appartenant au secteurs « potentiel ». Des unités spécifiques connues comme appartenant à priori à la filière sont également interrogées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1898> {
    <http://bauhaus/qualite/rapport/1898>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Outdoor accommodation occupancy survey 2017"@en , "Rapport qualité : Enquête de fréquentation dans l'hôtellerie de plein air 2017"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1456> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/952> , <http://bauhaus/documents/document/953> .
    
    <http://bauhaus/qualite/attribut/1898/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée d’avril à septembre par voie postale ou par internet, ainsi qu'une collecte centralisée auprès de certaines enseignes."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers the activities defined by the NAF rev. 2 code: 55.30Z (campsites and areas for caravans or leisure vehicles). Only residentials campsites are not surveyed.  \n\nType of unit surveyed : campsite, classified from 1 to 5 stars or non-classified site offering at least one short-stay pitch."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1898/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1898/S.3.4/text> , <http://bauhaus/qualite/attribut/1898/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1898/S.19/texte> , <http://bauhaus/qualite/attribut/1898/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017M031EC"@fr , "2017M031EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>A compter de la saison 2013, l&rsquo;enqu&ecirc;te n&rsquo;est plus exhaustive : elle est r&eacute;alis&eacute;e aupr&egrave;s d&rsquo;un &eacute;chantillon de 6 000 campings sur 8 000.</p>"@fr , "<p>From the 2013 season, the survey is no longer exhaustive: it is carried out with a sample of 6,000 campsites from 8,000.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Un emplacement, considéré comme locatif, dispose d'un équipement d'hébergement de type bungalow, bungatoile, mobil-home, habitation légère de loisir (HLL)…\n\nLes éventuels emplacements prévus pour le stationnement des camping-cars sont considérés comme des emplacements nus."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Comité de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry : DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D).   \nThe needs of local partners are taken into account through partnership agreements with the tourism sites of Insee."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2018-07-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1898/I.18.10/texte> , <http://bauhaus/qualite/attribut/1898/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is carried out from April to September by post or by internet, and centralized collection at some enterprises."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1898/S.18.3/text> , <http://bauhaus/qualite/attribut/1898/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey concerns the occupancy in the five summer months, from May to September: the stock is measured on 30 November of each year.It covers the following topics:  \n- Characteristics of the site  \n- Opening period  \n- Accommodation capacity (bare pitches and pitches with rental accommodation)  \n- Occupancy of pitches (bare and with rental accommodation)  \n- Monthly occupancy (in terms of the numbers of arrivals and nights) according to the type of pitch (bare and with rental accommodation) and the customers' normal country of residence."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Cette enquête porte sur la fréquentation des cinq mois d'été, de mai à septembre : le parc est mesuré chaque année au 30 novembre.  \nElle aborde les thèmes suivants :  \n- caractéristiques du terrain ;  \n- période d'ouverture ;  \n- capacité d'accueil (emplacements nus et emplacements locatifs) ;  \n- occupation des emplacements (nus et locatifs) ;  \n- fréquentation mensuelle (en termes de nombre d'arrivées et de nuitées) selon le type d'emplacements (nus et locatifs) et le pays de résidence habituelle des clients."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "A pitch that is considered to have rental accommodation is equipped with a bungalow, \"Bungatent\", mobile home, leisure home, etc.\n\nAny pitches that may be reserved for campervans are considered to be bare pitches."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1898/S.12.1/text> , <http://bauhaus/qualite/attribut/1898/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre les activités définies par le code NAF rév. 2 : 55.30Z (terrains de camping et parcs pour caravanes ou véhicules de loisirs). Sont exclus les campings à vocation exclusivement résidentielle.\n\nType d'unité enquêtée : terrain de camping, classé de 1 à 5 étoiles ou terrain non classé offrant au moins un emplacement de passage."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/documents/document/953>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête de fréquentation dans l'hôtellerie de plein air 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_camping_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1898/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1898/S.3.6/texte> , <http://bauhaus/qualite/attribut/1898/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le Comité de Coordination des Statistiques du Tourisme (CCST), animé par l'Insee, intègre les principaux acteurs nationaux du tourisme : DGE, Atout France, fédérations professionnelles des hôteliers et représentants des comités départementaux et régionaux du tourisme (FNCRT, RN2D).   \nLes besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage est le fichier des campings offrant au moins un emplacement de passage géré par l'Insee.   \nDans dix régions de petite taille, l'enquête est exhaustive. Pour les autres régions, les critères de stratification de l'échantillon sont :  \n- l'axe géographique (espaces touristiques nationaux (ETN)  \n- la catégorie de camping (1 à 5 étoiles, non classé)  \n- la taille en nombre d'emplacements  \nA l'intérieur des strates le tirage est aléatoire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1898/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sampling frame is the file of campsites offering at least one passage site managed by INSEE.  \nIn ten small areas, the survey is comprehensive. For the other regions, the stratification criteria of the sample are:  \n- the geographical focus (national tourist areas (ETNs)  \n- camping category (1 to 5 stars, unclassified)  \n- size in number of locations  \nInside the strata the draw is random."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1898/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/qualite/attribut/1898/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1898> .
    
    <http://bauhaus/documents/document/952>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice relative à l'enquête de fréquentation dans l'hôtellerie de plein air 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_explicative_camping_2017.pdf> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1656> {
    <http://bauhaus/qualite/attribut/1656/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-06-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1656> .
    
    <http://bauhaus/qualite/attribut/1656/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
