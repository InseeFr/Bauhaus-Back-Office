    <http://bauhaus/documents/document/912>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Sales volume index base 2015"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-03-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/IVVC_methodo_20180330_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1887/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "VAT declarations of some companies may not be available when the indices are first published. This leads to revise raw indices or prices and SWDA indices when these declarations or prices are finally available.  \nModels used to correct seasonal and calendar effects are updated annually. Between two model updates, SWDA coefficients are updated monthly in order to take into account the most recent data – this includes raw data rectifications related to the previous months. At each publication, all SWDA indices disseminated on the INSEE website are updated from 2005.\n\nSales volume indices on retail trade and wholesale trade are monthly disseminated at the latest 60 days after the month under review. For retail trade, an early estimate of sales volume is also published within 30 days.  \nThis estimate is based on econometric equations for which the main explanatory variables are currently:  \n- results of the monthly INSEE survey on the activity of large-scale food retailing;  \n- results of Bank of France monthly survey in retail trade;  \n- results of the monthly survey of retail trade by the Bank of France household equipments and food products;  \n- household consumer price index for fuels."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1887/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1887/S.3.6/text> , <http://bauhaus/qualite/attribut/1887/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1887/S.14.1/texte> , <http://bauhaus/qualite/attribut/1887/S.14.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1887> .
    
    <http://bauhaus/qualite/attribut/1887/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sales volume indices are calculated according to the nomenclature NAF rev. 2, which came into force on 1 January 2008.  \nThey cover the following sectors:  \nTrade and repair of motor vehicles and motorcycles (Division 45);  \nWholesale trade, except for motor vehicles and motorcycles (Division 46);  \nRetail trade, except motor vehicles and motorcycles (Division 47).  \n\nTrade volume indices are constructed from a tax source, the \"CA3\" form, which must be completed by enterprises for the payment of value added tax (VAT) every month. These indexes cover “whole France” including overseas departments (excepted French Guyana and Mayotte, which are not liable for VAT). Price indices calculated by INSEE, mainly for “whole France” (including Overseas Departments) are used as deflators for indices in value."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1887/S.14.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 days"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/911>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indice de volume des ventes dans le commerce (base 2015) "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-03-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
