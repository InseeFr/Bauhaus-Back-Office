                    <http://bauhaus/qualite/rapport/1637> .
    
    <http://bauhaus/qualite/attribut/1637/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "In addition to the amount of financial lease contracts, questions concern the breakdown of contracts according to the sectors of activity of client enterprises, their location and the nature of the goods (movable or real-estate) acquired by this financing."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
