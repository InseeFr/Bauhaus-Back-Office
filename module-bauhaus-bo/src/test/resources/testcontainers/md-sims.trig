}

<http://rdf.insee.fr/graphes/qualite/rapport/1655> {
    <http://bauhaus/qualite/attribut/1655/S.13.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Errors that do not result from sampling are mainly due to total and partial non-response. Measures to reduce these errors include follow-up and controls during collection and the inclusion of non-response in adjustments."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
