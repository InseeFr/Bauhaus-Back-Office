    <http://bauhaus/qualite/attribut/1793/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Agriculture"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1793/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les indices de prix peuvent être révisés lors des mois qui suivent leur première publication. Les révisions résultent le plus souvent du remplacement d’un prix manquant par un prix collecté. Les prix manquants font l’objet d’une imputation."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1793/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
