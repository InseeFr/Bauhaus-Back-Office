                    <http://bauhaus/qualite/attribut/1592/S.18.3/texte> , <http://bauhaus/qualite/attribut/1592/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1592> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
