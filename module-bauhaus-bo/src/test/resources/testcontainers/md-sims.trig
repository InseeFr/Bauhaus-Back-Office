    <http://bauhaus/qualite/attribut/1815/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1815/S.12.1/texte> , <http://bauhaus/qualite/attribut/1815/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le Comité de Coordination des Statistiques du Tourisme (CCST), animé par l'Insee, intègre les principaux acteurs nationaux du tourisme : DGE, Atout France, fédérations professionnelles des hôteliers et représentants des comités départementaux et régionaux du tourisme (FNCRT, RN2D). \nLes besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1815/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage est le fichier des hôtels de tourisme géré par l'Insee.\n\nLes critères de stratification de l'échantillon national sont :\n\n- l'axe géographique (régions, espaces touristiques nationaux (ETN)) - la catégorie d'hôtel (1 à 5 étoiles ou non classé)\n\n- le type d'hôtel (chaîne ou indépendant) Au sein des strates, le tirage est aléatoire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Hotel stock is measured every year on 31 December and occupancy is measured every month.\n\nThe main topics considered are:\n\n- characteristics of the establishment;\n\n- accommodation capacity;\n\n- daily room occupancy;\n\n- arrivals and nights spent by country of residence of tourists;\n\n- average length of stay;\n\n- proportion of business tourism."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1924> {
    <http://bauhaus/qualite/attribut/1924/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>L&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e chaque mois, de janvier &agrave; d&eacute;cembre pour les 3 types d&rsquo;&eacute;tablissements. <br />Cependant, pour les campings, seuls les r&eacute;sultats des mois d&rsquo;avril &agrave; septembre sont diffus&eacute;s en 2019.</p>"@fr , "<p>The survey is conducted every month, from January to December for the 3 types of establishments.<br />However, for campings, only the results from April to September are broadcast in 2019.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
                    <http://bauhaus/qualite/attribut/1924/S.8.1/texte> , <http://bauhaus/qualite/attribut/1924/S.8.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/documents/document/1068>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire France métropolitaine de l'enquête de fréquentation dans les hôtels et AHCT 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questio_HTL_AHCT_METRO_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Deux statuts de diffusion : données provisoires et définitives   \n- diffusion des données provisoires : en début de mois M+2 pour le mois M  \n- diffusion des données définitives : en fin de mois M+3 pour le mois M"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1924/S.7.1/text> , <http://bauhaus/qualite/attribut/1924/S.7.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte se fait en début de mois M+1 pour les données du mois M."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1924/I.18.12/text> , <http://bauhaus/qualite/attribut/1924/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Coordinating Committee for Tourism Statistics (CCST), led by Insee, integrates the main national tourism stakeholders: Directorate General for Enterprise (DGE) - Minister for the Economy and Finance , Atout France, professional federations of hoteliers and representatives of departmental and regional tourism committees (FNCRT, RN2D) .  \nThe needs of local partners are taken into account in partnership agreements with Insee tourism sites."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1924/S.18.3/text> , <http://bauhaus/qualite/attribut/1924/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1924/S.3.1/texte> , <http://bauhaus/qualite/attribut/1924/S.3.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/documents/document/1067>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête de fréquentation dans les campings 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questio_CPG_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Month elapsed</p>"@en , "<p>Mois &eacute;coul&eacute;</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1924/S.19/text> , <http://bauhaus/qualite/attribut/1924/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.7.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Aucun résultat n'est publié s'il concerne moins de trois entreprises, ni aucune donnée pour laquelle une seule entreprise représente 85% ou plus de la valeur obtenue."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>Pour les h&ocirc;tels&nbsp;: l&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon national d'environ 12&nbsp;000 h&ocirc;tels sur un total de 18&nbsp;000.<br />Pour les campings&nbsp;: l&rsquo;enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d&rsquo;un &eacute;chantillon de 6&nbsp;000 campings sur 8&nbsp;000.<br />Pour les AHCT&nbsp;: l'enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon d'environ 2&nbsp;500 &eacute;tablissements sur un total de 3&nbsp;500.</p>"@fr , "<p>Hotels: survey is conducted with a national sample of approximately 12,000 hotels out of a total of 18,000.<br />Campsites: survey is conducted with a sample of 6,000 campsites out of 8,000.<br />AHCT: survey is conducted with a sample of approximately 2,500 establishments out of a total of 3,500.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête de fréquentation dans les autres hébergements collectifs touristiques complète les informations concernant la fréquentation touristique déjà produites par :  \n- les enquêtes de fréquentation dans l'hôtellerie de tourisme ;  \n- les enquêtes de fréquentation dans l'hôtellerie de plein air.  \nCette enquête rentre dans le cadre du réglement européen n°692/2011 concernant la production d'informations statistiques sur le tourisme à Eurostat.  \nElle répond également aux besoins nationaux de la Direction Générale des Entreprises (DGE) et locaux pour les acteurs et décideurs régionaux du tourisme.  \nLe dispositif comporte deux extensions régionales dans les deux régions où existaient déjà cette enquête (Rhône-Alpes, Languedoc-Roussillon).  \nDans les DOM, les autres hébergements collectifs sont enquêtés dans l'enquête de fréquentation hôtelière."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le questionnaire envoyé aux campings est différent de celui envoyé aux hôtels et autres hébergements collectifs de tourisme : il permet de rendre compte de la nature des emplacements occupés (emplacements nus ou emplacements équipés)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1066> , <http://bauhaus/documents/document/1069> , <http://bauhaus/documents/document/1068> , <http://bauhaus/documents/document/1067> .
    
    <http://bauhaus/documents/document/1066>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice relative à l'enquête de fréquentation dans les hébergements collectifs de tourisme 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_explicative_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le Comité de Coordination des Statistiques du Tourisme (CCST), animé par l'Insee, intègre les principaux acteurs nationaux du tourisme : la Direction Générale des Entreprises – Ministère de l'Economie et des Finances (DGE), Atout France, les fédérations professionnelles des hôteliers et représentants des comités départementaux et régionaux du tourisme (FNCRT, RN2D).   \nLes besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The occupancy survey in other collective tourist accommodation supplements the tourist occupancy information already produced by:  \n- Occupancy surveys of tourist hotels  \n- Occupancy surveys of campsites  \nThis survey relates to European reglement n°692/2011 concerning the production of statistical information on tourism at EUROSTAT.  \nIt also meets the French national needs of the Enterprise Directorate General  and the local needs of regional tourism stakeholders and decision makers.  \nThe scheme includes two regional extensions in the two regions already covered by this survey (Rhône-Alpes, Languedoc-Roussillon).  \nIn the overseas departments, other collective tourist accomodation are in the hotel occupancy survey."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Une « Informations rapides » est publiée chaque trimestre.  \nUn bilan de saison d’été est publié en décembre.  \nUn bilan de saison d’hiver est publié en juin.  \nUn bilan annuel est publié en avril."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The main topics are:  \n- characteristics of the establishment;  \n- reception capacities;  \n- daily occupancy of rooms;  \n- Arrivals and overnight stays according to the country of residence of the tourists;  \n- duration of stay;  \n- proportion of business tourism.  \nThe park is measured on December 31 of each year and the attendance on each month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1924/I.18.10/texte> , <http://bauhaus/qualite/attribut/1924/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Statistics requested relate to customer stays."@en , "Les statistiques demandées concernent les séjours de la clientèle."@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2019M018EC"@fr , "2019M018EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Pour les hôtels, l'enquête couvre les activités définies par les codes de la nomenclature d’activité française (NAF rév. 2) suivants : 55.10Z (hôtels et hébergement similaire), c’est à dire les hôtels à vocation touristique, qu'ils soient classés ou non.\n\nPour les campings, l'enquête couvre les activités définies par le code NAF rév. 2 : 55.30Z (terrains de camping et parcs pour caravanes ou véhicules de loisirs). Sont exclus les campings à vocation exclusivement résidentielle.\n\nPour les autres hébergements collectifs de tourisme (AHCT), les unités enquêtées sont les hébergements collectifs touristiques faisant l'objet d'une réglementation : auberges de jeunesse, centres internationaux de séjour, centres sportifs, résidences de tourisme et résidences hôtelières, maisons familiales de vacances et villages de vacances.\n\nL'unité économique interrogée est l'exploitant de l'hébergement (NAF rév. 2 : codes 55.10Z et 55.20Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection is done at the beginning of month M + 1 for the data of month M."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Hotels: the sampling frame is the index of tourism hotels, index managed by Insee.  \nThe stratification criteria of the national sample are:  \n- the geographical axis (regions, national tourist areas (ETN));  \n- hotel category (1 to 5 stars or unclassified);  \n- the type of hotel (chain or independent).  \nWithin the strata, the draw is random.\n\nCampings: the sampling frame is the file of establishments offering at least one location, file managed by Insee.  \nIn small regions, the survey is comprehensive. For other regions, the stratification criteria of the sample are:  \n- the geographical axis (national tourist areas (ETN));  \n- the category of camping (1 to 5 stars, not classified);  \n- the size in number of locations.  \nInside the strata, the draw is random.\n\nOther collective tourist accommodations: the sampling frame is the file of other collective accommodation, file managed by Insee. The stratification criteria of the national sample are:  \n- the geographical axis (regions, national tourist areas (ETN));  \n- the type of establishment.  \nWithin the strata, the draw is random."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "No results are published if it concerns less than three companies, or no data for which a single company represents 85% or more of the value obtained."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1924/S.10.2/text> , <http://bauhaus/qualite/attribut/1924/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "For hotels, the survey covers the activities defined by the French classification of activities (NAF rev. 2): 55.10Z codes (hotels and similar accommodation), i.e. tourist-oriented hotels, whether classified or not.\n\nFor campings, the survey covers activities defined by NAF rev. 2: 55.30Z (campsites and parks for caravans or recreational vehicles). Outdoor accommodations exclusively for residential use are excluded.\n\nFor other collective tourist accommodations, the units surveyed are collective tourist accommodation subject to regulation: youth hostels, international centers of stay, sports centers, tourist residences and residential hotels, family holiday homes and holiday villages.\n\nThe economic unit questioned is the operator of the accommodation (NAF rev. 2: 55.10Z and 55.20Z)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1924/S.14.1/text> , <http://bauhaus/qualite/attribut/1924/S.14.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1924/I.18.7/text> , <http://bauhaus/qualite/attribut/1924/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Pour les hôtels : la base de sondage est le fichier des hôtels de tourisme géré par l'Insee.  \nLes critères de stratification de l'échantillon national sont :  \n- l'axe géographique (régions, espaces touristiques nationaux (ETN)) ;  \n- la catégorie d'hôtel (1 à 5 étoiles ou non classé) ;  \n- le type d'hôtel (chaîne ou indépendant).  \nAu sein des strates, le tirage est aléatoire.\n\nPour les campings : la base de sondage est le fichier des campings offrant au moins un emplacement de passage géré par l'Insee.   \nDans les régions de petite taille, l'enquête est exhaustive. Pour les autres régions, les critères de stratification de l'échantillon sont :  \n- l'axe géographique (espaces touristiques nationaux (ETN)) ;  \n- la catégorie de camping (1 à 5 étoiles, non classé) ;  \n- la taille en nombre d'emplacements.  \nA l'intérieur des strates, le tirage est aléatoire.\n\nPour les AHCT : la base de sondage est le fichier des autres hébergements collectifs, fichier géré par l'Insee. Les critères de stratification de l'échantillon national sont :  \n- l'axe géographique (régions, espaces touristiques nationaux (ETN)) ;  \n- le type d'établissement.  \nAu sein des strates, le tirage est aléatoire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1924/S.12.1/text> , <http://bauhaus/qualite/attribut/1924/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The questionnaire sent to campings is different from that sent to hotels and other collective tourist accommodation, it allows to report the nature of the occupied sites (bare pitches or equipped pitches)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les résultats relatifs au mois M sont publiés en deux temps :  \n- résultats provisoires : délai de 30 à 35 jours ;  \n- résultats définitifs : délai d’environ 60 jours."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.8.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Two dissemination statuses: provisional and final data  \n- Provisional data dissemination: at the beginning of the month M+2 for the month M  \n- dissemination of definitive data: at the end of the month M+3 for the month M"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.14.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The results for month M are published in two stages:  \n- provisional results: delay from 30 to 35 days;  \n- final results: about 60 days."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1924>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly attendance survey in collective tourist accommodation 2019"@en , "Rapport qualité : Enquête mensuelle de fréquentation dans les hébergements collectifs de tourisme 2019"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1480> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les principaux thèmes abordés sont :  \n- les caractéristiques de l’établissement ;  \n- les capacités d’accueil ;  \n- l’occupation quotidienne des chambres ou emplacements ;  \n- les arrivées et nuitées selon le pays de résidence des touristes ;  \n- la durée de séjour ;  \n- la proportion de tourisme d’affaires.  \nLe parc est mesuré au 31 décembre de chaque année et la fréquentation sur chaque mois."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Envoi d’un courrier postal et/ou envoi d’un mail.\n\nUnités de mesure : nombre d’arrivées et nombre de nuitées\n\nZone géographique de référence :  \n- pour les hôtels : France   \n- pour les campings et les AHCT : France métropolitaine"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1924/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Sending a mail and / or sending an email.\n\nUnits of measurement: number of arrivals and number of nights\n\nReference geographical area:  \n- For hotels: France   \n- For campings and other collective tourist accommodations: Metropolitan France"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1924/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1924/S.3.3/text> , <http://bauhaus/qualite/attribut/1924/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/documents/document/1069>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire DOM de l'enquête de fréquentation dans l'hôtellerie 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questio_HTL_DOM_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1924/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2019-03-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1924> .
    
    <http://bauhaus/qualite/attribut/1924/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "An \"Information rapide\" published quarterly.  \nA summer season report published in December.  \nA winter season report published in June.  \nAn annual report published in April."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

