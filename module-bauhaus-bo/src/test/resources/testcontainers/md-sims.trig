            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/347> .
    
    <http://bauhaus/qualite/attribut/1639/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Since 2012, the sampling frame is the Sirus directory (directory of statistical units).\n\nThe sampling method: stratification by sector of activity and by local unit size.\n\nThe survey is more exhaustive for establishments of 250 or more employees."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/S.2.3>
