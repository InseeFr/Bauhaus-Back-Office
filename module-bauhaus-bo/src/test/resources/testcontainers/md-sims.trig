                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1865> .
    
    <http://bauhaus/qualite/attribut/1865/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Establishments belong to sections B and C (division 05 to 33), to group 383 (recovery),  \nexcluding: subclasses 1013B, 1071B, 1071C, 1071D (commercial crafts), 2013A and 2446Z;  \nexcluding divisions 05, 06 and 19;  \nexcluding group 091."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1865/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
