    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1569/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers the retail trade and automobile trading and repairs, excluding local food and specialised retailers, retail sales of flowers and pets, retail trade in used goods and out-of-store retail trade (except for the mail-order sector which is included in the scope of the survey).\n\nMore precisely, the survey covers the sectors defined in the following NAF Rev. 2 codes: division 45, 47.1 (except 47.11A, 47.11B, 47.11C), 47.3, 47.4, 47.5, 47.6, 47.7 (except 47.76Z), 47.91A, 47.91B."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1569/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/62> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1569/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1569> .
    
    <http://bauhaus/qualite/attribut/1569/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1569/S.3.6/text> , <http://bauhaus/qualite/attribut/1569/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1569> .
    
    <http://bauhaus/qualite/attribut/1569/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1569/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1569> .
    
    <http://bauhaus/qualite/attribut/1569/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête mensuelle de conjoncture dans le commerce de détail et le commerce et la réparation automobiles fait partie du système européen harmonisé des enquêtes de conjoncture de la Commission européenne, auquel contribuent les vingt-sept États membres de l'Union européenne.  \n\nÀ ce titre, les questionnaires, les nomenclatures et les méthodes de traitement sont largement harmonisés dans les instituts nationaux des pays adhérant à ce système.  \n\nLa formulation des questions est conçue de manière à faciliter une réponse rapide (la plupart des questions sont qualitatives à trois modalités exprimées sous la forme \"hausse, baisse, stable\", ou \"supérieur à la normale, normal, inférieur à la normale\")."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1569/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1569> .
    
    <http://bauhaus/qualite/attribut/1569/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1569/S.18.3/texte> , <http://bauhaus/qualite/attribut/1569/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1569> .
    
    <http://bauhaus/qualite/attribut/1569/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1569/I.18.10/text> , <http://bauhaus/qualite/attribut/1569/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1569> .
    
    <http://bauhaus/qualite/attribut/1569/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête par sondage auprès de 3 750 entreprises.\n\nToutes les entreprises de plus de 100 salariés sont interrogées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1980> {
    <http://bauhaus/documents/document/1269>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice 2020 de l'enquête européenne sur l'activité des filiales étrangers des groupes français / OFATS"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0010-07-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/notice_OFATS_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>2009-2018</p>"@fr , "<p>2009-2018</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ est l'ensemble des groupes dont le principal centre de décision (UCI) est en France et contrôlant au moins une société implantée hors de France. La sélection des groupes à enquêter est faite à partir du fichier issu de l'enquête sur les liaisons financières (Lifi) qui donne les contours de groupes et une information sur les implantations étrangères de rang 1. Tous les ans, ce sont environ 2 500 groupes français ayant au moins une filiale hors de France quel que soit le secteur d'activité du groupe (à l'exception du secteur bancaire couvert par la Banque de France) qui sont sélectionnés pour être interrogés au titre de l'enquête OFATS. Conformément au règlement Eurostat, aucun seuil de taille de chiffre d'affaires ou d'effectifs n'a été appliqué. "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1980/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L’enquête OFATS répond au règlement européen n°716/2007 du 20 juin 2007."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/rapport/1980>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: European survey on activities of subsidiaries under national control implanted in foreign countries 2020"@en , "Rapport qualité : Enquête européenne sur l'activité des filiales étrangères des groupes français 2020"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1436> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1269> , <http://bauhaus/documents/document/1270> .
    
    <http://bauhaus/qualite/attribut/1980/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/documents/document/1270>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2020 de l'enquête européenne sur l'activité des filiales étrangers des groupes français / OFATS"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0010-07-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaire_OFATS_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1980/S.3.6/text> , <http://bauhaus/qualite/attribut/1980/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey contains the three variables to be necessarily supplied, as from 2011 concerning 2009, for France: the turnover, the staff and the number of subsidiaries by country of presence of subsidiaries and by business sector. It also integrates some additional variables among which the costs of staff and the physical investment."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1980/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1980/S.18.3/text> , <http://bauhaus/qualite/attribut/1980/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>2800</p>"@fr , "<p>2800</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The coverage is all the groups for which the main center of decision is in France and controlling at least a company implanted outside France. The selection of the groups to be investigated is made from the french group register (Lifi) which gives the outlines of groups and an information on the foreign subsidiaries. INSEE questions yearly about 2,800 groups of the non-financial sectors with at least one subsidiary outside France.  \nIn  with the Eurostat regulation, no turnover or workforce size threshold has been applied."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1980/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1980/S.3.4/texte> , <http://bauhaus/qualite/attribut/1980/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Cette enquête comporte les trois variables à fournir obligatoirement, à compter de 2011 sur l'exercice 2009, pour la France : le chiffre d'affaires, les effectifs et le nombre de filiales par pays d'implantation des filiales et par secteur d'activité. Elle intègre également quelques variables additionnelles dont les coûts de personnel et l'investissement corporel."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1980/I.18.10/texte> , <http://bauhaus/qualite/attribut/1980/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/G> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2021A023EC"@fr , "2021A023EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte s'effectue à compter du mois de juin pour les très grands groupes et à compter de septembre pour les autres. Les unités UCI sont interrogés par (via) Internet. Le support excel est toutefois proposé aux plus grands groupes."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1980/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1980/S.6.1/texte> , <http://bauhaus/qualite/attribut/1980/S.6.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>88 avenue Verdier - CS 70058 - 92541 Montrouge cedex</p>\n<div id=\"mailtorapidetoModal\" style=\"z-index: 20002;\">&nbsp;</div>"@fr , "<p>88 avenue Verdier - CS 70058 - 92541 Montrouge cedex</p>\n<div id=\"mailtorapidetoModal\" style=\"z-index: 20002;\">&nbsp;</div>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The OFATS survey complies with European Regulation n°716/2007 of 20 June 2007."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Tous les secteurs d'activité marchands sont concernés, à l'exception du secteur bancaire du ressort de la Banque de France.  \n\nL'unité enquêtée est l' \" UCI \" , Ultimate Controlling Institutional unit. Cette unité définie par Eurostat correspond à l'unité qui exerce le contrôle des filiales déclarées dans l'enquête. Ce contrôle se caractérise par le pouvoir de nommer les dirigeants des sociétés ou des business units en charge des activités opérationnelles. L'UCI est aussi l'unité qui dispose des données de toutes les filiales du groupe."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1980/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1980> .
    
    <http://bauhaus/qualite/attribut/1980/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All merchant activity sectors are concerned (excluded financial sector).  \nThe unit investigated is the \"UCI\", Ultimate Controlling Institutional unit. This unit defined by Eurostat corresponds to the unit which exercises control over the subsidiaries declared in the survey. This control is characterized by the power to appoint the managers of companies or business units in charge of operational activities. The UCI is also the unit which has the data of all the group's subsidiaries."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1980/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection is made from May for large MNE and from September for the others. The units \"UCI\" are questioned either by (via) Internet, or by an Excel file for large companies."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1750> {
    <http://bauhaus/qualite/attribut/1750/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1750> .
    
    <http://bauhaus/qualite/attribut/1750/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Scope restricted to ordinary dwellings and renewed by a third each year."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1750/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ de l'enquête est restreint aux ménages ordinaires (hors foyers, casernes, etc.) et l'échantillon est renouvelé par tiers chaque année.\n\nLes 75 000 logements enquêtés sont issus d'un échantillon stratifié (21 régions X 10 catégories de communes)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1750/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1750> .
    
    <http://bauhaus/documents/document/322>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Une histoire de l'enquête Emploi"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2003-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/esane_ecostat362_histoire_enq_empl.pdf> .
    
    <http://bauhaus/qualite/attribut/1750/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1750> .
    
    <http://bauhaus/qualite/attribut/1750/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête porte sur l'emploi, le chômage, la formation, l'activité professionnelle antérieure, l'origine sociale, la situation en mars de l'année précédente, et la situation principale mensuelle sur les douze derniers mois."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1750/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1750/S.3.4/texte> , <http://bauhaus/qualite/attribut/1750/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1750> .
    
    <http://bauhaus/qualite/attribut/1750/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
