    <http://bauhaus/qualite/attribut/1793/S.10.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<https://www.insee.fr/fr/statistiques?debut=0&theme=30&collection=5&conjoncture=49>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1793/S.10.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.3>
                    <http://bauhaus/qualite/attribut/1793/S.10.3/text> , <http://bauhaus/qualite/attribut/1793/S.10.3/texte> ;
