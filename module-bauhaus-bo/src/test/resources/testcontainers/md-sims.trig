                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2009-03-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Tresorerie_francais_2008.pdf> .
    
    <http://bauhaus/qualite/attribut/1625/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/S> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1625> .
    
    <http://bauhaus/qualite/attribut/1625/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre l'industrie manufacturière et les industries extractives; divisions 08 à 33 de la NAF rév. 2 (hors 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/27>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de l'OCDE"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Les indicateurs de conjoncture de l'OCDE"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://www.oecd.org/fr/france> .
    
    <http://bauhaus/qualite/attribut/1625/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée deux fois par an, en juin et en décembre.\n\nLa collecte s'effectue par voie postale et par internet sur une période qui s'étend de la fin du mois précédant le mois de l'enquête à la date de publication de l'enquête, dans les 10 premiers jours du mois suivant le mois de l'enquête."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
