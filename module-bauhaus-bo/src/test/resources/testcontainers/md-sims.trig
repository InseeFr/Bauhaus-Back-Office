    <http://bauhaus/qualite/attribut/1926/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted every month but not all questions are asked every month. Some questions are only asked to enterprises in road haulage of goods.\n\nIn practice, three models of questionnaires were created to take into account these specificities:   \n- the first questionnaire corresponds to the months of January and July;  \n- the second one is sent in February, March, April, May, June, August, Septembre, November and December;  \n- the last one is sent in April and October."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1093> , <http://bauhaus/documents/document/1095> , <http://bauhaus/documents/document/1091> , <http://bauhaus/documents/document/1094> , <http://bauhaus/documents/document/1092> .
    
    <http://bauhaus/qualite/attribut/1926/S.7.2>
