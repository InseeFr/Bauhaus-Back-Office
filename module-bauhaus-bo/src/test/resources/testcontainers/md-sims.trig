    <http://bauhaus/qualite/attribut/1928/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2019-06-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1928> .
    
    <http://bauhaus/qualite/attribut/1928/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte s'effectue par voie postale et par internet sur une période qui s'étend de la fin du mois précédant le mois de l'enquête à la date de publication de l'enquête, soit 4 jours ouvrables avant la fin du mois courant.\n\nLes résultats d'enquête sont envoyés à la Commission européenne 4 jours ouvrables avant la fin de mois."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1928/S.15.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.15.2>
                    <http://bauhaus/qualite/attribut/1928/S.15.2/texte> , <http://bauhaus/qualite/attribut/1928/S.15.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1928> .
    
    <http://bauhaus/qualite/attribut/1928/S.10.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.3>
                    <http://bauhaus/qualite/attribut/1928/S.10.3/text> , <http://bauhaus/qualite/attribut/1928/S.10.3/texte> ;
