    <http://bauhaus/qualite/attribut/1887/S.18.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.6>
                    <http://bauhaus/qualite/attribut/1887/S.18.6/text> , <http://bauhaus/qualite/attribut/1887/S.18.6/texte> ;
