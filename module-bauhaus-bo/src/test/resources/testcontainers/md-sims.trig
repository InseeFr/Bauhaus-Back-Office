            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers sectors defined by the following NAF rev.2 codes: 41.10A, 68.20A."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1609/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1609/S.3.4/texte> , <http://bauhaus/qualite/attribut/1609/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
    <http://bauhaus/qualite/attribut/1609/S.3.6/texte>
