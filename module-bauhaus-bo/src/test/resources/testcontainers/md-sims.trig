    <http://bauhaus/qualite/attribut/1629/S.13.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.13.3>
                    <http://bauhaus/qualite/attribut/1629/S.13.3/texte> , <http://bauhaus/qualite/attribut/1629/S.13.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
