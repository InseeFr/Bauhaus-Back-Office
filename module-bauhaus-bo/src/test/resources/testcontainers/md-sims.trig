    <http://bauhaus/qualite/attribut/1888/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1888/S.19/text> , <http://bauhaus/qualite/attribut/1888/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1888> .
    
    <http://bauhaus/qualite/attribut/1888/S.8.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Services Production index are monthly disseminated at the latest 60 days after the month under review."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1888/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
