                    "Construction Cost index (base 2010)"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-05-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICC_BASE_2010_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1766/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête ICC-PRLN, Sit@del2"@fr ;
            <http://purl.org/dc/terms/language>
