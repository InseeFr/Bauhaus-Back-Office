                    "2019-04-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/IPPAP_base_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1798/S.3.4/texte>
