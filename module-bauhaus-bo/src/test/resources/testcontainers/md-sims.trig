    <http://bauhaus/qualite/attribut/1554/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1554> .
    
    <http://bauhaus/qualite/attribut/1554/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête CIS2014 couvre les activités suivantes (selon la nomenclature NAF rév. 2) :  \n- Industrie manufacturière, industries extractives et autres (sections B, C, D et E),  \n- Construction (section F),  \n- Commerce de gros et de détail (section G),  \n- Transports (section H),  \n- Hébergement et restauration (section I),  \n- Information et communication (section J),  \n- Activités financières et d'assurance (section K),  \n- Activités immobilières (section L),  \n- Activités spécialisées, scientifiques et techniques et activités de services administratifs et de soutien (sections M et N, hors div 75 et 82)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1554/S.3.6>
