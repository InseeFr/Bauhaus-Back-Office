    <http://bauhaus/qualite/attribut/1622/S.11.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1622/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1622/S.3.4/texte> , <http://bauhaus/qualite/attribut/1622/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1622> .
    
    <http://bauhaus/qualite/attribut/1622/I.18.10/text>
