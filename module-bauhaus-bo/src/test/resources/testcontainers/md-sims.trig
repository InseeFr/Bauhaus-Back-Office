    <http://bauhaus/qualite/attribut/1896/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1896/S.3.3/texte> , <http://bauhaus/qualite/attribut/1896/S.3.3/text> ;
