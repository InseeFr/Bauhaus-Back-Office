    <http://bauhaus/documents/document/279>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Flux touristique à Mayotte (Enquête auprès des voyageurs au départ de l’aéroport de Dzaoudzi)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-01-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaire_2014_EFT.pdf> .
    
    <http://bauhaus/qualite/attribut/1672/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1672/S.3.6/text> , <http://bauhaus/qualite/attribut/1672/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1672> .
    
    <http://bauhaus/qualite/attribut/1672/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Number and characteristics of tourists ;\n\n- the motivation of the travel (affinity, pleasure, business) ;\n\n- the characteristics of their tourism stay (duration, mode of accommodation, visits) ;\n\n- the expenditure by items, and by \"categories\" of tourists ;"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1672/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1672> .
    
    <http://bauhaus/qualite/attribut/1672/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection takes place each year from January 1st to December 31st. The passengers are fulfilling the questionnaires before entering the boarding area or in boarding area."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1672/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Il ne comporte pas de surreprésentation lors des périodes de forte affluence pour limiter les effets de grappe. Les compositions des vols des périodes juillet-août (congés d'été et d'hiver austral) d'une part, et de décembre-janvier (congés d'été austral) d'autre part sont similaires en terme de caractéristiques des touristes. Le plan de sondage repose sur une sélection de 91 jours d'enquête répartis sur une année équitablement entre chaque jour de la semaine (tous les 4 jours en moyenne). L'ensemble des vols programmés les jours d'enquêtes sont concernés. L'enquête à l'aéroport permet l'exploitation d'environ 15 000 fiches par an. Les données peuvent être comparées sans recours à la désaisonnalisation."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1672/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La période de collecte se déroule du 1er janvier au 31 décembre de chaque année. Les voyageurs au départ renseignent les questionnaires avant l'entrée en salle d'embarquement ou en salle d'embarquement."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1672/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Nombre et caractéristiques des touristes ;\n\n- motifs du déplacement( affinitaire, agrément, affaires…) ;\n\n- caractéristiques des séjours (durée, mode d'hébergement, visites…) ;\n\n- les dépenses par poste de consommations et par « catégories » de touristes."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1672/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/279> .
    
    <http://bauhaus/qualite/attribut/1672/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1672/S.3.4/texte> , <http://bauhaus/qualite/attribut/1672/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1672> .
    
    <http://bauhaus/qualite/attribut/1672/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1672/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1672> .
}

