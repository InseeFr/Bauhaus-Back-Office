                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
                    <http://bauhaus/qualite/attribut/1929/S.8.1/text> , <http://bauhaus/qualite/attribut/1929/S.8.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Survey of a sample of about 4,000 industrial enterprises with 20 employees or more. The sampling frame is an administrtative referentiel of firms. Strata are defined according to econonomic activity and number of employees.\n\nAll enterprises with at least 500 employees of turnover of €150 million euros are surveyed. For the other strata, the sample is produced by stratified sampling without replacement, using an allocation proportional to turnover."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
