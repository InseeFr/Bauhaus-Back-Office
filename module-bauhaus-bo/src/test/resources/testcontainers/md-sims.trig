            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Usually on the last businees day of the month (excluding mondays)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1793/S.3.4/text>
