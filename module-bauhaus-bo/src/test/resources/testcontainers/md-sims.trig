                    "personnes"@fr , "Persons"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1761> .
    
    <http://bauhaus/documents/document/4>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La détermination de la population légale des communes"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-12-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/determination_pop_legal_communes_RP_16122008.pdf> .
    
    <http://bauhaus/qualite/attribut/1761/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1761> .
    
    <http://bauhaus/qualite/attribut/1761/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The \"housing form\" questionnaire features 15 questions relating to the characteristics and comfort of the dwelling as well as the household composition.\n\nA specific housing form exists for the overseas departments (DOMs).\n\nThe \"individual bulletin\" questionnaire features 25 questions focusing on age, place of birth, nationality, level of qualifications, place of residence the year before and occupation.\n\nIt applies to all the people normally living in the dwelling."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1761/I.18.9>
