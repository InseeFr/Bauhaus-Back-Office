                    "<https://www.insee.fr/fr/metadonnees/source/s1225>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1653/S.18.3/text>
