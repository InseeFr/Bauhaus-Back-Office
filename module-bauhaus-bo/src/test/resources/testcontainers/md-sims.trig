                    "<p>10,000</p>"@en , "<p>10 000</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1862> .
    
    <http://bauhaus/qualite/attribut/1862/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1862/S.10.2/text> , <http://bauhaus/qualite/attribut/1862/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1862> .
    
    <http://bauhaus/qualite/attribut/1862/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Insee Première, Insee Résultats"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1862/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "Entreprise (telle que définie par la loi de modernisation de l’économie)"@fr , "Enterprise (as defined in the law on the modernisation of the economy)"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1862> .
    
    <http://bauhaus/qualite/attribut/1862/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The main topics of this survey are :\n\n- the number of employees inside the company at the end of 2016 by activity : core business function on the one hand, support functions divided into 7 categories on the other hand ;  \n- the type of activities outsourced in France between 2014 and 2016 ;  \n- the type of activities sourced abroad between 2014 and 2016 ;  \n- the geographical areas hosting international sourcing between 2014 and 2016 : dividing of the world into 9 geographical areas ;   \n- the consequences of international sourcing in terms of jobs lost inside the company between 2014 and 2016 ;  \n- the reasons for international sourcing ; the obstacles encountered during a planned and/or done international sourcing between 2014 and 2016 ;  \n- the type of activities moved from abroad to France  between 2014 and 2016 ;  \n- the type and the location of activities expanded abroad between 2014 and 2016."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
