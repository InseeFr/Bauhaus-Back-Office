    <http://bauhaus/qualite/attribut/1636/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le fichier de lancement d'enquête est établi principalement à partir des enquêtes précédentes sur les réseaux, de la presse professionnelle et par contact avec les organisations professionnelles. Il compte 1 500 réseaux."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1636/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
