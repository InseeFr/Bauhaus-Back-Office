            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_BDF_QUEST_1.pdf> .
    
    <http://bauhaus/qualite/attribut/1549/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1549> .
    
    <http://bauhaus/qualite/attribut/1549/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Sample (random self-weighted sample) of about 17,000 dwellings in Metropolitan France, 8,000 in the overseas departments. In 2011, 10,342 households answered the whole of the questionnaire, which corresponds to 24,417 individuals. The survey in the 5 overseas departments covered 5,455 households and 16,868 individuals."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
