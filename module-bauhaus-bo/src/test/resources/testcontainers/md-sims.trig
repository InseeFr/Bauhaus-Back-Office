            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1040> , <http://bauhaus/documents/document/679> .
    
    <http://bauhaus/qualite/attribut/1948/S.2.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.1>
                    "2019-12-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
