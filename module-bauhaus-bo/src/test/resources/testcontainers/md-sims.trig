    <http://bauhaus/qualite/attribut/1573/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1573/S.18.3/text> , <http://bauhaus/qualite/attribut/1573/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête par sondage réalisée auprès de 3 000 grossistes.\n\nToutes les entreprises de plus de 200 salariés sont interrogées, ainsi que toutes celles possédant un chiffre d'affaires supérieur à un seuil dépendant de leur sous-secteur d'activité."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/58>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Insee Méthodes n° 113"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête de conjoncture sur la situation et les perspectives dans le commerce de gros : méthodologie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/information/2579329> .
    
    <http://bauhaus/qualite/attribut/1573/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1573/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 3,000 wholesalers.\n\nAll companies with more than 200 employees are questioned, and all those with a turnover of more than a certain threshold, depending on their sub-sector of activity."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/453>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête bimestrielle de conjoncture dans le commerce de gros"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/methodo_enq_conj_comgros_3052010.pdf> .
    
    <http://bauhaus/qualite/attribut/1573/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1573/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The bi-monthly business outlook survey on wholesaling records the opinion of wholesalers on their recent activity and on their future planned activity.\n\nThis opinion is obtained by monitoring the volume of sales and related variables, such as stocks, order intentions, deliveries, general future trends in activity, changes in workforce and prices.\n\nWholesalers also provide their opinion on their cash flow situation and payment deadlines."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1573/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1573/S.3.6/texte> , <http://bauhaus/qualite/attribut/1573/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête bimestrielle de conjoncture dans le commerce de gros est réalisée auprès de l'ensemble des grossistes à l'exclusion de certains sous-secteurs qui sont : les intermédiaires du commerce de gros, le commerce de gros de tabac (manufacturé ou non), le commerce de gros de déchets et débris, le commerce de gros non spécialisé.\n\nPlus précisément, l'enquête couvre les secteurs définis par les codes NAF Rév. 2 suivants : 46.2, 46.3 (hors 4635Z), 46.4, 46.5, 46.6, 46.7 (hors 4677Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1573/I.20/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    ""@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/89> , <http://bauhaus/documents/page/81> .
    
    <http://bauhaus/qualite/attribut/1573/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted every two months (January, March, May, July, September, November, i.e. the odd months of the year).\n\nData collection is by post and via the internet from the end of the month preceding the survey month to the end of the survey month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1573/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1573/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/attribut/1573/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The bi-monthly business outlook survey on wholesaling is conducted on all wholesalers, with the exception of certain sub-sectors: wholesale intermediaries, wholesale tobacco trade (whether manufactured or not), wholesale trade of waste and scrap, non-specialised wholesale trade.\n\nMore precisely, the survey covers the sectors defined by the following NAF Rev. 2 codes: 46.2, 46.3 (excl. 4635Z), 46.4, 46.5, 46.6, 46.7 (excl. 4677Z)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1573/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/453> , <http://bauhaus/documents/document/444> .
    
    <http://bauhaus/qualite/attribut/1573/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1573/S.19/texte> , <http://bauhaus/qualite/attribut/1573/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1573> .
    
    <http://bauhaus/qualite/rapport/1573>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Bi-monthly business outlook survey on wholesaling 2015"@en , "Rapport qualité : Enquête bimestrielle de conjoncture dans le commerce de gros 2015"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1126> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1573/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée tous les deux mois (janvier, mars, mai, juillet, septembre, novembre ; c'est à dire les mois impairs).\n\nLa collecte s'effectue par voie postale et par internet de la fin du mois précédant le mois de l'enquête à la fin du mois de l'enquête."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/page/89>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Insee Méthodes n° 113"@en ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "The French Business Survey on The Situation and Outlook in The Wholesale Trade : Methodology"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://schema.org/url>  <http://www.insee.fr/en/publications-et-services/sommaire.asp?codesage=IMET113&nivgeo=0> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1670> {
    <http://bauhaus/qualite/attribut/1670/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The data base consists of outgoing passengers on commercial aircraft leaving the airport of Guadeloupe Pôle Caraïbes to metropole, Martinique, Guyane, Canada, Porto Rico and the Scandinavian countries. Even if our target population is tourists, we also have to take into account the passengers in transit and the passengers living in Guadeloupe."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1670/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La dernière enquête s'est déroulée du 1er mai 2010 au 30 avril 2011. Cette période de collecte correspond à l'année touristique. Le questionnaire est distribué en salle d'embarquement à tous les ménages des vols sélectionnés."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1670/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.4>
                    "personnes"@fr , "Persons"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/region/598b3ed6-a7ea-44f8-a130-7a42e3630a8a> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The last survey took place from May 1st, 2010 to April 30th, 2011. This period of collection corresponds in the tourist year. The questionnaire is distributed in departure lounge to all the households of the selected flights."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1670/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- nombre et caractéristiques des touristes,\n\n- motifs du déplacement et caractéristiques des séjours (durée, mode d'hébergement, visites…) ,\n\n- les dépenses par postes de consommations et par \" catégories \" de touristes,\n\n- le niveau de satisfaction."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1670/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le plan de sondage repose sur une sélection de 90 jours d'enquête répartis sur une année. Dans un deuxième temps, on procède, chaque mois, à un tirage des vols à enquêter. Ce tirage s'effectue sur la base d'un planning mensuel prévisionnel des vols fourni par l'aéroport. Le nombre de vols à enquêter fait l'objet d'une estimation basée sur les résultats de collecte de l'enquête précédente. On distribue le questionnaire à chacun des ménages du vol enquêté. Les questionnaires seront saisis et exploités. On ne connaît donc pas, a priori, la taille de l'échantillon des ménages. Elle dépend du nombre de vols, du taux de remplissage des avions, de la taille des ménages et du taux de réponse. On prévoit de distribuer environ 20 000 questionnaires et de récupérer 12 000 questionnaires complets de ménages, touristiques et transit. Les données peuvent être comparées sans recours à la désaisonnalisation."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1670/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1670/S.18.3/texte> , <http://bauhaus/qualite/attribut/1670/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1670/S.3.6/texte> , <http://bauhaus/qualite/attribut/1670/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage se compose des voyageurs des avions commerciaux partant de l'aéroport Guadeloupe Pôle Caraïbes à destination de la métropole, de la Martinique, de la Guyane, du Canada, de Porto-Rico et des pays scandinaves. Même si notre population cible est composée des touristes, nous devons également prendre en compte les passagers en transit et les passagers résidant en Guadeloupe."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1670/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/281> .
    
    <http://bauhaus/qualite/attribut/1670/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "-The number and the caracteristics of tourists;\n\n-The motivation of the travel and the caracteristics of the tourism stay (the entire duration, type of accommodation, sightseeing…);\n\n-The expenditure consumptions functions and the \"category\" of tourists;\n\n-the level of satisfaction."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1670/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sampling plan is based on a selection of 90 days of survey, over one year. Secondly, we proceed, every month, to an drawing of the flights to be investigated. This drawing is made on the basis of a projected monthly schedule of the flights supplied by the airport. The number of flights to be investigated makes the object of an estimation based on the results of collection of the previous survey. A questionnary is handed out to each households of the survey flight. The questionnaire will be entered and exploited. We do not know, a priori, the size of the sample of the households. It depends on the number of flights, the rate of the lack of seating capacity on the aircraft, the size of households and the rate of answer to the survey. 20 000 questionnaires will be distribute and get back 12 000 complete questionnaires of households, passengers in transit and tourists. The data sources can be compared without seasonal adjustment."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1670/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1670/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1670/S.3.4/text> , <http://bauhaus/qualite/attribut/1670/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/documents/document/281>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les flux touristiques en Guadeloupe auprès des voyageurs au départ de l'aéroport Pôle Caraïbes"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_flux_touristiques_Guadeloupe.pdf> .
    
    <http://bauhaus/qualite/rapport/1670>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Flux touristiques en Guadeloupe (enquête auprès des voyageurs au départ de l'aéroport Pôle Caraïbes)"@fr , "Quality report: Tourist flows in Guadeloupe Island (survey with travelers from the airport of Pôle Caraïbes)"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1236> .
    
    <http://bauhaus/qualite/attribut/1670/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
    
    <http://bauhaus/qualite/attribut/1670/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1670/I.18.10/texte> , <http://bauhaus/qualite/attribut/1670/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1670> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1585> {
    <http://bauhaus/qualite/attribut/1585/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1585/S.18.3/text> , <http://bauhaus/qualite/attribut/1585/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The monthly business outlook survey in the building industry is part of the European system to harmonise European Commission business outlook surveys, and to which the 27 Member States of the European Union contribute.  \n\nThus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system.  \n\nQuestions are formulated so that they can be answered quickly (most of the questions are qualitative with three response options expressed in the form \"higher, lower, stable\", or \"more than normal, normal, less than normal\")."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1585/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1585/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/rapport/1585>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête mensuelle de conjoncture dans l'industrie du bâtiment 2009"@fr , "Quality report: Monthly business outlook survey in the building industry 2009"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1145> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1585/S.3.6/text> , <http://bauhaus/qualite/attribut/1585/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1585/S.19/text> , <http://bauhaus/qualite/attribut/1585/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1585/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête mensuelle de conjoncture dans l'industrie du bâtiment est réalisée auprès d'entreprises travaillant dans la construction de maisons individuelles et de bâtiments divers, les travaux de maçonnerie générale, la réalisation de charpentes et de couvertures, les travaux d'installation et de finition.\n\nPlus précisément, l'enquête couvre les secteurs définis par les codes NAF rév. 2 suivants : 41.2, 43.2, 43.3, 43.9."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1585/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/documents/document/436>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2009"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-03-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Batiment_francais_2009.pdf> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The monthly business outlook survey in the building industry covers companies working on the construction of individual houses and miscellaneous buildings, general building work, roofing, framing, fitting and finishing work.\n\nMore precisely, the survey covers the sectors defined by the following NAF Rev. 2 codes: 41.2, 43.2, 43.3, 43.9"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1585/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/436> .
    
    <http://bauhaus/qualite/attribut/1585/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête par sondage auprès de 2 500 entreprises de plus de 10 salariés.\n\nToutes les entreprises de plus de 500 salariés sont interrogées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1585/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Jusqu'en 2007, l'enquête avait lieu chaque mois sauf au mois d'août.  \n\nDepuis 2008, elle a lieu tous les mois.  \n\nLa collecte s'effectue par voie postale et par internet sur une période qui s'étend de la fin du mois précédant le mois de l'enquête à la date de publication de l'enquête, soit 4 jours ouvrables avant la fin du mois courant.  \n\nLes résultats d'enquête sont envoyés à la Commission européenne 4 jours ouvrables avant la fin de mois."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1585/S.3.4/text> , <http://bauhaus/qualite/attribut/1585/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/documents/page/54>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Insee Méthodes n° 115"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête de conjoncture sur la situation et les perspectives dans l'industrie du bâtiment : méthodologie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/7258> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1585/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête mensuelle de conjoncture dans l'industrie du bâtiment fait partie du système européen harmonisé des enquêtes de conjoncture de la Commission européenne, auquel contribuent les vingt-sept États membres de l'Union européenne.  \n\nÀ ce titre, les questionnaires, les nomenclatures et les méthodes de traitement sont largement harmonisés dans les instituts nationaux des pays adhérant à ce système.  \n\nLa formulation des questions est conçue de manière à faciliter une réponse rapide (la plupart des questions sont qualitatives à trois modalités exprimées sous la forme \"hausse, baisse, stable\", ou \"supérieur à la normale, normal, inférieur à la normale\")."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1585/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1585/I.18.10/text> , <http://bauhaus/qualite/attribut/1585/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/documents/document/443>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête mensuelle de conjoncture dans l’industrie du bâtiment"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_BAT_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1585/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1585/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The monthly business outlook survey in the building industry records the opinion of entrepreneurs in the sector on recent activity and on their future activity.  \n\nThis opinion is obtained by monitoring production itself and related variables, such as order books, production bottlenecks, workforce, difficulties with hiring workers, etc.  \n\nCompany chiefs also provide estimates of their investments and an opinion on their cash flow."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1585/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/443> , <http://bauhaus/documents/document/444> .
    
    <http://bauhaus/qualite/attribut/1585/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 2,500 companies with more than 10 employees.\n\nAll companies with more than 500 employees are canvassed."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Until 2007, the survey was conducted every month except August.  \n\nSince 2008, it takes place every month.  \n\nData collection is by post and via the internet over a period that extends from the end of the month preceding the survey month to the survey publication date, i.e. 4 business days before the end of the current month.  \n\nSurvey results are sent to the European Commission 4 business days before the end of the month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1585/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/54> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1585/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
    
    <http://bauhaus/qualite/attribut/1585/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête mensuelle de conjoncture dans l'industrie du bâtiment a pour objet de transcrire l'opinion des entrepreneurs du secteur sur leur activité récente et sur leurs perspectives d'activité.  \n\nCette opinion est retracée au moyen du suivi de la production elle-même et de variables qui lui sont liées, telles que les carnets de commandes, goulots de production, effectifs, difficultés de recrutement...  \n\nLes chefs d'entreprise fournissent également des estimations de leurs investissements et une opinion sur leur trésorerie."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1585/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1585> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1791> {
