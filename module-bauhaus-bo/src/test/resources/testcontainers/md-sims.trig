    <http://bauhaus/qualite/attribut/1837/S.18.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.5>
                    <http://bauhaus/qualite/attribut/1837/S.18.5/texte> , <http://bauhaus/qualite/attribut/1837/S.18.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
