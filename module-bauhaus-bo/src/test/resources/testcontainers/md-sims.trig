    <http://bauhaus/qualite/attribut/1820/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1820/S.7.2/text> , <http://bauhaus/qualite/attribut/1820/S.7.2/texte> ;
