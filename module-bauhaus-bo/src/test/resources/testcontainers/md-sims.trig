    <http://bauhaus/documents/document/966>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête achats des entreprises 2017 - Services 1 - IAA"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-08-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Achats2017_questionnaire_Services1_IAA.pdf> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "From september to december 2018"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Secteurs marchands (y-c financier), hors secteur agricole"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1901/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey sample is drawn from a sampling frame constructed from the Sirus directory (directory of statistical units).\n\nThe sample size is 20,000 legal units out of a population of about 850,000 legal units.\n\nThe objective is to gather information on intermediate consumption (IC).\n\nThe exhaustive stratum is constructed with a criterion of number of employees (more than 250 employees) or minimum amount of intermediate consumption (28.14 million euros). Finally, units with a \"CI/Sales turnover\" ratio greater than 3 and a headcount greater than 10 are added to the exhaustive stratum.\n\nThe non-exhaustive strata are first defined by the sector of activity, then the IC amount (adaptively to the sectors)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1901/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1901> .
    
