            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La périodicité est biennale. La collecte est réalisée de mai à octobre."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1950/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1950/S.3.4/text> , <http://bauhaus/qualite/attribut/1950/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1950> .
    
    <http://bauhaus/documents/document/1170>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les réseaux d’enseigne du commerce de détail et des services 2018"@fr ;
