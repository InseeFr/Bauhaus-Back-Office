    <http://bauhaus/qualite/attribut/1969/S.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.1>
                    <http://bauhaus/qualite/attribut/1969/S.3.1/texte> , <http://bauhaus/qualite/attribut/1969/S.3.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1969> .
    
    <http://bauhaus/qualite/attribut/1969/S.18.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All survey steps ensure that process meet high requirements for quality statistical production : \n\n- tests carried out prior to collection, with 27 companies\n\n- exhaustive survey \n\n- reminders and data controls being collected by Insee collectors\n\n- clearance \n\n- total no-response adjustment\n\n- shimming \n\n- partial no-response adjustment\n\n- winsorization"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1969/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All Space Center Employers Union companies are surveyed, as well as all their suppliers with a minimal significant amount of contract."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1969/S.1.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.7>
                    "05 94 29 73 00"@fr , "05 94 29 73 00"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1969> .
    
    <http://bauhaus/documents/document/1250>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des établissements membres de l'Union des employeurs de la base spatiale"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_IAS_QUESTIONNAIRE_RANG1_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1969/S.11.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted with a great diversity of firms, many small ones among them. Its response rate is lower than usual annual structural survey response rate in French Guiana, that implies only big companies.\n\nThus weighting adjusments have a bigger impact on the estimated results. Before any processing, it will be necessary to evaluate all data quality through partial-response rate, accounting structure of the spendings, and especially the turnover made with space industry."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1248>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice d’aide au remplissage du questionnaire destiné aux établissements membres de l'Union des employeurs de la base spatiale"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_IAS_NOTICE_RANG1_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1969/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Result users were consulted in a regional opportunity board, composed of civil services, elected representatives, local authorities and corporations. The board confirmed the necessity of renewing the survey, in order to measure the Space industry impact in French Guiana’s economy."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1969/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1969> .
    
    <http://bauhaus/qualite/attribut/1969/S.15.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les évolutions des questionnaires ont veillé à préserver la comparabilité temporelle sur l’objectif essentiel de l’étude : la mesure de l’impact du spatial sur les principaux agrégats macroéconomiques guyanais."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1969/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1969/S.18.3/texte> , <http://bauhaus/qualite/attribut/1969/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1969> .
    
    <http://bauhaus/qualite/attribut/1969/S.7.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "<p class=\"MsoNormal\"><span style=\"color: #1f497d;\">Act No. 51-711 of 7 June 1951 on the obligation, coordination and secrecy of statistics. Available at <a href=\"https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573\">https://www.legifrance.gouv.fr/affichTexte.do?cidTexte=JORFTEXT000000888573</a>. </span></p>\n<p class=\"MsoNormal\"><span style=\"color: #1f497d;\">Article 6 concerns statistical secrecy: Subject to the provisions of articles 40, 56, 76, 97 and 99 of the Code of Criminal Procedure and those of article L. 213-3 of the Heritage Code, individual information contained in the questionnaires bearing the visa provided for in article 2 of this Act and relating to personal and family life and, in general, to facts and behaviour of a private nature may not, unless decided by the administration of the archives, taken after obtaining the opinion of the Committee on Statistical Confidentiality and relating to a request made for the purposes of official statistics or scientific or historical research, shall not be communicated by the depository service before the expiry of 75 years from the date of the survey or 25 years from the date of the death of the person concerned, whichever is the earlier. </span></p>\n<p class=\"MsoNormal\"><span style=\"color: #1f497d;\">A Committee on Statistical Confidentiality shall be set up. This Committee shall be called upon to give its opinion on any matter relating to statistical confidentiality. It shall give its opinion on requests for disclosure of individual data collected pursuant to this Act. The committee is chaired by a State Councillor, appointed by the Vice-President of the Council of State. It includes in particular representatives of the National Assembly and the Senate. The composition and operating procedures of the committee are set by decree in the Council of State. Beneficiaries of data communications resulting from ministerial decisions taken after the opinion of the Committee on Statistical Confidentiality undertake not to communicate these data to anyone. Any infringement of the provisions of this paragraph shall be punishable by the penalties provided for in Article 226-13 of the Penal Code.</span></p>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1969/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1969/S.3.6/texte> , <http://bauhaus/qualite/attribut/1969/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1969> .
    
    <http://bauhaus/qualite/attribut/1969/S.3.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les données sont ventilées selon la nomenclature d’activité francaise (NAF-2008, rév 2.)"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1715> {
    <http://bauhaus/qualite/attribut/1715/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- État de santé : santé physique, comportements à risque, capacités cognitives, santé mentale, système de soins, force de préhension, vitesse de marche ;  \n- Participation au marché du travail (emploi et retraite) ;  \n- Conditions de vie (richesse, revenu, consommation, actifs financiers, transferts, logement) ;  \n- Démographie (composition du ménage, enfants) ;  \n- Statut social (soutien familial et social, activité sociale, anticipations).  \n- Réseau social (nouveau module de vague 4)"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1715/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1715/S.3.4/texte> , <http://bauhaus/qualite/attribut/1715/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1715/S.10.6/text> , <http://bauhaus/qualite/attribut/1715/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/I.20/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "SHARE - Survey of Health, Ageing and Retirement in EuropeEuropean SHARE Website<br /><a href=' http://www.share-project.org/ '> http://www.share-project.org/ </a> <br /><br />"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1715/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'ambition pluri-thématique et comparatiste du projet SHARE donne lieu à une organisation autour de deux entités.  \n\nDes équipes internationales sont chargées de la mise au point des questionnaires (choix des thèmes et définition de méthodologies harmonisées) ; des équipes nationales mettent en œuvre l'enquête sur le terrain.  \n\nLe questionnement harmonisé en amont est donc commun à l'ensemble des pays participants. Une coordonnée centralisée au niveau européen, une méthodologie unique et une collecte synchronisée caractérisent donc l'enquête SHARE.  \n\nL'enquête comporte trois volets :  \n\n- un questionnaire classique rédigé en anglais et traduit dans la langue de chaque pays participant ;  \n- des tests cognitifs et physiques (par exemple, mémoire et force de préhension) ;  \n- un questionnaire papier auto-administré."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/210> , <http://bauhaus/documents/document/211> .
    
    <http://bauhaus/qualite/attribut/1715/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Health status: physical health, risk behaviour, cognitive capacities, mental health, health care system, grip strength, walking speed;  \n- Participation in the labour market (employment and retirement);  \n- Living conditions (wealth, income, consumption, financial assets, transfers, accommodation);  \n- Demographics (composition of the household, children);  \n- Social status (family and social support, social activity, expectations);  \n- Social network (new wave 4 module)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1715/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "In France, the sample was selected from the INSEE master sample, with pre-selection of dwellings based on the age of the occupants at the last census.  \n\nIn France, wave 1 took place  in two phases. In 2004, the sample included a little more than 1,150 households, i.e. approximately 1,800 respondents.  \n\nIn 2005, 900 additional households were added, i.e. approximately 1,400 respondents. Total number of wave 1 respondents: 3193.  \n\nThe sample for wave 2 in 2006 in France consisted of:  \n- eligible individuals from the households surveyed in wave 1 in order to obtain a panel-based sample;  \n- a \"refresher\" sample consisting of approximately 650 households featuring at least one individual aged 50 or over in 2006, i.e. 940 respondents.  \n\nIn each eligible household, one individual selected from the eligible individuals aged 50 or over, as well as their partner, if applicable, is surveyed.  \n\nThose surveyed in wave 1 that had since moved into institutions were monitored and re-surveyed. For wave 2, the sample in France  included 2968 respondents (2041 longitudinal and 927 refresher individuals).  \n\n<br />\n\nThe respondents from waves 1 and 2 of the Share survey were resurveyed as part of the 2009 Sharelife survey (i.e. anyone who responded at least once to Share), amounting to a total of approximately 4,200 individuals, accounting for approximately 2,700 households.  \nTotal number of wave 3 respondents: 2461.  \n\nIn wave 4 former respondents were re-interviewed according to the same rules. A refresher sample was drawn. Total number of wave 4 respondents: around 5800 (among which 3480 refresher individuals)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1715/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-04-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "As the Share project aims to cover multiple themes and enable comparison, it is managed by two entities.  \n\nInternational teams are responsible for developing questionnaires (choice of themes and definition of harmonised methodologies); national teams implement the survey in the field.  \n\nThe survey is ex ante harmonised and is therefore common to all the participant countries. Coordinated on a European level, the Share survey is characterised by this unique methodology and synchronised collection.  \n\nThe survey features three sections:  \n\n- a standard questionnaire written in English and translated into the language of each participant country;  \n- cognitive and physical tests (e.g. memory test and grip strength) ;  \n- a self-administered paper questionnaire."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1715/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1715/S.18.3/text> , <http://bauhaus/qualite/attribut/1715/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "France is the only country in which the survey has been conducted by the National Institute for Statistics from wave 1 to wave 4.\n\nIn wave 4, the refresher sample was drawn by INSEE and the field work was conducted par GfK-ISL in the regions non covered by INSEE."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1715>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur la santé, le vieillissement et la retraite en Europe depuis 2004"@fr , "Quality report: Survey of Health, Ageing and Retirement in Europe since 2004"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1266> .
    
    <http://bauhaus/qualite/attribut/1715/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1715/I.20/texte> , <http://bauhaus/qualite/attribut/1715/I.20/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/documents/document/211>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Santé, vieillissement et retraite en Europe"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2007-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/eco_stat_403404_sante_vieilliss_retraite_europe.pdf> .
    
    <http://bauhaus/qualite/attribut/1715/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/U> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/documents/document/210>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête Share, présentation et premiers résultats de l'édition française"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/enq_share_2005.pdf> .
    
    <http://bauhaus/qualite/attribut/1715/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "So-called \"ordinary\" households, i.e. excluding households living in collective dwellings (nursing homes, prisons, hospitals, etc.) and living in mobile accommodation (boatmen, the homeless, etc.) for the sampling of households entering the survey. However, the longitudinal aspect of the survey deals with individuals who have left to live in retirement or nursing homes.\n\nThe survey covers metropolitan France.  \n\nHowever, for reasons of cost, the sample of wave 1 (2004-20005) to wave 3 (2008-2009) focused on the following regions:  \n\n- Nord-Pas-de-Calais ;  \n- Île-de-France ;  \n- Aquitaine;  \n- Rhône-Alpes;  \n- Pays de la Loire;  \n- Languedoc-Roussillon;  \n- Provence Alpes Côte d'Azur (since wave 2 in 2006)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1715/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> , <http://bauhaus/codes/uniteEnquetee/H> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1715/S.3.6/text> , <http://bauhaus/qualite/attribut/1715/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête sur la santé, le vieillissement et la retraite en Europe 2004 / Share  \nSite internet de l'Institut de Recherche et Documentation en Economie de la santé  \n<http://www.irdes.fr/EspaceRecherche/Enquetes/SHARE/EnqueteSHARE.html>   \n"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1715/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée \"en face à face\" par enquêteur sous Capi (collecte assistée par informatique) avec ordinateur portable.  \n\nUn questionnaire papier  auto-administré peut aussi être laissé aux répondants.  \n\nL’enquête couvre un panel longitudinal (tous les 2 ans) :  \n- Ménages dont un membre au moins est âgé de 50 ans ou plus ;  \n- Individus de 50 ans et plus et leur conjoint."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1715/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "En France, l'échantillon est tiré dans l'échantillon maître de l'Insee, avec une présélection des logements selon l'âge des occupants au dernier recensement.  \n\nEn France, la vague 1 a eu lieu en deux temps. En 2004, l'échantillon est d'un peu plus de 1 150 ménages, soit environ 1 800 répondants.  \n\nEn 2005, 900 ménages supplémentaires ont été ajoutés, soit environ 1 400 répondants. Au total pour la vague 1 : 3193 individus répondants.  \n\nL'échantillon de la vague 2 de 2006 en France est constitué :  \n\n- des individus éligibles des ménages enquêtés en vague 1 de manière à obtenir un échantillon panélisé ;  \n- d'un échantillon de \"rafraîchissement\" composé de 650 ménages dans lesquels se trouve au moins un individu âgé de 50 ans ou plus en 2006.  \n\nDans chaque ménage éligible, un individu tiré au sort parmi les éligibles de 50 ans et plus, ainsi que son conjoint éventuel, sont interrogés.  \n\nLes personnes interrogées en vague 1 qui sont entrées en institution depuis lors, sont suivies et réinterrogées. Au total pour la  vague 2 : 2968 individus répondants (2041 longitidinaux et 927 entrants).  \n\nLes répondants issus des vagues 1 et 2 de l'enquête SHARE sont réinterrogés dans le cadre de l'enquête Sharelife de 2009 (c'est-à-dire toute personne ayant répondu au moins une fois à Share), soit un total de 4 200 individus environ, correspondant à 2 700 ménages environ. Au total pour la vague 3 : 2461 individus répondants.  \n\nEn vague 4, les répondants des vagues antérieures sont réinterrogés selon les mêmes règles. S'y ajoute un échantillon de rafraîchissement de 5500 ménages. Au total pour la vague 4 : de l'ordre de 5800 individus répondants (dont 3480 entrants)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1715/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ménages dits \" ordinaires \", c'est-à-dire hors ménages vivant en collectivité (foyers, prisons, hôpitaux…) et vivant dans des habitations mobiles (mariniers, sans-abri…) pour l'échantillon des ménages entrants.\n\nL'enquête concerne la France métropolitaine.\n\nPour des raisons de coûts l'échantillon des vagues 1 (2004-2005) à 3 (2008-2009) a été concentré sur les régions suivantes :  \n\n- Nord-Pas-de-Calais ;  \n- Ile-de-France ;  \n- Aquitaine ;  \n- Rhône-Alpes ;  \n- Pays de la Loire ;  \n- Languedoc-Roussillon ;  \n- Provence-Alpes Côte d'Azur (depuis la vague 2 de 2006).  \n\nA partir de la vague 4 (2011) toutes les régions sont couvertes.\n\nMais dans sa dimension longitudinale, l'enquête suit les individus partis en maison de retraite."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1715/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La France est un des seuls pays dans lequel l'enquête a été réalisée par l'Institut National de Statistique pour les vagues 1 à 4.\n\nEn vague 4 l'échantillon de rafraîchissement, tiré par l'INSEE, a été enquêté par l'entreprise GfK-ISL dans les régions non couvertes par l'INSEE."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1715/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The data is collected \"face to face\" by interviewers using laptop computers with Capi (computer-assisted collection).  \n\nA self-completion paper questionnaire is also left to the respondent.  \n\nIndividuals aged 50+ and their spouse.  \n\nLongitudinal panel (every two years)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1715/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1715/S.19/texte> , <http://bauhaus/qualite/attribut/1715/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
    
    <http://bauhaus/qualite/attribut/1715/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1715/I.18.10/text> , <http://bauhaus/qualite/attribut/1715/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1715> .
}

