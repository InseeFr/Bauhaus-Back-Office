    <http://bauhaus/qualite/attribut/1909/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 2,500 companies with more than 10 employees.\n\nAll companies with more than 500 employees are canvassed."@en ;
