    <http://bauhaus/qualite/attribut/1858/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1858/S.19/text> , <http://bauhaus/qualite/attribut/1858/S.19/texte> ;
