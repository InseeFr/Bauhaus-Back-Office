            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1797/S.18.3/texte> , <http://bauhaus/qualite/attribut/1797/S.18.3/text> ;
