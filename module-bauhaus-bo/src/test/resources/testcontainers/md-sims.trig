                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/1064>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête trimestrielle de conjoncture dans la promotion immobilière 2019"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONJ_PROMOTION_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1923/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>1&nbsp;000 unit&eacute;s</p>"@fr , "<p>1,000 units</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1923> .
    
    <http://bauhaus/qualite/attribut/1923/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 1,000 property development companies producing dwellings to buy and dwellings to rent."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1923/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les questions portent sur l’évolution de la demande de logements adressée aux entreprises, du nombre de logements mis en chantier, du nombre de permis demandé ou encore des prix des terrains.\n\nD’autres questions, posées uniquement sur les activités de vente, concernent l’apport des candidats à l’acquisition d’un logement neuf, les prix des logements mis en vente ou les moyens de financement de ces achats.\n\nLes questions de l’enquête sont toutes qualitatives et à trois modalités. Les résultats sont présentés sous forme de soldes d’opinion, correspondant aux différences entre le pourcentage de réponses « en hausse » (+) et le pourcentage de réponses « en baisse » (-)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1923/S.10.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey series are freely accessible in the macroeconomic database («BDM»)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1923/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is by post and via the internet over a period that extends from the end of the month preceding the reference quarter of the survey to the survey publication date, i.e. 4 business days before the end of the current month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1923/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1923> .
    
    <http://bauhaus/qualite/attribut/1923/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L’enquête est une enquête par sondage auprès de 1 000 entreprises de promotion immobilière de logements et de location de logements."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1923/S.3.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.5>
                    "L’unité interrogée est l’entreprise (au sens d’unité légale ou d’unité profilée)."@fr , "The unit interviewed is the company."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1923> .
    
    <http://bauhaus/qualite/attribut/1923/I.18.10>
