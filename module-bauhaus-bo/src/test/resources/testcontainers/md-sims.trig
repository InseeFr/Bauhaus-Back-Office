                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-04-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICA_chgt2016_note_methodo_FR.pdf> .
    
    <http://bauhaus/documents/document/627>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "What changed for turnover indexes since March 31st"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICA_chgt2016_note_methodo_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1776/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1776/S.10.6/text> , <http://bauhaus/qualite/attribut/1776/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les indices de chiffre d'affaires sont construits à partir d'une source fiscale, la déclaration CA3, formulaire que doivent remplir les entreprises pour le paiement de la taxe sur la valeur ajoutée (TVA).  \nIls comprennent l'ensemble du chiffre d'affaires des entreprises déclarantes, toutes activités confondues, classées selon l'activité principale de l'entreprise."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1776/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1776> .
    
    <http://bauhaus/qualite/attribut/1776/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
