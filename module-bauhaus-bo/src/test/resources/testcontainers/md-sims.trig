    <http://bauhaus/qualite/attribut/1837/S.13.3.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.13.3.1>
                    <http://bauhaus/qualite/attribut/1837/S.13.3.1/text> , <http://bauhaus/qualite/attribut/1837/S.13.3.1/texte> ;
