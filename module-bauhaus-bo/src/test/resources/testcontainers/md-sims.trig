<http://rdf.insee.fr/graphes/qualite/rapport/1582> {
    <http://bauhaus/qualite/attribut/1582/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Until 2007, the survey was conducted every month except August.  \n\nSince 2008, it takes place every month.  \n\nData collection is by post and via the internet over a period that extends from the end of the month preceding the survey month to the survey publication date, i.e. 4 business days before the end of the current month.  \n\nSurvey results are sent to the European Commission 4 business days before the end of the month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1582/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1582> .
    
