    <http://bauhaus/qualite/attribut/1929/S.8.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "le calendrier de diffusion est accessible sous :  \n<https://www.insee.fr/fr/information/1405540?debut=0>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1929/S.14.1/text> , <http://bauhaus/qualite/attribut/1929/S.14.1/texte> ;
