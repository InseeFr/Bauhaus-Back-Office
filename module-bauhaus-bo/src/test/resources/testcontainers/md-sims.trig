                    <http://bauhaus/qualite/rapport/1942> .
    
    <http://bauhaus/qualite/attribut/1942/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1942/I.18.10/text> , <http://bauhaus/qualite/attribut/1942/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
