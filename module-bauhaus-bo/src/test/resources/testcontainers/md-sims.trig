            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "No revision of survey data planned."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Energy purchases or consumption are those corresponding to all invoices received in 2018.<br />The information concerning the certification of the establishment refers to its situation in 2018.<br />The other questions (presence of a heat pump, industrial production activity, activity on customer site) relate to the&nbsp; establishment&rsquo;s situation at the time of responding to the survey.</p>"@en , "<p>Les achats ou consommations d&rsquo;&eacute;nergie sont ceux correspondant &agrave; l&rsquo;ensemble des factures re&ccedil;ues en 2018.<br />Les informations concernant la certification de l'&eacute;tablissement se r&eacute;f&egrave;rent &agrave; sa situation en 2018.<br />Les autres questions (pr&eacute;sence d&rsquo;une pompe &agrave; chaleur, activit&eacute; industrielle de production, activit&eacute; sur site client) sont relatives &agrave; la situation de l'entreprise au moment de r&eacute;pondre &agrave; l'enqu&ecirc;te.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/S.10.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.7>
                    <http://bauhaus/qualite/attribut/1907/S.10.7/texte> , <http://bauhaus/qualite/attribut/1907/S.10.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1907> .
    
    <http://bauhaus/qualite/attribut/1907/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
