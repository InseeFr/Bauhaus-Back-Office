    <http://bauhaus/qualite/attribut/1925/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 3,000 companies.\n\nAll companies with more than 200 employees are questioned, and all those with a turnover of more than a certain threshold, depending on their sub-sector of activity."@en ;
            <http://purl.org/dc/terms/language>
