    <http://bauhaus/qualite/attribut/1943/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
                    <http://bauhaus/qualite/attribut/1943/S.8.1/text> , <http://bauhaus/qualite/attribut/1943/S.8.1/texte> ;
