<http://rdf.insee.fr/graphes/qualite/rapport/1631> {
    <http://bauhaus/qualite/attribut/1631/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1631/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ de l'enquête réalisée à l'Insee en 2016 est le suivant :  \nÉtablissements exploitants, implantés en France (y compris Dom), ayant 20 salariés ou plus, dont l'activité principale est industrielle (y compris récupération de déchets), hors artisanat commercial et hors certaines industries de l'énergie. Plus précisément, le champ couvre les activités suivantes de la nomenclature NAF rév.2 : 07, 08, 09.9, 38.3 et 10 à 33 (sauf l'artisanat commercial : 10.13B, 10.71B, 10.71C, 10.71D, la cokéfaction-raffinage : 19.10Z, 19.20Z et l'enrichissement, le retraitement, l'élaboration ou la transformation de matières nucléaires : 20.13A, 24.46Z).  \nA partir de 2013, le champ a été restreint aux établissements de 20 salariés ou plus pour tous les secteurs. Auparavant étaient interrogés à partir de 10 salariés : les industries agro-alimentaires (IAA) jusqu'en 2011, et le secteur de la Fabrication de gaz industriels (2011Z) jusqu'en 2012."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/366>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2013 (et notice explicative) de l'enquête sur les consommations d'énergie dans l'industrie / EACEI"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_CONSO_ENERGIE_INDUSTRIE_EACEI_NOTICE.pdf> .
    
    <http://bauhaus/qualite/rapport/1631>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur les consommations d'énergie dans l'industrie 2013"@fr , "Quality report: Annual survey on industrial energy consumption 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1292> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is via the internet with the option of sending in a paper version of the questionnaire."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1631/S.3.6/text> , <http://bauhaus/qualite/attribut/1631/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/365>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête annuelle sur les consommations d'énergie dans l'industrie (EACEI)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-10-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_EACEI_2016.pdf> .
    
    <http://bauhaus/qualite/attribut/1631/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1631/S.19/texte> , <http://bauhaus/qualite/attribut/1631/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1631/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Since 2013, about 8,500 establishments are interviewed each year.  \n The sampling method is as follows:  \n- Completeness for establishments of 250 employees or more and for strata sizing less than 10 establishments;  \n- For other strata: a survey optimised by a Neyman allocation (on energy consumption), with stress on the precision of estimates by activity.  \nFrom the EACEI 2013, the sample frame of EACEI is drawn from the new statistical Sirus directory (this directory is used as a frame for all thematic surveys). This change has led to a sharp increase in the number of units belonging to the scope of the survey between 2012 and 2013 : this fact impacts the results level."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/364>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête annuelle sur les consommations d'énergie dans les industries agricoles et alimentaires et les scieries en 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-09-21"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/eacei_methodo_2010.pdf> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The scope of the survey conducted by INSEE in 2016 is :  \nEstablishments operators located in France (including overseas), with 20 employees or more, whose main activity is industrial (including recovery), excluding commercial crafts and excluding a part of energy industry. In code NAF rev. 2 this corresponds to: 07, 08, 09.9, 38.3 and 10 to 33 (except commercial crafts: 10.13B, 10.71B, 10.71C, 10.71D, manufacture of coke and refined petroleum products : 19.10Z, 19.20Z, enrichment, reprocessing and processing of nuclear fuel : 20.13A, 24.46 Z).  \nFrom 2013, the scope was restricted to establishments with 20 or more employees in all sectors. Previously establishments with 10 employees at least were interviewed: agrifood industries until 2011 and 2011Z sector until 2012."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1631/S.3.4/texte> , <http://bauhaus/qualite/attribut/1631/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This type of monitoring of industrial energy consumption is specific to all developed countries. The International Energy Agency (IEA) requires and assembles information on these subjects. \nFor European Union countries, Community regulation 58/97 concerning structural business statistics sets out additional obligations in this field."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée par internet avec envoi possible de questionnaire papier."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1631/S.10.6/texte> , <http://bauhaus/qualite/attribut/1631/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/documents/document/363>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-07-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_CONSO_ENERGIE_INDUSTRIE_EACEI_2013_bis.pdf> .
    
    <http://bauhaus/qualite/attribut/1631/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The EACEI survey is conducted among establishments, as this is where the energy consuming materials are implanted, and where the electricity meters and gas and fuel tanks are. Since the reporting year 2009, the survey has been conducted online (a paper version of the questionnaire may be sent upon request). Approximately 95% of the establishments surveyed respond oneline."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1631/I.18.10/text> , <http://bauhaus/qualite/attribut/1631/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ce suivi des consommations d'énergies industrielles est propre à tous les pays développés. L'Agence internationale de l'énergie (AIE) demande et rassemble l'information sur ces sujets. \nDe plus, pour les pays de l'Union européenne, le règlement communautaire 58/97 sur les statistiques structurelles d'entreprises fixe des obligations complémentaires dans ce domaine."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Environ 8 500 établissements sont interrogés. La méthode de sondage est la suivante :  \n - Exhaustivité pour les établissements de 250 salariés ou plus et pour les strates de taille inférieure à 10 établissements ;  \n- Pour les autres strates : sondage optimisé par une allocation de Neyman (sur les consommations d'énergie passées), avec contrainte sur la précision des estimations par activité.  \nA partir de l'EACEI 2013, la base de sondage de l'EACEI est constituée à partir du nouveau répertoire statistique Sirus (Système d'informations du répertoire des unités statistiques : répertoire servant de base de sondage à toutes les enquêtes thématiques). Cette modification a entrainé une forte augmentation du nombre d'unités appartenant au champ de l'enquête entre 2012 et 2013, ce qui a impacté les résultats en niveau.  \nLors de l'EACEI 2015, collectée en 2016, l'échantillon a été exceptionnellement complété par 5 500 unités (appartenant au même champ des établissements industriels de 20 salariés ou plus) également interrogés sur leurs consommations d'énergie en 2015, interrogés au second semestre 2016. Ce complément, portant exceptionnellement l'échantillon à 14 000 unités, permettra de produire des statistiques plus détaillées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/363> .
    
    <http://bauhaus/qualite/attribut/1631/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-01-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les thèmes de cette enquête sont l'observation des consommations d'énergie dans l'industrie en volume, en valeur et sur les usages.  \nL'interrogation utilise une typologie d'énergies compatible avec les définitions internationales.  \nCes thèmes abordent :  \n- la consommation de combustible ;  \n- la consommation totale d'énergie ;  \n- l'autoproduction ;  \n- les achats et la consommation d'électricité ;  \n- les achats, stocks et consommation de produits énergétiques en unité propre ;  \n- l'achat en valeur, le prix moyen d'achat et la répartition de la consommation de combustible par usage ;  \n- la répartition de la consommation d'électricité par usage."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The topics covered by this survey are the observation of industrial energy consumption by volume, by value and by use.  \nDuring the questioning stage an energy typology was used which was compatible with international definitions.  \nTopics covered are :  \n- fuel consumption;  \n- total energy consumption;  \n- self-production;  \n- electricity purchase and consumption;  \n- purchase, storage and consumption of energy products by industrial unit;  \n- value of purchases, average purchase price and distribution of fuel consumption by use;  \n- distribution of electricity consumption by use."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1631/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1631/S.18.3/text> , <http://bauhaus/qualite/attribut/1631/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
    
    <http://bauhaus/qualite/attribut/1631/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/366> .
    
    <http://bauhaus/qualite/attribut/1631/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'EACEI est une enquête réalisée auprès des établissements, car c'est là que sont implantés les matériels consommant de l'énergie, où se trouvent les compteurs d'électricité ou de gaz et les cuves de combustibles. Depuis l'année de constat 2009, l'enquête est effectuée par internet (un questionnaire papier peut être envoyé sur demande). Plus de 95 % des établissements interrogés répondent par internet.  \nPour en savoir plus : Cf. note méthodologique de l'EACEI sur le site de l'Insee (rubrique \" Sources et méthodes \")."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/364> , <http://bauhaus/documents/document/365> .
    
    <http://bauhaus/qualite/attribut/1631/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1631> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1510> {
    <http://bauhaus/qualite/attribut/1510/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1510/S.3.4/texte> , <http://bauhaus/qualite/attribut/1510/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/documents/document/573>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Fichier Général de l'État / FGE"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-04-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_Fichier_General_Agents_Etat_FGE.pdf> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Metropolitan France, French Overseas Departments (DOM) and French civil servants posted abroad."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Civil servants belonging to the Central Civil Service in the broad sense of the term (including certain Public Industrial and Commercial Institutions (EPIC)).\n\nThe survey covers metropolitan France, French Overseas Departments (DOM) and French civil servants posted abroad."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "France métropolitaine, départements d'outre-mer (DOM) et agents de l'Etat en poste à l'étranger."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Les salariés, leurs caractéristiques et celles de leurs emploi ;\n\n- Les rémunérations et leurs composantes."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2013-05-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1510/S.10.6/text> , <http://bauhaus/qualite/attribut/1510/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Lorsque la confrontation de cet ensemble de sources avec les résultats des années précédentes révéle des lacunes, ces dernières sont comblées en reprenant les mêmes agents (ou leurs prédécesseurs) dans le dernier poste de travail où ils sont effectivement recensés.  \n\nLeurs rémunérations font aussi l'objet de mises à jour, basées sur les augmentations générales de traitement et les variations de prélèvements sociaux éventuellement intervenues entre les deux dates.  \n\nLes fonctionnaires d'État dans les COM font l'objet d'estimations chaque année depuis 2000.  \n\nPar ailleurs, la confrontation de l'ensemble des données d'une année avec la base de données complète de l'année précédente permet, si nécessaire, de récupérer des informations qui n'avaient pu être obtenues (par exemple : statut, indice de traitement, emploi décrit précisément, commune de travail)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Agents de la fonction publique de l'État au sens large (y compris certains établissements publics à caractère industriel ou commercial (EPIC)).\n\nL'enquête couvre la France métropolitaine, les départements d'outre-mer (DOM) et les agents de l'Etat en poste à l'étranger."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/rapport/1510>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: File on central civil servants"@en , "Rapport qualité : Fichier général de l'État"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1171> .
    
    <http://bauhaus/qualite/attribut/1510/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "When gaps in the data are revealed by comparing all of these sources with the results of previous years, why the missing information is replaced by data for the same civil servants (or their predecessors) in the last post of employment in which they were actually surveyed.  \n\nTheir remunerations are also updated, based on the general salary increases and the variations in payroll taxes that may have occurred between the two dates.  \n\nEstimates have been provided for civil servants in the COMs each year since 2000.  \n\nIn addition, by comparing all of the data for one year with the complete database for the previous year, it becomes possible, if necessary, to gather information which was previously impossible to obtain (e.g. status, salary index, specific job description, municipality in which the job is based)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Plusieurs sources permettent d'élaborer ce système d'information sur les agents de l'État :  \n- des fichiers de paie annuels provenant de la Direction générale des Finances Publiques (DGFiP) pour les agents civils des ministères et de certains établissements publics ;  \n- le fichier annuel provenant du ministère de la Défense pour les militaires  ;  \n- les déclarations annuelles de données sociales (DADS) pour les agents de la FPE absents de la source DGFiP.\n\nCes données sont fournies par les administrations et organismes suivants :  \n- Les trésoreries générales (TG) de métropole et de 2 des 4 départements d'outre-mer (Antilles-Guyane, Réunion);  \n- La Trésorerie générale pour l'Étranger (TGE) ;  \n- Les déclarations annuelles de données sociales (DADS) ;  \n- Le ministère chargé de la Défense."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/573> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Employees, their descriptions and the nature of the work;\n\n- Remunerations and their components."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Several sources are used to create this information system :  \n\n-Data originating from the General Directorate for Public Finances (DGFiP) for civil servants (excluding military personnel) of ministries and employees of certain public establishments;  \n\n-This information base is supplemented by the \"Annual Declarations of Social Data\" (DADS);  \n\n-Data concerning military personnel whose pay is managed by the Ministry for Defence."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1510/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1510/S.3.6/texte> , <http://bauhaus/qualite/attribut/1510/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1510/S.18.3/text> , <http://bauhaus/qualite/attribut/1510/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1510/S.19/texte> , <http://bauhaus/qualite/attribut/1510/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
    
    <http://bauhaus/qualite/attribut/1510/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1510> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1548> {
    <http://bauhaus/qualite/attribut/1548/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête de 2016-2017 se déroule en 6 vagues d'environ 8 semaines chacune, de septembre 2016 à septembre 2017. A Mayotte, l'enquête est réalisée avec un décalage d'un an.\n\nL'enquête Budget de Famille utilise deux instruments de collecte :\n\n- un questionnaire de collecte assistée par informatique, réparti sur 2 visites, qui enregistre les dépenses importantes ou régulières effectuées au cours des 12 derniers mois, ainsi que des informations socio-démographiques, les caractéristiques du logement et des questions qualitatives illustrant la situation financière du ménage ;\n\n- un carnet auto-administré pour chaque membre du ménage âgé de plus de 14 ans dans lequel consigner toutes ses dépenses durant 7 jours."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1548/S.18.3/texte> , <http://bauhaus/qualite/attribut/1548/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ensemble des ménages ordinaires de France entière (métropole et Dom).  \nReprésentativité géographique : ZEAT (Zone d'études et d'aménagement du territoire) pour la métropole, départementale pour les Dom."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1548/I.18.10/text> , <http://bauhaus/qualite/attribut/1548/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The 2016-2017 survey is conducted in 6 waves of approximately 8 weeks each, from September 2016 to September 2017.\n\nThe Household Budget Survey uses two data collection instruments:\n\n- a questionnaire using computer-assisted data collection, broken down over 2 visits, which records income over the last 12 months and major or regular expenditure, also socio-demographic information, characteristics of the dwelling and qualitative questions about the household's financial situation;\n\n- a self-completed diary in which all members of the household aged over 14 record all their expenditure over 7 days."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1548/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-10-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/U> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête s’étend de septembre 2016 à septembre 2017 et se déroule en deux visites auprès de toutes les unités de vie du ménage.\n\nTous les 5 ans"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All ordinary households in the whole of France (mainland and overseas departments).  \nGeographic representation: Zones for study and development (ZEAT) in Metropolitan France, departmental in the overseas departments."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/H> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1548/S.3.6/text> , <http://bauhaus/qualite/attribut/1548/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Échantillon (aléatoire à taux de sondage uniforme) d'environ 20 700 logements en France métropolitaine, et 8 000 dans les Dom.\n\nDans l'enquête 2016-2017, les familles monoparentales sont sur-échantillonnées : 2 000 logements supplémentaires ont été tirés en France métropolitaine à partir des fichiers d'allocataires de la CNAF."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1548/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1548/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Sample (random self-weighted sample) of about 20,700 dwellings in Metropolitan France, 8,000 in the overseas departments.\n\nThe survey 2016-2017 includes an upsample of single-parent families of 2,000 dwellings from administrative data source (CNAF) "@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1548/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
    
    <http://bauhaus/qualite/attribut/1548/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Consommation, dépenses, ressources, opinion sur la situation financière, caractéristiques socio-démographiques et équipement. L'édition 2016-2017 de l'enquête comporte en outre pour la première fois des questions sur l'économie du partage (covoiturage par exemple). "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1548>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête Budget de famille 2017"@fr , "Quality report: Household budget survey 2017"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1341> .
    
    <http://bauhaus/qualite/attribut/1548/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.4>
                    "Euro"@fr , "Euro"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1548> .
}

