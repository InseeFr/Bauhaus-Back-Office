    <http://bauhaus/qualite/attribut/1919/S.18.5/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Une chaîne de contrôles et redressements automatiques spécifique a été mise en œuvre. Cette chaîne assure en outre la cohérence des données de l'enquête avec les données fiscales de l'entreprise."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/1054>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Construction (Questionnaire 2017)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
