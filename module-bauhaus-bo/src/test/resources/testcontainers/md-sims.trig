    <http://bauhaus/qualite/attribut/1679/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2016M029EC"@fr , "2016M029EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1679> .
    
    <http://bauhaus/qualite/attribut/1679/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers the activities defined by the NAF rev. 2 code: 55.30Z (campsites and areas for caravans or leisure vehicles). Only residentials campsites are not surveyed.\n\nThe survey covers campsites, classified from 1 to 5 stars or non-classified sites offering at least one short-stay pitch."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1679/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1679> .
    
    <http://bauhaus/qualite/attribut/1679/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "A compter de la saison 2013, l'enquête n'est plus exhaustive : elle est réalisée auprès d'un échantillon de 6.000 campings sur 8,000"@fr , "From the 2013 season, the survey is no longer exhaustive: it is carried out with a sample of 6,000 campsites from 8,000"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1679> .
    
    <http://bauhaus/qualite/attribut/1679/I.6.3>
