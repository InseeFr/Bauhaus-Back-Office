    <http://bauhaus/qualite/attribut/1897/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey covers the activities defined by the NAF rev.2 codes: 55.10Z (hotels and similar accommodation).  \n\nThe survey covers all tourist-oriented hotels, whether classified or not."@en ;
            <http://purl.org/dc/terms/language>
