                    <http://bauhaus/documents/document/414> .
    
    <http://bauhaus/qualite/attribut/1601/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1601/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée tous les trimestres. Elle est effectuée en janvier, avril, juillet et octobre, soit le premier mois de chaque trimestre.\n\nLa collecte se fait par voie postale et par internet de la fin du mois précédant le mois de l'enquête jusqu'à la fin du mois de l'enquête."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1601/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre l'industrie manufacturière et les industries extractives ; divisions 08 à 33 de la NAF rév. 2 (hors 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1601/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
