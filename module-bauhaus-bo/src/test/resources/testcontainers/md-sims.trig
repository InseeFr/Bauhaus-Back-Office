    <http://bauhaus/qualite/attribut/1796/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1796/S.10.6/texte> , <http://bauhaus/qualite/attribut/1796/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
