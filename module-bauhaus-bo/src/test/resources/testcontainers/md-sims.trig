            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "DREES : raphaelle.rivalin@sante.gouv.fr INSEE :sebastien.grobon@insee.fr"@fr , "DREES : raphaelle.rivalin@sante.gouv.fr INSEE :sebastien.grobon@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
