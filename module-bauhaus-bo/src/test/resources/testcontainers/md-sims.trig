            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/576> , <http://bauhaus/documents/document/578> , <http://bauhaus/documents/document/577> , <http://bauhaus/documents/document/580> , <http://bauhaus/documents/document/579> , <http://bauhaus/documents/document/582> , <http://bauhaus/documents/document/584> , <http://bauhaus/documents/document/583> , <http://bauhaus/documents/document/581> .
    
    <http://bauhaus/documents/document/584>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
