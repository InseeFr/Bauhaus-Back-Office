    <http://bauhaus/documents/document/974>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Liste des variables CIS2016"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2018-09-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/S_3_1_Liste_variables_CIS16.pdf> .
    
    <http://bauhaus/qualite/attribut/1553/S.3.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The main areas of distribution are the company's sector of activity and the size of the company."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1553/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Pas de révision prévue sur les données de l'enquête."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1553/S.11.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The variable on the share of operating expenses (LGPC) is distributed with great caution. It has a fairly high non-response rate (9%). In addition, the collection team reported difficulties for companies in answering this question: this does not correspond to items in the chart of accounts. Finally, the wording of the question suggests that zero should be set for companies that did not have a cost for logistics innovations in 2016. Among innovative companies in logistics 1/4 put 0 and among non-innovators in logistics 2/3 put 0. In addition, the cooperation or turnover variables resulting from innovations new to the market or to the company have variation coefficients greater than 20% for certain sectors (industry, sections B and C in particular)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1553/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Chef de la division Enqu&ecirc;tes th&eacute;matiques et &eacute;tudes transversales (ETET)</p>"@fr , "<p>Head of the Thematic Surveys and Cross-Sectional Studies Section</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1553/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.17.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.1>
                    <http://bauhaus/qualite/attribut/1553/S.17.1/text> , <http://bauhaus/qualite/attribut/1553/S.17.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon est tiré dans une base de sondage construite à partir du répertoire Sirus selon un plan de sondage aléatoire simple stratifié selon l’activité, la tranche d’effectifs et la région lorsque cela était possible. Le calcul des allocations combine une allocation de Neyman sur le taux d’unités innovantes et une allocation proportionnelle sur le nombre d’unités innovantes, ce qui permet d’une part d’être précis sur la variable centrale de l’enquête (le taux d’innovation) et également d’interroger un nombre raisonnable d’unités innovantes afin d’assurer une précision satisfaisante pour les questions ne concernant que ces unités."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1553/S.10.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Insee Résultats sur Insee.fr  \nIndicateurs Eurostat sur <http://ec.europa.eu/eurostat/data/database>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1553/S.3.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les principaux domaines de diffusion sont le secteur d’activité de l’entreprise et la taille de l’entreprise."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1553/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1553/S.11.2/text> , <http://bauhaus/qualite/attribut/1553/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1553/S.3.3/text> , <http://bauhaus/qualite/attribut/1553/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte de CIS2016 s'est déroulée du 11 mai 2017 au 5 janvier 2018, date de fermeture du portail d’authentification Coltrane pour cette enquête. Elle est réalisée par internet (95% des retours) et, éventuellement, par voie postale (à la demande de l'entreprise).\n\nLa zone géographique de référence couvre la France métropolitaine et les départements d'outre-mer (DOM) y compris Mayotte.\n\nUnités de mesure :  \n- Effectifs (TEFF_coll) en nombre de salariés ;  \n- Montants (CA, RALLX, RRDINX, RRDEXX, RMACX, ROEKX et ROTRX) en milliers d'euros ;  \n- Part des produits nouveaux pour un des marchés de l’entreprise (TURNMAR), part des produits nouveaux uniquement pour l’entreprise (TURNIN), part des produits inchangés (TURNUNG), part des des dépenses d’exploitation consacrée à la logistique (LGPC), part du CA à l’export en 2014 (SLO14) et en 2016 (SLO16) en pourcentage (%) ;  \n- Variable binaire ou multimodale pour les données qualitatives."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1553/S.10.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.2>
                    <http://bauhaus/qualite/attribut/1553/S.10.2/text> , <http://bauhaus/qualite/attribut/1553/S.10.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The main topics covered in the CIS2016 survey are as follows:  \n- Presence of innovation by type of innovation (products, processes, organisational, marketing)  \n- Turnover share from product or service innovations introduced between 2014 and 2016   \n- Expenditure associated with product and process innovation activities  \n- Public funding (European and national)  \n- Forms of cooperation for the development of innovations  \n- Intellectual property rights (patent filing, design registration etc.)  \n- Non-innovative companies: factors explaining the lack of innovation over the 2014-2016 period  \n- Logistics innovations"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1553/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1553/S.7.2/texte> , <http://bauhaus/qualite/attribut/1553/S.7.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-03-23"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Fran&ccedil;ois-Xavier Dussud</p>"@fr , "<p>Fran&ccedil;ois-Xavier Dussud</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>23&nbsp;240&nbsp;unit&eacute;s</p>"@fr , "<p>23,240&nbsp;units</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.13.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.13.1>
                    <http://bauhaus/qualite/attribut/1553/S.13.1/text> , <http://bauhaus/qualite/attribut/1553/S.13.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.16/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The median response time (estimated after adjustment) is 30 minutes.  \nThe Label Committee ensures that the survey does not place an excessive burden on respondents, In addition, other decisions have been made to limit the burden on respondents:   \n- negative coordination of the ICT sample with samples from a number of other surveys;  \n- electronic collection;  \n- possibility to validate the last known turnover and headcount, pre-filled in the questionnaire;  \n- possibility to answer some questions in % if the exact number value is unknown."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1553/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>2014 to 2016 depending on the questions</p>"@en , "<p>2014 &agrave; 2016 selon les questions</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.13.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Des calculs de précision sont effectués sur l'ensemble des variables.  \nLes indicateurs de précision (écart-type ou coefficient de variation, intervalle de confiance à 95%) prennent en compte les erreurs dues à l’échantillonnage, à la correction de la non-réponse totale, au calage et à la winsorisation, mais pas l’erreur liée à la correction de la non-réponse partielle."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1553/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La variable sur la part de dépenses d’exploitation (LGPC) est diffusée avec beaucoup de précautions. Elle a un taux de non-réponse assez élevé (9%). De plus, l’équipe de collecte a fait remonter des difficultés pour les entreprises à répondre à cette question : cela ne correspond pas à des postes du plan comptable. Enfin, la formulation de la question suggère de mettre zéro aux entreprises n’ayant pas eu de coût pour les innovations en logistique en 2016. Parmi les entreprises innovantes en logistique 1/4 ont mis 0 et parmi les non-innovante en logistique 2/3 ont mis 0.  \nPar ailleurs, les variables de coopération ou de chiffres d’affaires issus d’innovations nouvelles pour le marché ou pour l’entreprise ont des coefficeint de variation supérieurs à 20% pour certains secteurs (industrie, sections B et C notamment)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/976> .
    
    <http://bauhaus/qualite/attribut/1553/S.11.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.1>
                    <http://bauhaus/qualite/attribut/1553/S.11.1/text> , <http://bauhaus/qualite/attribut/1553/S.11.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.3.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.2>
                    <http://bauhaus/qualite/attribut/1553/S.3.2/texte> , <http://bauhaus/qualite/attribut/1553/S.3.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The legal units surveyed will be units located in France (metropolitan France and the French overseas departments, including Mayotte), active as of 31/12/2016 and having had at least 6 months of activity, merchants, operators with 10 or more employees (in FTEs) excluding the Syndicat Intercommunal à Vocation Unique (SIVU) (legal category 7353)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1553/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "No revision of survey data planned."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1553/S.18.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.5>
                    <http://bauhaus/qualite/attribut/1553/S.18.5/texte> , <http://bauhaus/qualite/attribut/1553/S.18.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1553/S.7.1/text> , <http://bauhaus/qualite/attribut/1553/S.7.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.16>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.16>
                    <http://bauhaus/qualite/attribut/1553/S.16/texte> , <http://bauhaus/qualite/attribut/1553/S.16/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1553> .
    
    <http://bauhaus/qualite/attribut/1553/S.17.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "No revision of survey data planned."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1553/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
