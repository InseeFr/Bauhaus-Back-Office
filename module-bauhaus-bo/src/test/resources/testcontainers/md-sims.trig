    <http://bauhaus/qualite/attribut/1643/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1643/S.3.6/text> , <http://bauhaus/qualite/attribut/1643/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
