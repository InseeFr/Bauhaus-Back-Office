            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1930> .
    
    <http://bauhaus/qualite/attribut/1930/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Insee Première, Insee Résultats"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1930/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête TIC 2020 répond au règlement européen n°2019/1910 du 7 novembre 2019 portant application, pour l'année de référence 2020, du règlement (CE) n°808/2004 du Parlement européen et du Conseil concernant les statistiques communautaires sur la société de l'information.  \nCette enquête a été financée par l'Union européenne."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
