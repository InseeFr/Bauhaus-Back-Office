                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/406> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1604/S.3.6/texte> , <http://bauhaus/qualite/attribut/1604/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La formulation des questions est conçue de manière à faciliter une réponse rapide (la plupart des questions sont qualitatives à trois modalités exprimées sous la forme \"supérieur, égal, baisse\", ou \"fort, normal, faible\")."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1604/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-G001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 1,000 property development companies producing dwellings to buy and dwellings to rent."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/406>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête trimestrielle de conjoncture dans la promotion immobilière"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-01-26"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/methodo_enq_trim_promo_immob_26012016.pdf> .
    
    <http://bauhaus/qualite/attribut/1604/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1604/I.18.10/text> , <http://bauhaus/qualite/attribut/1604/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1604/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Questions are formulated so that they can be answered quickly (most of the questions are qualitative with three response options expressed in the form \"higher, same, lower\", or \"strong, normal, weak\")."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1604/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The quarterly business outlook survey in real estate development records the opinion of developers and housing rental companies on their recent activity and on their future planned activity.\n\nThis opinion is obtained by tracking the demand for new housing for sale or rent, unsold housing stock, housing sale prices. Data about future trends are provided in particular by monitoring opinions on housing starts."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1604/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1604/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1604/S.3.4/texte> , <http://bauhaus/qualite/attribut/1604/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
    
    <http://bauhaus/qualite/attribut/1604/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted every quarter (in January, April, July and October, i.e. the month after the end of each quarter).\n\nData collection is by post from the end of the month preceding the survey month to the end of the survey month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1604>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Quarterly business outlook survey in real estate development 2014"@en , "Rapport qualité : Enquête trimestrielle de conjoncture dans la promotion immobilière 2014"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1110> .
    
    <http://bauhaus/qualite/attribut/1604/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête trimestrielle de conjoncture dans la promotion immobilière permet de transcrire l'opinion des promoteurs et des entreprises réalisant de la location immobilière sur leur activité récente et sur leurs perspectives d'activité.\n\nCette opinion est retracée au moyen du suivi de la demande en logements neufs à acheter et à louer, des stocks de logements invendus, du prix de vente des logements. Les données sur les perspectives sont fournies notamment par le suivi des opinions sur les mises en chantier."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1604/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1604/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1604> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1725> {
    <http://bauhaus/qualite/attribut/1725/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The surveying of a new set is launched every 4 years."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/175> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    ""@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-09-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "SINE est un système permanent d'observation et de suivi d'une génération (ou cohorte) de nouvelles entreprises tous les quatre ans.\n\nUne génération correspond ici aux entreprises créées au cours de la même période (le premier semestre) d'une année donnée. Chaque génération d'entreprises est donc représentée par les seules créations du premier semestre de l'année.\n\nPour chaque génération, le recueil d'information repose sur trois interrogations :  \n- la première, quelques mois après la création de l'entreprise ;  \n- la deuxième, au bout de la troisième année d'existence de l'entreprise ;  \n- la troisième, cinq ans après la création.\n\n "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1725/S.18.3/texte> , <http://bauhaus/qualite/attribut/1725/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1725/I.18.10/texte> , <http://bauhaus/qualite/attribut/1725/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/rapport/1725>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: New enterprises information system 2002"@en , "Rapport qualité : Système d'information sur les nouvelles entreprises 2002"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1081> .
    
    <http://bauhaus/qualite/attribut/1725/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Each generation (or set) of businesses responds to three surveys using two different questionnaires: a questionnaire for the first survey upon start-up and a second questionnaire for the second and third surveys, after three years and five years of activity."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/175>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête auprès des entreprises créées ou reprises en 2002 : Situation initiale"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-12-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_SINE_Initial_2002.pdf> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/U> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The economic coverage of the SINE programme matches the businesses' demographic scope: all market activities, excluding agricultural activities.\n\nUntil the 2002 set, the SINE system only covered the \"ICS\" scope (Industry, the building industry, Trade and Services)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le questionnaire porte sur :  \n- le profil du créateur et les conditions de démarrage de l'entreprise ;  \n- l'évolution de l'activité de l'entreprise, le type de clientèle, la coopération avec les autres entreprises ;  \n- l'évolution des effectifs (embauches, licenciements, personnel occasionnel) ;  \n- les investissements et leur mode de financement ;  \n- la formation et les conseils après la création ;  \n- les difficultés rencontrées par l'entreprise ;  \n- la stratégie de l'entreprise ;  \n- les conditions de son développement."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1725/S.3.6/texte> , <http://bauhaus/qualite/attribut/1725/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1725/S.19/text> , <http://bauhaus/qualite/attribut/1725/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'interrogation d'une nouvelle cohorte est initialisée tous les 4 ans."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Chaque génération (ou cohorte) d'entreprises fait l'objet de trois enquêtes par le biais de deux questionnaires différents : un questionnaire pour la première interrogation dès la création et un second questionnaire pour la deuxième et la troisième interrogation, après trois ans et cinq ans d'activité."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La couverture économique du dispositif SINE correspond au champ de la démographie d'entreprises : l'ensemble des activités marchandes, hormis les activités agricoles.\n\nJusqu'à la cohorte 2002, le dispositif SINE ne couvrait que le champ dit \"ICS\" (de l'Industrie, de la construction, du Commerce et des Services)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "SINE is an ongoing system to observe and monitor a generation (or set) of new enterprises every four years.\n\nIn this case, a generation is a group of enterprises created over the same period (the first half) of a given year. Each generation of enterprises is therefore only represented by the companies created in the first half of the year.\n\nFor each generation, the information is collected using three surveys:  \n- the first, a few months after the creation of the enterprise;  \n- the second, at the end of the third year of existence of the enterprise;  \n- the third, five years after its creation.\n\n "@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1725/S.3.4/texte> , <http://bauhaus/qualite/attribut/1725/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The questionnaire dealt with:  \n- the profile of the creator and the conditions for the start-up of the enterprise;  \n- the development of the enterprise's activity, type of clientele, cooperation with other enterprises;  \n- changes to employee numbers (hiring, dismissals, occasional staff);  \n- investments and their form of financing;  \n- training and advice after start-up;  \n- the difficulties encountered by the enterprise;  \n- the enterprise's strategy;  \n- the conditions for its development."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1725/I.18.7/text> , <http://bauhaus/qualite/attribut/1725/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Toutes les nouvelles entreprises ne sont pas enquêtées.\n\nLes échantillons de la cohorte 2002 du dispositif SINE sont tirés à partir des créations d'entreprises enregistrées dans le répertoire Sirene au cours du premier semestre 2002 réparties en strates selon la région, l’activité et l’origine de la création (création pure ou reprise).\n\nRappel : sur les cohortes 2006 et antérieures, le régime de l’auto-entrepreneur n’existait pas encore. Il n’y a donc qu’un seul questionnaire.\n\nAttention, la notion de reprise n'est plus appréhendée de la même façon avec les concepts européens de démographie d'entreprises, adoptés en France à partir de 2007.\n\nDès lors, on n'interroge plus, dans SINE, à compter le la cohorte 2010, que des créations selon la définition européenne.\n\nLa cohorte 2002 fait donc encore appel à l’ancienne définition de création avant cette harmonisation européenne.\n\nLe mode de tirage de l'échantillon permet une représentativité nationale et régionale des résultats.\n\nSeules les entreprises survivantes sont ensuite réinterrogées après trois ans et cinq ans d'existence.\n\nL'échantillon total SINE 2002 (première interrogation de la génération 2002) compte environ 47 600 créateurs (dont environ 7 500 au titre d’extensions régionales).\n\nLa deuxième interrogation de cette cohorte a eu lieu en 2005 et la troisième en 2007.\n\nL’échantillon couvre la France entière, DOM compris."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1725/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1725/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1725> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1955> {
    <http://bauhaus/qualite/attribut/1955/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The LFS Mayotte questionnaire is structured around the following themes:  \n- a description of the household and its members;  \n- the status of an activity according to the ILO definition;  \n- a detailed description of the current main job (occupation, working time, kind of contract, etc.).  \n- the description of the employing institution  \n- The caracteristics of job search activities  \n- the level of education and participation in training;  \n- the situation one year before the survey (place of residence, labour market situation, etc.);  \n- the past and desired geographic mobility ;  \n- casual activities ;  \n- incomes."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1955/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>From March to July</p>"@en , "<p>De mars&nbsp; &agrave;&nbsp; juillet</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/I.18.7/text>
