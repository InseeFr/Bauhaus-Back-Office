    <http://bauhaus/qualite/attribut/1815/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "L'enquête est réalisée auprès d'un échantillon national d'environ 12.000 hôtels sur un total de 18.000."@fr , "The survey is conducted on a national sample of about 12,000 hotels from 18,000."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée par voie postale."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Documents-collecte\n\nNotice relative à l'enquête de fréquentation dans l'hôtellerie 2016\n\n23/05/2016\n\nNotice_explicative_Hotel_2016.pdf\n\n73 Ko\n\nPdf\n\nDocuments-collecte\n\nQuestionnaire Antilles - Guyane de l'enquête de fréquentation dans l'hôtellerie 2016\n\n23/05/2016\n\nQuestionnaire_Hotel_Antilles_2016.pdf\n\n133 Ko\n\nPdf\n\nDocuments-collecte\n\nQuestionnaire France métropolitaine de l'enquête de fréquentation dans l'hôtellerie 2016\n\n23/05/2016\n\nQuestionnaire_Hotel_Metro_2016.pdf\n\n60 Ko\n\nPdf\n\nDocuments-collecte\n\nQuestionnaire Réunion - Mayotte de l'enquête de fréquentation dans l'hôtellerie 2016\n\n23/05/2016 Questionnaire_Hotel_Reunion_2016.pdf\n\n164 Ko\n\nPdf"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Concerning the expansion to include overseas departments (DOM), two specific questionnaires were introduced: one for the three DOM in the French Antilles and one for Reunion Island.\n\nThis provides a statistical observation of tourism across the entire French territory.\n\nThis survey falls within the scope of European reglement 692/2011 on the collection of statistical information in the field of tourism in Eurostat.\n\nIt also meets the needs of the national department of tourism and of local and regional actors and decision-makers in the field of tourism."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1815/S.3.4/text> , <http://bauhaus/qualite/attribut/1815/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1815/I.18.10/text> , <http://bauhaus/qualite/attribut/1815/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2016M027EC"@fr , "2016M027EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/263> .
    
    <http://bauhaus/qualite/rapport/1815>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête de fréquentation dans l'hôtellerie 2013"@fr , "Quality report: Hotel occupancy survey 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1089> .
    
    <http://bauhaus/qualite/attribut/1815/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Comité de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry : DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D). \nThe needs of local partners are taken into account through partnership agreements with the tourism sites of Insee."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is by post."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-09-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey covers the activities defined by the NAF rev.2 codes: 55.10Z (hotels and similar accommodation).\n\nThe survey covers all tourist-oriented hotels, whether classified or not."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le parc est mesuré au 31 décembre de chaque année et la fréquentation sur chaque mois.\n\nLes principaux thèmes abordés sont les suivants :\n\n- caractéristiques de l'établissement ;\n\n- capacité d'accueil ;\n\n- occupation quotidienne des chambres ;\n\n- arrivées et nuitées selon le pays de résidence des touristes ;\n\n- durée moyenne de séjour ;\n\n- proportion de tourisme d'affaires."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sampling frame is the file of tourism hotels managed by INSEE.\n\nThe stratification criteria for the national sample are:\n\n- the geographical focus (regions, national tourist areas (ETNs))\n\n- hotel category (1 to 5 stars or unclassified)\n\n- type of hotel (chain or independent) Within the strata, the draw is random."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/263>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-01-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_FREQ_HOTELLERIE_2013.pdf> .
    
    <http://bauhaus/qualite/attribut/1815/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1815/S.18.3/text> , <http://bauhaus/qualite/attribut/1815/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre les activités définies par les codes NAF rév. 2 : 55.10Z (hôtels et hébergement similaire).\n\nL'enquête concerne les hôtels à vocation touristique, qu'ils soient classés ou non."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Concernant l'extension aux départements d'outre-mer (DOM), deux questionnaires spécifiques ont été mis en place : un pour les trois DOM antillais et un pour la Réunion.\n\nElle permet ainsi une observation statistique du tourisme sur l'ensemble du territoire français.\n\nCette enquête rentre dans le cadre du règlement européen 692/2011 concernant la production d'informations statistiques sur le tourisme à Eurostat.\n\nElle répond également aux besoins nationaux de la direction du tourisme et locaux pour les acteurs et décideurs régionaux du tourisme."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1815/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1815/S.19/texte> , <http://bauhaus/qualite/attribut/1815/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
    <http://bauhaus/qualite/attribut/1815/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1815> .
    
