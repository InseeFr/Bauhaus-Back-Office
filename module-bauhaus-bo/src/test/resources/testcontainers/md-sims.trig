    <http://bauhaus/documents/document/139>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2014"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-03-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_CVS_2014.pdf> .
    
    <http://bauhaus/qualite/attribut/1743/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1743/I.18.10/text> , <http://bauhaus/qualite/attribut/1743/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1743> .
    
    <http://bauhaus/qualite/attribut/1743/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Act(s) of destruction or damage to property (housing and vehicles): burglaries, thefts or attempted thefts, violence etc.  \n- Personal theft(s) or attempted personal theft(s), physical violence, threats and insults;  \n- Opinions on living environment and the feeling of insecurity, whether the respondent was exposed to problems related to drugs, alcohol or other trafficking;  \n- Consequences of victimisation: filing of complaints, declaration(s) to the authorities, psychological damage, adopting of new forms of behaviour, etc."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1743/S.11.2/texte>
