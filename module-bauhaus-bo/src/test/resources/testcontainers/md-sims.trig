            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon comporte environ 33 000 agents de l’État sélectionnés aléatoirement dans le fichier du système d’information sur les agents des services publics (SIASP)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1932/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
