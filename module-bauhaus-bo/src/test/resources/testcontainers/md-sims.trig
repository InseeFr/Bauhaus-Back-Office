    <http://bauhaus/documents/document/1261>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire d'enquête auprès des entreprises créées en 2018 - situation en 2021 (test2)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0027-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/NOTICE_SINE_2020.pdf> .
    
    <http://bauhaus/qualite/attribut/1962/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "SINE est un système permanent d'observation et de suivi d'une génération (ou cohorte) de nouvelles entreprises tous les quatre ans.\n\nUne génération correspond ici aux entreprises créées au cours de la même période (le premier semestre) d'une année donnée. Chaque génération d'entreprises est donc représentée par les seules créations du premier semestre de l'année.\n\nPour chaque génération, le recueil d'information repose sur trois interrogations :  \n- la première, quelques mois après la création de l'entreprise ;  \n- la deuxième, au bout de la troisième année d'existence de l'entreprise ;  \n- la troisième, cinq ans après la création."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1962/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    " L'interrogation d'une nouvelle cohorte est initialisée tous les 4 ans."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
