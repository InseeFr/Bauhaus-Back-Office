            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/rapport/1706>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur la production de déchets non dangereux dans l'industrie 2008"@fr , "Quality report: Survey of the production of non-hazardous waste by industrial etablishments 2008"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1305> .
    
    <http://bauhaus/qualite/attribut/1706/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/231> .
    
    <http://bauhaus/qualite/attribut/1706/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1706/S.19/texte> , <http://bauhaus/qualite/attribut/1706/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The frame of the survey is the Sirus directory (directory of statistical units).\n\nThe sampling method: stratification by industry and by local unit size.\n\nThe survey is exhaustive for establishments with 250 or more employees (approximately 1,800 establishments)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1706/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1706/S.3.6/texte> , <http://bauhaus/qualite/attribut/1706/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1706/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This themed survey only deals with non-hazardous waste. Data on hazardous waste is obtained by consulting the annual  administrative declarations for hazardous waste fulfilled by establishments (database on directory polluting emissions directory : BDREP)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1706/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The questionnaire includes 3 sections:  \n\n- the first part requires background information relating to the scope of the survey (activity, numbers);  \n\n- the second part requires qualitative information on waste management and the importance of environmental concerns for the establishment. This provides qualitative insight into the figures required in the third part:  \n\n- the third part requires tonnages according to the type of waste, as well as information on its collection and its processing. It is broken down into three sub-sections on non-hazardous slurry and organic waste, mixed non-hazardous waste,  and non-hazardous sorted waste."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1706/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1706/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1706/S.3.4/texte> , <http://bauhaus/qualite/attribut/1706/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1706/I.18.10/text> , <http://bauhaus/qualite/attribut/1706/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1706> .
    
    <http://bauhaus/qualite/attribut/1706/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Internet with the possibility of sending by mail upon request. The collection takes place from September to December n + 1.\n\nThe survey is conducted every four years. The last survey was conducted in 2016."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1706/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le questionnaire comporte 3 parties :  \n\n- la première partie demande les informations de cadrage relatives au champ de l'enquête (activité, effectif) ;  \n\n- la deuxième partie demande des informations qualitatives sur la gestion des déchets et l'importance des préoccupations environnementales au sein de l'établissement. Elles apportent un éclairage qualitatif aux informations chiffrées demandées dans la troisième partie ;  \n\n- la troisième partie demande les tonnages selon le type de déchets, ainsi que des informations sur la collecte et le traitement. Elle se décompose en trois sous-parties relatives aux déchets de boues et organiques non-dangereux, aux déchets non dangereux en mélange et aux déchets non dangereux triés."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1706/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage est le répertoire Sirus (répertoire des unités statistiques).\n\nLa méthode d'échantillonnage : stratification par secteur d'activité et taille d'unité locale.\n\nL'enquête est exhaustive pour les établissements de 250 salariés et plus (environ 1 800 établissements). "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1719> {
    <http://bauhaus/qualite/attribut/1719/S.7.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "In so far as concerns collection via the Internet, the Coltrane collection site is totally secure and the standards in terms of managing survey access codes are strict and standardized for all surveys. For enterprises that choose to use paper, the managers are responsible for the input, and must strictly respect the confidentiality of any data collected.  \nThis confidentiality applies before any data is disseminated. For data relating to enterprises - no results are published that relates to less than three enterprises or establishments. Similarly, a result will only be disseminated if no enterprise or institution contributes more than 85% of this result. Primary suppressions correspond to boxes that do not meet the above criteria. Secondary confidentiality removes other boxes so that the data can not be retrieved by adding and subtracting with the margins of the tables. Statistical confidentiality is defined in law n° 51-711 of 7 June 1951."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les thèmes abordés dans l’enquête sont les suivants :  \n- l’activité principale de l’entreprise ;  \n- les événements survenus pendant l’exercice comptable (Fusion-Absorption, Transmission Universelle de Patrimoine, Apport partiel d’actifs/Scission, …) ;  \n- les détails de la restructuration (augmentation et diminution des immobilisations corporelles) ;  \n- les investissements et cessions corporels ;  \n- l’emploi (personnel non salarié, personnel intérimaire, personnel mis à disposition d’autres sociétés, …) ;  \n- la répartition du chiffre d’affaires par produit ou activité détaillé ;  \n- es dépenses professionnelles (achats non stockés, sous-traitance incorporée, etc.) ;\n\nDes caractéristiques sectorielles comme :  \n- la répartition du chiffre d’affaires selon les formes de vente pour les entreprises du commerce de détail ;  \n- l’équipement commercial (nombre de points de vente, nombre de magasins  par surface de vente) pour les entreprises du commerce ;  \n- l’analyse de la clientèle (répartition du chiffre d’affaires par type de clientèle) ;  \n- l’analyse des fournisseurs pour les entreprises du commerce ;  \n- les autres charges et charges externes (sous-traitance générale, loyers et charges locatives, dépenses d’entretien, …) pour les entreprises de transport ;  \n- les immobilisations pour les entreprises agro-alimentaires et les coopératives agricoles ;  \n- les travaux réalisés sur des bâtiments existants ou non  ;  \n- la localisation des chantiers, les travaux réalisés sur des bâtiments existants ou non, la nature des ouvrages réalisés ;  \n- la liste des établissements immatriculés à Sirene, la sous-traitance de capacité, le crédit-bail pour les entreprises forestières."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is historically conducted by mail. It is possible to respond by internet since 2013, via a fillable PDF questionnaire. The internet data collection mode is expected to grow in the future, with the forthcoming integration of the survey in Coltrane, the internet-based data collection system currently developped by Insee.\n\nThe annual data on the year N is collected in several waves between February and June of the year N+1  in order to take account of businesses' different financial year end dates."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1719/S.12.1/text> , <http://bauhaus/qualite/attribut/1719/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1719/S.3.3/texte> , <http://bauhaus/qualite/attribut/1719/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "More precisely, in terms of sectors of activity, the scope of the survey in metropolitan France includes the sectors of forestry and sawmills, agri-food industries, trade, construction, transport and other mainly market services (excluding the financial sector).  \nThere is also a specific questionnaire for the French overseas departments, covering all these sectors, plus industry."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.7.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.2>
                    <http://bauhaus/qualite/attribut/1719/S.7.2/texte> , <http://bauhaus/qualite/attribut/1719/S.7.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/documents/document/192>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Industries agricoles et alimentaires (IAA) (Questionnaire 2016)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-02-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_esa2016_industries_agricoles_et_alimentaires.pdf> .
    
    <http://bauhaus/qualite/attribut/1719/S.18.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.5>
                    <http://bauhaus/qualite/attribut/1719/S.18.5/texte> , <http://bauhaus/qualite/attribut/1719/S.18.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/I.18.12/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "As the scope of the survey in terms of sector is very wide (see § on sector coverage), there are different models of questionnaires, adapted to the different main sectors covered by the survey."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/189> , <http://bauhaus/documents/document/190> , <http://bauhaus/documents/document/195> , <http://bauhaus/documents/document/193> , <http://bauhaus/documents/document/191> , <http://bauhaus/documents/document/196> , <http://bauhaus/documents/document/206> , <http://bauhaus/documents/document/194> , <http://bauhaus/documents/document/192> .
    
    <http://bauhaus/qualite/attribut/1719/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Emmanuel Gros</p>"@fr , "<p>Emmanuel Gros</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "Année civile"@fr , "Calendar year"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "A specific data editing procedure has been implemented. This procedure  also ensures the consistency of the survey data with admistrative data."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "For the metrolopitan France, the scope of the survey covers the economic sectors of trade, market services excluding financial enterprises, the agri-food industries, building industry, transport, forestry and sawwmills (class 02.20).   \nFor the overseas departments, the survey covers in addition the extractive, manufacturing and energy industry. The survey also allows to collect accounting information for the profiled enterprises.\n\nAll sizes of businesses are covered by the scope of the survey."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les données définitives sont publiées en fin juin N+2 pour les données de l'exercice N."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.8.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.1>
                    <http://bauhaus/qualite/attribut/1719/S.8.1/text> , <http://bauhaus/qualite/attribut/1719/S.8.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "Année civile"@fr , "Calendar year"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.8.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The data are published in the INSEE Results section and available at insee.fr"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1719/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L’enquête est historiquement réalisée par voie postale. La possibilité de répondre par internet est proposée depuis 2013, via un système de PDF remplissable en dépôt-retrait. La collecte par internet est amenée à ce développer fortement à partir de l’ESA 2018 collectée en 2019, avec l’intégration de l’enquête dans Coltrane qui proposera un « vrai » questionnaire en ligne.\n\nLa collecte annuelle sur l’exercice de l’année N, est effectuée en plusieurs vagues entre février et juin de l’année N+1 afin de tenir compte des différentes dates de clôture d’exercice des entreprises."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1719/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1719/S.7.1/text> , <http://bauhaus/qualite/attribut/1719/S.7.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1719> .
    
    <http://bauhaus/qualite/attribut/1719/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "National accounts, statistical agencies, researchers"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/191>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Transports (Questionnaire 2016)"@fr ;
