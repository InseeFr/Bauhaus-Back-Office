            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1608/S.3.6/texte> , <http://bauhaus/qualite/attribut/1608/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1608> .
    
    <http://bauhaus/qualite/attribut/1608/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
