    <http://bauhaus/qualite/attribut/1778/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/qualite/territoire/franceHorsMayotte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1778/S.18.3/text> , <http://bauhaus/qualite/attribut/1778/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
    
    <http://bauhaus/qualite/attribut/1778/S.14.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 days"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1778/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1778> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1899> {
    <http://bauhaus/qualite/attribut/1899/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2018-07-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Comité de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry : DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D).   \nThe needs of local partners are taken into account through partnership agreements with the tourism sites of Insee."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "<p>The survey is conducted among a national sample of approximately 2,500 establishments from 3,500.</p>"@en , "<p>L'enqu&ecirc;te est r&eacute;alis&eacute;e aupr&egrave;s d'un &eacute;chantillon national d'environ 2 500 &eacute;tablissements sur un total de 3 500.</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is by post, and centralized collection at some enterprises (example Lagrange)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête de fréquentation dans les autres hébergements collectifs touristiques complète les informations concernant la fréquentation touristique déjà produites par :  \n- les enquêtes de fréquentation dans l'hôtellerie de tourisme ;  \n- les enquêtes de fréquentation dans l'hôtellerie de plein air.  \nCette enquête rentre dans le cadre du réglement européen n°692/2011 concernant la production d'informations statistiques sur le tourisme à Eurostat.  \nElle répond également aux besoins nationaux de la Direction Générale des Entreprises (DGE) et locaux pour les acteurs et décideurs régionaux du tourisme.  \nLe dispositif comporte deux extensions régionales dans les deux régions où existaient déjà cette enquête (Rhône-Alpes, Languedoc-Roussillon).  \nDans les DOM, les autres hébergements collectifs sont enquêtés dans l'enquête de fréquentation hôtelière."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1899/S.19/text> , <http://bauhaus/qualite/attribut/1899/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1899/S.18.3/text> , <http://bauhaus/qualite/attribut/1899/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le parc est mesuré au 31 décembre de chaque année et la fréquentation sur chaque mois.  \nLes principaux thèmes abordés sont les suivants :  \n- caractéristiques de l'établissement ;  \n- capacité d'accueil ;  \n- occupation quotidienne des chambres ;  \n- arrivées et nuitées selon le pays de résidence des touristes ;  \n- durée moyenne de séjour ;  \n- proportion de tourisme d'affaires."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1899/I.18.10/texte> , <http://bauhaus/qualite/attribut/1899/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The units surveyed are collective tourist accommodation that is subject to regulation : youth hostels, international accommodation centres, sports centres, tourism and hotel residences, family holiday homes and holiday villages.\n\nThe economic unit surveyed is the accommodation operator (NAF rev. 2: 55.10Z and 55.20Z)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1899/S.3.6/text> , <http://bauhaus/qualite/attribut/1899/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sampling frame is the file of the other collective housing managed by INSEE. The stratification criteria for the national sample are:  \n- the geographical focus (regions, national tourist areas (ETNs))  \n- type of establishment  \nWithin the strata, the draw is random."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage est le fichier des autres hébergements collectifs géré par l'Insee. Les critères de stratification de l'échantillon national sont :  \n- l'axe géographique (régions, espaces touristiques nationaux (ETN))  \n- le type d'établissement  \nAu sein des strates, le tirage est aléatoire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1899/S.12.1/texte> , <http://bauhaus/qualite/attribut/1899/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les unités enquêtées sont les hébergements collectifs touristiques faisant l'objet d'une réglementation : auberges de jeunesse, centres internationaux de séjour, centres sportifs, résidences de tourisme et résidences hôtelières, maisons familiales de vacances et villages de vacances.\n\nL'unité économique interrogée est l'exploitant de l'hébergement (NAF rév. 2 : 55.10Z et 55.20Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The occupancy survey in other collective tourist accommodation supplements the tourist occupancy information already produced by:  \n- Occupancy surveys of tourist hotels  \n- Occupancy surveys of campsites  \nThis survey relates to European reglement n°692/2011 concerning the production of statistical information on tourism at EUROSTAT.  \nIt also meets the French national needs of the Enterprise Directorate General  and the local needs of regional tourism stakeholders and decision makers.  \nThe scheme includes two regional extensions in the two regions already covered by this survey (Rhône-Alpes, Languedoc-Roussillon).  \nIn the overseas departments, other collective tourist accomodation are in the hotel occupancy survey."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1899/I.18.7/texte> , <http://bauhaus/qualite/attribut/1899/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le Comité de Coordination des Statistiques du Tourisme (CCST), animé par l'Insee, intègre les principaux acteurs nationaux du tourisme : DGE, Atout France, fédérations professionnelles des hôteliers et représentants des comités départementaux et régionaux du tourisme (FNCRT, RN2D).   \nLes besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1899/S.3.4/text> , <http://bauhaus/qualite/attribut/1899/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017M030EC"@fr , "2017M030EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/attribut/1899/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The park is measured on December 31 of each year and the attendance over each month.  \nThe main themes addressed are the following:  \n- characteristics of the establishment ;  \n- reception capacity ;  \n- daily occupancy of rooms ;  \n- arrivals and nights according to the country of residence of tourists ;  \n- average length of stay ;  \n- proportion of business tourism."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
    
    <http://bauhaus/qualite/rapport/1899>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête de fréquentation dans les autres hébergements collectifs touristiques 2017"@fr , "Quality report: Other Collective Tourist Accommodation Occupancy Survey 2017"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1455> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Questionnaires are sent at the end of the month for the month of collection."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1899/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les questionnaires sont envoyés en fin de mois pour le mois de collecte."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée par voie postale, ainsi qu'une collecte centralisée auprès de certaines enseignes (exemple Lagrange)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1899/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1899> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1766> {
    <http://bauhaus/documents/document/797>
