                    <http://bauhaus/qualite/attribut/1813/S.3.4/texte> , <http://bauhaus/qualite/attribut/1813/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/documents/document/267>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire France métropolitaine de l'enquête de fréquentation dans l'hôtellerie 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaire_hotel_metro_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1813/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le parc est mesuré au 31 décembre de chaque année et la fréquentation sur chaque mois.\n\nLes principaux thèmes abordés sont les suivants :\n\n- caractéristiques de l'établissement ;\n\n- capacité d'accueil ;\n\n- occupation quotidienne des chambres ;\n\n- arrivées et nuitées selon le pays de résidence des touristes ;\n\n- durée moyenne de séjour ;\n\n- proportion de tourisme d'affaires."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1813/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2016M027EC"@fr , "2016M027EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/266> , <http://bauhaus/documents/document/267> , <http://bauhaus/documents/document/268> , <http://bauhaus/documents/document/269> .
    
    <http://bauhaus/qualite/attribut/1813/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1813/S.18.3/texte> , <http://bauhaus/qualite/attribut/1813/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/documents/document/266>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire Réunion de l'enquête de fréquentation dans l'hôtellerie 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaire_hotel2015_Reunion.pdf> .
    
    <http://bauhaus/qualite/attribut/1813/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1813/S.19/text> , <http://bauhaus/qualite/attribut/1813/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre les activités définies par les codes NAF rév. 2 : 55.10Z (hôtels et hébergement similaire).\n\nL'enquête concerne les hôtels à vocation touristique, qu'ils soient classés ou non."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1813/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1813/S.12.1/texte> , <http://bauhaus/qualite/attribut/1813/S.12.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le Comité de Coordination des Statistiques du Tourisme (CCST), animé par l'Insee, intègre les principaux acteurs nationaux du tourisme : DGE, Atout France, fédérations professionnelles des hôteliers et représentants des comités départementaux et régionaux du tourisme (FNCRT, RN2D). \nLes besoins des partenaires locaux sont pris en compte dans des conventions de partenariat avec les sites tourisme de l'Insee."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1813/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-09-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sampling frame is the file of tourism hotels managed by INSEE. The stratification criteria for the national sample are:\n\n- the geographical focus (regions, national tourist areas\n\n(ETNs))\n\n- hotel category (1 to 5 stars or unclassified)\n\n- type of hotel (chain or independent) Within the strata, the draw is random."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1813/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey covers the activities defined by the NAF rev.2 codes: 55.10Z (hotels and similar accommodation).\n\nThe survey covers all tourist-oriented hotels, whether classified or not."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1813/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Concernant l'extension aux départements d'outre-mer (DOM), deux questionnaires spécifiques ont été mis en place : un pour les trois DOM antillais et un pour la Réunion. Elle permet ainsi une observation statistique du tourisme sur l'ensemble du territoire français. Cette enquête rentre dans le cadre du règlement européen 692/2011 concernant la production d'informations statistiques sur le tourisme à Eurostat. Elle répond également aux besoins nationaux de la direction du tourisme et locaux pour les acteurs et décideurs régionaux du tourisme."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1813/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/rapport/1813>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Hotel occupancy survey 2015"@en , "Rapport qualité : Enquête de fréquentation dans l'hôtellerie 2015"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1087> .
    
    <http://bauhaus/qualite/attribut/1813/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1813/S.3.6/texte> , <http://bauhaus/qualite/attribut/1813/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/documents/document/269>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice relative à l'enquête de fréquentation dans l'hôtellerie 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/notice_explicative_hotel_2015.pdf> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.11>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.11>
                    "L'enquête est réalisée auprès d'un échantillon national d'environ 12.000 hôtels sur un total de 18.000."@fr , "The survey is conducted on a national sample of about 12,000 hotels from 18,000."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée par voie postale."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1813/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Hotel stock is measured every year on 31 December and occupancy is measured every month.\n\nThe main topics considered are:\n\n- characteristics of the establishment;\n\n- accommodation capacity;\n\n- daily room occupancy;\n\n- arrivals and nights spent by country of residence of tourists;\n\n- average length of stay;\n\n- proportion of business tourism."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1813/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/documents/document/268>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire Antilles de l'enquête de fréquentation dans l'hôtellerie 2015Questionnaire Antilles - Guyane de l'enquête de fréquentation dans l'hôtellerie 2015"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-05-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/questionnaire_hotel2015_Antilles.pdf> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage est le fichier des hôtels de tourisme géré par l'Insee.\n\nLes critères de stratification de l'échantillon national sont :\n\n- l'axe géographique (régions, espaces touristiques nationaux (ETN))\n\n- la catégorie d'hôtel (1 à 5 étoiles ou non classé)\n\n- le type d'hôtel (chaîne ou indépendant) Au sein des strates, le tirage est aléatoire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1813/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Comité de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry : DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D). \nThe needs of local partners are taken into account through partnership agreements with the tourism sites of Insee."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1813/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1813/I.18.10/text> , <http://bauhaus/qualite/attribut/1813/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1813> .
    
    <http://bauhaus/qualite/attribut/1813/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Concerning the expansion to include overseas departments (DOM), two specific questionnaires were introduced: one for the three DOM in the French Antilles and one for Reunion Island.\n\nThis provides a statistical observation of tourism across the entire French territory.\n\nThis survey falls within the scope of European reglement 692/2011 on the collection of statistical information in the field of tourism in Eurostat.\n\nIt also meets the needs of the national department of tourism and of local and regional actors and decision-makers in the field of tourism."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1813/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is by post."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

