    <http://bauhaus/documents/document/599>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie des indices des prix agricoles"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-06-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_IPAMPA_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1798/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les données sont publiées habituellement le dernier jour ouvré du mois (en dehors des lundi)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1798/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La méthodologie de calcul des indices des prix des produits agricoles à la production est précisée dans le \"Manuel de la statistique UE des prix agricoles\". La version 2.1 la plus récente (novembre 2015) n’est disponible qu’en anglais (voir document \"Handbook for EU Agricultural Price Statistics\")."@fr ;
