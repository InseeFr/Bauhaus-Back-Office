    <http://bauhaus/documents/document/153>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2016 de l'enquête sur les technologies de l'information et de la communication et le commerce électronique (auprèsdes entreprises) / TIC"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-01-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
