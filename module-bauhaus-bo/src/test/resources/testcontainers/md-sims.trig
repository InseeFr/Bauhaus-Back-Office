            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1639/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Depuis 2012, La base de sondage est le répertoire Sirus (répertoire des unités statistiques).\n\nLa méthode d'échantillonnage : stratification par secteur d'activité et taille d'unité locale.\n\nL'enquête est exhaustive pour les établissements de 250 salariés et plus. "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1639/S.19/text> , <http://bauhaus/qualite/attribut/1639/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/348> .
    
    <http://bauhaus/qualite/attribut/1639/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1639/S.3.6/texte> , <http://bauhaus/qualite/attribut/1639/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Cette enquête thématique ne concerne que les déchets non dangereux. Les données sur les déchets dangereux sont obtenues par l'exploitation des déclarations administratives annuelles obligatoires en matière de déchets dangereux remplies par les entreprises (Base de données du répertoire des émissions polluantes : BDREP)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "These are establishments with 20 or more employees, with a NAF rev. 2 code belonging to the divisions 46 and 47 (wholesale and retail trade, except of motor vehicles and motorcycles).\n\nThe sample is about 5000 units.\n\nThe survey covers Metropolitan France and the overseas departments."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Internet with the possibility of sending by mail upon request. The data collection of the year n takes place from September to December n + 1.\n\nThe survey is aperiodic. The two last surveys were conducted in 2007, on the observation years 2006 and in 2013, on the observation year 2012.\n\nThe data collection of the year n takes place from September to December n + 1."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1639/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Internet avec possibilité d'envoi par courrier sur demande. La collecte des données de l'année n se déroule de septembre à décembre n+1.\n\nL'enquête est apériodique. Les deux dernières enquêtes datent de 2007, sur l'année de constat 2006 et de 2013, sur l'année de constat 2012.\n\nLa collecte des données de l'année n se déroule de septembre à décembre n+1."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1639/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1639/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le questionnaire comporte 3 parties :  \n\n- la première partie recueille des informations de cadrage relatives aux établissements du  champ de l'enquête (activité, effectif) ;  \n\n- la deuxième partie recueille des informations qualitatives sur la gestion des déchets et l'importance des préoccupations environnementales au sein de l'établissement ;  \n\n- la troisième partie recueille  les tonnages de déchets produits selon leur type, ainsi que des informations sur leur collecte et leur traitement. Elle se décompose en trois sous-parties : les  boues et déchets organiques non-dangereux, les  déchets non dangereux en mélange et  les  déchets non dangereux triés."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1639>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on non-hazardous waste in wholesale and retail trade 2012"@en , "Rapport qualité : Enquête sur la production de déchets non dangereux dans le commerce 2012"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1355> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The questionnaire includes 3 sections:  \n\n- the first part collects background information relating to the establishments of the scope of the survey (activity, numbers);  \n\n- the second part collects qualitative information on waste management and the importance of environmental concerns for the establishment.  \n\n- the third part collects tonnages of producted waste according to their type, as well as information on  their collection and their processing. It is broken down into three sub-sections: non-hazardous slurry and organic waste, mixed non-hazardous waste, non-mixed non-hazardous waste."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1639/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/348> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1639/S.3.4/text> , <http://bauhaus/qualite/attribut/1639/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Il s'agit des établissements de 20 salariés et plus, ayant un code NAF rév. 2 appartenant aux divisions 46 et 47 (commerce de gros et commerce de détail à l'exception des automobiles et des motocycles).\n\nL'échantillon est de l'ordre de 5 000 unités.\n\nL'enquête couvre la France métropolitaine et les départements d'outre-mer (DOM)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/348>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2012 de l'enquête sur la production de déchets non dangereux dans le commerce"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-08-26"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_DECHETS_NDGRX_COMMERC_2012_QUEST.pdf> .
    
    <http://bauhaus/qualite/attribut/1639/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1639/I.18.10/texte> , <http://bauhaus/qualite/attribut/1639/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1639> .
    
    <http://bauhaus/qualite/attribut/1639/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This thematic survey concerns only non-hazardous waste. Data on hazardous waste are produced by the operation of mandatory annual administrative declarations for hazardous waste fulfilled by firms (French pollutant emission database : BDREP)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

