                    <http://bauhaus/qualite/attribut/1979/S.6.1/texte> , <http://bauhaus/qualite/attribut/1979/S.6.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les données sont collectées tout au long de l’année.\n\nLa collecte est effectuée sous collecte assistée par informatique (Capi), en face-à-face pour la première et la dernière interrogations, et par téléphone pour les interrogations intermédiaires.  \nSi une personne ne peut (ou ne veut) pas répondre, une autre personne peut le faire à sa place (proxy).\n\nUne enquête annuelle spécifique a lieu à Mayotte."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1979/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1979/I.18.7/text> , <http://bauhaus/qualite/attribut/1979/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
}

