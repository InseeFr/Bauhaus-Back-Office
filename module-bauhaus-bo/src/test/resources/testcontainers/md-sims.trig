            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet du CIRET, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Centre international de recherche sur les enquêtes tendancielles - CIRET"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.ciret.org> .
    
    <http://bauhaus/qualite/attribut/1618/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête trimestrielle de conjoncture dans les travaux publics a pour objet de transcrire l'opinion des entrepreneurs du secteur sur leur activité récente et sur leurs perspectives d'activité. Cette opinion est retracée au moyen du suivi, notamment : de l'activité passée et future, des carnets de commandes et des prix ; des délais de paiement ; de la capacité de production ; des facteurs limitant l'activité ; des effectifs."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1618/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1618/S.11.2/text> , <http://bauhaus/qualite/attribut/1618/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1618> .
    
    <http://bauhaus/qualite/attribut/1618/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1618> .
    
    <http://bauhaus/qualite/attribut/1618/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The quarterly business outlook survey on public works records the opinions of entrepreneurs in the sector about their recent activities and activity planned for the future. These opinions are obtained mainly by tracking: past and future activity, order books and prices; payment deadlines; production capacity; factors which limit activity; workforce."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1618/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1618> .
    
    <http://bauhaus/qualite/attribut/1618/I.18.9>
