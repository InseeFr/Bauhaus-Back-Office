                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/169> .
    
    <http://bauhaus/qualite/attribut/1728/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les unités interrogées sont les unités légales de moins de 10 personnes occupées hors unités agricoles, financières et d'assurance. Les activités concernées, en NAF rév. 2, sont les sections C à J, L, N, ainsi que les divisions 69 à 74 et le groupe 95.1."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête TIC-TPE est une extension aux entreprises occupant moins de 10 personnes de l'enquête annuelle TIC, extension demandée par la commission \" Entreprises et stratégies de marché \" du Conseil national de l'information statistique (CNIS) lors du renouvellement du label d'intérêt général de l'enquête TIC pour les années 2011 à 2015.\n\nL'enquête TIC-TPE a obtenu le label d'intérêt général et de qualité statistique avec caractère obligatoire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "De septembre à décembre 2012"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/S.10.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Insee Résultats"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2012A088EC"@fr , "2012A088EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1728/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/170> .
    
    <http://bauhaus/qualite/attribut/1728/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The ICT-TPE survey is an extension to firms employing less than 10 people from the annual ICT survey, extension requested by the Committee \"Business and market strategies\" of the National Council for Statistical Information (CNIS) on renewal of the general interest label of the ICT survey for the years 2011 to 2015.\n\nThe ICT-TPE survey obtained the label of general interest and statistical quality with binding."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Web survey"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1728/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1728/S.3.4/text> , <http://bauhaus/qualite/attribut/1728/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les principaux thèmes abordés sont l'équipement en technologies de l'information et de la communication (TIC), l'accès à internet et son usage, le partage automatique de l'information et le commerce électronique."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1728/S.18.3/texte> , <http://bauhaus/qualite/attribut/1728/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.12.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Un comité de concertation, composé des experts et représentants des politiques publiques concernées par les questions de technologie de l'information, de la communication et de commerce électronique (SOeS, SSP, DGE, CCIP, ARCEP, SGMAP, Télécom Paris Tech…) ainsi que des représentants d'organisations professionnelles, ou de syndicats de salariés (FEVAD, Syntec Numérique, Medef, CCIP, CGPME, CGT, FO…) s'est réuni pour participer à la conception du questionnaire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/S.10.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Insee Résultats"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1728/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-08-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1911> {
    <http://bauhaus/qualite/attribut/1911/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All main residences rented in an unfurnished state which essential reason for the rental is housing.  \nSince 2013 for metropolitan France and since July 2017 for Guadeloupe, the scope of the survey has been restricted to the private sector (social sector is collected through the quarterly survey on the rents of the social sector)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1911/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2019T002EC"@fr , "2019T002EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Each quarter, approximately 3,700 homes in Metropolitan France and 600 in Guadeloupe form part of the sample to be surveyed.  \nThese are main residences rented in an unfurnished state, whose main purpose is residential: the accommodation concerned must not have more than 50% of its surface area used for a professional activity.  \nSub-let accommodation, leases with purchase options (or rental/purchase schemes) and accommodation occupied on a free basis, are excluded from the field of the survey.  \nThe sample is drawn from the INSEE master sample (derived from the population census).  \nOne fifth of the sample is renewed each quarter: the outgoing sample consists of accommodation surveyed 5 times and accommodation which fell outside the scope of the previous survey.  \nEach quarter, the outgoing sub-sample is replaced by an incoming sub-sample."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1911/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1911/S.18.3/text> , <http://bauhaus/qualite/attribut/1911/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Caractéristiques de l'immeuble, du logement (dont les éléments de confort) ;  \n- Mode de location et aides perçues ;  \n- Montants des loyers et des charges."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1911/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Chaque trimestre, environ 3 700 logements en métropole et 600 en Guadeloupe font partie de l'échantillon à enquêter.  \nIl s'agit de résidences principales louées vides dont l'objet essentiel de la location est l'habitation : les logements concernés ne doivent pas avoir plus de 50 % de leur surface consacrée à une activité professionnelle.  \nSont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occupés à titre gratuit.  \nL'échantillon est tiré dans l'échantillon maître de l'Insee (issu du recensement de la population).  \nUn cinquième de l'échantillon est renouvelé chaque trimestre : l'échantillon sortant se compose des logements interrogés 5 fois et des logements hors champ à l'enquête précédente.  \nOn effectue chaque trimestre le remplacement du sous-échantillon sortant par un sous échantillon entrant."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1911/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ensemble des résidences principales louées vides dont l'objet essentiel de la location est l'habitation.  \nDepuis 2013 pour la métropole et depuis juillet 2017 pour la Guadeloupe, l'enquête porte uniquement sur les loyers du secteur libre (les logements du secteur HLM sont interrogés via l'enquête ELBS)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1911/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Since 1958</p>"@en , "<p>Depuis 1958</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Collection is carried out in January, April, July and October.  \nThis is a panel survey: the occupants of the accommodation are interviewed during 5 consecutive quarters.  \nThe first and last interviews of a household are conducted by visits (and after any change of tenant, or in the event of any difficulties in obtaining information by telephone). Intermediate surveys are conducted by telephone.  \n\nSurvey in Guadeloupe since October 2010."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1911/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Characteristics of the residential building and accommodation (including conveniences);  \n- Rental method and benefits received;  \n- Total amounts of rents and charges."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1911/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est effectuée en janvier, avril, juillet et octobre.  \nIl s'agit d'une enquête par panel : on interroge les occupants du logement pendant 5 trimestres consécutifs.  \nLa première et la dernière interrogation d'un ménage sont réalisées par visite (et après tout changement de locataire ou en cas de difficulté éventuelle d'obtention des informations par téléphone). Les interrogations intermédiaires sont menées par téléphone.  \n\nEnquête en Guadeloupe depuis octobre 2010."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1911/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1911/S.3.6/text> , <http://bauhaus/qualite/attribut/1911/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/rapport/1911>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport de métadonnées 1911"@fr , "Metadata report 1911"@en .
    
    <http://bauhaus/qualite/attribut/1911/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1911/I.18.10/texte> , <http://bauhaus/qualite/attribut/1911/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "-dg75-F330@insee.fr"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
    
    <http://bauhaus/qualite/attribut/1911/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1911/S.3.4/texte> , <http://bauhaus/qualite/attribut/1911/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1911> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1802> {
    <http://bauhaus/qualite/attribut/1802/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1802/S.10.6/text> , <http://bauhaus/qualite/attribut/1802/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/attribut/1802/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/attribut/1802/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1802/S.19/text> , <http://bauhaus/qualite/attribut/1802/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/attribut/1802/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Costs, construction"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1802/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/attribut/1802/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Public Works (TP) indices are cost indices for different  public works activities, apprehended from 7 line-items in a cost accounting approach: \"capital goods\", \"labour costs\" once called \"salaries and costs\", \"energy\", \"materials\", \"miscellaneous expenses\", \"transport\", “waste” similar to the productivity economists' approach called \"KLEMST\" (K = capital for \"material\", L = Labour ,\" E = energy, M = materials, S = Service for \"miscellaneous expenses\" T = transport). The structure and weights of various construction indices have been reviewed on the occasion of new base and reference 2010.  \n\n(See also methodological note)"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/757> , <http://bauhaus/documents/document/1160> , <http://bauhaus/documents/document/597> , <http://bauhaus/documents/document/755> .
    
    <http://bauhaus/qualite/attribut/1802/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1802/S.3.6/text> , <http://bauhaus/qualite/attribut/1802/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/documents/document/597>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Building indices, Civil engineering indices and various indices for construction"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-05-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_INDEX_BAT_BT_BASE_2010_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1802/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/attribut/1802/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1802/S.18.3/text> , <http://bauhaus/qualite/attribut/1802/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/documents/document/757>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Civil engineering indices"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_TP_BASE_2010_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1802/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The public works (TP) indices do not give rise to a new survey, but use existing public statistics, including from survey on Producer Price Indices (OPISE), which provide the elementary indices."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1802/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les index TP ne donnent pas lieu à une enquête nouvelle, mais utilisent les statistiques publiques existantes, notamment le dispositif OPISE, pour constituer les indices élémentaires."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1802/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Coût, construction"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/756>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique de l'index dans les travaux publics en base 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_TP_BASE_2010_FR.pdf> .
    
    <http://bauhaus/qualite/attribut/1802/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les index travaux publics (TP) sont des indices de coûts des différentes activités du secteur de la construction, appréhendés à partir de 7 postes dans une démarche de comptabilité analytique : « coût du travail » jadis appelé « salaires et charges », « matériaux », « matériel », « énergie », « transport », « frais divers », « déchets », analogue à l'approche « KLEMS » des économistes de la productivité (K = capital pour « matériel », L = labour pour « travail », E = energy pour « énergie », M = materials pour « matériaux », S = services pour « frais divers »).   \nLa structure et les pondérations des index TP ont été revues, à l’occasion de la base et référence 2010, à partir des sources structurelles Insee confrontées aux travaux des fédérations professionnelles.  \nLes index TP sont des indices de Laspeyres chaînés à tous les niveaux (d’indices élémentaires issus de la statistique publique à postes, de postes à index, d’index à l’index TP01).  \n\n(Voir aussi  la note méthodologique)"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/756> , <http://bauhaus/documents/document/1160> , <http://bauhaus/documents/document/755> , <http://bauhaus/documents/document/1> .
    
    <http://bauhaus/qualite/attribut/1802/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1802/S.3.4/texte> , <http://bauhaus/qualite/attribut/1802/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/attribut/1802/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/documents/document/1160>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique Composition detaillée des index TP en base 2010 "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Met_composition_detaillee_index_TP_base_2010.pdf> .
    
    <http://bauhaus/qualite/attribut/1802/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les tableaux liés présentés dans la rubrique \"Documents associés\" fournissent les pondérations des différents index, par postes, au sein des postes le cas échéant, et par index pour le TP01 (l'index TP01 est lui-même obtenu comme moyenne pondérée des autres index TP, avec les coefficients de la colonne de gauche du tableau).  \n\nConceptuellement, l'unité observée sur ses coûts est une branche ou sous-branche d'activité des entreprises françaises de construction."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1802/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Conceptually, the statistical unit observed on its costs is a branch or sub-branch of activity of French public works companies.  \n\nSee associated documents."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1802/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/documents/document/755>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique Correspondance entre les nouveaux et les anciens index TP"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_CORRESPONDANCE_NOUV_ANCIENS_TP.pdf> .
    
    <http://bauhaus/qualite/attribut/1802/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Public Works (TP) indices are released during the third month following the month under review, on the site of the Macro-economic database BDM in the topic \"Prices and price indices\" under \"Construction producer costs\". They are also published in the Official Journal. "@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1802/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/attribut/1802/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-02-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1802> .
    
    <http://bauhaus/qualite/rapport/1802>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Index travaux publics (base 2010)"@fr , "Quality report: Public works Indice (base 2010)"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1661> .
    
    <http://bauhaus/documents/document/1>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note méthodologique de l'index TP"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2015-11-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/methodo_BTP_10112015.pdf> .
    
    <http://bauhaus/qualite/attribut/1802/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les index TP sont diffusés au cours du troisième mois suivant le mois sous revue, sur le site de la BDM, dans le thème « Prix et indices de prix », rubrique « Indices des prix de production et de coûts dans la construction », sous-rubrique « Indices des coûts de production dans la construction (indexation de contrats) ». Ils sont aussi publiés au Journal Officiel."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1923> {
