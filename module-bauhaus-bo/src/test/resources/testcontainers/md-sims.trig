            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée par courrier et internet entre septembre et novembre 2014 puis par téléphone par un enquêteur auprès des non répondants entre novembre 2014 et février 2015."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
