                    <http://bauhaus/qualite/rapport/1974> .
    
    <http://bauhaus/documents/document/1282>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Commerce de gros (Questionnaire 2020)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
