    <http://bauhaus/qualite/attribut/1929/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1929/I.18.12/texte> , <http://bauhaus/qualite/attribut/1929/I.18.12/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1929> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les fichiers de réponses individuelles sont mis en conservation annuellement. Toute demande d’accès à ces données individuelles est soumise à l’autorisation du comité du secret statistique. Les données sont alors mises à  à disposition des utilisateurs extérieurs à l’Insee via le CASD (Centre d’accès sécurisé aux données), après passage au Comité du secret."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1929/S.10.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.4>
                    <http://bauhaus/qualite/attribut/1929/S.10.4/text> , <http://bauhaus/qualite/attribut/1929/S.10.4/texte> ;
