    <http://bauhaus/qualite/attribut/1949/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1949/I.18.7/texte> , <http://bauhaus/qualite/attribut/1949/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1949> .
    
    <http://bauhaus/qualite/attribut/1949/S.11.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The quaterly outlook survey on investment in industry is part of the harmonised European Union programme of business and consumer surveys to which the 28 Member States of the European Union contribute.\n\nThus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system.\n\nQuestions are formulated so that they can be answered quickly."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1949/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers manufacturing industry and extraction industries; divisions 08 to 33 of French Nomenclature of Activities (NAF Rev. 2)  (except 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@en ;
            <http://purl.org/dc/terms/language>
