    <http://bauhaus/qualite/attribut/1801/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "Insee, 18 boulevard Adolphe Pinard, 75675 Paris cedex 14."@fr , "Insee, 18 boulevard Adolphe Pinard, 75675 Paris cedex 14."@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1801> .
    
    <http://bauhaus/qualite/rapport/1801>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Localised unemployment rates (by region, department and employment area)"@en , "Rapport qualité : Taux de chômage localisés (par régions, départements et zones d'emploi)"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1660> .
    
    <http://bauhaus/qualite/attribut/1801/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The localised unemployment rate estimation method is based on an estimate of, firstly, the unemployment (numerator) and, secondly, the employment (a part of the denominator), by employment area and department.  \n\nThe numerator is obtained each quarter by breaking down national figures for unemployment using the geographical structure observed in the DEFM.  \n\nThe employment is computed mainly due to employment estimations.  \n\nThe localised unemployment rate is finally calculated by comparing the number of unemployed persons to the labour force (sum of the number of unemployed persons and occupied active persons) estimated in this manner."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1801/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1801/S.3.4/text> , <http://bauhaus/qualite/attribut/1801/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1801> .
    
    <http://bauhaus/qualite/attribut/1801/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>En moyenne sur le trimestre.<br />En moyenne sur l'ann&eacute;e (depuis 2014 pour les DOM hors Mayotte).</p>"@fr , "<p>Quartely average.<br />Annual average (since 2014 for overseas department except Mayotte).</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1801> .
    
    <http://bauhaus/qualite/attribut/1801/S.12.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Need information on labour market, and especially about unemployment for all people, media and local administration."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1801/S.3.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
