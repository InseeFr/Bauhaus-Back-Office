    <http://bauhaus/qualite/attribut/1594/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Survey of a sample of 4,000 industrial enterprises with 20 employees or more\n\nAll enterprises with at least 500 employees of turnover of €150 million are surveyed."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1594/I.18.9>
