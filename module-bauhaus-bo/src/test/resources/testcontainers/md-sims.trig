    <http://bauhaus/qualite/rapport/1653>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: National survey on the resources of young adults 2014"@en , "Rapport qualité : Enquête sur les ressources des jeunes 2014"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1445> .
    
    <http://bauhaus/qualite/attribut/1653/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1653/S.3.6/text> , <http://bauhaus/qualite/attribut/1653/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est basée sur un échantillon de logements tiré au printemps 2014 dans une base de sondage au 1er janvier 2013.  \nLa base de sondage principale envisagée est l'échantillon-Maître OCTOPUSSE.  \nCette base ne couvrant que les logements des ménages ordinaires, un échantillon complémentaire est tiré dans le répertoire des communautés (internats, foyers étudiants, foyers de jeunes travailleurs).  \nL'enquête vise 5 000 jeunes répondants environ : 4 000 en logements ordinaires, 1 000 en communauté. Le volet des parents est estimé à 6 000 parents répondants environ."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1653/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
