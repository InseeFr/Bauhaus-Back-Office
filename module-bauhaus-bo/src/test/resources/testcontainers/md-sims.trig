    <http://bauhaus/qualite/attribut/1601/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers manufacturing and extraction industries; divisions 08 to 33 of the NAF Rev. 2 (excl. 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@en ;
            <http://purl.org/dc/terms/language>
