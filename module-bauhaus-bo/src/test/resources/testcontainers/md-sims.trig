<http://rdf.insee.fr/graphes/qualite/rapport/1921> {
    <http://bauhaus/qualite/attribut/1921/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-02-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte se déroule d'avril à juin de l'année."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1921/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte se déroule par internet, avec possibilité de répondre au moyen d'un questionnaire par mail, courrier ou fax, d'avril à juin de l'année. Le questionnaire est différent selon que l'entreprise est mono-régionale mono-établissement, mono-régionale multi-établissement ou multirégionale.\n\nChamps géographique :  \nPour les enquêtes de 2013 à 2016 : Grand Sud-Ouest (départements : 09, 12, 24, 31, 32, 33, 40, 46, 47, 64, 65, 81, 82).  \nPour les enquêtes à compter de 2017 : Grand Sud-Ouest (départements : 09, 11, 12, 16, 17, 19, 23, 24, 30, 31, 32, 33, 34, 40, 46, 47, 18, 64, 65, 66, 79, 81, 82, 86, 87)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1921/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le périmètre conventionnel de la filière aéronautique et spatiale est défini par les unités des secteurs du « noyau » de la filière AS (3030Z, 5122Z), les unités des secteurs « partiel » (2051Z, 2562B, 2651A, 3316Z), et les unités des secteurs « potentiel » (40 classes d'activités NAF)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1921/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The following topics are covered:  \n- Relations with the AS industry (function, range, customers)  \n- Outlook (order book, recruitments)  \n- Human resources (managers, temporary staff)  \n- Relation to innovation, certification, quality"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1921/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1921/S.3.6/texte> , <http://bauhaus/qualite/attribut/1921/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1921/I.18.10/texte> , <http://bauhaus/qualite/attribut/1921/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection takes from April to June of the given year."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1921/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1921/I.18.7/text> , <http://bauhaus/qualite/attribut/1921/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is comprehensive for the field of the AS industry’s \"core\" (3030Z, 5122Z), \"partial\" sector’s units (2051Z, 2562B, 2651A, 3316Z), units of more than 20 employees in  \"potential \" sector (40 NAF classes of activity). The survey asks survey units with fewer than 20 employees belonging to the 'potential'sectors. Specific units known as belonging to a priori the sector are also interviewed."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1921/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est exhaustive sur le champ du « noyau » de la filière AS (3030Z, 5122Z), des unités du secteur « partiel » (2051Z, 2562B, 2651A, 3316Z), des unités de plus de 20 salariés appartenant aux secteurs « potentiel » (40 classes d'activités NAF). L'enquête interroge par sondage les unités de moins de 20 salariés appartenant au secteurs « potentiel ». Des unités spécifiques connues comme appartenant à priori à la filière sont également interrogées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1921>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur la filière aéronautique et spatiale dans le grand Sud-Ouest 2019"@fr , "Quality report: Survey on aerospace and space sector of the large Southwest region 2019"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1468> .
    
    <http://bauhaus/qualite/attribut/1921/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Conventional perimeter of the aerospace and space industry is defined by the units of the « core » of the AS sector (3030Z, 5122Z), by the \"partial\" sectors units (2051Z, 2562B, 2651A, 3316Z), and the \"potential\" areas units (40 classes of activity NAF)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1921/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1921/S.3.4/texte> , <http://bauhaus/qualite/attribut/1921/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
    
    <http://bauhaus/qualite/attribut/1921/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection takes place by internet, with the possibility to respond through an e-mailed, mailed or faxed questionnaire from April to June of the given year. The questionnaire is different depending on whether the company is mono -regional and mono- institution, mono -regional multi-establishment or multi-regional.\n\nGeographical scope:  \nFor the surveys from 2013 to 2016: large Southwest of France (departments: 09, 12, 24, 31, 32, 33, 40, 46, 47, 64, 65, 81, 82).  \nFor the surveys from 2017: large Southwest of France (departments: 09, 11, 12, 16, 17, 19, 23, 24, 30, 31, 32, 33, 34, 40, 46, 47, 18, 64, 65, 66, 79, 81, 82, 86, 87)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1921/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les thèmes suivants sont abordés :  \n- relations avec la filière AS (fonction, rang, clients)  \n- perspectives (carnet de commande, recrutements)  \n- ressources humaines (cadres, intérim)  \n- rapport à l'innovation, la certification, la qualité"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1921/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1921/S.18.3/texte> , <http://bauhaus/qualite/attribut/1921/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1921> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1703> {
    <http://bauhaus/qualite/attribut/1703/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/236> .
    
    <http://bauhaus/qualite/attribut/1703/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1703/S.3.4/text> , <http://bauhaus/qualite/attribut/1703/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Si l'établissement est l'unité statistique enquêtée, l'entreprise est l'unité échantillonnée et l'unité de collecte.  \n\nLe plan de sondage est un sondage \" en grappes \", chaque entreprise constituant une grappe. Les entreprises commerciales sélectionnées dans l'échantillon sont interrogées sur la totalité de leurs établissements commerciaux de détail.  \n\nL'enquête Points de vente 2009 est composée de deux échantillons : un échantillon principal et un échantillon complémentaire. Ils ont été tirés de manière successive. L'échantillonnage principal est presque similaire à l'échantillonnage de l'enquête Points de vente 2004. L'échantillonnage complémentaire permet de compléter l'information sur les réseaux d'enseignes.  \n\nL'échantillon principal des entreprises commerciales est constitué :  \n\n- d'une première partie sondée pour les entreprises qui possèdent entre 2 et 39 magasins. L'échantillon de cette partie sondée est constitué de 8 166 entreprises. Le plan de sondage est stratifié par secteur d'activité et tranche de nombre de  magasins. Pour quelques strates à faible effectif, le tirage a été exhaustif. Puis, une allocation proportionnelle à l'importance de chaque grande zone du zonage en aire urbaine a été effectuée. Une coordination négative d'échantillon avec l'ESA  2009 a également été appliquée ;  \n\n- d'une seconde partie sondée pour les entreprises mono-magasins. L'échantillon de cette partie sondée est constitué de 11 862 entreprises. Le plan de sondage est stratifié par secteur d'activité et tranche de nombre de magasins. Pour quelques strates à faible effectif, le tirage a été exhaustif. Puis, une allocation proportionnelle à l'importance de chaque grande zone du zonage en aire urbaine a été effectuée. Une coordination positive d'échantillon avec l'ESA  2009 a également été appliquée : 2 885 entreprises ayant déjà été interrogées à l'ESA ne l'ont pas été dans Points de vente. Seule la variable d'appartenance à un réseau d'enseignes n'est pas disponible dans l'ESA ; elle est considérée comme non-répondue et nécessite un redressement ultérieur. 8 977 entreprises mono-magasins ont donc été réellement interrogées ;  \n\n- d'une partie exhaustive pour les entreprises qui possèdent 40 magasins ou plus. Les entreprises de cette strate exhaustive sont au nombre de 196.  \n\nÀ l'issue du tirage définitif, on dénombre sur le champ de l'enquête une population totale de 301 380 entreprises qui représentent 373 114 magasins et un échantillon de 20 224 entreprises dont 17 339 ont été réellement interrogées.  \n\nL'échantillonnage complémentaire consiste à tirer un échantillon d'unités légales possédant des points de vente en réseau de manière à collecter de l'information sur ces points de vente. Les unités interrogées ont été tirées selon un sondage aléatoire simple. Il n'a pas été nécessaire de fournir de poids de sondage car la base de sondage ne représente pas l'ensemble des unités légales possédant des points de vente en réseau. Ainsi, 3 247 entreprises ont été interrogées pour enrichir les possibilités d'analyse des points de vente en réseau."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1703/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The scope of the Retail Outlets Survey consists of enterprises belonging to the small-scale craft industry category (NAF rev. 2 categories 10.13B - Small-scale meat preparation, 10.71B - Baking of bread products, 10.71C - Bakery -pastry shop and 10.71D - Pastry-making) or in the retail trade (division 47) and owning at least one shop.\n\nFurthermore, retail businesses with no physical retail outlet (groups 47.8 and 47.9) are out of the scope of the survey."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1703/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1703/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/237> .
    
    <http://bauhaus/documents/document/237>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête sur les Points de vente du commerce de détail sur l'exercice 2009"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-10-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_Points_vente_detail_2009.pdf> .
    
    <http://bauhaus/qualite/attribut/1703/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1703/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample consists of enterprises (sampling units), providing individual information on each of their retail sales establishments (statistical units).  \n\nTherefore, the sampling plan is a \"cluster sample\", each cluster corresponding to the set of establishments (stores) belonging to a given sampled enterprise.  \n\nThe Retail Outlets Survey consists of two samples: a main sample and an additional sample. The main sample provides similar information to the Retail Outlets Survey of 2004. The additional sample supplements the main sample to increase the survey coverage of the population of establishments being part of retail network.  \n\nThe sample of commercial enterprises consists of:  \n\n- A first sub-sample of enterprises owning from 2 to 39 shops. This first sub-sample consists of 8,166 enterprises. The sampling plan is stratified according to the enterprise's main business activity and the number of shops. For some small-sized strata, the collection was exhaustive. Then, an allocation proportionnal to the number of firms in each major geographical zone (see the French zoning in urban area) was carried out. A negative coordination of the sample with the ESA 2009 survey was also applied.  \n\n- A second sub-sample of single-establishment enterprises. This sub-sample consists of 11,862 enterprises. The sampling plan is stratified by business sector and number of shops. For some small-sized strata, the collection was exhaustive. Again, an allocation proportionnal to the number of firms in each major geographical zone was carried out, and a positive sample coordination with the ESA 2009 survey was applied: 2,885 enterprises having already been surveyed in the ESA were not surveyed it in the Retail Outlets Survey. Only the variable of membership of a network is not available in the ESA ; it was therefore treated as partial non-response. 8,977 single-establishment enterprises were thus actually surveyed in The Retail Outlets Survey.  \n\n- An exhaustive set of enterprises owning 40 shops or more (196 enterprises).  \n\nThe total population from which the sample is drawn consists of 301,380 enterprises (representing 373,114 shops). The sample consists of 20,224 enterprises among which 17,339 were actually surveyed.  \n\nThe additional sample consists of legal units owning shops belonging to a network. These legal units were surveyed according to a simple random sampling (the sample is not designed to be representative of the population of legal units owning shops being member of a retail network. Overall, 3,247 enterprises were surveyed to extend the possibilities of analysis of the retail outlets being member of a retail network."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/236>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête points de vente du commerce de détail en 2009"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-09-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_points_vente_commerce_detail_2009.pdf> .
    
    <http://bauhaus/qualite/attribut/1703/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte des données a été réalisée en 2010.  \n\nLes entreprises commerciales possédant au moins un établissement du commerce de détail ont été interrogées par l'enquête Points de vente de septembre 2010 à janvier 2011. Le mode de collecte a été fonction de la taille des entreprises.  \n\nLes entreprises possédant entre 1 et 39 magasins ont été invitées à répondre directement sur Internet, à partir d'un questionnaire personnalisé où était préinscrite la liste de leurs établissements issus du répertoire Sirène, et qui étaient a priori dans le champ d'investigation. Une collecte par questionnaire papier envoyé par voie postale était également possible : ces mêmes entreprises, si elles ne voulaient ou ne pouvaient pas répondre électroniquement, pouvaient demander un exemplaire papier de leur questionnaire.  \n\nLes entreprises possédant au moins 40 magasins ont été sollicitées pour une collecte par dépôt de fichier sur le site sécurisé de l'Insee ; la possibilité de répondre sur questionnaire papier ou sur internet étant aussi maintenue. Sur demande, un questionnaire Excel personnalisé était alors disponible au centre de collecte de Caen. Une fois complété, ce fichier était retourné sur le site sécurisé de dépôt de fichier de l'Insee.  \n\nDeux populations ont été récupérées via le fichier de résultats d'autres enquêtes :  \n\n- les unités légales mono-établissement enquêtées par l'ESA ;  \n- les unités légales enquêtées par l'enquête Contours de réseaux ayant au moins 40 établissements en propre (faisant donc partie de la population enquêtée exhaustivement).  \n\nDes compléments d'enquête en cas de réponse incomplète ou incohérente ont été effectués, selon les cas, par voie postale ou par téléphone.\n\nL’enquête concerne les établissements commerciaux implantés en France métropolitaine."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1703/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey provides information about the turnover, the workforce and the surface area of the retail outlet. The latest edition also collects information on membership of a retail network."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1703/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The data were collected in 2010.  \n\nCommercial enterprises owning at least one retail establishments were surveyed in the Retail Outlets Survey. The collection method depended on the size of the enterprises.  \n\nFor enterprises owning from 1 to 39 establishments, a personalized questionnaire was available online; it contained the list of their current establishments according to the SIRENE register of firms and establishments (Computer system for the National Register of Enterprises and their Establishments), which were a priori in the field of investigation. A paper copy of the questionnaire was also available for those enterprises which did not want or could not answer electronically.  \n\nEnterprises owning at least 40 establishments had the additional option to answer the survey by means of a personalized Excel file, send to a secured Insee website dedicated to survey collection.  \n\nThe single-establishment enterprises were surveyed through the ESA (Annual Sectoral Survey).Legal units with more than 40 establishments were surveyed through the simultaneous survey on retail networks.  \n\nIn the event of incomplete or inconsistent responses, additional information was collected by post or by telephone.\n\nThe survey concerns the commercial enterprises and establishments located in Metropolitan France."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1703/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1703/S.18.3/text> , <http://bauhaus/qualite/attribut/1703/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/documents/document/235>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice  2009"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-09-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Fiche_Qualite_PDV_2009.pdf> .
    
    <http://bauhaus/qualite/attribut/1703/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1703/I.18.10/text> , <http://bauhaus/qualite/attribut/1703/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1703/S.3.6/text> , <http://bauhaus/qualite/attribut/1703/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les principaux thèmes abordés sont :  \n\n- le chiffre d'affaires,  \n- les effectifs (personnes occupées),  \n- la surface du point de vente,  \n- l'enseigne et l'appartenance à un réseau d'enseignes."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1703/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1703/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1703> .
    
    <http://bauhaus/qualite/attribut/1703/S.18.2>
