    <http://bauhaus/qualite/attribut/1777/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1777/S.3.6/text> , <http://bauhaus/qualite/attribut/1777/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1777> .
    
    <http://bauhaus/qualite/rapport/1777>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Indice de chiffre d'affaires dans l'industrie et la construction"@fr , "Quality report: Sales Index in Industry and Construction"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1636> .
    
    <http://bauhaus/documents/document/79>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indice de chiffre d'affaires dans l'industrie et la construction base 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-04-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_ICA_Industrie_Construction_2010.pdf> .
    
    <http://bauhaus/qualite/attribut/1777/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1777> .
    
    <http://bauhaus/qualite/attribut/1777/S.14.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "60 jours"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1777/S.18.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les indices de chiffre d'affaires sont construits à partir d'une source fiscale, la déclaration CA3, formulaire que doivent remplir les entreprises pour le paiement de la taxe sur la valeur ajoutée (TVA).  \nIls comprennent l'ensemble du chiffre d'affaires des entreprises déclarantes, toutes activités confondues, classées selon l'activité principale de l'entreprise.  \nPour les exportations hors Union européenne et les livraisons communautaires, les indices de chiffre d'affaires sont établis sur le montant des chiffres d'affaires déclarés par les entreprises. Ils permettent de suivre l'évolution du chiffre d'affaires en euros avec l'étranger."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1777/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1777/S.10.6/text> , <http://bauhaus/qualite/attribut/1777/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1777> .
    
    <http://bauhaus/qualite/attribut/1777/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1777/S.19/texte> , <http://bauhaus/qualite/attribut/1777/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1777> .
    
    <http://bauhaus/qualite/attribut/1777/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Companies which are monthly declaring VAT are those falling under the \"actual normal tax system\". This system applies to service provider companies generating a turnover of more than € 236,000 as well as to companies selling goods or dwellings and generating a turnover of more than € 783,000. Companies for which value added tax due amount doesn't exceed € 4,000 for a given year may however present VAT declarations quarterly."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/116>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Ce qui a changé pour les indices de chiffre d’affaires depuis le 31 mars 2016"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-04-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICA_chgt2016_note_methodo_FR.pdf> .
    
    <http://bauhaus/documents/document/627>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "What changed for turnover indexes since March 31st"@en ;
            <http://purl.org/dc/elements/1.1/language>
                    "en" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2016-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ICA_chgt2016_note_methodo_GB.pdf> .
    
    <http://bauhaus/qualite/attribut/1777/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les indices de chiffre d'affaires dans l'industrie et la construction sont construits à partir d'une source fiscale, le formulaire CA3, que doivent remplir les entreprises pour le paiement de la taxe sur la valeur ajoutée (TVA).  \n\nDans certains secteurs où le chiffre d'affaires des entreprises non assujetties au régime fiscal réel normal est important, la source d'information est complétée par une enquête postale mensuelle auprès d'un panel glissant d'entreprises non assujetties au régime fiscal réel normal.  \n\nLes indices sont ainsi représentatifs de l'évolution du chiffre d'affaires de l'ensemble des secteurs.  \n\nLe champs géographique de l'indice est la France entière (à l'exception de la Guyane et de Mayotte non assujettis à la TVA)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1777/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "A partir de janvier 2009, les indices de chiffre d'affaires dans l'industrie et la construction sont calculés selon la nomenclature agrégée NA, fondée sur la NAF rév. 2 entrée en vigueur le 1er janvier 2008.  \nIls couvrent les secteurs suivants :  \n- Industrie (BE) ;  \n- Industrie manufacturière (CZ) ;  \n- Industries agricoles et alimentaires (C1) ;  \n- Cokéfaction et raffinage (C2) ;  \n- Équipements électriques, électroniques et informatiques, machines (C3) ;  \n- Matériel de transport (C4) ;  \n- Autres produits industriels (C5) ;  \n- Industries extractrices, énergie, eau, déchets (DE) ;  \n- Construction (FZ)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1777/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Sales Indices in Industry and Construction are created from a tax source - the CA3 form, which enterprises must complete for the payment of Value-Added Tax (VAT).  \n\nIn certain sectors in which the turnover of enterprises not subject to the \"actual normal\" tax system is substantial, the information source is supplemented by a monthly postal survey administered to a rolling selection of enterprises not subject to the \"actual normal\" tax system.  \n\nThe indices are thus representative of the trend for turnover in all sectors.  \n\nThis index is calculated for \"Whole France\" (except French Guyana and Mayotte which are not liable to VAT)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1777/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Since January 2009, the turnover indices have been calculated according to the NA aggregated classification based on NAF rev. 2, which came into force on January 1st, 2008.  \nThey cover the following sectors:  \n- Industry (BZ)  \n- Manufacturing industry (CZ)  \n- Agrifood industries (C1)  \n- Coking and refining industries (C2)  \n- Electrical, electronic and computer industries; machines (C3)  \n- Transport equipment (C4)  \n- Other industrial products (C5)  \n- Extractive industries, energy, water, wastes (DE)  \n- Construction (FZ)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1777/S.3.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.9>
                    "Année 2010"@fr , "Year 2010"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1777> .
    
    <http://bauhaus/qualite/attribut/1777/S.14.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.14.1>
                    <http://bauhaus/qualite/attribut/1777/S.14.1/texte> , <http://bauhaus/qualite/attribut/1777/S.14.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1777> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1535> {
    <http://bauhaus/qualite/attribut/1535/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The information supplied by the survey is:  \n-Elements of retrospective order such as the salaried staff or the turnover for 2 years before the survey,  \n-Elements of forward looking order such as the trends in the course of the year and perspectives of commands in six months and in one year.\n\nFinally other themes are approached such as:  \n-Dependence and diversification,  \n- type and mode of relations with the contractors,  \n-Geographical origin of the commands,  \n-Works for the military sector,  \n- subcontracting in chain,  \n- resort to the new technologies of information and the communication ( NTIC),  \n- major items for the development,  \n- work in network and partnerships."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1535/I.18.7/texte> , <http://bauhaus/qualite/attribut/1535/I.18.7/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The area of the survey is all the establishments having worked the one at least 2 years preceding the survey for a contractor of the aircraft, spatial, civil or military manufacturing."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1535/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Beginning of the survey in March sending  questionnaires by mail way, then reminders mail and phone way till the end of June."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1535/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les informations fournies par l'enquête sont :  \n- des éléments d'ordre rétrospectif tel que les effectifs salariés ou le chiffre d'affaires pour les 2 années précédents l'enquête,  \n- des éléments d'ordre prospectif telles que les tendances en cours d'année et perspectives de commandes à six mois et à un an.\n\nEnfin d'autres thèmes sont abordés tels que :  \n- dépendance et diversification,  \n- type et mode de relations avec les donneurs d'ordres,  \n- provenance géographique des commandes,  \n- travaux pour le secteur militaire,  \n- sous-traitance en chaîne,  \n- recours aux nouvelles technologies de l'information et de la communication (NTIC),  \n- points majeurs pour le développement,  \n- travail en réseau et partenariats."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1535/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/documents/document/516>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire relatif à l'enquête annuelle Aéronautique-Espace auprès des établissements sous-traitants, fournisseurs ou prestataires de services du secteur "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-11-21"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_Aeronautique_espace.pdf> .
    
    <http://bauhaus/qualite/attribut/1535/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1535/S.3.6/text> , <http://bauhaus/qualite/attribut/1535/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte s'effectue de mars à juin."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1535/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Début de l'enquête en mars envoi des questionnaires par voie postale, puis rappels par voie postale et téléphonique jusqu'à fin juin."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/515>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête Aéronautique-Espace auprès des établissements sous-traitants, fournisseurs ou prestataires de services du secteur aéronautique et spatial implantés en Aquitaine et en Midi-Pyrénées."@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-11-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Methodologie_Aeronautique_Espace.pdf> .
    
    <http://bauhaus/qualite/attribut/1535/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ de l'enquête comprend :  \n- pour la partie volet commun : toutes les activités susceptibles de dépendre partiellement de la demande du secteur aéronautique et spatial, hormis commerce de détail, hôtellerie, restauration, traiteurs, activités financières, assurances, immobilier ;  \n- pour la partie volet complémentaire : industrie manufacturière (10.11Z à 35.30Z) et recherche-études (71.12B, 71.20B, 72.19Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1535/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1535/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection takes place from March to the end of June."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1535/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1535/S.19/text> , <http://bauhaus/qualite/attribut/1535/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The area of the survey includes:  \n- for the common part: every activities susceptible to depend partially of the demand of the aeronautical and spatial sector, except retail trade, hotel business, catering, caterers, financial activities, insurances, real estate;  \n- for the additional part: manufacturing industry (10.11Z to 35.11Z) and researches - studies (71.12B, 71.20B, 72.19Z)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1535>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Annual survey to establissements subcontractors, suppliers or service providers of aeronautical and spacial sector"@en , "Rapport qualité : Enquête annuelle auprès des établissements sous-traitants, fournisseurs ou prestataires de services du secteur Aéronautique-Espace"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1191> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/516> .
    
    <http://bauhaus/qualite/attribut/1535/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1535/S.3.4/texte> , <http://bauhaus/qualite/attribut/1535/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Couverture exhaustive en théorie des donneurs d'ordre nationaux (liste des sous-traitants, fournisseurs et prestataires de services) de la construction aéronautique et spatiale. Environ 1 200 établissements sont interrogés chaque année dans chaque région."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1535/I.18.10/texte> , <http://bauhaus/qualite/attribut/1535/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/515> .
    
    <http://bauhaus/qualite/attribut/1535/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ de l'enquête est l'ensemble des établissements ayant travaillé l'une au moins des 2 années précédant l'enquête pour un donneur d'ordre de la construction aéronautique, spatiale, civile ou militaire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/L> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1535/S.18.3/texte> , <http://bauhaus/qualite/attribut/1535/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Exhaustive cover in theory for national contractors (list of the subcontractors, the suppliers and the service providers) of the aircraft and spatial manufacturing. Approximately 1,200 establishments are questioned every year in every region."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1535/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/P> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1535> .
    
    <http://bauhaus/qualite/attribut/1535/S.18.2>
