                    <http://bauhaus/qualite/attribut/1562/S.10.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1562> .
    
    <http://bauhaus/qualite/attribut/1562/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-G001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1562> .
    
    <http://bauhaus/qualite/attribut/1562/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The quarterly outlook survey in the building trades aims to transcribe the opinion of craftspeople in the sector on their recent activity and activity prospects.\n\nThis opinion is tracked by monitoring activity and related variables such as changes in workforce.\n\nThe entrepreneurs also provide their opinion on their investments and their cash flow."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1562/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1562/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1562> .
    
    <http://bauhaus/qualite/attribut/1562/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1562/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1562> .
    
    <http://bauhaus/qualite/attribut/1562/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/473> .
    
    <http://bauhaus/qualite/attribut/1562/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1562/S.3.4/texte> , <http://bauhaus/qualite/attribut/1562/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1562> .
    
    <http://bauhaus/documents/document/473>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Méthodologie de l'enquête trimestrielle dans l'artisanat du bâtiment"@fr ;
