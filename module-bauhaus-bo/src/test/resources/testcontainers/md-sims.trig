    <http://bauhaus/documents/document/399>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2008"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2009-03-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Promotion_francais_2008.pdf> .
    
    <http://bauhaus/qualite/attribut/1609/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête trimestrielle de conjoncture dans la promotion immobilière permet de transcrire l'opinion des promoteurs et des entreprises réalisant de la location immobilière sur leur activité récente et sur leurs perspectives d'activité.\n\nCette opinion est retracée au moyen du suivi de la demande en logements neufs à acheter et à louer, des stocks de logements invendus, du prix de vente des logements. Les données sur les perspectives sont fournies notamment par le suivi des opinions sur les mises en chantier."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1609/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1609/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
    <http://bauhaus/qualite/attribut/1609/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1609> .
    
    <http://bauhaus/qualite/attribut/1609/S.3.6/text>
