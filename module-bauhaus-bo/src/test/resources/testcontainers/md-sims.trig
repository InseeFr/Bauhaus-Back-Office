                    <http://bauhaus/qualite/attribut/1761/S.6.1/text> , <http://bauhaus/qualite/attribut/1761/S.6.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1761> .
    
    <http://bauhaus/documents/document/5>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
