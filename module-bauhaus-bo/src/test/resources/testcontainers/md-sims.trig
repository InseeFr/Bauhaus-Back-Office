    <http://bauhaus/qualite/rapport/1620>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Half-yearly survey of the cash flow situation in industry 2015"@en , "Rapport qualité : Enquête semestrielle sur la situation de trésorerie dans l'industrie 2015"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1095> .
    
    <http://bauhaus/qualite/attribut/1620/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée deux fois par an, en juin et en décembre.\n\nLa collecte s'effectue par voie postale et par internet sur une période qui s'étend de la fin du mois précédant le mois de l'enquête à la date de publication de l'enquête, dans les 10 premiers jours du mois suivant le mois de l'enquête."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1620/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1620> .
    
    <http://bauhaus/qualite/attribut/1620/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1620/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1620> .
    
    <http://bauhaus/qualite/attribut/1620/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/380> .
    
    <http://bauhaus/qualite/attribut/1620/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1620/I.18.10/texte> , <http://bauhaus/qualite/attribut/1620/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1620> .
    
    <http://bauhaus/qualite/attribut/1620/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1620/S.3.6/texte> , <http://bauhaus/qualite/attribut/1620/S.3.6/text> ;
