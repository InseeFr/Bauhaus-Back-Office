    <http://bauhaus/qualite/attribut/1942/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte s’étend de la fin du mois précédant le mois de référence de l’enquête à la date de la publication des résultats (entre le 20 et le 25 du mois de référence)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1942/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
