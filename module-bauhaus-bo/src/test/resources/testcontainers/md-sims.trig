    <http://bauhaus/qualite/attribut/1824/S.7.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.7.1>
                    <http://bauhaus/qualite/attribut/1824/S.7.1/text> , <http://bauhaus/qualite/attribut/1824/S.7.1/texte> ;
