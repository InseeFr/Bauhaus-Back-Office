            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.2>
                    <http://bauhaus/qualite/attribut/1928/S.8.2/text> , <http://bauhaus/qualite/attribut/1928/S.8.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1928> .
    
    <http://bauhaus/qualite/attribut/1928/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1928/S.3.3/text> , <http://bauhaus/qualite/attribut/1928/S.3.3/texte> ;
