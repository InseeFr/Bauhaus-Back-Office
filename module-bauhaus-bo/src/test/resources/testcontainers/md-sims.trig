            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1658> .
    
    <http://bauhaus/documents/document/22>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'indice de référence des loyers / IRL"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2008-03-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/indice_ref_loyers_loi_2005.pdf> .
    
    <http://bauhaus/qualite/attribut/1799/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
