    <http://bauhaus/qualite/attribut/1626/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1626/S.3.4/text> , <http://bauhaus/qualite/attribut/1626/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1626> .
    
    <http://bauhaus/qualite/attribut/1626/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête par sondage auprès de 4 000 entreprises industrielles de 20 salariés ou plus.\n\nToutes les entreprises d'au moins 500 salariés ou 150 millions d'euros de chiffre d'affaires sont interrogées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1626/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The half-yearly survey of the cash flow situation in industry aims to transcribe the opinion of entrepreneurs on their cash flow and factors explaining changes in that situation, such as: operating profits, prices, sales volumes, wage contributions, financial expenses, investment expenses...\n\nThis survey also provides some items of information on financing terms. Lastly, industrialists indicate their prospects in these areas."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1626>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête semestrielle sur la situation de trésorerie dans l'industrie 2007"@fr , "Quality report: Half-yearly survey of the cash flow situation in industry 2007"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1101> .
    
    <http://bauhaus/documents/page/26>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
