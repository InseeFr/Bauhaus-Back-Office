    <http://bauhaus/qualite/attribut/1549/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1549/S.3.4/text> , <http://bauhaus/qualite/attribut/1549/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1549> .
    
    <http://bauhaus/qualite/attribut/1549/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1549/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1549> .
    
    <http://bauhaus/qualite/attribut/1549/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1549/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1549> .
    
    <http://bauhaus/qualite/attribut/1549/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All ordinary households in the whole of France (mainland and overseas departments).  \nGeographic representation: Zones for study and development (ZEAT) in Metropolitan France, departmental in the overseas departments."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1549/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The 2011 survey was conducted in 6 waves of 8 weeks each, from October 2010 to September 2011.\n\nThe Household Budget Survey uses two data collection instruments:\n\n- a questionnaire using CAPI (computer-assisted data collection, broken down over 2 visits), which records income over the last 12 months and major or regular expenditure, also socio-demographic information, characteristics of the dwelling and qualitative questions about the household's financial situation;\n\n- a self-completed diary in which all members of the household aged over 14 record all their expenditure over 7 days."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/496>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "La méthodologie de l'enquête Budget de famille 2011 / BDF 2011"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-06-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_BDF_2011.pdf> .
    
    <http://bauhaus/qualite/attribut/1549/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Consommation, dépenses, ressources, opinion sur la situation financière, caractéristiques socio-démographiques et équipement."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/495>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice  2011"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2014-06-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/BIL_ENQ_BDF_2011.pdf> .
    
    <http://bauhaus/qualite/rapport/1549>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête Budget de famille 2011"@fr , "Quality report: Household budget survey 2011"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1340> .
    
    <http://bauhaus/qualite/attribut/1549/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête de 2011 s'est déroulée en 6 vagues de 8 semaines chacune, d'octobre 2010 à septembre 2011.\n\nL'enquête Budget de Famille utilise deux instruments de collecte :\n\n- un questionnaire sous CAPI (collecte assistée par informatique ; réparti sur 2 visites), qui enregistre les revenus des 12 derniers mois et les dépenses importantes ou régulières, ainsi que des informations socio-démographiques, les caractéristiques du logement et des questions qualitatives illustrant la situation financière du ménage ;\n\n- un carnet auto-administré dans lequel tous les membres du ménage âgés de plus de 14 ans notent toutes leurs dépenses durant 7 jours."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1549/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-10-18"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1549> .
    
    <http://bauhaus/qualite/attribut/1549/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ensemble des ménages ordinaires de France entière (métropole et Dom).  \nReprésentativité géographique : ZEAT (Zone d'études et d'aménagement du territoire) pour la métropole, départementale pour les Dom."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1549/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1549/S.18.3/texte> , <http://bauhaus/qualite/attribut/1549/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1549> .
    
    <http://bauhaus/qualite/attribut/1549/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Consumption, expenditure, resources, opinion on financial situation, socio-demographic characteristics and equipment."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1876> {
    <http://bauhaus/qualite/attribut/1876/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ concerne les entreprises qui gèrent des supermarchés, des hypermarchés et/ou des magasins multi-commerces.\n\nL'enquête couvre les activités principales définies par les codes NAF rév. 2 : 47.11D, 47.11E et 47.11F."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1876/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1876/S.3.6/text> , <http://bauhaus/qualite/attribut/1876/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The opening of each monthly campaign takes place just days after the end of retail month investigated. Enterprise that have sent an e-mail address are informed by mail of the opening of the campaign."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1876/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête répond à une forte demande d'analyse conjoncturelle, au niveau du secteur d'activité comme au niveau macro-économique (préoccupations exprimées par les membres de la Commission des Comptes Commerciaux de la Nation - CCCN).  \n\nL'enquête permet également de prendre en compte les fréquentes restructurations et l'évolution démographique du secteur ; le détail par famille de produits permet également de dégager un diagnostic conjoncturel.  \n\nEnfin, l'enquête permet surtout de disposer d'un résultat plus rapide que la mobilisation des sources fiscales : à cet égard, l'enquête Emagsa est un maillon indispensable pour établir l'indice précoce à 30 jours du volume des ventes dans le commerce de détail qui est requis par le règlement européen."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1876/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey meets strong demand for outlook analysis at both sector and macro-economic level alike (preoccupations expressed by the members of the Commission for the Commercial Accounts of the Nation - CCCN).  \n\nThe survey also takes into account the frequent restructuring and demographic changes in the sector; The breakdown by family of products also makes it possible to establish a cyclical diagnosis.  \n\nFinally, the survey provides a quicker result than the mobilization of tax sources: in this respect, the Emagsa survey is an indispensable link in establishing the early index at 30 days of the volume of sales in commerce Which is required by the European Regulation."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1876/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The themes addressed are:  \n\n- total turnover incl. VAT and breakdown per type of sale (supermarkets/hypermarkets);  \n\n- breakdown of sales per product type: food, non-food, fuel;  \n\n- any modifications to the stock of stores: openings, closures, modifications in floor area."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1876/S.3.4/text> , <http://bauhaus/qualite/attribut/1876/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'ouverture de chaque campagne mensuelle a lieu quelques jours après la fin du mois d'affaires enquêté. Les entreprises ayant transmis une adresse électronique sont informées par courriel de l'ouverture de la campagne."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1876/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1876/S.19/text> , <http://bauhaus/qualite/attribut/1876/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée mensuellement par Internet à partir du Portail de Réponse aux Enquêtes Entreprises : (http://entreprises.insee.fr/).\n\nLa collecte se déroule mensuellement par internet via le portail de réponse aux enquêtes « entreprise » de l’Insee. L’entreprise reçoit par courrier ou par courriel un code d’accès et un mot de passe afin de s’identifier."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1876/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1876/I.18.7/text> , <http://bauhaus/qualite/attribut/1876/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1876/I.18.10/text> , <http://bauhaus/qualite/attribut/1876/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/rapport/1876>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Monthly survey of large-scale food retail activities 2015"@en , "Rapport qualité : Enquête mensuelle sur l'activité des grandes surfaces alimentaires 2015"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1422> .
    
    <http://bauhaus/qualite/attribut/1876/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-02-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "From 1997"@en , "à partir de 1997"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted monthly by Internet : (http://entreprises.insee.fr/).\n\n<br />\n\nEnterprise that have sent an e-mail address are informed by mail of the opening of the campaign."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Environ 7 500 entreprises entrent dans le champ de l'enquête (hypermarchés, supermarchés et magasins multi-commerces).\n\nL'échantillon est d'environ 400 entreprises ; il est exhaustif pour les entreprises ayant un chiffre d'affaires supérieur à 300 millions d'euros TTC annuel. Dans les autres strates, un tirage coordonné positivement avec les précédentes éditions est mis en œuvre."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1876/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les thèmes abordés sont :  \n\n- le chiffre d'affaires total TTC et sa ventilation par forme de vente (supermarchés/hypermarchés) ;  \n\n- la répartition des ventes par type de produits : alimentaires, non alimentaires, carburants ;  \n\n- les modifications éventuelles du parc de magasins : ouvertures, fermetures, modifications de surface."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1876/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The scope includes the companies managing supermarkets, hypermarkets and/or multi-commerce stores.\n\nThe survey covers the main activities defined by NAF rev. 2 codes: 47.11D, 47.11E and 47.11F."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1876/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1876/S.18.3/text> , <http://bauhaus/qualite/attribut/1876/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
    
    <http://bauhaus/qualite/attribut/1876/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Approximately 7,500 companies are involved in the survey (hypermarkets, supermarkets and multi-commerce stores).\n\nThe sample is about 400 companies; It is exhaustive for companies with a turnover of more than 300 million euros (inclusive of VAT). In the other strata, a draw coordinated positively with the previous editions is implemented."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1876/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1876> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1755> {
    <http://bauhaus/qualite/attribut/1755/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
