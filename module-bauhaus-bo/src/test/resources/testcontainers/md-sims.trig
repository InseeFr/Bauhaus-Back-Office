                    "Quality report: Monthly outlook survey in services 2007"@en , "Rapport qualité : Enquête mensuelle de conjoncture dans les services 2007"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1176> .
    
    <http://bauhaus/qualite/attribut/1617/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-03-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
