                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1982> .
    
    <http://bauhaus/qualite/attribut/1982/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample for the 2014-2015 FQP survey was drawn from the tax files:  \n- personal tax files (FIP),  \n- housing tax files (PLFC),  \n- income declaration files (POTE) of the 2013 and 2014 editions containing the income declared for the years 2012 and 2013.  \nIt is divided for the survey into three sub-samples: people whose tax household is linked to the housing tax, people living in communities and people whose fiscal household is not linked to the housing tax."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1982/S.10.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "A file for researchers is accessible through the Quételet network :  \nhttps://quetelet.casd.eu/fr/utilisateur/connexion"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1982/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-F230> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1982> .
    
    <http://bauhaus/qualite/attribut/1982/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Comme les éditions précédentes de l'enquête, le questionnaire s'articule autour de cinq volets :   \n- la mobilité professionnelle ;   \n- la formation initiale ;   \n- la formation continue ;   \n- l'origine sociale ;   \n- les revenus du travail."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
