                    "2017-05-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ID_2010_COMPOSITION_INDEX_FRAIS_DIVERS_BT_TP.pdf> .
    
    <http://bauhaus/qualite/attribut/1791/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Coût, construction"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/752>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Various indices for contruction (base 2010)"@en ;
            <http://purl.org/dc/elements/1.1/language>
