<http://rdf.insee.fr/graphes/qualite/rapport/1716> {
    <http://bauhaus/qualite/attribut/1716/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample for the 2002-2003 Health Survey consists of 25,000 dwellings (18,000 for the national sample and 7,000 for regional extensions), selected from the INSEE master sample (derived from the population census), and supplemented by the New Housing Survey Database (BSLN).\n\nAll in all, approximately 16,800 households responded to this survey, giving an approximate total of 40,900 people in the population of responding households (\"eligible\" individuals, i.e. people over 18 years of age)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1716/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1716/S.19/texte> , <http://bauhaus/qualite/attribut/1716/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1716> .
    
    <http://bauhaus/qualite/attribut/1716/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The following topics are covered:  \n\n- First visit: living conditions, social protection, general state of health, disability, description of illnesses, use and  contact with health care providers;  \n- Second and third visits: surgical antecedents, interruptions of work due to illnesses and periods of bed rest, use of care facilities over the period (hospitalisation, doctor, biology, paramedical interventions, etc.), incapacities, dietary habits and prevention."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1716/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1716/I.18.10/texte> , <http://bauhaus/qualite/attribut/1716/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1716> .
    
    <http://bauhaus/qualite/attribut/1716/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1716> .
    
    <http://bauhaus/qualite/attribut/1716/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1716/S.18.3/texte> , <http://bauhaus/qualite/attribut/1716/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
