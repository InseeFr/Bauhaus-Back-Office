<http://rdf.insee.fr/graphes/qualite/rapport/1681> {
    <http://bauhaus/qualite/attribut/1681/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1681/S.18.3/texte> , <http://bauhaus/qualite/attribut/1681/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1681> .
    
    <http://bauhaus/qualite/attribut/1681/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre les activités définies par le code NAF rév. 2 : 55.30Z (terrains de camping et parcs pour caravanes ou véhicules de loisirs).\n\nLes unités enquêtées sont des terrains de camping, classés de 1 à 5 étoiles ou des terrains non classés offrant au moins un emplacement de passage."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1681/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1681> .
    
    <http://bauhaus/qualite/attribut/1681/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1681/S.3.4/texte> , <http://bauhaus/qualite/attribut/1681/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1681> .
    
    <http://bauhaus/qualite/attribut/1681/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1681/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1681> .
    
    <http://bauhaus/qualite/attribut/1681/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey concerns the occupancy in the five summer months, from May to September: the stock is measured on 30 November of each year.\n\nIt covers the following topics:\n\n- Characteristics of the site\n\n- Opening period\n\n- Accommodation capacity (bare pitches and pitches with rental accommodation)\n\n- Occupancy of pitches (bare and with rental accommodation) - Monthly occupancy (in terms of the numbers of arrivals and nights) according to the type of pitch (bare and with rental accommodation) and the customers' normal country of residence."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1681/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
