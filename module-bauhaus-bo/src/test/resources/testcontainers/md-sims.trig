    <http://bauhaus/qualite/attribut/1629/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection period extended from January to May 2016 (main sample) and from September to December 2016 (complementary sample)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1629/S.3.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les établissements appartiennent aux sections B et C (division 05 à 33) , au groupe 383 (récupération), hors : sous classes : 1013B, 1071B, 1071C, 1071D (artisanat commercial), 2013A et 2446Z ; hors divisions 05, 06 et 19; hors groupe 091."@fr ;
