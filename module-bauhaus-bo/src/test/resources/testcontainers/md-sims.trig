                    <http://bauhaus/qualite/rapport/1653> .
    
    <http://bauhaus/qualite/attribut/1653/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Logements ordinaires et communautés.\n\nLes jeunes de 18 à 24 ans et leurs parents sont enquêtés."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1653/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
