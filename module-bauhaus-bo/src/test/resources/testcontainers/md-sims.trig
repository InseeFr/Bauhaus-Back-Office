                    <http://bauhaus/qualite/rapport/1601> .
    
    <http://bauhaus/qualite/attribut/1601/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
