            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/documents/document/417>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Théorie de l'opinion : Faut-il pondérer les réponses individuelles ?"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2006-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/theorie_de_l_opinion2006.pdf> .
    
    <http://bauhaus/qualite/attribut/1599/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/qualite/rapport/1599>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Quarterly business outlook survey on investment in industry 2010"@en , "Rapport qualité : Enquête trimestrielle sur les investissements dans l'industrie 2010"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1123> .
    
    <http://bauhaus/qualite/attribut/1599/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 4,000 industrial companies with 20 employees or more.\n\nAll companies with at least 500 employees or 150 million euros in turnover are questioned."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1599/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/qualite/attribut/1599/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The quarterly survey on investment in industry is part of the European system to harmonise European Commission business outlook surveys, and to which the 27 Member States of the European Union contribute.\n\nThus questionnaires, classifications and data processing methods have been harmonised to a large extent in the national institutes of the countries that have adopted this system."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1599/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The quarterly business outlook survey on investment in industry records the opinion of industrialists on trends in the economic climate in investment, in the destination of investment (replacement, modernisation, capacity extension, etc.), trends in production capacity and displacement of facilities, investments abroad, and factors influencing their decision to invest.\n\nAs well as qualitative questions, the survey is unusual in that it also includes quantitative questions. Annual amounts of investment by the company over two years and the current year are collected and also investment distribution according to destination."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1599/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/documents/document/416>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Prévoir l'investissement des entreprises : Un indicateur des révisions dans l'enquête de conjoncture sur les investissements dans l'industrie "@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/prevoir_invest_entreprises_G2005_09.pdf> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 395-396"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquêtes de conjoncture"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/23337> .
    
    <http://bauhaus/qualite/attribut/1599/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/qualite/attribut/1599/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1599/S.3.4/texte> , <http://bauhaus/qualite/attribut/1599/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/qualite/attribut/1599/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête couvre l'industrie manufacturière et les industries extractives ; divisions 08 à 33 de la NAF rév. 2 (hors 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1599/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted every quarter. This is done in January, April, July and October, i.e. the month after the end of each quarter.\n\nData collection is by post and via the internet from the end of the month preceding the survey month to the end of the survey month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1599/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1599/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/documents/page/52>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Économie et Statistique n° 359-360"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Analyse conjoncturelle : entre statistique et économie"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.epsilon.insee.fr/jspui/handle/1/22923> .
    
    <http://bauhaus/qualite/attribut/1599/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête trimestrielle sur les investissements dans l'industrie a pour objet de transcrire l'opinion des industriels sur l'évolution conjoncturelle de l'investissement, la destination de l'investissement (remplacement, modernisation, extension de capacité, etc.), l'évolution de la capacité de production et des déclassements d'équipements, les investissements à l'étranger, les facteurs influençant la décision d'investissement.\n\nOutre des questions qualitatives, l'enquête présente la particularité de contenir également des questions quantitatives. Sont ainsi collectés les montants annuels d'investissement de l'entreprise relatifs à deux années et à l'année courante ou encore la répartition des investissements selon leur destination."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1599/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1599/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/documents/page/33>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#comment>
                    "Site internet de la Commission européenne, page en anglais"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Le système européen harmonisé des enquêtes de conjoncture de la Commission européenne"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://ec.europa.eu/economy_finance/db_indicators/surveys/method_guides/index_en.htm> .
    
    <http://bauhaus/qualite/attribut/1599/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée tous les trimestres. Elle est effectuée en janvier, avril, juillet et octobre, soit le premier mois de chaque trimestre.\n\nLa collecte se fait par voie postale et par internet de la fin du mois précédant le mois de l'enquête jusqu'à la fin du mois de l'enquête."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1599/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1599/S.19/text> , <http://bauhaus/qualite/attribut/1599/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/qualite/attribut/1599/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-07-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1599> .
    
    <http://bauhaus/qualite/attribut/1599/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers manufacturing and extraction industries; divisions 08 to 33 of the NAF Rev. 2 (excl. 08.92Z, 09.10Z, 12, 19.10Z, 30.40Z)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1599/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/46> , <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/53> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1696> {
    <http://bauhaus/qualite/attribut/1696/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Loyers pratiqués y compris surloyers, hors charges et avant déduction des aides,\n\n- Caractéristiques physiques du logement."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1696/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte a lieu tous les trimestres. Elle est réalisée par transfert de fichiers pour la France métropolitaine et la Guadeloupe."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1696/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Applied rents including rent supplements, except charges, without deducting housing supports.\n\n- Physical state of housing"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1696/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-04-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ensemble des résidences principales possédées par un bailleur social (organismes HLM et Société d'Économie Mixte) louées vides dont l'usage essentiel est l'habitation."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1696/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1696/I.18.10/texte> , <http://bauhaus/qualite/attribut/1696/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "101 social landlords are investigated (96 in metropolitan France and 5 in Guadeloupe). The collected data relate to the rents of about 3000 dwellings.\n\nThe sample of the social landlords and of dwellings was pulled out of the Repertory on the Social Rental stock (RPLS) of the Ministère de l'Environnement, de l'énergie et de la mer. "@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1696/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1696/S.3.6/texte> , <http://bauhaus/qualite/attribut/1696/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "101 bailleurs sociaux sont enquêtés 96 en métropole et 5 en Guadeloupe). Les données collectées portent sur les loyers d'environ 3 000 logements.\n\nL'échantillon de bailleurs et de logements a été tiré dans le Répertoire des logements locatifs des bailleurs sociaux (RPLS) du Ministère de l'Environnement, de l'énergie et de la mer. "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1696>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête conjoncturelle sur les loyers auprès des bailleurs sociaux"@fr , "Quality report: Quarterly outlook survey on the rents of the social sector"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/serie/s1252> .
    
    <http://bauhaus/qualite/attribut/1696/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All the main homes possessed by social landlords, rented empty."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1696/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1696/S.3.4/text> , <http://bauhaus/qualite/attribut/1696/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
    
    <http://bauhaus/qualite/attribut/1696/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection is performed every quarter, with electronic data transmission for Metropolitan France and Guadeloupe."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1696/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1696/S.18.3/text> , <http://bauhaus/qualite/attribut/1696/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1696> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1575> {
    <http://bauhaus/qualite/attribut/1575/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted every two months (January, March, May, July, September, November, i.e. the odd months of the year).\n\nData collection is by post and via the internet from the end of the month preceding the survey month to the end of the survey month."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1575/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Questions are formulated so that they can be answered quickly (most of the questions are qualitative with three response options expressed in the form \"higher, lower, stable\", or \"more than normal, normal, less than normal\")."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1575>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Bi-monthly business outlook survey on wholesaling 2013"@en , "Rapport qualité : Enquête bimestrielle de conjoncture dans le commerce de gros 2013"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1128> .
    
    <http://bauhaus/qualite/attribut/1575/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête bimestrielle de conjoncture dans le commerce de gros a pour objet de transcrire l'opinion des grossistes sur leur activité récente et sur leurs perspectives d'activité.\n\nCette opinion est retracée au moyen du suivi du volume des ventes et de variables qui lui sont liées, telles que les stocks, les intentions de commandes, les livraisons, les perspectives générales d'activité, l'évolution des effectifs ainsi que celle des prix.\n\nLes grossistes fournissent également une opinion sur leur situation de trésorerie et les délais de paiement."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1575/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/58> , <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1575/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1575/I.18.10/text> , <http://bauhaus/qualite/attribut/1575/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1575/S.3.6/texte> , <http://bauhaus/qualite/attribut/1575/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 3,000 wholesalers.\n\nAll companies with more than 200 employees are questioned, and all those with a turnover of more than a certain threshold, depending on their sub-sector of activity."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1575/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> , <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête bimestrielle de conjoncture dans le commerce de gros est réalisée auprès de l'ensemble des grossistes à l'exclusion de certains sous-secteurs qui sont : les intermédiaires du commerce de gros, le commerce de gros de tabac (manufacturé ou non), le commerce de gros de déchets et débris, le commerce de gros non spécialisé.\n\nPlus précisément, l'enquête couvre les secteurs définis par les codes NAF Rév. 2 suivants : 46.2, 46.3 (hors 4635Z), 46.4, 46.5, 46.6, 46.7 (hors 4677Z)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1575/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1575/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/documents/document/444>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Indicateur de climat des affaires et de retournement conjoncturel – Tous secteurs"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-04-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_CONJ_CLIMAT_AFF_FR_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1575/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1575/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1575> .
    
    <http://bauhaus/qualite/attribut/1575/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The bi-monthly business outlook survey on wholesaling is conducted on all wholesalers, with the exception of certain sub-sectors: wholesale intermediaries, wholesale tobacco trade (whether manufactured or not), wholesale trade of waste and scrap, non-specialised wholesale trade.\n\nMore precisely, the survey covers the sectors defined by the following NAF Rev. 2 codes: 46.2, 46.3 (excl. 4635Z), 46.4, 46.5, 46.6, 46.7 (excl. 4677Z)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/453>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête bimestrielle de conjoncture dans le commerce de gros"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/methodo_enq_conj_comgros_3052010.pdf> .
    
    <http://bauhaus/documents/page/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
