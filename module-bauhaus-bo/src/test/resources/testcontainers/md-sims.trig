            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    " La fiche qualité est décrite selon la norme européenne du Single integrated metadata structure (SIMS)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1843/S.13.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.13.1>
                    <http://bauhaus/qualite/attribut/1843/S.13.1/texte> , <http://bauhaus/qualite/attribut/1843/S.13.1/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
