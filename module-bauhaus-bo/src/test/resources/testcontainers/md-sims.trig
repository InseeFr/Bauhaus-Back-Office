    <http://bauhaus/qualite/attribut/1953/I.20/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Unemployment file\n\n<https://www.insee.fr/fr/information/2022025>  \n"@en ;
