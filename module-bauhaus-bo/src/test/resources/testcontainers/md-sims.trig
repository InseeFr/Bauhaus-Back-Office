    <http://bauhaus/qualite/attribut/1736/S.3.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The following categories of the NACE Rev. 2 : sections C, D, E, F, G, H, I, J, L, N, divisions 69 to 74, groups 65.1, 65.2, 95.1, classes 64.19, 64.92, 66.12, 66.19."@en ;
            <http://purl.org/dc/terms/language>
