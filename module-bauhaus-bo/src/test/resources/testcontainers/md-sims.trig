    <http://bauhaus/documents/document/53>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Note additionnelle sur les changements de l'année 2017 "@fr ;
