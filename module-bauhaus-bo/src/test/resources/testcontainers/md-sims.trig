            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1953> .
    
    <http://bauhaus/qualite/attribut/1953/S.10.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "A file for researchers is accessible through the Quételet network :\n\n<https://quetelet.casd.eu/fr/utilisateur/connexion>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1953/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les données ont été révisées après le dernier recensement exhaustif de la population. Celui-ci a eu lieu en 2017, ainsi les données 2013-2017 sont révisées."@fr ;
