<http://rdf.insee.fr/graphes/qualite/rapport/1714> {
    <http://bauhaus/documents/document/214>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Traitement de la non-réponse et calages pour l'enquête santé itinéraire professionnel de 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-01-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/863_2_JMS2012_S04_1_DE_RICCARDIS_ACTE.pdf> .
    
    <http://bauhaus/qualite/attribut/1714/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête Santé et Itinéraire Professionnel suit un protocole novateur initié par un comité scientifique qui a établi et validé les choix méthodologiques afin d'appréhender les liens entre santé et itinéraire professionnel et leurs décalages temporels."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1714/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1714/S.3.6/texte> , <http://bauhaus/qualite/attribut/1714/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1714/I.18.10/texte> , <http://bauhaus/qualite/attribut/1714/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/212> .
    
    <http://bauhaus/documents/document/213>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Appréhender les interactions entre la santé et la vie professionnelle et leur éventuel décalage temporel, premier bilan d'une enquête innovante : SIP"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2009-10-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/102_4_JMS2009_S15_2_BAHU_ACTE.pdf> .
    
    <http://bauhaus/qualite/attribut/1714/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Punctual in two waves (in 2006 and in 2010)\n\nThe survey Health and Professional Career is based on a double interrogation spaced out of four years (at the end of 2006 and at the end of 2010).  \n\nA first wave was realized in 2006, the survey of 2010 is a re-interview."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1714/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey Health and Professional Career follows an innovative protocol introduced by a scientific committee which established and validated the methodological choices to apprehend the links between health and professional career and their temporal lags."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1714/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1714/S.10.6/text> , <http://bauhaus/qualite/attribut/1714/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The questioning of the first wave concerns:  \n\n- the main characteristics and the striking events of the family life in the childhood and in the grown-up life, as well as the changes connected to the professional life;  \n- the professional career;  \n- the characteristics of the current work, the income of the household;  \n- the current and past various social activities;  \n- a set of questions on some dimensions of health, past or current, the questions of self-assessment of the health, the statement of functional disabilities, pains or limitations of activities declared at the date of the survey.  \n\nThe second wave collects:  \n\n- similar elements on the health and on the work status for 2010;- additional elements on psychosocial risks at the date of the survey;  \n- the main evolutions of the professional career, the health and the family situation between 2006 and 2010."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1714/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le questionnement de la première vague porte sur :  \n\n- les principales caractéristiques et des évènements marquants de la vie familiale dans l'enfance et dans la vie adulte, ainsi que les déménagements liés à la vie professionnelle ;  \n- l'itinéraire professionnel ;  \n- les caractéristiques du travail actuel, les revenus du ménage ;  \n- les différentes activités sociales actuelles et passées ;  \n- un ensemble d'aspects de la santé, passée ou actuelle, des questions d'auto évaluation de la santé, un relevé de gênes fonctionnelles, de douleurs ou de restrictions d'activités déclarées au moment de l'enquête.  \n\nCelui de la seconde vague recueille :  \n\n- les mêmes éléments sur la santé et sur le travail en 2010 ;  \n- des éléments complémentaires sur des risques psychosociaux au moment de l'enquête ;  \n- les principales évolutions de l'itinéraire professionnel, de la santé et de la situation familiale entre 2006 et 2010."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/212>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2010"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-12-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Fiche_Qualite_SIP_2010.pdf> .
    
    <http://bauhaus/qualite/attribut/1714/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête Santé et Itinéraire Professionnel est basée sur une double interrogation espacée de quatre ans (fin 2006- fin 2010). Une première vague a été réalisée en 2006, l'enquête de 2010 est une ré-interrogation."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/214> , <http://bauhaus/documents/document/213> , <http://bauhaus/documents/document/215> .
    
    <http://bauhaus/qualite/attribut/1714/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1714/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1714/S.3.4/texte> , <http://bauhaus/qualite/attribut/1714/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Pour la partie panel : les individus âgés entre 20 et 74 ans en 2006, et vivant en logements ordinaires, c'est-à-dire en locaux indépendants à usage d'habitation. Ne font pas partie des logements ordinaires les habitations mobiles (roulottes, bateaux,…) et les communautés (établissements et collectivités).\n\nPour la partie risques psychosociaux (RPS) : les actifs occupés au moment de l'enquête vivant en logements ordinaires."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1714/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Site internet du Ministère du Travail, de l'Emploi, de la Formation professionnelle et du Dialogue social  \n\n[http://dares.travail-emploi.gouv.fr/dares-etudes-et-statistiques/etudes-et-syntheses/documents-d-etudes/article/sante-et-itineraire-professionnel-etat-de-la-connaissance-et-perspectives](The questioning of the first wave concerns: - the main characteristics and the striking events of the family life in the childhood and in the grown-up life, as well as the changes connected to the professional life; - the professional career; - the characteristics of the current work, the income of the household; - the current and past various social activities; - a set of questions on some dimensions of health, past or current, the questions of self-assessment of the health, the statement of functional disabilities, pains or limitations of activities declared at the date of the survey. The second wave collects: - similar elements on the health and on the work status for 2010;- additional elements on psychosocial risks at the date of the survey; - the main evolutions of the professional career, the health and the family situation between 2006 and 2010.)   \n"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1714/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1714/S.19/text> , <http://bauhaus/qualite/attribut/1714/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1714/S.18.3/texte> , <http://bauhaus/qualite/attribut/1714/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/rapport/1714>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Heath and Professional Career Survey 2010"@en , "Rapport qualité : Enquête Santé et Itinéraire Professionnel 2010"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1382> .
    
    <http://bauhaus/qualite/attribut/1714/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey Health and Professional Career is based on a double interrogation spaced out of four years (at the end of 2006 and at the end of 2010). A first wave was realized in 2006, the survey of 2010 is a re-interview."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1714/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-04-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey HPC contains:  \n\n- a longitudinal part, called Sample group, formed of persons who answered to both survey waves (in  2006 and 2010) and persons died between the two waves;  \n\n- a transversal part, called RPS (psychosocial risks), formed of an additional sample of working population questioned in 2010, coupled with the working population (in 2010) of the part Sample group."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1714/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1714/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/P> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "For the Panel group: the individuals between 20 and 74 years old in 2006, and living in ordinary housing, that is to say independent local with residential use. The mobile houses (trailers, boats) and communities (institutions and communities) are not part of ordinary housing.\n\nRPS group: the working population at the date of the survey living in ordinary housing."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/documents/document/215>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'impact de la mise en place d'un suivi d'adresse entre les deux vagues de l'enquête santé et itinéraire professionnel (SIP)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-01-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/949_2_JMS2012_CA_S05_MERMILLIOD_ACTE.pdf> .
    
    <http://bauhaus/qualite/attribut/1714/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- 1ère vague de novembre 2006 à janvier 2007, - 2ème vague quatrième trimestre 2010. La collecte est réalisée en face à face selon un mode de collecte assisté par informatique (Capi).\n\nL'enquête Santé et Itinéraire Professionnel est basée sur une double interrogation espacée de quatre ans (fin 2006- fin 2010).  \n\nUne première vague a été réalisée en 2006, l'enquête de 2010 est une ré-interrogation."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1714/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1714> .
    
    <http://bauhaus/qualite/attribut/1714/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête SIP comporte :  \n\n- une partie longitudinale, appelée Panel, composée des répondants aux deux vagues de l'enquête (2006 et 2010) et des personnes décédées entre les deux vagues ;  \n\n- une partie transversale, appelée RPS (risques psychosociaux), composée d'un échantillon complémentaire d'actifs occupés interrogés en 2010, couplé aux actifs occupés (en 2010) de la partie Panel."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1956> {
    <http://bauhaus/qualite/attribut/1956/S.13.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.13.1>
                    <http://bauhaus/qualite/attribut/1956/S.13.1/text> , <http://bauhaus/qualite/attribut/1956/S.13.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.13.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le taux de chômage annuel à  Mayotte est estimé avec un intervalle de confiance à 95 % de ± 2 points."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les données ont été révisées après le dernier recensement exhaustif de la population. Celui-ci a eu lieu en 2017, ainsi les données 2013-2017 sont révisées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1956/S.3.4/texte> , <http://bauhaus/qualite/attribut/1956/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.7/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The data collection is conducted from march to june. With some exceptions, the interview is usually conducted in the 2 weeks and 2 days following the reference week."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le questionnaire est  joint ci-dessous :"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1178> .
    
    <http://bauhaus/qualite/attribut/1956/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.18.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.5>
                    <http://bauhaus/qualite/attribut/1956/S.18.5/texte> , <http://bauhaus/qualite/attribut/1956/S.18.5/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage est une base d’adresses. Cette base d’adresses est actualisée via une enquête cartographique réalisée chaque année sur un cinquième du territoire. Les îlots mahorais ont été répartis en 5 groupes de rotation à partir des données du recensement de 2012. Ces groupes de rotation sont stratifiés selon le groupement géographique de l’ensemble des communes et ils sont équilibrés selon le nombre de logements.   \n\nLe plan de sondage est stratifié selon le type d’adresse (mono-logements, petites adresses et grandes adresses).   \nLe tirage de l’échantillon est équilibré selon le type de bâti (en dur ou autre), selon la localisation géographique et enfin selon une variable de classification des villages (celle-ci étant basée sur des critères socio-économiques et démographiques).  \n\nL’échantillon est rotatif. Il est renouvelé au tiers chaque année.   \n\nL'échantillon est uniformément réparti sur les 17 semaines de « référence ».   \n\nLe taux de sondage moyen est de 1/66."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.4>
                    "<p>Chef de la division Emploi</p>"@fr , "<p>Head of Employment Section</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.13.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The unemployment rate in Mayotte is estimated with a confidence interval at 95 % of ± 2 pt."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée entre mars et juin. Elle s’effectue, sauf exception, dans les 2 semaines et 2 jours après la fin de la semaine de référence."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/rapport/1956>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête Emploi annuelle de Mayotte 2013"@fr , "Quality report: Labour force survey (LFS)  Mayotte 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1512> .
    
    <http://bauhaus/qualite/attribut/1956/S.10.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Un fichier à destination des chercheurs est accessible par le réseau Quételet :\n\n<https://quetelet.casd.eu/fr/utilisateur/connexion>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.17.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data has been updated due to the new  population census. This one occured in 2017, and data from 2013 to 2017 have been updated."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Le statut d&rsquo;activit&eacute; au sens du BIT est mesur&eacute; en r&eacute;f&eacute;rence &agrave; une semaine donn&eacute;e fixe, dite &laquo;&nbsp;semaine de r&eacute;f&eacute;rence&nbsp;&raquo;.</p>"@fr , "<p>The ILO status of activity is measured according to a fixed week, named reference week.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.2/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "See the link\n\n<https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/S.13.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Taux de réponse : 86,0 %"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Dossier chômage\n\n<https://www.insee.fr/fr/information/2022025>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Chlo&eacute; Tavan</p>"@fr , "<p>Chlo&eacute; Tavan</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The LFS Mayotte questionnaire is structured around the following themes:  \n- a description of the household and its members;  \n- the status of an activity according to the ILO definition;  \n- a detailed description of the current main job (occupation, working time, kind of contract, etc.).  \n- the description of the employing institution  \n- The caracteristics of job search activities  \n- the level of education and participation in training;  \n- the situation one year before the survey (place of residence, labour market situation, etc.);  \n- the past and desired geographic mobility ;  \n- casual activities ;  \n- incomes."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>From March to July</p>"@en , "<p>De mars&nbsp; &agrave;&nbsp; juillet</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Individus de 15 ans ou plus vivant en logement ordinaire.   \nLien vers définition\n\n<https://www.insee.fr/fr/metadonnees/definition/c2056>"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.2>
                    <http://bauhaus/qualite/attribut/1956/S.3.2/texte> , <http://bauhaus/qualite/attribut/1956/S.3.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
    <http://bauhaus/qualite/attribut/1956/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey provides a measurement of activity, employment and unemployment according to the ILO definition. It provides a description of the job (status, occupation, working time…) according to european classifications / definitions.\n\n<https://ec.europa.eu/eurostat/statistics-explained/index.php/EU_labour_force_survey_-_methodology#EU-LFS_concept_of_labour_force_status>"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1956/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1956/I.18.12/texte> , <http://bauhaus/qualite/attribut/1956/I.18.12/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1956> .
    
