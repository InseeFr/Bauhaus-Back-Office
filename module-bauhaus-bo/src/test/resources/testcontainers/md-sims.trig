<http://rdf.insee.fr/graphes/qualite/rapport/1768> {
    <http://bauhaus/qualite/attribut/1768/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1768/S.18.3/text> , <http://bauhaus/qualite/attribut/1768/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/I.20>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.20>
                    <http://bauhaus/qualite/attribut/1768/I.20/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La construction de logements et de locaux (site internet du Ministère de la transition écologique et solidaire) :  \n<http://www.statistiques.developpement-durable.gouv.fr/logement-construction/i/construction.html>   \n"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1768/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les informations nécessaires à la constitution de ces indicateurs sont recueillies par le système d'information et de traitement automatisé des données élémentaires sur les logements et les locaux (sitadel) du Service de la donnée et des études statistiques (SDES).  \n\nDepuis avril 2009, la base Sit@del2 enregistre l'ensemble des opérations faisant l'objet d'un permis de construire (autorisation, ouverture de chantier…), répondant ainsi à des nouvelles spécifications en termes de détails des surfaces concernées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1768/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-03-21"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/S.10.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sit@del2 database gathers information on building permits and on building starts, supplied by the departmental offices of the French Ministry of Ecology Environment, Energy, Construction, Housing and Transport and by the municipalities.  \n\nThe Service de la donnée et des études statistiques (SDES) is responsible for consolidating all of this information."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1768/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/rapport/1768>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Building authorisations and building starts"@en , "Rapport qualité : Données des autorisations de construire et des mises en chantier"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/produits/indicateur/p1627> .
    
    <http://bauhaus/qualite/attribut/1768/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La demande de permis de construire constitue le document de base dont les informations sont collectées au niveau local par les mairies et les Directions départementales de l'équipement (DDE) pour être transmises aux services statistiques des Directions régionales de l'équipement.  \n\nLe Service de la donnée et des études statistiques (SDES) assure la consolidation de l'ensemble de ces informations."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1768/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1768/S.19/texte> , <http://bauhaus/qualite/attribut/1768/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1768/S.10.6/texte> , <http://bauhaus/qualite/attribut/1768/S.10.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
    
    <http://bauhaus/qualite/attribut/1768/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les logements en résidences se caractérisent par la fourniture de services individualisés (loisirs, restauration, soins ou autres) en sus du gîte.  \n\nLes foyers et les hôtels qui ne comportent que des chambres et des services communs ne sont pas classés dans les logements mais dans les locaux d'hébergement.  \n\nDans le cadre de la nouvelle organisation de son administration, le ministère chargé de l'aménagement du territoire a décidé le rapprochement de ses services exerçant les fonctions d'observation et d'information statistique.  \n\nLe Service de la donnée et des études statistiques (SDES) est rattaché au Commissariat général au développement durable.  \n\nIl assure, depuis le 10 juillet 2008, les fonctions de service statistique pour les domaines de l'environnement, de l'énergie, de la construction, du logement et des transports."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1768/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Community dwellings, such as halls of residence, nursing or retirement homes, prisons, etc.  provide individual services alongside lodging to their residents such as catering or nursing. Homes or hotels that have only rooms and common services (and not individual services) are not classified into community dwellings but into non residential buildings.  \n\nHostels and hotels which only have bedrooms and collective services are not classified as dwellings but as accommodation units.  \n\nThe Service de la donnée et des études statistiques (SDES) is attached to the General Commission for Sustainable Development."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1768/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The results published are culled from the sit@del2 database.  \n\nSince April 2009, the sit@del2 database has been recording all of the operations that are subject to planning permission (permit, housing start, etc.)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1768/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1768> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1610> {
