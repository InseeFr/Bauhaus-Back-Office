    <http://bauhaus/qualite/attribut/1954/S.17.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les données ont été révisées après le dernier recensement exhaustif de la population. Celui-ci a eu lieu en 2017, ainsi les données 2013-2017 sont révisées."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1954/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
