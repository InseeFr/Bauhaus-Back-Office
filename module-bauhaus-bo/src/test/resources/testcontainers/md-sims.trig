<http://rdf.insee.fr/graphes/qualite/rapport/1900> {
    <http://bauhaus/qualite/attribut/1900/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>La p&eacute;riode de r&eacute;f&eacute;rence est 2019 pour la plupart des questions&nbsp;; le dernier exercice comptable (2018) pour le commerce &eacute;lectronique.</p>"@fr , "<p>The reference period is mainly 2019 except for the characteristics referring to the previous accounting year (turnover, websales).</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1900> .
    
    <http://bauhaus/qualite/attribut/1900/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/148> .
    
    <http://bauhaus/qualite/attribut/1900/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
