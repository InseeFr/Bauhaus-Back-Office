    <http://bauhaus/qualite/attribut/1954/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The weighting adjustement is done in two steps.   \nThe weights are first adjusted by estimating the response probabilities using a logistic regression (with auxiliary variables : type of address, previous non-response status, type of housing, geographical location).  \nThen, a calibration is done on individual margins (disaggregated by gender and age group, diploma, place of birth) and on housing external margins (number of main residences)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1954/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le questionnaire est  joint ci-dessous :"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1174> .
    
    <http://bauhaus/qualite/attribut/1954/S.1.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
