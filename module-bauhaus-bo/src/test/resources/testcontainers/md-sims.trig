                    "Site de la Drees"@fr ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Description de l'enquête CARE (site de la Drees)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <http://drees.social-sante.gouv.fr/etudes-et-statistiques/open-data/personnes-agees/article/les-enquetes-capacites-aides-et-ressources-des-seniors-care> .
    
    <http://bauhaus/documents/document/564>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "L'enquête Handicap-santé - Volet Ménages : Présentation, calcul des poids"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-02-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/enq_handicap_volet_menages.pdf> .
}

