    <http://bauhaus/qualite/rapport/1707>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête sur la qualité de vie 2011"@fr , "Quality report: Survey on quality of life 2011 "@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1390> .
    
    <http://bauhaus/qualite/attribut/1707/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/227> .
    
    <http://bauhaus/documents/document/228>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête Qualité de vie 2011"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2011-05-03"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/DOC_ENQ_QUEST_QUAL_VIE_2011.pdf> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample is drawn in the 2010 tax file. The sample size is 10,000 individuals. The stratification variables are: age, sex, rural or urban character of the commune of residence, whether or not the individual is attached to a principal residence and, if attached to a principal residence, the dwelling type and household composition. "@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1707/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1707/S.3.4/text> , <http://bauhaus/qualite/attribut/1707/S.3.4/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/documents/document/227>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Les préconisations du rapport Stiglitz-Sen-Fitoussi : quelques illustrations"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2010-07-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/MET_ENQ_QUAL_VIE_DOSSIER_PRECON_STIGLITZ.pdf> .
    
    <http://bauhaus/qualite/attribut/1707/S.10.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.10.6>
                    <http://bauhaus/qualite/attribut/1707/S.10.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon est tiré dans le fichier d'imposition des personnes 2010 La taille de l'échantillon est de 10 000 individus. Les variables de stratification sont : l'âge, le sexe, le caractère rural ou urbain de la commune de résidence, le rattachement ou non de l'individu à une résidence principale et, s'il est rattaché à une résidence principale, le type d'immeuble et la composition du ménage."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Individus vivant dans des logements ordinaires (hors institutions) "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey comprises several modules covering several of the dimensions of quality of life, highlighted by the Stiglitz Commission, some of them not covered by public statistics:  \n- Living conditions, deprivations  \n- Quality of the environment and insecurity  \n- Job satisfaction  \n- Health  \n- Well-being in general  \n- Trust in society and in institutions"@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1707/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Unique survey carried out in the first half of 2011.  \nBimodal survey: internet and postal surveys.  \nThe questionnaire is self-administered via the Internet to 10,000 individuals 18 years of age or older, contacted by mail in May 2011. Non-respondents are contacted again , and receive a paper questionnaire to be returned by mail.  \nMetropolitan France for the 2011 survey. The overseas departments may be integrated if the experiment is conclusive and if the survey is renewed."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête comprend plusieurs modules qui couvriront plusieurs dimensions de la qualité de la vie, soulignées par la Commission Stiglitz, pour certaines non couvertes par la statistique publique :  \n- conditions de vie, privations  \n- qualité de l'environnement et insécurité  \n- satisfaction par rapport au travail  \n- santé  \n- bien-être en général  \n- confiance dans la société et dans les institutions"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1707/I.18.10/texte> , <http://bauhaus/qualite/attribut/1707/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/228> .
    
    <http://bauhaus/qualite/attribut/1707/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-12-29"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Enquête unique réalisée au cours du premier semestre de 2011.  \nEnquête bimode : internet et courrier.  \nLe questionnaire est auto-administré par Internet auprès de 10 000 individus de 18 ans ou plus, contactés par courrier en mai 2011. Les non-répondants par Internet sont relancés avec un questionnaire papier à retourner par la poste.   \nFrance métropolitaine pour l’enquête 2011. Les DOM pourront être intégrés si l’expérience est concluante et que l’enquête est renouvelée."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1707/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1707/S.18.3/texte> , <http://bauhaus/qualite/attribut/1707/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
    
    <http://bauhaus/qualite/attribut/1707/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1707> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1937> {
    <http://bauhaus/qualite/attribut/1937/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
