    <http://bauhaus/documents/document/242>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2013 Enquête Loyers et charges (1ère interrogation)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-01-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire2013_1ere_interro.pdf> .
    
    <http://bauhaus/qualite/attribut/1699/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1699/S.3.6/texte> , <http://bauhaus/qualite/attribut/1699/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1699/I.18.10/texte> , <http://bauhaus/qualite/attribut/1699/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/rapport/1699>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Rents and Charges Survey 2013"@en , "Rapport qualité : Enquête Loyers et charges 2013"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1347> .
    
    <http://bauhaus/qualite/attribut/1699/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Collection is carried out in January, April, July and October. This is a panel survey: the occupants of the accommodation are interviewed during 5 consecutive quarters.  \nThe first and last interviews of a household are conducted by visits (and after any change of tenant, or in the event of any difficulties in obtaining information by telephone). Intermediate surveys are conducted by telephone.  \n\nSurvey in Guadeloupe since October 2010."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1699/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Characteristics of the residential building and accommodation (including conveniences);  \n- Rental method and benefits received;  \n- Total amounts of rents and charges."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1699/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est effectuée en janvier, avril, juillet et octobre.  \nIl s'agit d'une enquête par panel : on interroge les occupants du logement pendant 5 trimestres consécutifs.  \nLa première et la dernière interrogation d'un ménage sont réalisées par visite (et après tout changement de locataire ou en cas de difficulté éventuelle d'obtention des informations par téléphone). Les interrogations intermédiaires sont menées par téléphone.  \n\nEnquête en Guadeloupe depuis octobre 2010."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1699/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/documents/document/241>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Pourquoi les ménages pauvres paient-ils des loyers plus ou moins élevés ? L’incidence des aides au logement en France"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2005-10-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/enq_loyer_charges_incidences_revenus.pdf> .
    
    <http://bauhaus/qualite/attribut/1699/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "- Caractéristiques de l'immeuble, du logement (dont les éléments de confort) ;  \n- Mode de location et aides perçues ;  \n- Montants des loyers et des charges."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1699/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1699/S.18.3/text> , <http://bauhaus/qualite/attribut/1699/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1699/S.3.4/texte> , <http://bauhaus/qualite/attribut/1699/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Ensemble des résidences principales louées vides dont l'objet essentiel de la location est l'habitation.  \nDepuis 2013, l'enquête en métropole porte uniquement sur les loyers du secteur libre (les logements du secteur HLM sont interrogés via l'enquête ELBS)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1699/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Chaque trimestre, environ 3 700 logements en métropole et 600 en Guadeloupe font partie de l'échantillon à enquêter.  \nIl s'agit de résidences principales louées vides dont l'objet essentiel de la location est l'habitation : les logements concernés ne doivent pas avoir plus de 50 % de leur surface consacrée à une activité professionnelle.  \nSont exclus du champ les logements en sous-location, les locations-ventes (ou locations-accession) ainsi que les logements occupés à titre gratuit.  \nL'échantillon est tiré dans l'échantillon maître de l'Insee (issu du recensement de la population).  \nUn cinquième de l'échantillon est renouvelé chaque trimestre : l'échantillon sortant se compose des logements interrogés 5 fois et des logements hors champ à l'enquête précédente.  \nOn effectue chaque trimestre le remplacement du sous-échantillon sortant par un sous échantillon entrant.\n\n "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1699/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/Q> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/241> .
    
    <http://bauhaus/qualite/attribut/1699/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Each quarter, approximately 3,700 homes in Metropolitan France and 600 in Guadeloupe form part of the sample to be surveyed.  \nThese are main residences rented in an unfurnished state, whose main purpose is residential: the accommodation concerned must not have more than 50% of its surface area used for a professional activity.  \nSub-let accommodation, leases with purchase options (or rental/purchase schemes) and accommodation occupied on a free basis, are excluded from the field of the survey.  \nThe sample is drawn from the INSEE master sample (derived from the population census).  \nOne fifth of the sample is renewed each quarter: the outgoing sample consists of accommodation surveyed 5 times and accommodation which fell outside the scope of the previous survey.  \nEach quarter, the outgoing sub-sample is replaced by an incoming sub-sample."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1699/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/242> , <http://bauhaus/documents/document/243> .
    
    <http://bauhaus/qualite/attribut/1699/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-07-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All main residences rented in an unfurnished state which essential reason for the rental is housing.  \nSince 2013, the scope of the survey in metropolitan France has been restricted to the private sector (social sector is collected through the quarterly survey on the rents of the social sector)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1699/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Depuis 1958</p>"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1699/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/qualite/attribut/1699/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/P> , <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1699> .
    
    <http://bauhaus/documents/document/243>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2013 Enquête Loyers et charges (ré-interrogation)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-01-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
