                    <http://bauhaus/qualite/rapport/1919> .
    
    <http://bauhaus/documents/document/1060>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Enquête Exploitations forestières (Questionnaire 2017)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_esa2017_Exploitations_forestieres.pdf> .
    
    <http://bauhaus/qualite/attribut/1919/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1919> .
    
    <http://bauhaus/qualite/attribut/1919/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "De février à octobre"@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/1045>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice Transports"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2019-03-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Notice_transport.pdf> .
    
    <http://bauhaus/qualite/attribut/1919/S.3.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The themes addressed in the survey are as follows:   \n-The business's principal activity;  \n-The events occurring during the accounting year (merger-absorption, full transfert of assets, partial transfer of assets, split off);  \n-The details of the restructuring (increases and decreases in fixed assets);  \n-Tangible investments and sales;  \n-Employment (non-employeed staff, temporary staff, staff leased to other companies, etc.);  \n-Breakdown of turnover by product or detailed activity;  \n-Professional expenses (non-stored purchases, incorporated sub-contracting, etc.);\n\nSectoral characteristics such as:  \n- Breakdown of the turnover of the form of sales like company retail;  \n- Analysis of the customer base (breakdown of turnover by type of customer);  \n- Analysis of the providers retail;  \n- Other charges and external charges (general sub-contracting, rent and rental charges, maintenance expenses, etc.) for transport companies;  \n- Long-term assets, a for agri-food companies and agricultural cooperative;  \n- Work performed on existing or future buildings;  \n- Localisation of sites, work performed on existing or future buildings, type of work performed;  \n- The list of establishments registered on the Business Register Sirene, subcontracting capacity, financial leasing for forestry companies."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1919/S.3.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.3.8>
                    "<p>Ann&eacute;e civile</p>"@fr , "<p>Calendar year</p>"@en ;
