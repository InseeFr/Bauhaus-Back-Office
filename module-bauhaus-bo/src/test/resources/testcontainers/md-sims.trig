    <http://bauhaus/qualite/attribut/1955/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>Le statut d&rsquo;activit&eacute; au sens du BIT est mesur&eacute; en r&eacute;f&eacute;rence &agrave; une semaine donn&eacute;e fixe, dite &laquo;&nbsp;semaine de r&eacute;f&eacute;rence&nbsp;&raquo;.</p>"@fr , "<p>The ILO status of activity is measured according to a fixed week, named reference week.</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L’enquête Emploi s’inscrit dans un cadre européen, défini par le règlement 577/1998 du Conseil du 9 mars 1998."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1955/S.17.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.17.2>
                    <http://bauhaus/qualite/attribut/1955/S.17.2/texte> , <http://bauhaus/qualite/attribut/1955/S.17.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1955> .
    
    <http://bauhaus/qualite/attribut/1955/S.18.5/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The weighting adjustement is done in two steps.   \nThe weights are first adjusted by estimating the response probabilities using a logistic regression (with auxiliary variables : type of address, previous non-response status, type of housing, geographical location).  \nThen, a calibration is done on individual margins (disaggregated by gender and age group, diploma, place of birth) and on housing external margins (number of main residences)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
