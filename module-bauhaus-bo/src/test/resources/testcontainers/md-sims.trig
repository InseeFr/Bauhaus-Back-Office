            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1721/S.3.6/text> , <http://bauhaus/qualite/attribut/1721/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1721/I.18.10/text> , <http://bauhaus/qualite/attribut/1721/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1721/S.18.3/text> , <http://bauhaus/qualite/attribut/1721/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Pour l'enquête de l'année N (portant sur les données de l'exercice N-1), l'envoi des questionnaires, sous format papier, se fait en seule fois en décembre de l'année N-1.\n\nLes entreprises interrogées ont jusqu'au 31 janvier de l'année N pour retourner les questionnaires."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1721/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1721/S.3.4/texte> , <http://bauhaus/qualite/attribut/1721/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey covers the activities defined by the NAF rev. 2 code: 61 (Telecommunications)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1721/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "On enquête :\n\n- l'opérateur principal proposant des services de téléphonie fixe aux ménages ;  \n- les trois principaux opérateurs proposant des services de téléphonie mobile aux ménages ;  \n- les trois principaux fournisseurs d'accès à Internet aux ménages.\n\n "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1721/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2016-05-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/documents/document/188>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les services de télécommunications - Fournisseur d'accès à internet (FAI)"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-02-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_FAI_2011.pdf> .
    
    <http://bauhaus/qualite/attribut/1721/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "For the survey in year N (concerning the data for the fiscal year N-1), the questionnaires in paper format, are sent on just one occasion, in December of the year N-1.\n\nThe enterprises surveyed are given until 31 January of year N to return the questionnaires."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1721/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The following parties are surveyed:\n\n- Main operator proposing landline telephony services to households,  \n- Three main operators proposing mobile telephony services to households,  \n- Three main providers of internet services for households."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1721/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Sont collectées les informations sur les comportements de consommation des ménages en services de télécommunications suivantes :  \n\nTéléphonie mobile :  \n\n- la forme d'engagement ;  \n- la durée mensuelle totale des appels ;  \n- la répartition temporelle des appels.  \n\nTéléphonie fixe :  \n\n- le nombre de différents types d'abonnements ;  \n- la répartition du chiffre d'affaires (CA) des services les plus souscrits et utilisés.  \n\nFournisseurs d'accès à internet (FAI) :  \n\n- le nombre d'anciens et de nouveaux abonnés ;  \n- la répartition du chiffre d'affaires (CA) des services les plus souscrits et utilisés."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1721/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1721/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
    
    <http://bauhaus/qualite/attribut/1721/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The following information is collected concerning the consumer behaviour of households for telecommunications services:  \n\nMobile telephony:  \n\n- Form of the contractual commitment,  \n- Total monthly duration of calls,  \n- Temporal distribution of calls.  \n\nLandline telephony:  \n\n- Numbers of different types of subscriptions,  \n- Breakdown of the turnover of the most frequently subscribed and used services.  \n\nInternet Service Providers (ISPs):  \n\n- Numbers of old and new subscribers,  \n- Breakdown of the turnover of the most frequently subscribed and used services."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1721/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/188> , <http://bauhaus/documents/document/186> , <http://bauhaus/documents/document/187> .
    
    <http://bauhaus/documents/document/187>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire de l'enquête sur les services de télécommunications - Opérateur de téléphonie fixe"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2012-02-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_operateur_fixe_2011.pdf> .
    
    <http://bauhaus/qualite/attribut/1721/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1721> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1963> {
    <http://bauhaus/qualite/attribut/1963/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1963/I.18.10/text> , <http://bauhaus/qualite/attribut/1963/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/rapport/1963>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête européenne sur l'activité des filiales étrangères des groupes français 2019"@fr , "Quality report: Survey on activities of subsidiaries under national control implanted in foreign countries 2019"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1518> .
    
    <http://bauhaus/qualite/attribut/1963/S.1.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.5>
                    "<p>88 avenue Verdier - CS 70058 - 92541 Montrouge cedex</p>\n<div id=\"mailtorapidetoModal\" style=\"z-index: 20002;\">&nbsp;</div>"@fr , "<p>88 avenue Verdier - CS 70058 - 92541 Montrouge cedex</p>\n<div id=\"mailtorapidetoModal\" style=\"z-index: 20002;\">&nbsp;</div>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte s'effectue à compter du mois de juin pour les très grands groupes et à compter de septembre pour les autres. Les unités UCI sont interrogés par (via) Internet. Le support excel est toutefois proposé aux plus grands groupes."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1963/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/G> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le champ est l'ensemble des groupes dont le principal centre de décision (UCI) est en France et contrôlant au moins une société implantée hors de France. La sélection des groupes à enquêter est faite à partir du fichier issu de l'enquête sur les liaisons financières (Lifi) qui donne les contours de groupes et une information sur les implantations étrangères de rang 1. Tous les ans, ce sont environ 2 500 groupes français ayant au moins une filiale hors de France quel que soit le secteur d'activité du groupe (à l'exception du secteur bancaire couvert par la Banque de France) qui sont sélectionnés pour être interrogés au titre de l'enquête OFATS. Conformément au règlement Eurostat, aucun seuil de taille de chiffre d'affaires ou d'effectifs n'a été appliqué. "@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1963/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "This survey contains the three variables to be necessarily supplied, as from 2011 concerning 2009, for France: the turnover, the staff and the number of subsidiaries by country of presence of subsidiaries and by business sector. It also integrates some additional variables among which the costs of staff and the physical investment. This OFATS survey questions the French groups on the same parameters of their locations abroad: number of affiliates by country and activity sector, and turnover and manpower of these subsidiaries. The survey includes three variables that appear in the FATS regulation and are necessarily required: the number of subsidiaries, their number of employees and their turnover by country and activity sector."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1963/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    " Cette enquête comporte les trois variables à fournir obligatoirement, à compter de 2011 sur l'exercice 2009, pour la France : le chiffre d'affaires, les effectifs et le nombre de filiales par pays d'implantation des filiales et par secteur d'activité. Elle intègre également quelques variables additionnelles dont les coûts de personnel et l'investissement corporel."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1963/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/I> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/1226> , <http://bauhaus/documents/document/1227> .
    
    <http://bauhaus/qualite/attribut/1963/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Tous les secteurs d'activité marchands sont concernés, à l'exception du secteur bancaire du ressort de la Banque de France.  \n\nL'unité enquêtée est l' \" UCI \" , Ultimate Controlling Institutional unit. Cette unité définie par Eurostat correspond à l'unité qui exerce le contrôle des filiales déclarées dans l'enquête. Ce contrôle se caractérise par le pouvoir de nommer les dirigeants des sociétés ou des business units en charge des activités opérationnelles. L'UCI est aussi l'unité qui dispose des données de toutes les filiales du groupe."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1963/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.2>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection is made from May for large MNE and from September for the others. The units \"UCI\" are questioned either by (via) Internet, or by an Excel file for large companies."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1963/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1963/S.3.6/text> , <http://bauhaus/qualite/attribut/1963/S.3.6/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The coverage is all the groups for which the main center of decision is in France and controlling at least a company implanted outside France. The selection of the groups to be investigated is made from the file stemming from the survey on financial links (Lifi) which gives the outlines of groups and an information on the foreign subsidiaries. INSEE questions yearly about 2,500 groups of the non-financial sectors with at least one subsidiary outside France. The results of the survey are statistically adjusted for partial and total non-response. Due to the dominant role of major groups in the global economy, the largest groups that have not responded are subject to a specific treatment, based on information about their foreign affiliates available in their yearly reports."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1963/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1963/I.18.12/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.6.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L’enquête OFATS  répond au règlement européen n° 716/2007 du 20 juin 2007."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/documents/document/1227>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2019 de l'enquête européenne sur l'activité des filiales étrangers des groupes français / OFATS"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/QUESTIONNAIRE_OFATS_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1963/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The OFATS survey complies with European Regulation n° 716/2007 of 20 June 2007."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1963/S.1.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.6>
                    "contact@insee.fr"@fr , "contact@insee.fr"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "All merchant activity sectors are concerned (excluded financial sector).  \n\n\" UCI \" : Ultimate Controlling Institutional unit."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1963/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1963/S.18.3/texte> , <http://bauhaus/qualite/attribut/1963/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/documents/document/1226>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Notice 2019 de l'enquête européenne sur l'activité des filiales étrangers des groupes français / OFATS"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/notice_OFATS_2019.pdf> .
    
    <http://bauhaus/qualite/attribut/1963/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1963/S.3.4/texte> , <http://bauhaus/qualite/attribut/1963/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
    
    <http://bauhaus/qualite/attribut/1963/S.6.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.6.1>
                    <http://bauhaus/qualite/attribut/1963/S.6.1/text> , <http://bauhaus/qualite/attribut/1963/S.6.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1963> .
}

