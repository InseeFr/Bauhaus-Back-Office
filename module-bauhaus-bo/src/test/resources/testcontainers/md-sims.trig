    <http://bauhaus/qualite/attribut/1943/I.18.7/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte s’étend de la fin du mois précédant le trimestre de référence de l'enquête à la date de la publication des résultats (entre le 20 et le 25 du mois de référence)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1943/S.8.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.8.2>
                    <http://bauhaus/qualite/attribut/1943/S.8.2/texte> , <http://bauhaus/qualite/attribut/1943/S.8.2/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1943> .
    
    <http://bauhaus/qualite/attribut/1943/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1943/S.3.3/text> , <http://bauhaus/qualite/attribut/1943/S.3.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1943> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1810> {
    <http://bauhaus/qualite/attribut/1810/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les unités enquêtées sont les hébergements collectifs touristiques faisant l'objet d'une réglementation.\n\nIl s'agit des auberges de jeunesse, des centres internationaux de séjour, des centres sportifs, des résidences de tourisme et résidences hôtelières, des maisons familiales de vacances et des villages de vacances soit près de 4 000 unités.\n\nL'unité économique interrogée est l'exploitant de l'hébergement (NAF rév. 2 : 55.10Z et 55.20Z).\n\nLes hôtels et campings classés sont observés dans le cadre des enquêtes de fréquentation dans l'hôtellerie homologuée et hôtellerie de plein air."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1810/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/rapport/1810>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Rapport qualité : Enquête de fréquentation dans les autres hébergements collectifs touristiques 2013"@fr , "Quality report: Other Collective Tourist Accommodation Occupancy Survey 2013"@en ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1314> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1810/S.3.4/texte> , <http://bauhaus/qualite/attribut/1810/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1810/S.19/text> , <http://bauhaus/qualite/attribut/1810/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/documents/document/275>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2013"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2013-01-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/ENQ_FREQ_AUTRE_HEBERGEMENT_COLL_AHC_13.pdf> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête est réalisée auprès d'un échantillon national d'environ 2 800 établissements.\n\nL'enquête de fréquentation dans les autres hébergements collectifs touristiques complète les informations concernant la fréquentation touristique déjà produites par :\n\n- les enquêtes de fréquentation dans l'hôtellerie homologuée ;\n\n- les enquêtes de fréquentation dans l'hôtellerie de plein air."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The units surveyed are collective tourist accommodation that is subject to regulation.\n\nThis concerns youth hostels, international accommodation centres, sports centres, tourism and hotel residences, family holiday homes and holiday villages, amounting to nearly 4,000 units.\n\nThe economic unit surveyed is the accommodation operator (NAF rev. 2: 55.10Z and 55.20Z).\n\nClassified hotels and campsites are observed in the context of occupancy surveys of approved hotels and campsites."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte des informations est effectuée sur support papier et par voie postale.\n\nLes questionnaires sont envoyés tout au long de l'année vers le 25 du mois précédant le mois de collecte.\n\nL'enquête est réalisée par voie postale pour la plupart des établissements et de manière centralisée auprès de quelques grandes enseignes (Lagrange, Néméa …), qui font parvenir un fichier comportant les données relatives à leurs établissements.\n\nCes données fournies font soit l'objet d'une mise à jour de masse (Lagrange) soit d'une saisie classique par les gestionnaires du site de collecte."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2015-11-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête de fréquentation dans les autres hébergements collectifs touristiques complète les informations concernant la fréquentation touristique déjà produites par :  \n- les enquêtes de fréquentation dans l'hôtellerie de tourisme ;  \n- les enquêtes de fréquentation dans l'hôtellerie de plein air.  \nCette enquête rentre dans le cadre du réglement européen n°692/2011 concernant la production d'informations statistiques sur le tourisme à Eurostat.  \nElle répond également aux besoins nationaux de la Direction Générale des Entreprises (DGE) et locaux pour les acteurs et décideurs régionaux du tourisme.  \nLe dispositif comporte deux extensions régionales dans les deux régions où existaient déjà cette enquête (Rhône-Alpes, Languedoc-Roussillon).  \nDans les DOM, les autres hébergements collectifs sont enquêtés dans l'enquête de fréquentation hôtelière."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/S.11.2/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/275> .
    
    <http://bauhaus/qualite/attribut/1810/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1810/I.18.10/text> , <http://bauhaus/qualite/attribut/1810/I.18.10/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/territoireFrancais/franceMetropolitaine> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data is collected on paper and by post.\n\nThe questionnaires are sent out throughout the year towards the 25th of the month preceding the month of data collection."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The following topics are covered:\n\n- Daily occupancy of accommodation units (youth hostels, international accommodation centres, sports centres, tourism and hotel residences, family holiday homes and holiday villages)\n\n- Arrivals and nights according to the tourists' country of residence\n\n- Characteristics of the clientele (proportion of business tourism, individuals, families, holiday camps, groups, etc.)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The occupancy survey in other collective tourist accommodation supplements the tourist occupancy information already produced by:  \n- Occupancy surveys of tourist hotels  \n- Occupancy surveys of campsites  \nThis survey relates to European reglement n°692/2011 concerning the production of statistical information on tourism at EUROSTAT.  \nIt also meets the French national needs of the Enterprise Directorate General  and the local needs of regional tourism stakeholders and decision makers.  \nThe scheme includes two regional extensions in the two regions already covered by this survey (Rhône-Alpes, Languedoc-Roussillon).  \nIn the overseas departments, other collective tourist accomodation are in the hotel occupancy survey."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les thèmes abordés sont les suivants :\n\n- occupation quotidienne des unités d'hébergement (auberges de jeunesse, centres internationaux de séjour, centres sportifs, résidences de tourisme, résidences hôtelières, maisons familiales ou villages de vacances) ;\n\n- arrivées et nuitées selon le pays de résidence des touristes ;\n\n- profil de la clientèle (proportion de tourisme d'affaires, d'individuel, de familles, de colonies, de groupes…)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey is conducted among a national sample of approximately 2,800 establishments."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1810/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1810/S.3.6/texte> , <http://bauhaus/qualite/attribut/1810/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
    
    <http://bauhaus/qualite/attribut/1810/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1810/S.18.3/texte> , <http://bauhaus/qualite/attribut/1810/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1810> .
}

