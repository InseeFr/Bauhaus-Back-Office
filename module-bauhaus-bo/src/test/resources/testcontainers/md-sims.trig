            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.7>
                    <http://bauhaus/qualite/attribut/1728/I.18.7/text> , <http://bauhaus/qualite/attribut/1728/I.18.7/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "The reference period is mainly 2012 except for the characteristics referring to the previous accounting year (turnover, websales). "@en , "La période de référence est 2012 pour la plupart des questions ; le dernier exercice comptable (souvent 2011) pour le commerce électronique"@fr ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/qualite/attribut/1728/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1728/S.12.1/text> , <http://bauhaus/qualite/attribut/1728/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1728> .
    
    <http://bauhaus/documents/document/170>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2012 de l'enquête sur l'usage de l'informatique et des technologies de la communication (auprès des entreprises demoins de 10 personnes) / TIC-TPE"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
