            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/I.18.8>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.8>
                    <http://bauhaus/codes/modeCollecte/F> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1979> .
    
    <http://bauhaus/qualite/attribut/1979/S.6.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The LFS is defined by the regulation n°577/1998 of the Council of 9 march 1998. This text has been modified and amended. In particular, the regulation n°1991/2002 imposed to have from 2003 a continuous survey, covering all the weeks of the year."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
