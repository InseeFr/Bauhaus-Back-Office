                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/948> , <http://bauhaus/documents/document/950> , <http://bauhaus/documents/document/949> , <http://bauhaus/documents/document/951> .
    
    <http://bauhaus/documents/document/950>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire France métropolitaine de l'enquête de fréquentation dans l'hôtellerie 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_hotel_métropole_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.10>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.10>
                    <http://bauhaus/qualite/attribut/1897/I.18.10/texte> , <http://bauhaus/qualite/attribut/1897/I.18.10/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte est réalisée par voie postale ou par internet, ainsi qu'une collecte centralisée auprès de certaines enseignes (exemple ACCOR)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Concerning the expansion to include overseas departments (DOM), two specific questionnaires were introduced: one for the three DOM in the French Antilles and one for Reunion Island.\n\nThis provides a statistical observation of tourism across the entire French territory.\n\nThis survey falls within the scope of European reglement 692/2011 on the collection of statistical information in the field of tourism in Eurostat.\n\nIt also meets the needs of the national department of tourism and of local and regional actors and decision-makers in the field of tourism."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La base de sondage est le fichier des hôtels de tourisme géré par l'Insee.  \nLes critères de stratification de l'échantillon national sont :  \n- l'axe géographique (régions, espaces touristiques nationaux (ETN))  \n- la catégorie d'hôtel (1 à 5 étoiles ou non classé)  \n- le type d'hôtel (chaîne ou indépendant)  \nAu sein des strates, le tirage est aléatoire."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Concernant l'extension aux départements d'outre-mer (DOM), deux questionnaires spécifiques ont été mis en place : un pour les trois DOM antillais et un pour la Réunion.\n\nElle permet ainsi une observation statistique du tourisme sur l'ensemble du territoire français.\n\nCette enquête rentre dans le cadre du règlement européen 692/2011 concernant la production d'informations statistiques sur le tourisme à Eurostat.\n\nElle répond également aux besoins nationaux de la direction du tourisme et locaux pour les acteurs et décideurs régionaux du tourisme."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.4>
                    <http://bauhaus/qualite/attribut/1897/S.3.4/texte> , <http://bauhaus/qualite/attribut/1897/S.3.4/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/I.6.4>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.4>
                    "2017M029EC"@fr , "2017M029EC"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Hotel stock is measured every year on 31 December and occupancy is measured every month.  \n\nThe main topics considered are:  \n- characteristics of the establishment;  \n- accommodation capacity;  \n- daily room occupancy;  \n- arrivals and nights spent by country of residence of tourists;  \n- average length of stay;  \n- proportion of business tourism."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/S.12.1/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The Comité de Coordination des Statistiques du Tourisme (Committee for the coordination of statistics on tourism), managed by Insee, comprises the main actors of the tourism industry : DGE (General Directorate for Equipment), Atout France, trade federations for the hoteliers and representatives of departmental and regional committees for tourism (FNCRT, RN2D).   \nThe needs of local partners are taken into account through partnership agreements with the tourism sites of Insee."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1897/S.18.3/text> , <http://bauhaus/qualite/attribut/1897/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1897/S.19/texte> , <http://bauhaus/qualite/attribut/1897/S.19/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Data collection is by post or internet, and  centralized collection at some enterprises (example ACCOR)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1897/I.6.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.6.3>
                    <http://bauhaus/codes/statutEnquete/T> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/M> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Le parc est mesuré au 31 décembre de chaque année et la fréquentation sur chaque mois.  \n\nLes principaux thèmes abordés sont les suivants :  \n- caractéristiques de l'établissement ;  \n- capacité d'accueil ;  \n- occupation quotidienne des chambres ;  \n- arrivées et nuitées selon le pays de résidence des touristes ;  \n- durée moyenne de séjour ;  \n- proportion de tourisme d'affaires."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1897/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2018-07-31"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/qualite/attribut/1897/S.12.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.12.1>
                    <http://bauhaus/qualite/attribut/1897/S.12.1/text> , <http://bauhaus/qualite/attribut/1897/S.12.1/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1897> .
    
    <http://bauhaus/documents/document/949>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire Antilles - Guyane de l'enquête de fréquentation dans l'hôtellerie 2017"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2017-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Questionnaire_hotel_antilles_2017.pdf> .
    
    <http://bauhaus/qualite/attribut/1897/I.18.12>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.12>
                    <http://bauhaus/qualite/attribut/1897/I.18.12/texte> ;
