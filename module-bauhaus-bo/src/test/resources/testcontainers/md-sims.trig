                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/documents/document/142>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Qualité de l'enquête relative à l'exercice 2006"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "2009-02-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Fiche_qualite_TIC.pdf> .
    
    <http://bauhaus/documents/document/946>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Questionnaire 2006 de l'Enquête sur les changements organisationnels et technologies de l'information et de la communication (auprès des entreprises) / TIC-COI"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/tic06_quest2006.pdf> .
    
    <http://bauhaus/qualite/attribut/1739/S.5>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.5>
                    "<p>La p&eacute;riode de r&eacute;f&eacute;rence est 2006 pour la plupart des questions&nbsp;; le dernier exercice comptable (2005) pour le commerce &eacute;lectronique.</p>"@fr , "<p>The reference period is mainly 2006 except for the characteristics referring to the previous accounting year (turnover, websales).</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The topics covered are: the development of new technologies and the intensity of their use in business; the types of use of ICT (electronic commerce, sharing and exchanging of information and, more generally, relations with the world outside the business); the obstacles and impacts of this dissemination ; the organizational changes it involves."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.19>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.19>
                    <http://bauhaus/qualite/attribut/1739/S.19/text> , <http://bauhaus/qualite/attribut/1739/S.19/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.3>
                    <http://bauhaus/qualite/attribut/1739/S.3.3/texte> , <http://bauhaus/qualite/attribut/1739/S.3.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.2.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.2.3>
                    "2017-01-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1739/S.18.3/texte> , <http://bauhaus/qualite/attribut/1739/S.18.3/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.12/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/946> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The scope covers businesses with 10 employees or more belonging to the following sectors of NACE rev. 1: industry and the agri-food industries (section D), the energy sector (section E), the building industry (section F), trade (section G), hotels and restaurants (section H), transport and communications (section I), financial services (section J partial), real-estate, leasing and services to businesses (section K) and the audiovisual sector (groups 92.1 and 92.2 in NAF rev. 1)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.3/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The collection, conducted by mail, is launched in the first quarter of the year in question.  \nThe survey covers the whole of France (geography at the time of collection)."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/rapport/1739>
            a       <http://www.w3.org/ns/sdmx-mm#MetadataReport> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Quality report: Survey on organizational changes and information and communication technologies in business 2006"@en , "Rapport qualité : Enquête sur les changements organisationnels et technologies de l'information et de la communication dans les entreprises 2006"@fr ;
            <http://www.w3.org/ns/sdmx-mm#target>
                    <http://bauhaus/operations/operation/s1313> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The sample is drawn from the annual enterprises surveys files 2004 (EAE), except for the enterprises belonging to financial sectors and the division 73, taken from the SIRENE register.  \n\nThe sample is stratified by business sector and by size."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Les thèmes abordés sont : le développement des nouvelles technologies et l'intensité de leur utilisation au sein de l'entreprise ; les types d'utilisation des TIC (commerce électronique, partage et échange d'information, plus généralement les relations avec le monde externe à l'entreprise) ; les obstacles et l'impact de cette diffusion ; les changements organisationnels qui en découlent."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.9>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.2>
                    <http://bauhaus/codes/frequence/A> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.1.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.7>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.7>
                    <http://bauhaus/geo/pays/france> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L’échantillon est tiré dans les fichiers d’entreprises des enquêtes annuelles d’entreprises 2004 (EAE), à l’exception des unités appartenants aux secteurs financiers ou à la division 73, tirés dans le répertoire Sirene.  \n\nL'échantillon est stratifié par secteur d'activité et par taille."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.19/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête communautaire sur \" l'utilisation des TIC et le commerce électronique \" dans les entreprises est un ensemble d'enquêtes réalisées par les instituts nationaux de la statistique des pays membres de l'union européenne.  \n\nElle s'inscrit dans le règlement n° 808/2004 adopté en date du 21 avril 2004 dans le cadre de la mise en œuvre du plan d'action eEurope 2005 consacré aux technologies de l'information et de la communication, règlement amendé par le règlement européen n° 1006/2009 du 16 septembre 2009. Dans ce cadre, les enquêtes sur les TIC et le commerce électronique dans les entreprises réalisées par les pays de l'Union européenne suivent une méthodologie commune et un même modèle de questionnaire.  \n\nChaque année, un ou plusieurs thèmes, déterminés par le règlement européen annuel d'application du règlement cadre, fait l'objet d'un développement particulier."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.18.3/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "La collecte, effectuée par voie postale, est lancée au premier trimestre de l'année considérée.  \nL'enquête couvre la France entière (géographie à la date de la collecte)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1739/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.1.1>
                    <http://bauhaus/organisations/insee/DG75-E001> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.19/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The EC survey on the \"use of ICT and electronic commerce\" in business is a set of surveys conducted by the national institutes of statistics of the member countries of the European Union.  \n\nIt complies with regulation n°808/2004 adopted on April 21, 2004 as part of the implementation of the 2005 eEurope action plan devoted to information and communication technologies: this regulation was amended by European regulation n° 1006/2009 of September 16, 2009. Accordingly, the surveys on ICT and electronic commerce in business conducted by the countries of the European Union follow a common methodology and the same model of questionnaire.  \n\nEach year, one or more topics, determined by the annual European regulation for the implementation of the framework regulation, are developed in particular."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1739/S.3.6>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.3.6>
                    <http://bauhaus/qualite/attribut/1739/S.3.6/texte> , <http://bauhaus/qualite/attribut/1739/S.3.6/text> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
    
    <http://bauhaus/qualite/attribut/1739/S.11.2>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.11.2>
                    <http://bauhaus/qualite/attribut/1739/S.11.2/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1739> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1606> {
    <http://bauhaus/qualite/attribut/1606/I.18.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/I.18.9>
                    <http://bauhaus/codes/uniteEnquetee/E> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1606> .
    
    <http://bauhaus/qualite/attribut/1606/S.10.6/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/document/406> .
    
    <http://bauhaus/qualite/attribut/1606/S.3.4/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'enquête trimestrielle de conjoncture dans la promotion immobilière permet de transcrire l'opinion des promoteurs et des entreprises réalisant de la location immobilière sur leur activité récente et sur leurs perspectives d'activité.\n\nCette opinion est retracée au moyen du suivi de la demande en logements neufs à acheter et à louer, des stocks de logements invendus, du prix de vente des logements. Les données sur les perspectives sont fournies notamment par le suivi des opinions sur les mises en chantier."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1606/I.20/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> ;
            <http://rdf.insee.fr/def/base#additionalMaterial>
                    <http://bauhaus/documents/page/33> , <http://bauhaus/documents/page/52> , <http://bauhaus/documents/page/53> .
    
    <http://bauhaus/qualite/attribut/1606/I.18.10/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "The survey covers 1,000 property development companies producing dwellings to buy and dwellings to rent."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1606/I.18.8>
