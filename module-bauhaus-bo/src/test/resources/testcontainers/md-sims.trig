    <http://bauhaus/qualite/attribut/1977/S.1.1>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/qualite/attribut/1977/S.18.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://bauhaus/qualite/simsv2fr/attribut/S.18.3>
                    <http://bauhaus/qualite/attribut/1977/S.18.3/text> , <http://bauhaus/qualite/attribut/1977/S.18.3/texte> ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1977> .
    
    <http://bauhaus/documents/document/1263>
            a                        <http://xmlns.com/foaf/0.1/Document> ;
            <http://www.w3.org/2000/01/rdf-schema#label>
                    "Documentation méthodologique Filosofi 2018"@fr ;
            <http://purl.org/dc/elements/1.1/language>
                    "fr" ;
            <http://purl.org/pav/lastRefreshedOn>
                    "0027-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
            <http://schema.org/url>  <https://www.insee.fr/fr/metadonnees/source/fichier/Source_methodes_Filosofi_2018.pdf> .
}

<http://rdf.insee.fr/graphes/qualite/rapport/1747> {
    <http://bauhaus/qualite/attribut/1747/I.18.10/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L'échantillon comporte environ 210 000 ménages (dont 10 000 dans les DOM)."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1747/S.3.6/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Private (i.e. non-institutional) households i.e. not living in communities (nursing homes, homes, prisons, hospitals...) or in mobile homes (sailors, homeless ...).  \nPeople living in homes for the elderly are included.  \nDwellings in which at least one individual born before 2nd May 1955 lives.  \nThe respondents are all the residents of the dwelling over 15."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1747/S.18.2>
