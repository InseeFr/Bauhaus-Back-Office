    <http://bauhaus/qualite/attribut/1928/S.1.3>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
            <http://ec.europa.eu/eurostat/simsv2/attribute/S.1.3>
                    "<p>Myriam Broin</p>"@fr , "<p>Myriam Broin</p>"@en ;
            <http://www.w3.org/ns/sdmx-mm#metadataReport>
                    <http://bauhaus/qualite/rapport/1928> .
    
    <http://bauhaus/qualite/attribut/1928/S.8.1/texte>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "L’enquête de conjoncture dans l’industrie est réalisée tous les mois. Les résultats sont publiés entre le 20 et le 25 du mois de référence."@fr ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/fr> .
    
    <http://bauhaus/qualite/attribut/1928/S.10.4/text>
            a       <http://purl.org/dc/dcmitype/Text> ;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#value>
                    "Individual response files are stored annually. Any request for access to these individual data shall be subject to the authorisation of the Committee on Statistical Confidentiality. The data is then made available to users outside Insee via the CASD (Centre d'accès sécurisé aux données), after passing through the Secret Committee."@en ;
            <http://purl.org/dc/terms/language>
                    <http://bauhaus/codes/langue/en> .
    
    <http://bauhaus/qualite/attribut/1928/S.9>
            a       <http://www.w3.org/ns/sdmx-mm#ReportedAttribute> ;
