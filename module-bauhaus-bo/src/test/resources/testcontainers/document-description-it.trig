# 9001 : document complet, cité dans une rubrique DOC_METHOD.
# page/9001 : lien qui partage l'identifiant du document, cité dans une rubrique COLLECTION_DOCUMENTS.
# 9002 : document sans aucune donnée facultative, cité nulle part.
# 9003 : document cité dans deux rubriques de concepts différents, taille dans un format non repris.

<http://rdf.insee.fr/graphes/qualite/documents> {
    <http://bauhaus/documents/document/9001>
        a                    foaf:Document ;
        rdfs:label           "Les projections de population 2026"@fr , "Population projections for 2026"@en ;
        rdfs:comment         "Commentaire sur les projections"@fr , "Comment on population projections"@en ;
        pav:lastRefreshedOn  "2026-04-09"^^xsd:date ;
        dc:language          "fr" ;
        dcterms:extent       "130048"^^xsd:integer ;
        schema:url           <https://www.insee.fr/fr/metadonnees/source/fichier/Note_technique.pdf> .

    <http://bauhaus/documents/page/9001>
        a                    foaf:Document ;
        rdfs:label           "Page des projections"@fr ;
        schema:url           <https://www.insee.fr/fr/statistiques/9001> .

    <http://bauhaus/documents/document/9002>
        a                    foaf:Document ;
        rdfs:label           "Document minimal"@fr ;
        schema:url           <https://www.insee.fr/fr/metadonnees/source/fichier/minimal.pdf> .

    <http://bauhaus/documents/document/9003>
        a                    foaf:Document ;
        rdfs:label           "Document partagé"@fr ;
        dcterms:extent       "127 ko" ;
        schema:url           <https://www.insee.fr/fr/metadonnees/source/fichier/partage.pdf> .
}

<http://rdf.insee.fr/graphes/qualite/simsv2fr> {
